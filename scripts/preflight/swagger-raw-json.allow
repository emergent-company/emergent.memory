# Allowlisted json.RawMessage fields for scripts/preflight/swagger-raw-json.sh.
#
# One entry per line:
#   <path>:<Type>.<jsonField>  -- <reason>
#
# The key is pinned to the exact source field, so an entry cannot drift onto a
# different field when lines move, and adding one is a deliberate, reviewable
# diff. An entry is only valid while its field still exists and still lacks a
# swaggertype; once the field is typed, the guard fails until the entry is
# removed. Prefer typing the field over adding an entry here.
#
# The schema-pack fields fixed by #161 have no entries: they are typed.
# The entries below are live waivers for pre-existing debt. Each reason names
# the shape the field should get and the file it lives in, so the field can be
# fixed from this file alone. #170 tracks the schemaregistry batch; the seven
# schemas entries are nested conflict/compiled-type DTOs outside #161's six.
#
# schemaregistry request/response DTOs (#170)
apps/server/domain/schemaregistry/dto.go:SchemaRegistryEntryDTO.json_schema  -- JSON Schema object returned by the registry list; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/dto.go:ObjectTypeVersionDTO.json_schema  -- JSON Schema object in a registry version snapshot; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/dto.go:ObjectTypeVersionDTO.ui_config  -- UI config object keyed by control name in a registry version snapshot; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/dto.go:ObjectTypeVersionDTO.extraction_config  -- extraction config object in a registry version snapshot; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/dto.go:CreateTypeRequest.json_schema  -- JSON Schema object on the custom-type create request; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/dto.go:CreateTypeRequest.ui_config  -- UI config object keyed by control name on the custom-type create request; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/dto.go:CreateTypeRequest.extraction_config  -- extraction config object on the custom-type create request; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/dto.go:UpdateTypeRequest.json_schema  -- JSON Schema object on the partial-update request; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/dto.go:UpdateTypeRequest.ui_config  -- UI config object keyed by control name on the partial-update request; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/dto.go:UpdateTypeRequest.extraction_config  -- extraction config object on the partial-update request; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/entity.go:ProjectObjectSchemaRegistry.jsonSchema  -- registered object-type JSON Schema object; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/entity.go:ProjectObjectSchemaRegistry.uiConfig  -- registered object-type UI config object; declare swaggertype:"object" (#170).
apps/server/domain/schemaregistry/entity.go:ProjectObjectSchemaRegistry.extractionConfig  -- registered object-type extraction config object; declare swaggertype:"object" (#170).
#
# nested schemas conflict/compiled-type DTOs (outside #161's six)
apps/server/domain/schemas/entity.go:ObjectTypeSchema.properties  -- JSON Schema property map (object) on the compiled-type DTO; declare swaggertype:"object".
apps/server/domain/schemas/entity.go:ObjectTypeSchema.ui  -- per-type UI config object on the compiled-type DTO; declare swaggertype:"object".
apps/server/domain/schemas/entity.go:PropertyConflict.existing_def  -- existing JSON Schema property-definition object on the merge-conflict DTO; declare swaggertype:"object".
apps/server/domain/schemas/entity.go:PropertyConflict.incoming_def  -- incoming JSON Schema property-definition object on the merge-conflict DTO; declare swaggertype:"object".
apps/server/domain/schemas/entity.go:SchemaConflict.existing_schema  -- existing whole JSON Schema object on the merge-conflict DTO; declare swaggertype:"object".
apps/server/domain/schemas/entity.go:SchemaConflict.incoming_schema  -- incoming whole JSON Schema object on the merge-conflict DTO; declare swaggertype:"object".
apps/server/domain/schemas/entity.go:SchemaConflict.merged_schema  -- merged whole JSON Schema object on the merge-conflict DTO; declare swaggertype:"object".
