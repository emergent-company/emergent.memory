        "$value": { "colorSpace": "oklch", "components": [0.92, 0.009, 274] }
      },
      "400": {
        "$value": { "colorSpace": "oklch", "components": [0.86, 0.01, 274] }
      }
    },
    "brass": {
      "$description": "Primary. The butler's tray: warm metal, used for the one action that matters on a screen.",
