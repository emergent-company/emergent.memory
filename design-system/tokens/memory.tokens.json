      },
      "200": {
        "$value": { "colorSpace": "oklch", "components": [0.84, 0.012, 274] }
      },
      "100": {
        "$value": { "colorSpace": "oklch", "components": [0.93, 0.008, 265] },
        "$description": "Base-content: body copy on dark."
      },
      "50": {
        "$value": { "colorSpace": "oklch", "components": [0.975, 0.004, 265] },
        "$description": "Strongest content: headings, values."
