{
  "tutorial": "deploy-to-railway",
  "instance": "portal",
  "baseUrl": "https://deploy.memory.emergent-company.ai",
  "locale": "en-US",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "colorScheme": "dark",
  "deviceScaleFactor": 4,
  "vars": {
    "adminEmail": {
      "literal": "admin@example.com"
    },
    "newPassword": {
      "env": "SHOT_NEW_PASSWORD"
    }
  },
  "steps": [
    {
      "name": "start disconnected, so the consent screen is part of every run",
      "goto": "/oauth/railway/logout"
    },
    {
      "name": "the installer lists the four targets",
      "goto": "/"
    },
    {
      "expect": [
        "Choose a target",
        "Railway",
        "OAuth install into a Railway workspace",
        "Google Cloud",
        "AWS"
      ]
    },
    {
      "shot": {
        "id": "01-choose-target",
        "clip": "main"
      }
    },
    {
      "name": "the Railway card starts the OAuth flow",
      "click": {
        "selector": "xpath=//div[contains(@class,'card-body')][.//div[contains(@class,'font-medium') and normalize-space(.)='Railway']]//a"
      }
    },
    {
      "waitFor": {
        "url": [
          "railway\\.com/login",
          "railway\\.com/oauth/consent",
          "deploy\\.memory\\.emergent-company\\.ai/setup/railway"
        ],
        "timeout": 60000
      }
    },
    {
      "name": "clear Railway's cookie banner so it cannot sit on the figure",
      "clickIfPresent": {
        "selector": ".osano-cm-denyAll",
        "timeout": 4000
      }
    },
    {
      "name": "authorize the installer \u2014 the consent screen only exists on a first run",
      "when": {
        "url": "railway\\.com/oauth/consent"
      },
      "expect": [
        "Memory wants to access your Railway account",
        "All workspaces",
        "Authorize"
      ]
    },
    {
      "when": {
        "url": "railway\\.com/oauth/consent"
      },
      "shot": {
        "id": "02-authorize-railway",
        "clip": "xpath=//button[normalize-space()='Authorize']/ancestor::div[contains(@class,'rounded-xl')][1]"
      }
    },
    {
      "when": {
        "url": "railway\\.com/oauth/consent"
      },
      "click": {
        "selector": "button:has-text('Authorize')"
      }
    },
    {
      "waitFor": {
        "url": "/setup/railway",
        "timeout": 120000
      }
    },
    {
      "expect": [
        "Railway connected as",
        "Railway workspace",
        "Admin email",
        "Skip email for now"
      ]
    },
    {
      "name": "the published figure shows a placeholder admin, not the operator's own address",
      "fill": {
        "selector": "#admin_email",
        "value": "${adminEmail}"
      }
    },
    {
      "shot": {
        "id": "03-workspace-admin-email",
        "clip": "xpath=//form[@id='setup-form']"
      }
    },
    {
      "name": "start the install",
      "click": {
        "selector": "#deploy"
      }
    },
    {
      "waitFor": {
        "selector": "#install-progress",
        "timeout": 30000
      }
    },
    {
      "waitFor": {
        "selector": "#progress-step:has-text('Creating Railway project')",
        "timeout": 30000
      }
    },
    {
      "expect": "Creating a project in the selected workspace."
    },
    {
      "shot": {
        "id": "04-progress-project",
        "clip": "main"
      }
    },
    {
      "name": "the project exists and the template is deploying",
      "waitFor": {
        "selector": "#progress-step:has-text('Waiting for Zitadel')",
        "timeout": 900000
      }
    },
    {
      "shot": {
        "id": "05-progress-zitadel",
        "clip": "main"
      }
    },
    {
      "name": "the credentials are written and the services restart",
      "waitFor": {
        "selector": "#progress-step:has-text('Restarting Memory')",
        "timeout": 900000
      },
      "expect": "Waiting for memory-server and memory-web-ui to become ready."
    },
    {
      "shot": {
        "id": "06-progress-restart",
        "clip": "main"
      }
    },
    {
      "name": "the install succeeded",
      "waitFor": {
        "selector": "#success-card",
        "timeout": 900000
      }
    },
    {
      "expect": [
        "Memory is ready",
        "Your Memory stack is running on Railway",
        "Open Memory",
        "Admin email",
        "Password"
      ]
    },
    {
      "shot": {
        "id": "07-install-complete",
        "clip": "main"
      }
    },
    {
      "name": "the temporary password is generated by the install, so the plan reads it off the page",
      "click": {
        "selector": "#reveal-password"
      }
    },
    {
      "setVar": {
        "name": "adminPassword",
        "from": {
          "selector": "#admin-password",
          "prop": "value"
        }
      }
    },
    {
      "name": "Open Memory opens the deployment in a new tab",
      "clickNewPage": {
        "selector": "#open-memory",
        "timeout": 60000
      }
    },
    {
      "waitFor": {
        "text": "Sign in",
        "timeout": 120000
      }
    },
    {
      "shot": {
        "id": "08-memory-signin",
        "clip": "main.login-card"
      }
    },
    {
      "name": "the app sends you to the instance's own Zitadel",
      "click": {
        "selector": "a:has-text('Sign in'), button:has-text('Sign in')"
      }
    },
    {
      "waitFor": {
        "selector": "#loginName",
        "timeout": 60000
      }
    },
    {
      "expect": [
        "Welcome Back!",
        "Login Name"
      ]
    },
    {
      "type": {
        "selector": "#loginName",
        "value": "${adminEmail}"
      }
    },
    {
      "shot": {
        "id": "09-zitadel-login",
        "clip": "xpath=//h1/ancestor::div[contains(@class,'content-container')][1]",
        "pad": 0
      }
    },
    {
      "click": {
        "selector": "#submit-button"
      }
    },
    {
      "waitFor": {
        "selector": "input[name=password]",
        "timeout": 60000
      }
    },
    {
      "expect": "Password"
    },
    {
      "type": {
        "selector": "input[name=password]",
        "value": "${adminPassword}"
      }
    },
    {
      "shot": {
        "id": "10-zitadel-password",
        "clip": "xpath=//h1/ancestor::div[contains(@class,'content-container')][1]",
        "pad": 0
      }
    },
    {
      "click": {
        "selector": "#submit-button"
      }
    },
    {
      "name": "the template's login policy asks for a second factor; the tutorial says to skip it",
      "waitFor": {
        "selector": "h1:has-text('2-Factor Setup'), h1:has-text('Change Password')",
        "timeout": 60000
      }
    },
    {
      "pause": 1200
    },
    {
      "when": {
        "text": "2-Factor Setup"
      },
      "expect": [
        "2-Factor Setup",
        "Skip"
      ]
    },
    {
      "when": {
        "text": "2-Factor Setup"
      },
      "shot": {
        "id": "11-2fa-setup",
        "clip": {
          "x": 580,
          "y": 257,
          "width": 440,
          "height": 487
        }
      }
    },
    {
      "when": {
        "text": "2-Factor Setup"
      },
      "clickIfPresent": {
        "selector": "button[name=skip]",
        "timeout": 5000
      }
    },
    {
      "waitFor": {
        "text": "Change Password",
        "timeout": 60000
      }
    },
    {
      "pause": 1200
    },
    {
      "expect": [
        "Change Password",
        "Old Password",
        "Password confirmation"
      ]
    },
    {
      "shot": {
        "id": "12-first-password-change",
        "clip": "xpath=//h1/ancestor::div[contains(@class,'content-container')][1]",
        "pad": 0
      }
    },
    {
      "name": "replace the generated password, which is what completes the bootstrap",
      "type": {
        "selector": "#change-old-password",
        "value": "${adminPassword}"
      }
    },
    {
      "type": {
        "selector": "#change-new-password",
        "value": "${newPassword}"
      }
    },
    {
      "type": {
        "selector": "#change-password-confirmation",
        "value": "${newPassword}"
      }
    },
    {
      "click": {
        "selector": "xpath=//button[normalize-space()='Next']"
      }
    },
    {
      "name": "Zitadel confirms the password change before it hands back to Memory",
      "waitFor": {
        "text": "Your password was changed successfully",
        "timeout": 60000
      }
    },
    {
      "pause": 1200
    },
    {
      "click": {
        "selector": "xpath=//button[normalize-space()='Next']"
      }
    },
    {
      "name": "the app opens on the organization's projects",
      "waitFor": {
        "text": "Projects",
        "timeout": 60000
      }
    },
    {
      "name": "the bulk-delete control is server-rendered and hidden by the app's own script: a shot on first paint would ship a red toolbar no reader sees",
      "waitHidden": {
        "selector": "button[data-project-delete-busy]",
        "timeout": 30000
      }
    },
    {
      "pause": 1500
    },
    {
      "shot": {
        "id": "13-memory-projects"
      }
    }
  ]
}
