{
  "tutorial": "deploy-to-railway",
  "instance": "portal",
  "baseUrl": "https://deploy.memory.emergent-company.ai",
  "locale": "en-US",
  "viewport": {
    "width": 1600,
    "height": 827
  },
  "colorScheme": "dark",
  "deviceScaleFactor": 4,
  "steps": [
    {
      "name": "the installer lists the four targets",
      "goto": "/"
    },
    {
      "expect": [
        "Choose a target",
        "Railway",
        "OAuth install into a Railway workspace",
        "Google Cloud",
        "AWS"
      ]
    },
    {
      "shot": {
        "id": "01-choose-target",
        "clip": "main"
      }
    },
    {
      "name": "the Railway card starts the OAuth flow",
      "click": {
        "selector": "xpath=//div[contains(@class,'card-body')][.//div[contains(@class,'font-medium') and normalize-space(.)='Railway']]//a"
      }
    },
    {
      "waitFor": {
        "url": [
          "railway\\.com/login",
          "backboard\\.railway\\.com/oauth/interaction",
          "deploy\\.memory\\.emergent-company\\.ai/setup/railway"
        ],
        "timeout": 60000
      }
    },
    {
      "name": "clear Railway's cookie banner so it cannot sit on the figure",
      "clickIfPresent": {
        "selector": ".osano-cm-denyAll",
        "timeout": 4000
      }
    },
    {
      "name": "authorize the installer when Railway asks (skipped when already authorized)",
      "clickIfPresent": {
        "selector": "button:has-text('Authorize'), a:has-text('Authorize'), button:has-text('Allow')",
        "timeout": 12000
      }
    },
    {
      "waitFor": {
        "url": "/setup/railway",
        "timeout": 120000
      }
    },
    {
      "expect": [
        "Railway connected as",
        "Railway workspace",
        "Admin email",
        "Skip email for now"
      ]
    },
    {
      "mask": [
        "#admin_email",
        "div[role=alert].alert-success"
      ]
    },
    {
      "shot": {
        "id": "03-workspace-admin-email",
        "clip": "main"
      }
    },
    {
      "name": "start the install",
      "click": {
        "selector": "#deploy"
      }
    },
    {
      "waitFor": {
        "selector": "#install-progress",
        "timeout": 30000
      }
    },
    {
      "waitFor": {
        "selector": "#progress-step:has-text('Creating Railway project')",
        "timeout": 30000
      }
    },
    {
      "expect": "Creating a project in the selected workspace."
    },
    {
      "shot": {
        "id": "04-progress-project",
        "clip": "main"
      }
    },
    {
      "name": "the project exists and the template is deploying",
      "waitFor": {
        "selector": "#progress-step:has-text('Waiting for Zitadel')",
        "timeout": 900000
      }
    },
    {
      "shot": {
        "id": "05-progress-zitadel",
        "clip": "main"
      }
    },
    {
      "name": "the credentials are written and the services restart",
      "waitFor": {
        "selector": "#progress-step:has-text('Restarting Memory')",
        "timeout": 900000
      },
      "expect": "Waiting for memory-server and memory-web-ui to become ready."
    },
    {
      "shot": {
        "id": "06-progress-restart",
        "clip": "main"
      }
    },
    {
      "name": "the install succeeded",
      "waitFor": {
        "selector": "#success-card",
        "timeout": 900000
      }
    },
    {
      "expect": [
        "Memory is ready",
        "Your Memory stack is running on Railway",
        "Open Memory",
        "Admin email",
        "Password"
      ]
    },
    {
      "mask": [
        "#admin-email"
      ]
    },
    {
      "shot": {
        "id": "07-install-complete",
        "clip": "main"
      }
    },
    {
      "name": "the first admin is generated by the install, so the plan reads it off the page",
      "setVar": {
        "name": "adminEmail",
        "from": {
          "selector": "#admin-email",
          "prop": "text"
        }
      }
    },
    {
      "click": {
        "selector": "#reveal-password"
      }
    },
    {
      "setVar": {
        "name": "adminPassword",
        "from": {
          "selector": "#admin-password",
          "prop": "value"
        }
      }
    },
    {
      "name": "Open Memory opens the deployment in a new tab",
      "clickNewPage": {
        "selector": "#open-memory",
        "timeout": 60000
      }
    },
    {
      "waitFor": {
        "text": "Sign in",
        "timeout": 120000
      }
    },
    {
      "shot": {
        "id": "08-memory-signin"
      }
    },
    {
      "name": "the app sends you to the instance's own Zitadel",
      "click": {
        "selector": "a:has-text('Sign in'), button:has-text('Sign in')"
      }
    },
    {
      "waitFor": {
        "selector": "input[name=loginName]",
        "timeout": 60000
      }
    },
    {
      "expect": [
        "Welcome back!",
        "Loginname"
      ]
    },
    {
      "shot": {
        "id": "09-zitadel-login",
        "clip": "xpath=//form/ancestor::div[contains(@class,'rounded')][1]"
      }
    },
    {
      "type": {
        "selector": "input[name=loginName]",
        "value": "${adminEmail}"
      }
    },
    {
      "click": {
        "selector": "button[data-testid=submit-button]"
      }
    },
    {
      "waitFor": {
        "selector": "input[type=password]",
        "timeout": 30000
      }
    },
    {
      "expect": [
        "Password",
        "Enter your password"
      ]
    },
    {
      "shot": {
        "id": "10-zitadel-password",
        "clip": "xpath=//form/ancestor::div[contains(@class,'rounded')][1]"
      }
    },
    {
      "type": {
        "selector": "input[type=password]",
        "value": "${adminPassword}"
      }
    },
    {
      "click": {
        "selector": "button[data-testid=submit-button]"
      }
    },
    {
      "name": "the first admin is imported with passwordChangeRequired",
      "waitFor": {
        "selector": "input[name=currentPassword]",
        "timeout": 60000
      }
    },
    {
      "expect": [
        "Change Password",
        "Set the password for your account"
      ]
    },
    {
      "shot": {
        "id": "12-first-password-change",
        "clip": "xpath=//form/ancestor::div[contains(@class,'rounded')][1]"
      }
    }
  ]
}
