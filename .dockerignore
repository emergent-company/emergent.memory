# Minimal .dockerignore - only exclude what's absolutely necessary
.git
.DS_Store
node_modules
**/node_modules
coverage
**/coverage
.env
.env.*
!.env.example
*.log
apps/logs

# e2e test-run artifacts — the e2e Dockerfile builds with the repo root as
# context, so keep run logs/DB out of the image.
e2e/test-logs
e2e/logs
e2e/.runlog

# Committed CLI release artifacts (~57 MB: emergent-cli-*, emergent-darwin-*).
# The e2e Dockerfile builds the CLI from source, so these must never enter the
# repo-root build context — they bloat the context/image and exhaust runner disk.
apps/cli/emergent-*
