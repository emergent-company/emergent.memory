# =============================================================================
# LOCAL DEVELOPMENT DEFAULTS
# =============================================================================
#
# Loaded by `task` (dotenv: .env then .env.local) and inherited by every task
# process, including `task dev` and `task start`. Put machine-specific values
# and secrets in .env.local (gitignored); .env.example is the full reference.
#
# This file is tracked on purpose, so keep it free of secrets.
# =============================================================================

# Go server (see apps/server/internal/config/config.go; docs assume 3002)
SERVER_PORT=3002

# PostgreSQL. `task migrate:*` interpolates HOST/PORT/DB into DB_HOST/DB_PORT/
# POSTGRES_DATABASE, and task interpolation is first-file-wins, so they have to
# live here — a copy in .env.local would be ignored by the task. USER and DB are
# also read directly by the server and the migrate binary. The password is the
# one value that belongs in .env.local (`task` exports it to the commands it runs).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=emergent
POSTGRES_DB=emergent

# OpenTelemetry tracing (unset OTEL_EXPORTER_OTLP_ENDPOINT to disable)
OTEL_SERVICE_NAME=emergent-server
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLING_RATE=1.0

# xberg document extraction service
XBERG_ENABLED=true
XBERG_SERVICE_URL=http://localhost:8000
XBERG_SERVICE_TIMEOUT=300000

# Whisper audio transcription service
WHISPER_ENABLED=true
WHISPER_SERVICE_URL=http://localhost:9876
WHISPER_MODEL=base
WHISPER_LANGUAGE=pl
WHISPER_MAX_FILE_SIZE_MB=500
# 7200000ms = 2 hours - sufficient for a ~2h episode at ~1x realtime on CPU
WHISPER_SERVICE_TIMEOUT=7200000

# Object storage (S3-compatible). `deploy/self-hosted/docker-compose.local.yml`
# provides SeaweedFS on :9000 (see CONTRIBUTING.md); `storage` is a critical
# health component, so that service must be running for GET /health to pass.
# Dev-only — override both credentials in .env.local.
STORAGE_PROVIDER=seaweedfs
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=emergent
STORAGE_SECRET_KEY=emergent
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_TEMP=document-temp
STORAGE_REGION=us-east-1

# Document parsing worker
DOCUMENT_PARSING_WORKER_INTERVAL_MS=5000
DOCUMENT_PARSING_WORKER_BATCH_SIZE=5

# Google Cloud / Vertex AI (set GCP_PROJECT_ID in .env.local when using Vertex)
VERTEX_AI_LOCATION=global
