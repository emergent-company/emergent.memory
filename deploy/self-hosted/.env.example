# =============================================================================
# Memory Minimal Standalone Deployment - Environment Configuration
# =============================================================================
#
# REQUIRED SECRETS (generate with: openssl rand -hex 32)
# -------------------------------------------------------

# PostgreSQL Password
POSTGRES_PASSWORD=

# SeaweedFS Object Store Secret Key
OBJECT_STORE_SECRET_KEY=

# Standalone API Key (for MCP access)
STANDALONE_API_KEY=

# Encryption key for stored LLM provider credentials (API keys, service account JSON, etc.)
# Generate with: openssl rand -hex 32
LLM_ENCRYPTION_KEY=

# Google API Key (for embeddings and AI)
GOOGLE_API_KEY=

# Tailscale Auth Key (get from: https://login.tailscale.com/admin/settings/keys)
# Generate an auth key with tag:emergent and reusable=true
TS_AUTHKEY=

# =============================================================================
# OPTIONAL CONFIGURATION (defaults provided)
# =============================================================================

# Database Configuration
POSTGRES_USER=emergent
POSTGRES_DB=emergent
POSTGRES_PORT=5432

# Server Configuration
SERVER_PORT=3002

# Standalone User Configuration
STANDALONE_USER_EMAIL=admin@localhost
STANDALONE_ORG_NAME=Default Organization
STANDALONE_PROJECT_NAME=Default Project

# Object Store Configuration (SeaweedFS, S3-compatible)
OBJECT_STORE_ACCESS_KEY=emergent
OBJECT_STORE_API_PORT=9000
# AWS region used to sign S3 requests (any value works for SeaweedFS)
STORAGE_REGION=us-east-1

# xberg Configuration
XBERG_PORT=8000
XBERG_LOG_LEVEL=info

# AI Configuration
EMBEDDING_DIMENSION=768

# Feedback intake (OPTIONAL — disabled while FEEDBACK_GITHUB_TOKEN is empty)
# POST /api/feedback and the `feedback-submit` MCP tool file feedback from a
# signed-in user (or their agent) as a GitHub issue, with the submitter's
# account, project and environment attached by the server.
# To use your own tracker, set both values below:
#   FEEDBACK_GITHUB_TOKEN  fine-grained PAT with Issues: Read and write
#   FEEDBACK_GITHUB_REPO   owner/name of the repository that receives issues
# Optional: FEEDBACK_GITHUB_LABEL (default feedback), FEEDBACK_ENABLED (kill
# switch, default true), FEEDBACK_RATE_LIMIT_PER_HOUR (default 5),
# FEEDBACK_GITHUB_API_BASE_URL (GitHub Enterprise API origin).
# Leave the token empty and the endpoint answers 503; nothing is sent anywhere.
# FEEDBACK_GITHUB_TOKEN=
# FEEDBACK_GITHUB_REPO=

# Tailscale Configuration
TAILSCALE_HOSTNAME=emergent
