# Emergent Server with CLI — Consolidated Image
# Includes: Go server, swagger docs, migration binary, CLI binary
# Build context: REPOSITORY ROOT (.)
#
# Optimizations:
#   - Cross-compilation (GOARCH) instead of QEMU emulation for arm64
#   - Swag installed before source copy for Docker layer caching
#   - Go build cache mounts for faster incremental builds
#   - Pinned swag version for deterministic builds
#   - Parallel builder stages for server + CLI

# ── Global build args ──────────────────────────────────────────────
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
# Pinned github-mcp-server release baked into the runtime image. Used by the
# MCP registry to run a stdio GitHub server with native GitHub App auth
# (the server mints/refreshes installation tokens itself; no token stored).
ARG GITHUB_MCP_SERVER_VERSION=1.12.1

# ── Stage 1: Server + Migration + Swagger ──────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS server-builder

ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG VERSION
ARG GIT_COMMIT
ARG BUILD_TIME

# Install build dependencies (git needed for swag)
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build/server

# Install swag BEFORE source copy — cached until base image or version changes
RUN go install github.com/swaggo/swag/cmd/swag@v1.16.4

# Copy go.mod/go.sum first for dependency caching
# Also copy pkg/sdk go.mod/go.sum needed by the replace directive in apps/server/go.mod
COPY apps/server/go.mod apps/server/go.sum ./
COPY apps/server/pkg/sdk/go.mod apps/server/pkg/sdk/go.sum ./pkg/sdk/
RUN go mod download

# Copy source code (cache invalidation point for source changes)
COPY apps/server/ ./

# Sync go.mod/go.sum — release tags built via `git archive` can be slightly
# out of sync, causing `go build` to fail with "updates to go.mod needed"
RUN go mod tidy

# Generate swagger docs (runs on build platform, not target)
# Note: apps/server/docs may be a symlink on the host — remove it entirely first
RUN rm -rf docs && mkdir -p docs/swagger && \
    /go/bin/swag init -g cmd/server/main.go -o docs/swagger --parseDependency --parseInternal

# Cross-compile server binary for target platform
# Re-declare VERSION/GIT_COMMIT/BUILD_TIME here so BuildKit invalidates
# the cache when they change (build args don't bust cache inside RUN steps
# unless re-declared in the same stage scope immediately before use).
ARG VERSION
ARG GIT_COMMIT
ARG BUILD_TIME
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w \
      -X github.com/emergent-company/emergent.memory/internal/version.Version=${VERSION} \
      -X github.com/emergent-company/emergent.memory/internal/version.GitCommit=${GIT_COMMIT} \
      -X github.com/emergent-company/emergent.memory/internal/version.BuildTime=${BUILD_TIME}" \
    -o /out/emergent-server \
    ./cmd/server

# Cross-compile migration binary
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w" \
    -o /out/emergent-migrate \
    ./cmd/migrate

# ── Stage 2: CLI ───────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS cli-builder

ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG VERSION
ARG GIT_COMMIT
ARG BUILD_TIME

WORKDIR /build/cli

# Copy SDK first (needed for go.mod replace directive)
COPY apps/server/pkg/sdk/ /apps/server/pkg/sdk/

# Copy go.mod/go.sum for dependency caching
COPY tools/cli/go.mod tools/cli/go.sum ./
RUN go mod download

# Copy CLI source
COPY tools/cli/ ./

# Sync go.mod/go.sum — release tags built via `git archive` can be slightly
# out of sync, causing `go build` to fail with "updates to go.mod needed"
RUN go mod tidy

# Cross-compile CLI binary
# Re-declare version args to bust cache when version changes.
ARG VERSION
ARG GIT_COMMIT
ARG BUILD_TIME
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w \
      -X main.Version=${VERSION} \
      -X main.Commit=${GIT_COMMIT} \
      -X main.BuildTime=${BUILD_TIME}" \
    -o /out/memory \
    ./cmd

# ── Stage 2b: GitHub MCP server (stdio) ───────────────────────────
# Baked so the MCP registry can run a stdio GitHub server with native GitHub
# App auth; the server mints and refreshes installation tokens itself, so no
# long-lived token is stored in config. The tarball is arch-specific but the
# download runs on the build platform (no emulation).
FROM --platform=$BUILDPLATFORM alpine:3.21 AS github-mcp-builder

ARG TARGETARCH
ARG GITHUB_MCP_SERVER_VERSION

RUN apk add --no-cache curl tar coreutils
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) asset_arch=x86_64 ;; \
      arm64) asset_arch=arm64 ;; \
      *) echo "unsupported TARGETARCH for github-mcp-server: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/github/github-mcp-server/releases/download/v${GITHUB_MCP_SERVER_VERSION}"; \
    asset="github-mcp-server_Linux_${asset_arch}.tar.gz"; \
    curl -fsSL -o "/tmp/${asset}" "${base}/${asset}"; \
    curl -fsSL -o /tmp/github-mcp-checksums.txt "${base}/github-mcp-server_${GITHUB_MCP_SERVER_VERSION}_checksums.txt"; \
    expected="$(awk -v a="${asset}" '$2==a || $2=="*"a {print $1}' /tmp/github-mcp-checksums.txt)"; \
    test -n "${expected}"; \
    echo "${expected}  /tmp/${asset}" | sha256sum -c -; \
    mkdir -p /out; \
    tar -xzf "/tmp/${asset}" -C /out github-mcp-server; \
    chmod +x /out/github-mcp-server; \
    test -s /out/github-mcp-server

# ── Stage 3: Runtime ──────────────────────────────────────────────
FROM alpine:3.21

# Install runtime dependencies
# Includes Firecracker prerequisites: iptables (NAT), iproute2 (TAP), e2fsprogs (mkfs.ext4)
RUN apk --no-cache add \
    ca-certificates \
    curl \
    wget \
    bash \
    jq \
    postgresql16-client \
    iptables \
    iproute2 \
    e2fsprogs \
    coreutils

WORKDIR /app

# Copy binaries from builders
COPY --from=server-builder /out/emergent-server /usr/local/bin/
COPY --from=server-builder /out/emergent-migrate /usr/local/bin/
COPY --from=cli-builder /out/memory /usr/local/bin/

# GitHub MCP server (stdio) — invoked by the MCP registry with GitHub App auth
COPY --from=github-mcp-builder /out/github-mcp-server /usr/local/bin/github-mcp-server
RUN chmod +x /usr/local/bin/github-mcp-server

# Copy swagger docs (server looks for ./docs/swagger relative to WORKDIR)
COPY --from=server-builder /build/server/docs/swagger /app/docs/swagger

# Copy email templates (Handlebars .hbs files for invite emails, etc.)
COPY apps/server/templates/ /app/templates/

# Copy migrations
COPY apps/server/migrations/*.sql /app/migrations/

# Copy entrypoint and CLI wrapper
COPY deploy/self-hosted/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

COPY deploy/self-hosted/memory-wrapper.sh /usr/local/bin/emergent
RUN chmod +x /usr/local/bin/emergent

# Create directory for CLI config
RUN mkdir -p /root/.emergent

EXPOSE 3002

ENTRYPOINT ["/app/entrypoint.sh"]

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -sf http://localhost:3002/health || exit 1
