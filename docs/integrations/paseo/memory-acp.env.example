# Memory ACP provider credentials for Paseo.
#
# OPERATOR ACTION REQUIRED:
#   1. cp ~/.memory/memory-acp.env.example ~/.memory/memory-acp.env
#   2. Fill in the values below.
#   3. chmod 600 ~/.memory/memory-acp.env
#
# MEMORY_PROJECT_ID and MEMORY_ACP_PROXY_TARGET are needed only for the
# pre-#764 verification shim and the README's direct `curl`; they are harmless
# to leave in place when the wrapper runs `memory acp` directly.
#
# This file is sourced by ~/.memory/memory-acp-wrapper.sh, which Paseo spawns
# for the `memory` ACP provider. Do NOT commit it and do NOT paste a real token
# into ~/.paseo/config.json.

# Memory server base URL (no trailing slash), e.g. https://api.dev.emergent-company.ai
MEMORY_SERVER_URL=https://api.dev.emergent-company.ai

# Project-scoped API token (emt_...). Create with `memory init` / the admin UI.
MEMORY_PROJECT_TOKEN=emt_REPLACE_ME_WITH_A_REAL_PROJECT_TOKEN

# Memory agent skill id (RFC1123 slug) to front, listed by `memory a2a discover`.
MEMORY_AGENT=REPLACE_ME_WITH_AGENT_SKILL_ID

# Project UUID. Required by the pre-#764 header-injecting shim and by the
# README's direct `curl`; the shim falls back to reading it from this file.
# Remove together with the shim once PR #764 lands.
MEMORY_PROJECT_ID=REPLACE_ME_WITH_PROJECT_UUID

# Shim only: upstream that the pre-#764 proxy forwards to. Required before
# running docs/integrations/paseo/memory-acp-proxy.py. Remove with the shim.
MEMORY_ACP_PROXY_TARGET=https://api.dev.emergent-company.ai
