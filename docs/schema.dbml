  "batch_number" integer [not null]
  "type_name" text [not null]
  "description" text
  "confidence" real [not null]
  "inferred_schema" jsonb [not null]
  "example_instances" jsonb [default: '[]']
  "frequency" integer [not null, default: 1]
  "proposed_relationships" jsonb [default: '[]']
  "source_document_ids" uuid[] [default: '{}']
  "extraction_context" text
  "refinement_iteration" integer [not null, default: 1]
  "merged_from" uuid[]
  "status" text [not null, default: 'candidate']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "required_properties" jsonb [not null, default: '[]', note: 'Property names the model marked as required for this type; unioned (and filtered to surviving properties) when candidates merge.']

  Indexes {
    (job_id) [name: "idx_discovery_type_candidates_job_id"]
  }
}

