    (project_id) [name: "idx_graph_objects_embedding_coverage", note: '((embedding_v2 IS NOT NULL) AND (deleted_at IS NULL))']
    (fts) [name: "idx_graph_objects_fts"]
    (`(migration_archive <> '[]'::jsonb)`) [name: "idx_graph_objects_has_archive", note: '(migration_archive <> \'[]\'::jsonb)']
    (project_id, created_at, id) [name: "idx_graph_objects_head_main", note: '((supersedes_id IS NULL) AND (branch_id IS NULL) AND (deleted_at IS NULL))']
    (project_id, status, created_at, id) [name: "idx_graph_objects_head_status", note: '((supersedes_id IS NULL) AND (branch_id IS NULL) AND (deleted_at IS NULL))']
    (project_id, type, id) [name: "idx_graph_objects_head_type_count", note: '((deleted_at IS NULL) AND (supersedes_id IS NULL) AND (branch_id IS NULL))']
    (project_id) [name: "idx_graph_objects_labels_head", note: '((supersedes_id IS NULL) AND (deleted_at IS NULL) AND (cardinality(labels) > 0))']
    (last_accessed_at) [name: "idx_graph_objects_last_accessed", note: '(last_accessed_at IS NOT NULL)']
    (created_at) [name: "idx_graph_objects_missing_embedding", note: '((embedding_v2 IS NULL) AND (deleted_at IS NULL))']
    (project_id, namespace) [name: "idx_graph_objects_namespace", note: '(namespace IS NOT NULL)']
    (project_id, assignee) [name: "idx_graph_objects_project_assignee", note: '(assignee IS NOT NULL)']
    (project_id, branch_id, type, key) [name: "idx_graph_objects_project_branch_type_key_c", note: '((deleted_at IS NULL) AND (supersedes_id IS NULL) AND (branch_id IS NOT NULL))']
    (project_id, credential_id) [name: "idx_graph_objects_project_credential", note: '(credential_id IS NOT NULL)']
    (project_id, extraction_job_id) [name: "idx_graph_objects_project_extraction_job"]
    (project_id, run_id) [name: "idx_graph_objects_project_run", note: '(run_id IS NOT NULL)']
    (project_id, type, created_at, id) [name: "idx_graph_objects_project_type_created_id"]
    (project_id, type, key) [name: "idx_graph_objects_project_type_key_c", note: '((deleted_at IS NULL) AND (supersedes_id IS NULL) AND (branch_id IS NULL))']
    (project_id, type, `"left"(properties ->> 'name'::text, 256)`, key) [name: "idx_graph_objects_project_type_name", note: '((deleted_at IS NULL) AND (supersedes_id IS NULL) AND (branch_id IS NULL))']
    (project_id, type, `lower(name)`) [name: "idx_graph_objects_project_type_name_lower"]
    (project_id, type, properties) [name: "idx_graph_objects_project_type_props_gin", note: '((deleted_at IS NULL) AND (supersedes_id IS NULL) AND (branch_id IS NULL))']
    (schema_version) [name: "idx_graph_objects_schema_version"]
    (project_id, last_accessed_at, id) [name: "idx_graph_objects_unused_main", note: '((supersedes_id IS NULL) AND (deleted_at IS NULL))']
    (project_id, namespace, type, key) [name: "idx_graph_objects_upsert_namespace", unique, note: '((key IS NOT NULL) AND (namespace IS NOT NULL) AND (supersedes_id IS NULL) AND (deleted_at IS NULL) AND (branch_id IS NULL))']
  }
}

