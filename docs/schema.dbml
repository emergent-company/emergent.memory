  "credential_id" uuid
  "run_id" uuid
  "root_run_id" uuid
  "data_class" text [not null, default: 'synthesized']
  "owner_source_id" uuid
  "input_hash" text
  "name" text

  Indexes {
    (type) [name: "IDX_b8c7752534a444c2f16ebf3d91"]
    (canonical_id) [name: "IDX_c04db004625a1c8be8abb6c046"]
    (embedding_v2) [name: "IDX_graph_objects_embedding_v2_hnsw"]
    (project_id, branch_id, type, key) [name: "IDX_graph_objects_upsert_branch", unique, note: '((key IS NOT NULL) AND (supersedes_id IS NULL) AND (deleted_at IS NULL) AND (branch_id IS NOT NULL))']
    (project_id, type, key) [name: "IDX_graph_objects_upsert_main", unique, note: '((key IS NOT NULL) AND (supersedes_id IS NULL) AND (deleted_at IS NULL) AND (branch_id IS NULL))']
