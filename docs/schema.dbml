Table "kb"."graph_schemas" {
  "id" uuid [pk, default: `uuid_generate_v4()`]
  "name" text [not null]
  "version" text [not null]
  "description" text
  "author" text
  "license" text
  "repository_url" text
  "documentation_url" text
  "source" text [default: 'manual']
  "discovery_job_id" uuid
  "pending_review" boolean [not null, default: false]
  "object_type_schemas" jsonb [not null]
  "relationship_type_schemas" jsonb [not null, default: '{}']
  "ui_configs" jsonb [not null, default: '{}']
  "extraction_prompts" jsonb [not null, default: '{}']
  "sql_views" jsonb [not null, default: '[]']
  "signature" text
  "checksum" text
  "published_at" timestamptz [not null, default: `now()`]
  "deprecated_at" timestamptz
  "superseded_by" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "parent_version_id" uuid
  "draft" boolean [default: false]
  "project_id" uuid
  "migrations" jsonb

  Indexes {
    (draft) [name: "IDX_graph_schemas_draft", note: '(draft = true)']
    (parent_version_id) [name: "IDX_graph_schemas_parent_version_id", note: '(parent_version_id IS NOT NULL)']
    (name, version) [name: "graph_schemas_builtin_name_version_key", unique, note: '(source = \'builtin\'::text)']
    (project_id) [name: "idx_graph_schemas_project_id", note: '(project_id IS NOT NULL)']
    (project_id) [name: "uq_graph_schemas_current_discovered", unique, note: '((source = \'discovered\'::text) AND (pending_review = true) AND (superseded_by IS NULL) AND (project_id IS NOT NULL))']
  }
}

