Table "kb"."documents" {
  "id" uuid [pk, default: `uuid_generate_v4()`]
  "project_id" uuid
  "source_url" text
  "filename" text
  "mime_type" text
  "content" text
  "content_hash" text
  "parent_document_id" uuid
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "source_type" text [not null, default: 'upload']
  "storage_key" text
  "storage_url" text
  "metadata" jsonb [default: '{}']
  "file_size_bytes" bigint
  "conversion_status" text [default: 'not_required']
  "conversion_error" text
  "conversion_completed_at" timestamptz
  "file_hash" text
  "domain_name" text
  "domain_confidence" real
  "classification_signals" jsonb
  "canonical_id" uuid [not null, default: `uuid_generate_v4()`]
  "supersedes_id" uuid
  "version" integer [not null, default: 1]
  "source_id" uuid
  "source_external_id" text
  "source_revision_id" text
  "source_text_hash" text
  "source_synced_at" timestamptz
  "source_status" text [not null, default: 'active']
  "source_deleted_at" timestamptz
  "created_by_user_id" uuid [note: 'Authenticated user who uploaded the document; NULL for source-synced documents and for rows predating #2260.']

  Indexes {
    (project_id) [name: "IDX_e156b298c20873e14c362e789b"]
    (canonical_id, version) [name: "idx_documents_canonical_version", unique]
    (conversion_status) [name: "idx_documents_conversion_status", note: '(conversion_status = ANY (ARRAY[\'pending\'::text, \'failed\'::text]))']
    (project_id, `(metadata ->> 'messageId'::text)`) [name: "idx_documents_email_message_id", unique, note: '((source_type = \'email\'::text) AND ((metadata ->> \'messageId\'::text) IS NOT NULL))']
    (`(metadata ->> 'messageId'::text)`) [name: "idx_documents_email_message_id_lookup", note: '((source_type = \'email\'::text) AND ((metadata ->> \'messageId\'::text) IS NOT NULL))']
    (metadata) [name: "idx_documents_metadata", note: '((metadata IS NOT NULL) AND (metadata <> \'{}\'::jsonb))']
    (parent_document_id) [name: "idx_documents_parent_document_id"]
    (project_id, content_hash) [name: "idx_documents_project_content_hash_manual_head", unique, note: '((content_hash IS NOT NULL) AND (supersedes_id IS NULL) AND (source_id IS NULL) AND (file_hash IS NULL))']
    (project_id, created_at, id) [name: "idx_documents_project_created_id"]
    (project_id, source_id, source_status) [name: "idx_documents_project_source_status"]
    (project_id, updated_at, id) [name: "idx_documents_project_updated_id"]
    (source_id, source_external_id) [name: "idx_documents_source_external_head", unique, note: '((source_external_id IS NOT NULL) AND (supersedes_id IS NULL))']
    (source_type) [name: "idx_documents_source_type"]
    (storage_key) [name: "idx_documents_storage_key", note: '(storage_key IS NOT NULL)']
  }
}

Table "kb"."email_jobs" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "template_name" varchar(100) [not null]
  "to_email" varchar(320) [not null]
  "to_name" varchar(255)
  "subject" varchar(500) [not null]
  "template_data" jsonb [not null, default: '{}']
  "status" varchar(20) [not null, default: 'pending']
  "attempts" integer [not null, default: 0]
  "max_attempts" integer [not null, default: 3]
  "last_error" text
  "mailgun_message_id" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "processed_at" timestamptz
  "next_retry_at" timestamptz
  "source_type" varchar(50)
  "source_id" uuid
  "delivery_status" kb.email_delivery_status
  "delivery_status_at" timestamptz
  "delivery_status_synced_at" timestamptz
  "started_at" timestamptz
  "project_id" uuid

  Indexes {
    (mailgun_message_id) [name: "idx_email_jobs_mailgun_id", note: '(mailgun_message_id IS NOT NULL)']
    (`btrim(mailgun_message_id::text, '<>'::text)`) [name: "idx_email_jobs_mailgun_message_id_btrim"]
    (processed_at) [name: "idx_email_jobs_needs_status_sync", note: '(((status)::text = \'sent\'::text) AND (mailgun_message_id IS NOT NULL) AND (delivery_status IS NULL))']
    (project_id, status) [name: "idx_email_jobs_project_status", note: '(project_id IS NOT NULL)']
    (source_type, source_id) [name: "idx_email_jobs_source"]
    (status, next_retry_at) [name: "idx_email_jobs_status_next_retry", note: '((status)::text = ANY (ARRAY[(\'pending\'::character varying)::text, (\'processing\'::character varying)::text]))']
