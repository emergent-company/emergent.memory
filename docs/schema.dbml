Table "kb"."mcp_server_oauth" {
  "server_id" uuid [not null]
  "project_id" uuid [not null]
  "authorization_server" text [not null, default: '']
  "token_endpoint" text [not null, default: '']
  "registration_endpoint" text [not null, default: '']
  "resource" text [not null, default: '', note: 'RFC 8707 protected resource identifier sent on authorize/token/refresh']
  "scope" text [not null, default: '']
  "client_id" text [not null, default: '']
  "client_secret" jsonb [note: 'AES-GCM encrypted client secret: {ct, nonce}']
  "access_token" jsonb [note: 'AES-GCM encrypted access token: {ct, nonce}']
  "refresh_token" jsonb [note: 'AES-GCM encrypted refresh token: {ct, nonce}']
  "expires_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "user_id" uuid [note: 'Owning user for a personal OAuth credential; NULL is the project-wide shared credential']
  "requested_scope" text [not null, default: '', note: 'Operator-configured scope set to request on connect; overrides the challenge scope (RFC 9728 §7.2). Empty means discover.']

  Indexes {
    (project_id) [name: "idx_mcp_server_oauth_project_id"]
    (server_id) [name: "mcp_server_oauth_shared_uniq", unique, note: '(user_id IS NULL)']
    (user_id) [name: "mcp_server_oauth_user_id", note: '(user_id IS NOT NULL)']
    (server_id, user_id) [name: "mcp_server_oauth_user_uniq", unique, note: '(user_id IS NOT NULL)']
  }
}
// kb.mcp_server_oauth: OAuth credentials (client registration + token set) for a remote MCP server

Table "kb"."mcp_server_tools" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "server_id" uuid [not null]
  "tool_name" varchar(255) [not null, note: 'Tool name as reported by the MCP server (unprefixed)']
  "description" text [note: 'Tool description for display and agent introspection']
  "input_schema" jsonb [default: '{}', note: 'JSON Schema for tool input parameters']
  "enabled" boolean [not null, default: true, note: 'Whether this tool is available for use (per-tool toggle)']
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "config" jsonb
  "config_keys" text[] [default: '{}']
  "output_schema" jsonb
  "enabled_override" boolean

  Indexes {
    (server_id, enabled) [name: "idx_mcp_server_tools_enabled", note: '(enabled = true)']
    (server_id) [name: "idx_mcp_server_tools_server_id"]
    (server_id, tool_name) [name: "idx_mcp_server_tools_server_name", unique]
  }
}
// kb.mcp_server_tools: Cached tool definitions from MCP servers with per-tool enable/disable

Table "kb"."mcp_servers" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "project_id" uuid [not null]
  "name" varchar(255) [not null]
  "enabled" boolean [not null, default: true]
  "type" varchar(50) [not null, note: 'Server transport type: builtin, stdio, sse, http']
  "command" text [note: 'Command to execute for stdio-type servers']
  "args" text[] [default: '{}', note: 'Command arguments for stdio-type servers']
  "env" jsonb [default: '{}', note: 'Environment variables passed to the server process']
  "url" text [note: 'Endpoint URL for sse/http-type servers']
  "headers" jsonb [default: '{}', note: 'HTTP headers for sse/http-type servers']
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "description" text
  "secret_env" jsonb [default: '{}', note: 'AES-GCM encrypted secret env vars: {KEY: {ct, nonce}}']
  "secret_headers" jsonb [default: '{}', note: 'AES-GCM encrypted secret HTTP headers: {KEY: {ct, nonce}}']
  "target" text [not null, default: 'server', note: 'server (connected outbound) or device (pushed over the relay)']
  "target_instance_id" text [note: 'relay instance_id for device target; NULL = all eligible devices in the project']
  "required_config" jsonb [not null, default: '[]', note: 'credential keys (kind=header|env) the server needs before it can be enabled; [{"name","kind","isSecret","isRequired","description","valueHint"}]']
  "registry_name" text [note: 'registry server name a row was installed from; NULL for manual creates']
  "registry_repository_url" text [note: 'source repository URL from the registry entry; backs the configure form docs link']

  Indexes {
    (project_id, enabled) [name: "idx_mcp_servers_project_enabled", note: '(enabled = true)']
    (project_id) [name: "idx_mcp_servers_project_id"]
    (project_id, name) [name: "idx_mcp_servers_project_name", unique]
  }
}
// kb.mcp_servers: Registry of MCP servers (builtin and external) per project

