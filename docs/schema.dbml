    (agent_id) [name: "idx_skill_reviews_one_active", unique, note: '((status = ANY (ARRAY[\'pending\'::text, \'running\'::text])) AND (agent_id IS NOT NULL))']
    (agent_run_id) [name: "idx_skill_reviews_run", unique, note: '(agent_run_id IS NOT NULL)']
  }
}

Table "kb"."skill_usage" {
  "skill_id" uuid [pk]
  "project_id" uuid
  "use_count" bigint [not null, default: 0]
  "patch_count" bigint [not null, default: 0]
  "last_used_at" timestamptz
  "last_patched_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (project_id, last_used_at) [name: "idx_skill_usage_project"]
  }
}

Table "kb"."skills" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "name" text [not null, note: 'Slug identifier: lowercase alphanumeric with hyphens, 1–64 chars']
  "description" text [not null, default: '']
  "content" text [not null, default: '']
  "metadata" jsonb [not null, default: '{}']
  "description_embedding" vector(768) [note: '768-dim embedding of description text for semantic retrieval (gemini-embedding-001 with MRL); NULL when embedding generation failed or is disabled']
  "project_id" uuid [note: 'NULL for global skills; set for project-scoped skills. Project-scoped wins on name collision.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "org_id" uuid [note: 'NULL for global and project-scoped skills; set for org-wide skills. Mutually exclusive with project_id.']

  Indexes {
    (description_embedding) [name: "idx_skills_embedding_hnsw"]
    (name) [name: "idx_skills_name_global", unique, note: '(project_id IS NULL)']
    (name, org_id) [name: "idx_skills_name_org", unique, note: '((project_id IS NULL) AND (org_id IS NOT NULL))']
    (name, project_id) [name: "idx_skills_name_project", unique, note: '(project_id IS NOT NULL)']
    (org_id) [name: "idx_skills_org_id"]
    (project_id) [name: "idx_skills_project_id"]
  }
}
// kb.skills: Reusable Markdown workflow instructions (skills) for agents. Global when project_id IS NULL; project-scoped otherwise.

