  "migration_archive" jsonb [default: '[]', note: 'Archive of dropped properties from schema migrations. Each entry contains: from_version, to_version, timestamp, dropped_data']
  "last_accessed_at" timestamptz
  "namespace" text
  "delete_reason" text
  "merged_to_canonical_id" uuid
