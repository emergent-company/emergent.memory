Table "kb"."backup_schedules" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "organization_id" uuid [not null]
  "project_id" uuid [not null, unique]
  "enabled" boolean [not null, default: true]
  "cron_schedule" text [not null, note: 'Standard 5-field cron expression evaluated in UTC, e.g. "0 2 * * *" for 02:00 UTC daily']
  "timezone" text [not null, default: 'UTC']
  "retention_days" integer [not null, default: 30, note: 'Retention applied to every backup the schedule creates: expires_at = created_at + retention_days']
  "include_chat" boolean [not null, default: false]
  "include_journal" boolean [not null, default: false]
  "include_deleted" boolean [not null, default: false]
  "next_run_at" timestamptz [not null, note: 'Next due instant; the runner claims rows where enabled AND next_run_at <= now()']
  "last_run_at" timestamptz
  "last_backup_id" uuid
  "created_by" uuid
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (next_run_at) [name: "idx_backup_schedules_due", note: 'enabled']
  }
}
// kb.backup_schedules: Per-project recurring backup schedule; one row per project, executed by the backups:project_schedules scheduler task

Table "kb"."backups" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "organization_id" uuid [not null]
  "project_id" uuid [not null]
  "project_name" text [not null]
  "storage_key" text [not null, note: 'MinIO object key: backups/{orgId}/{backupId}/backup.zip']
  "size_bytes" bigint [not null, default: 0]
  "status" text [not null, default: 'creating']
  "progress" integer [not null, default: 0]
  "error_message" text
  "backup_type" text [not null, default: 'full', note: 'Type of backup: full (complete snapshot) or incremental (changes only)']
  "includes" jsonb [not null, default: '{}', note: 'What data is included: {documents: true, chat: true, graph: true}']
  "stats" jsonb [note: 'Backup statistics: {documents: 150, chunks: 3000, files: 150, ...}']
  "created_at" timestamptz [not null, default: `now()`]
  "created_by" uuid
  "completed_at" timestamptz
  "expires_at" timestamptz
  "deleted_at" timestamptz
  "manifest_checksum" text
  "content_checksum" text
  "parent_backup_id" uuid
  "baseline_backup_id" uuid
  "change_window" jsonb [note: 'For incremental backups: {from: timestamp, to: timestamp}']
  "imported" boolean [not null, default: false, note: 'True when the backup was imported from another deployment; project_id is the foreign source project (no local kb.projects row) and such backups are clone-restore only']

  Indexes {
    (baseline_backup_id) [name: "idx_backups_baseline", note: '(baseline_backup_id IS NOT NULL)']
    (created_at) [name: "idx_backups_created", note: '(deleted_at IS NULL)']
    (expires_at) [name: "idx_backups_expires", note: '((deleted_at IS NULL) AND (expires_at IS NOT NULL))']
    (organization_id, project_id) [name: "idx_backups_org_project", note: '(deleted_at IS NULL)']
    (parent_backup_id) [name: "idx_backups_parent", note: '(parent_backup_id IS NOT NULL)']
    (status) [name: "idx_backups_status", note: '(deleted_at IS NULL)']
  }
}
// kb.backups: Stores metadata for project backups stored in MinIO

