# =============================================================================
# ROOT .ENV - WORKSPACE & SHARED CONFIGURATION
# =============================================================================
# 
# This file contains SAFE DEFAULTS for workspace-wide configuration.
# It is COMMITTED to the repository and should NOT contain secrets.
#
# ORGANIZATION:
# - Root .env         → Workspace/shared variables (THIS FILE)
# - Root .env.local   → User overrides & secrets (GITIGNORED)
# - apps/server/.env → Go server application variables (see apps/server/README.md)
# - apps/admin/.env   → Admin frontend variables
#
# LOADING PRECEDENCE:
# .env.local overrides .env (when both exist)
#
# SECRETS POLICY:
# - Keep secrets in .env.local (never committed)
# - This file contains only safe defaults
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Configuration
# -----------------------------------------------------------------------------
# Environment type (for organizational purposes)
# Options: local | dev | staging | production
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# Workspace Process Management
# -----------------------------------------------------------------------------
# Namespace for PM2 processes to avoid conflicts with other projects (REQUIRED)
# Used by: tools/workspace-cli
NAMESPACE=emergent

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
# Admin frontend port (REQUIRED)
ADMIN_PORT=5176

# Server backend port (REQUIRED)
SERVER_PORT=3002

# -----------------------------------------------------------------------------
# Zitadel Configuration
# -----------------------------------------------------------------------------
# NOTE: Zitadel is now deployed independently in ../emergent-infra/zitadel/
# See ../emergent-infra/zitadel/README.md for deployment instructions
#
# Zitadel domain for OIDC authentication (REQUIRED)
# Used by: apps communicate via this domain
# Default points to the independent Zitadel deployment on port 8080
ZITADEL_DOMAIN=localhost:8080

# OIDC scope authority (unify-scope-authority §8, #1161)
# The application is the sole authority for fine-grained Memory scopes; Zitadel
# authenticates only. An OIDC token can no longer mint a Memory scope:
# MEMORY_OIDC_TRUST_TOKEN_SCOPES and MEMORY_USERINFO_GRANT_ALL_SCOPES were
# removed, and the userinfo fallback resolves through application entitlements
# (project membership, org_admin, superadmin) -> app-owned default -> empty.
# The only remaining scope-policy knob is the app-owned default set:
#   MEMORY_OIDC_DEFAULT_SCOPES  comma-separated; empty (default) grants nothing.
# The authenticated /api/health/scope-authority endpoint reports whether RFC 7662
# introspection is configured (introspection_configured).

# -----------------------------------------------------------------------------
# Test User Configuration
# -----------------------------------------------------------------------------
# Two separate test users are created during bootstrap:
# 1. TEST_USER_* - For manual testing and development
# 2. E2E_TEST_USER_* - For automated E2E tests
# Bootstrap script will create both users if they don't exist

# E2E Test User email (OPTIONAL)
E2E_TEST_USER_EMAIL=e2e-test@example.com

# E2E Test User password (OPTIONAL) (SECRET)
E2E_TEST_USER_PASSWORD=E2eTestPassword123!

# Manual Test User email (OPTIONAL)
TEST_USER_EMAIL=test@example.com

# Manual Test User password (OPTIONAL) (SECRET)
TEST_USER_PASSWORD=TestPassword123!

# -----------------------------------------------------------------------------
# Email / Mailgun Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# Outbound email is disabled unless EMAIL_ENABLED=true.
EMAIL_ENABLED=false

# Transport: mailgun (default) or smtp
EMAIL_TRANSPORT=mailgun

# Mailgun domain + API key (SECRET)
MAILGUN_DOMAIN=
MAILGUN_API_KEY=

# Mailgun webhook signing key (SECRET). Required for the public
# POST /api/webhooks/mailgun delivery-status webhook; without it every request
# is rejected (fail closed). Find it under Settings > API keys > HTTP webhook
# signing key in the Mailgun control panel.
MAILGUN_SIGNING_KEY=your-mailgun-webhook-signing-key

# Mailgun webhook replay hardening. Mailgun's HMAC binds only timestamp+token,
# not the request body, so a signature timestamp older (or further ahead) than
# this window is rejected as a replay, and each signature token is single-use
# within the window. Default: 5m.
MAILGUN_WEBHOOK_TOLERANCE=5m

# Mailgun webhook rate limiting (public endpoint). Per-client-IP budget and
# burst, plus a global backstop across all clients (a spoofed X-Forwarded-For
# cannot bypass the global cap). The upstream WAF/proxy remains the coarse first
# layer. Defaults: 120/min per IP, burst 40, 1200/min global, burst 300.
MAILGUN_WEBHOOK_RATE_PER_MIN=120
MAILGUN_WEBHOOK_RATE_BURST=40
MAILGUN_WEBHOOK_GLOBAL_RATE_PER_MIN=1200
MAILGUN_WEBHOOK_GLOBAL_RATE_BURST=300

# Mailgun region: us (default) or eu
MAILGUN_REGION=us

# -----------------------------------------------------------------------------
# External Tools & Scripts Configuration
# -----------------------------------------------------------------------------
# These variables are NOT used by the application code itself, but by:
# - MCP servers (Model Context Protocol) - database access for AI tools
# - Development scripts in scripts/ directory
# - Testing utilities
# - CLI tools like Gemini Code Assist
#
# They can be placed in root .env for convenience when using these tools,
# even though they are technically "server" variables. This avoids the need
# to duplicate them across multiple .env files for external tool access.

# Database connection for MCP Postgres server (OPTIONAL)
# Used by: scripts/mcp-postgres-wrapper.sh, .vscode/mcp.json, .gemini/settings.json
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=emergent
POSTGRES_DB=emergent

# Note: POSTGRES_PASSWORD should be in .env.local (SECRET)
# It's also needed by MCP tools but must not be committed

# Google Cloud / Vertex AI configuration for scripts (OPTIONAL)
# Used by: scripts/test-vertex-ai-credentials.mjs and other development scripts
GCP_PROJECT_ID=<your-gcp-project-id>
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash-lite

# -----------------------------------------------------------------------------
# Storage Configuration (MinIO / S3-compatible)
# -----------------------------------------------------------------------------
# NOTE: MinIO is now deployed independently in ../emergent-infra/xberg/
# See ../emergent-infra/xberg/README.md for deployment instructions
#
# Storage provider type (OPTIONAL)
# Options: minio | s3 | gcs
STORAGE_PROVIDER=minio

# MinIO/S3 endpoint URL (REQUIRED for storage features)
# Default points to the independent MinIO deployment on port 9010
STORAGE_ENDPOINT=http://localhost:9010

# Storage credentials (OPTIONAL - set in .env.local for security)
# Default MinIO credentials for local development
STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY should be in .env.local (SECRET)

# Storage bucket names (OPTIONAL)
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_TEMP=document-temp

# Storage region (OPTIONAL)
STORAGE_REGION=us-east-1

# -----------------------------------------------------------------------------
# xberg Document Parsing Service
# -----------------------------------------------------------------------------
# NOTE: xberg is deployed alongside MinIO in ../emergent-infra/xberg/
#
# xberg service URL (REQUIRED for document parsing)
XBERG_SERVICE_URL=http://localhost:8000

# xberg service timeout in milliseconds (OPTIONAL)
XBERG_SERVICE_TIMEOUT=300000

# Enable xberg document parsing (OPTIONAL)
# XBERG_ENABLED=true

# -----------------------------------------------------------------------------
# Whisper Audio Transcription Service
# -----------------------------------------------------------------------------
# Self-hosted Whisper transcription for audio files (mp3, wav, m4a, ogg, etc.)
# Deploy with: docker run -p 9000:9000 onerahmet/openai-whisper-asr-webservice:latest
#
# Enable Whisper transcription (OPTIONAL, default: false)
WHISPER_ENABLED=false

# Whisper service URL (REQUIRED when WHISPER_ENABLED=true)
WHISPER_SERVICE_URL=http://localhost:9000

# Whisper model to use: base (fast/CPU), small, medium, large-v3 (accurate/GPU) (OPTIONAL)
WHISPER_MODEL=base

# Language hint for transcription, leave empty for auto-detect (OPTIONAL)
# WHISPER_LANGUAGE=en

# Whisper service timeout in milliseconds — allow extra time for large files (OPTIONAL)
WHISPER_SERVICE_TIMEOUT=600000

# Maximum audio file size in MB (OPTIONAL, default: 500)
WHISPER_MAX_FILE_SIZE_MB=500

# -----------------------------------------------------------------------------
# MCP Registry
# -----------------------------------------------------------------------------
# MCP registry base URL. Default: https://registry.modelcontextprotocol.io
# Override to point the server at a local stub (used by the e2e suite).
# MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io

# -----------------------------------------------------------------------------
# MCP Tool Guardrails
# -----------------------------------------------------------------------------
# Hard per-call deadline for the entity-query tool (OPTIONAL, default: 30s).
# MCP_ENTITY_QUERY_TIMEOUT=30s

# Maximum effective limit when field_strategy="full" is requested
# (OPTIONAL, default: 25).
# MCP_ENTITY_QUERY_FULL_MAX_LIMIT=25

# Bounded tool results fed to the model (issue #1205). The FULL result is still
# persisted (kb.agent_run_tool_calls, kb.agent_run_messages) and streamed to the
# UI; only the model context is truncated, with an actionable marker.
#
# Per-result cap in JSON bytes (OPTIONAL, default: 128 KiB ≈ 32k tokens). A
# negative value disables per-result truncation for EVERY tool and also ignores
# the per-tool overrides below.
# MCP_TOOL_RESULT_MAX_BYTES=131072

# Per-tool overrides for MCP_TOOL_RESULT_MAX_BYTES, comma-separated
# "tool=bytes" (OPTIONAL, default: empty). Use for tools that legitimately
# return bulk data. Applied only while the global per-result cap is enabled
# (>= 0): a positive override does NOT re-enable a globally disabled cap.
# MCP_TOOL_RESULT_MAX_BYTES_OVERRIDES=entity-edges-get=262144,session-get-messages=262144

# Cap on the SUM of all tool results in one model request in bytes; the oldest
# results are elided first when exceeded (OPTIONAL, default: 512 KiB ≈ 128k
# tokens — with the 128 KiB per-result default this trims the extreme tail only,
# i.e. >4 capped results in one request). The budget is SOFT: the most recent
# result is never elided, so if one newest result alone exceeds the budget it is
# retained whole. A negative value disables it.
# MCP_TOOL_RESULT_TOTAL_BUDGET_BYTES=524288

# -----------------------------------------------------------------------------
# Document Parsing Worker
# -----------------------------------------------------------------------------
# Enable background document parsing worker (OPTIONAL)
# DOCUMENT_PARSING_WORKER_ENABLED=true

# Worker poll interval in milliseconds (OPTIONAL)
DOCUMENT_PARSING_WORKER_POLL_INTERVAL_MS=5000

# Number of documents to process per batch (OPTIONAL)
DOCUMENT_PARSING_WORKER_BATCH_SIZE=5

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# 
# SERVER VARIABLES: See apps/server/README.md (Configuration section)
# - Database configuration (POSTGRES_*)
# - API keys (GOOGLE_API_KEY, etc.)
# - LLM/Extraction configuration
# - Authentication backend settings
#
# ADMIN VARIABLES: See apps/admin/.env.example  
# - Frontend configuration (VITE_*)
# - OIDC client settings
# - API connection settings
#
# USER OVERRIDES: Create .env.local to override any value above
# Example .env.local:
#   ADMIN_PORT=5177
#   SERVER_PORT=3003
#   NAMESPACE=my-custom-namespace
#

# -----------------------------------------------------------------------------
# Agent Safeguards (queue explosion prevention)
# -----------------------------------------------------------------------------
# Maximum number of pending/processing jobs per agent before new runs are rejected.
# AGENT_MAX_PENDING_JOBS=10

# Number of consecutive failures before an agent is auto-disabled.
# AGENT_CONSECUTIVE_FAILURE_THRESHOLD=5

# Minimum cron interval in minutes. Cron schedules firing more often are rejected.
# AGENT_MIN_CRON_INTERVAL_MINUTES=15

# Whether budget limits block agent execution (hard enforcement). Set to false to alert-only.
# BUDGET_ENFORCEMENT_ENABLED=true

# Emergency kill switch: set to false to disable ALL agent execution system-wide.
# AGENT_EXECUTION_ENABLED=true

# -----------------------------------------------------------------------------
# OpenTelemetry Tracing (opt-in)
# -----------------------------------------------------------------------------
# Enable local trace collection by setting the OTLP endpoint.
# Start Tempo first: docker compose --profile observability up tempo -d
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=emergent-server
# OTEL_SAMPLING_RATE=1.0
# OTEL_RETENTION_HOURS=720
