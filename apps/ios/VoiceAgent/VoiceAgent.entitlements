<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The share extension is a separate process with its own container; this
	     group is how it reads the device's Memory connection and hands captures
	     back to the app. It must be enabled on the app's App ID in the developer
	     portal before a signed build (see apps/ios/README.md). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.emergent.memory</string>
	</array>
</dict>
</plist>
