# LiveKit (self-hosted)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecret12

# Token endpoint (POST /api/token) — mints room-join JWTs for the iOS client.
# The gateway container listens on 8080; the published host port is
# MEMORY_PUBLISHED_PORT (default 8095). Voice auth is a Zitadel session or a
# scoped `emt_` device credential (sent via X-API-Key).
# TOKEN_API_KEY=
# Comma-separated room allow-list (default: only rooms prefixed "memory-")
# TOKEN_ALLOWED_ROOMS=
# Public URL returned to clients (default: LIVEKIT_URL)
# LIVEKIT_PUBLIC_URL=
# Default agent dispatched via room config (default: alfred)
# LIVEKIT_AGENT_NAME=alfred
# Idle TTL before an on-demand bridge worker is reaped (default: 10m)
# WORKER_IDLE_TTL=10m
# Host port published by docker-compose for the gateway (container listens on
# 8080; host 8080 is often taken). Default: 8095.
# MEMORY_PUBLISHED_PORT=8095

# STT — Deepgram (streaming, low-latency)
DEEPGRAM_API_KEY=

# LLM — any OpenAI-compatible API (default: local DeepSeek via LiteLLM)
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=sk-your-key-here
LLM_MAX_TOKENS=1024
# Alternative: OpenAI
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=
# LLM_API_KEY=sk-...

# Provider connection-test egress. The gateway's provider test / base-url check
# blocks non-public addresses (SSRF guard) by default. List comma-separated
# hostnames and/or CIDRs to exempt self-hosted LLM gateways (e.g. litellm).
# Leave empty for the strict public-only default.
# PROVIDER_PROBE_ALLOW=litellm

# TTS — Cartesia (streaming, natural)
CARTESIA_API_KEY=

# Home Assistant — via ha-mcp (homeassistant-ai/ha-mcp, 78 tools)
# Direct URL from HA-MCP Custom Component Configure screen:
HA_MCP_URL=http://ha-ip:9583/private_xxxxxxxx
# Or: built-in HA MCP Server (requires HA 2025.x+)
# HA_URL=http://ha-ip:8123
# HA_TOKEN=

# Wake word
WAKE_WORD_MODEL=hey_alfred
# Path to custom ONNX model if trained (default: use livekit-wakeword built-in)
# WAKE_WORD_MODEL_PATH=./models/hey_alfred.onnx

# ---- Self-hosted backend (no cloud keys) ----
# STT
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# LLM (Ollama)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# TTS backend: "piper" or "kokoro"
# TTS_BACKEND=piper
# PIPER_MODEL_PATH=~/.local/share/piper-tts/en_US-amy-medium.onnx
# KOKORO_VOICE=af_heart

# Error tracking (Sentry) — both the gateway (Go) and browser (JS) report to
# this DSN; leave SENTRY_DSN empty to disable
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Element-level feedback overlay (emergent-company/feedback-overlay). Base URL
# of the overlay service (client bundle + API). Empty = overlay disabled.
FEEDBACK_OVERLAY_URL=

# ---- Browser auth (Zitadel OIDC) ----
# AUTH_MODE=session is the DEFAULT and requires: SESSION_SECRET, ZITADEL_ISSUER,
# ZITADEL_CLIENT_ID, ZITADEL_REDIRECT_URI and PUBLIC_BASE_URL (plus MEMORY_URL).
# The UI requires a Zitadel sign-in and /api/* accepts a session cookie OR
# X-API-Key.
# AUTH_MODE=dev is an explicit local-dev escape hatch: unauthenticated UI,
# warned at startup. Never use it outside local development.
# AUTH_MODE=dev
# ZITADEL_ISSUER=https://my-zitadel.example.com
# ZITADEL_CLIENT_ID=
# ZITADEL_REDIRECT_URI=http://memory:8095/auth/callback
# PUBLIC_BASE_URL=http://memory:8095
# SESSION_SECRET=           # HMAC key for the session cookie (required in session mode)

# Dev-gated component gallery (/dev/components). Explicit and default-off;
# uncomment to enable locally for visual component review. Compose defaults the
# flag off (`${MEMORY_COMPONENT_GALLERY:-off}`), so leaving it commented is safe.
# MEMORY_COMPONENT_GALLERY=on

# --- Remote Mac build target ------------------------------------------------
# The iOS tooling (tools/ios-build-mac.sh, tools/ios-debug-mac.sh) and the Mac
# connector tooling (apps/connector.mac/Scripts/mac-*.sh) read these from the
# gitignored apps/connector.mac/.env, NOT from this file. See
# apps/connector.mac/.env.example for the full list. This repo's own Mac:
# MEMORY_MAC_HOST=mcj-mini
# MEMORY_MAC_PATH=~/code/emergent.memory
# MEMORY_MAC_IOS_SUBDIR=client/ios
