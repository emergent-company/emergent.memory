# Copy to .env.e2e (gitignored) and fill in a Zitadel test user.
# The user must exist on the deployment's Zitadel issuer (e.g.
# https://zitadel.example.com) and have no MFA.
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# Required: memory API origin the token/agent specs probe directly.
# There is no deployment default baked into the suite.
E2E_MEMORY_API_URL=

# Optional: connector API origin (defaults to E2E_MEMORY_API_URL).
# E2E_CONNECTOR_SERVER=

# Optional: override the gateway origin (defaults to http://localhost:8095).
# E2E_BASE_URL=http://localhost:8095

# Live-LLM scenario suite (scenarios/blueprint-object-chat.spec.ts):
# the provider add is live-validated by the memory backend and the chat turn
# calls a real model, so a real provider key is required. Without the key the
# scenario skips. Defaults target the dev litellm proxy (openai provider).
# E2E_SCENARIO_LLM_PROVIDER=openai
# E2E_SCENARIO_LLM_API_KEY=
# E2E_SCENARIO_LLM_BASE_URL=http://litellm:4000/v1
# E2E_SCENARIO_LLM_MODEL=openai/deepseek-v4-flash
# E2E_SCENARIO_LLM_EMBEDDING_MODEL=openai/gemini-embedding-001
# E2E_SCENARIO_LLM_MODEL is the already-prefixed "provider/model" catalog value.
# Memory strips exactly one routing prefix before calling litellm, so do not
# include the provider twice (e.g. openai/openai/deepseek-v4-flash).

# OpenAI-compatible provider via LiteLLM
# (scenarios/provider-openai-litellm-config.spec.ts): configures the
# "openai" provider against a LiteLLM proxy from a fresh project. The save is
# live-validated by the memory backend (real generate test against the base
# URL), so both must point at a reachable LiteLLM with a valid key. Base URL
# defaults to the documented dev proxy; without a key the scenario skips. The
# same vars also drive the "generic" registry-vendor scenario.
# E2E_OPENAI_BASE_URL=http://litellm:4000/v1
# E2E_OPENAI_API_KEY=

# MCP servers e2e — URL of an example MCP server the dev memory backend must reach (http/sse) for sync/inspect steps.
E2E_MCP_EXAMPLE_URL=
# Optional: Authorization header name/value sent when registering the example server.
E2E_MCP_EXAMPLE_HEADER_NAME=
E2E_MCP_EXAMPLE_HEADER_VALUE=

# Live Google Drive gate (specs/gdrive-live/gdrive-datasource-live.spec.ts,
# run with `npx playwright test --project=gdrive-live`). Opt-in and never in CI:
# it configures a project-scoped Google OAuth app, connects a REAL Drive folder,
# and requires a human to finish the Google consent screen mid-test.
# E2E_GDRIVE_LIVE=1                              # gate — the spec skips unless set
# E2E_GDRIVE_CLIENT_ID=                          # Google OAuth client id
# E2E_GDRIVE_CLIENT_SECRET=                      # Google OAuth client secret
# E2E_GDRIVE_FIXTURE_REFRESH_TOKEN=              # refresh token for the Drive
#                                                #   fixture (full drive scope —
#                                                #   see scripts/gdrive-fixture-token.mjs)
# E2E_GDRIVE_FOLDER_ID=                          # optional: reuse a pre-made
#                                                #   folder; a scratch folder is
#                                                #   created (and cleaned up) when unset
