package main

import (
	"fmt"
	"net/url"
	"strconv"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Documents ---

// DocumentsPage renders the document browser: a list of ingested documents
// plus an upload form. A failed list fetch renders the whole-page error state;
// a failed upload surfaces as flashErr, a successful one as flashMsg.
templ DocumentsPage(documents []Document, nextCursor string, loadErr error, flashMsg string, flashErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		@documentsHeader(len(documents), loadErr == nil)
		if loadErr != nil {
			@pageError("Failed to load documents", loadErr)
		} else {
			@uploadForm(flashMsg, flashErr)
			if len(documents) == 0 {
				@documentsEmpty()
			} else {
				@documentsList(documents)
			}
		}
	}
}

templ documentsHeader(count int, ok bool) {
	@pageHeader("Knowledge", "Documents", "Source documents ingested into memory — upload new ones, preview chunks, and trigger extraction.") {
		if ok {
			@countBadgeLabel(countLabel(count, "document", "documents"), "lucide--file-text")
		}
	}
}

templ uploadForm(flashMsg string, flashErr error) {
	<div class="mb-6">
		@flashToasts(flashMsg, flashErr)
		@components.PanelCard("", nil) {
			<form method="post" action="/documents" enctype="multipart/form-data" data-document-upload class="flex flex-wrap items-center gap-3">
				<input type="file" name="file" class="file-input file-input-bordered file-input-sm grow"/>
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--upload",
				}) {
					Upload
				}
			</form>
			@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS, Class: "mt-3"}) { Single file up to 10 MB. Text-based files chunk and extract best. }
		}
		<script>
		// Clicking Upload with no file chosen opens the file picker instead of
		// posting an empty multipart form (which the API rejects with a 400).
		// The page shell boosts forms (hx-boost on <main>), so htmx has already
		// claimed the submit by the time a bubbling handler runs: preventDefault
		// alone cannot stop its request. Listen in the capture phase and
		// stopPropagation so the event never reaches htmx's per-form listener,
		// then open the picker. Delegated from document so it survives
		// htmx-boosted navigations; the one-shot guard keeps it from stacking
		// listeners across visits.
		if (!window.__documentsUploadInit) {
			window.__documentsUploadInit = true;
			document.addEventListener('submit', function (event) {
				var form = event.target;
				if (!form || !form.matches('[data-document-upload]')) return;
				var input = form.querySelector('input[type="file"]');
				if (input && input.files && input.files.length === 0) {
					event.preventDefault();
					event.stopPropagation();
					input.click();
				}
			}, true);
		}
		</script>
	</div>
}

templ documentsEmpty() {
	@ui.EmptyState(ui.EmptyStateProps{
		Icon:        "lucide--file-text",
		Title:       "No documents yet",
		Description: "Upload a document and it will be chunked and ready to extract here.",
		Bordered:    true,
		Class:       "py-12",
	})
}

templ documentsList(documents []Document) {
	@cardList("", cardListProps{}) {
		for _, d := range documents {
			@documentRow(d)
		}
	}
}

templ documentRow(d Document) {
	<div class="flex items-center gap-2 px-4 py-3 transition-colors hover:bg-base-200/50">
		<a class="flex min-w-0 grow items-center gap-3" href={ templ.URL("/documents/" + url.PathEscape(d.ID)) }>
			@ui.IconSpan("lucide--file-text", "size-4 shrink-0 text-muted-faint")
			<div class="min-w-0 grow">
				<p class="truncate text-sm font-medium">{ documentName(d) }</p>
				@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS}) { { relTime(d.CreatedAt) } }
			</div>
			@ui.Badge(ui.BadgeProps{
				Label:   strconv.Itoa(d.Chunks) + " chunk" + plural(d.Chunks),
				Variant: ui.BadgeGhost,
				Size:    ui.BadgeSizeXS,
				Icon:    "lucide--braces",
			})
			@documentStatusBadge(d.ExtractionStatus)
			@ui.IconSpan("lucide--chevron-right", "size-4 shrink-0 text-muted-subtle")
		</a>
		@documentDeleteForm(d.ID, documentName(d))
	</div>
}

// documentDeleteForm is the per-row delete affordance on the documents list:
// a small danger ghost submit that hx-confirms before the POST to
// /documents/:id/delete.
templ documentDeleteForm(id, name string) {
	<form method="post" action={ templ.URL("/documents/" + url.PathEscape(id) + "/delete") } hx-confirm="Delete this document? This cannot be undone.">
		@ui.Button(ui.ButtonProps{
			Type:       ui.ButtonTypeSubmit,
			Variant:    ui.ButtonGhost,
			Size:       ui.ButtonSM,
			Shape:      ui.ButtonShapeSquare,
			Icon:       "lucide--trash-2",
			ExtraClass: "text-error hover:text-error",
			AriaLabel:  "Delete " + name,
		})
	</form>
}

templ documentStatusBadge(status string) {
	if status == "" {
		@components.EmptyDash()
	} else {
		@components.StatusBadge(status, documentStatusIntent(status), "", components.StatusBadgeOpts{
			Size: ui.BadgeSizeXS,
			Dot:  true,
		})
	}
}

// --- Document detail ---

// DocumentDetailPage renders a document's Overview sub-page: metadata, an
// extraction trigger, and a preview of the original file. A failed document
// fetch renders the whole-page error state; a failed preview fetch degrades
// only the preview card.
templ DocumentDetailPage(doc *Document, preview documentPreview, loadErr error, flashMsg string, flashErr error, extractionBlocked bool) {
	@layout.Container(layout.ContainerLG, nil) {
		if loadErr != nil {
			@pageError("Document unavailable", loadErr)
		} else {
			@documentDetailHeader(doc, "overview")
			@layout.Rail(documentSubNav(doc.ID, "overview"), nil) {
				@extractionCard(doc, flashMsg, flashErr, extractionBlocked)
				@documentPreviewCard(doc, preview)
			}
		}
	}
}

// documentSubNav is the vertical sub-navigation rail shared by the document
// Overview, Chunks, and Extraction history views, mirroring agentSubNav.
templ documentSubNav(documentID, active string) {
	{{ base := "/documents/" + url.PathEscape(documentID) }}
	@components.SettingsRail("Document sections", active, []components.RailItem{
		{Key: "overview", Href: base, Icon: "lucide--file-text", Label: "Overview"},
		{Key: "chunks", Href: base + "/chunks", Icon: "lucide--braces", Label: "Chunks"},
		{Key: "extractions", Href: base + "/extractions", Icon: "lucide--history", Label: "Extraction history"},
		{Key: "versions", Href: base + "/versions", Icon: "lucide--layers", Label: "Versions"},
	})
}

// documentPreviewCard previews a document's original content by media type:
// PDFs and images inline through the gateway file proxy, text/markdown as a
// capped escaped text preview, anything else as a download link.
templ documentPreviewCard(doc *Document, preview documentPreview) {
	<div class="mt-6">
		@components.PanelCard("", nil) {
			<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
				<div class="flex items-center gap-3">
					@ui.IconTile("lucide--eye", ui.IconTileProps{Tone: "info"})
					<div>
						<h2 class="text-base font-semibold">Preview</h2>
						@ui.EmptyNote() { The original file as stored in memory. }
					</div>
				</div>
				@ui.Button(ui.ButtonProps{
					Type:       ui.ButtonTypeLink,
					Href:       documentFilePath(doc.ID),
					Variant:    ui.ButtonGhost,
					Size:       ui.ButtonSM,
					ExtraClass: "gap-1",
					Attrs:      templ.Attributes{"data-testid": "document-download-link"},
				}) {
					@ui.IconSpan("lucide--download", "size-4")
					Download
				}
			</div>
			switch preview.Mode {
				case previewModePDF:
					<embed
						data-testid="document-preview-pdf"
						src={ templ.URL(documentFilePath(doc.ID)) }
						type="application/pdf"
						class="h-[36rem] w-full rounded-box border border-base-content/10"
					/>
				case previewModeImage:
					<img
						data-testid="document-preview-image"
						src={ templ.URL(documentFilePath(doc.ID)) }
						alt={ documentName(*doc) }
						class="mx-auto max-h-[36rem] rounded-box border border-base-content/10"
					/>
				case previewModeText:
					if preview.Err != nil {
						@documentPreviewUnavailable(doc)
					} else {
						<pre data-testid="document-preview-text" class="max-h-[36rem] overflow-auto rounded-box bg-base-200/50 p-4 text-xs whitespace-pre-wrap">{ preview.Text }</pre>
						if preview.Truncated {
							@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS, Class: "mt-2", Attrs: templ.Attributes{"data-testid": "document-preview-truncated"}}) {
								Preview truncated to { strconv.Itoa(maxTextPreviewChars) } characters — open the Chunks view for the full text.
							}
						}
					}
				default:
					@documentPreviewDownload(doc)
			}
		}
	</div>
}

// documentPreviewUnavailable degrades a failed server-side text fetch to a note
// with a link into the Chunks view, never a broken section.
templ documentPreviewUnavailable(doc *Document) {
	<div class="rounded-box border border-base-content/10 p-4" data-testid="document-preview-unavailable">
		<p class="text-sm text-muted-bright">The original file could not be loaded for preview.</p>
		<a class="link link-primary text-sm" href={ templ.URL("/documents/" + url.PathEscape(doc.ID) + "/chunks") }>Open the Chunks view</a>
	</div>
}

// documentPreviewDownload is the fallback preview for media types the gateway
// cannot render inline: a download link to the original file.
templ documentPreviewDownload(doc *Document) {
	<div class="rounded-box border border-base-content/10 p-4" data-testid="document-preview-download">
		<p class="text-sm text-muted-bright">This file type cannot be previewed inline.</p>
		@ui.Button(ui.ButtonProps{
			Type:       ui.ButtonTypeLink,
			Href:       documentFilePath(doc.ID),
			Variant:    ui.ButtonOutline,
			Size:       ui.ButtonSM,
			ExtraClass: "gap-1 mt-2",
		}) {
			@ui.IconSpan("lucide--download", "size-4")
			Download file
		}
	</div>
}

// documentSectionCrumbs builds the breadcrumb trail for a document view: the
// documents list, the document itself, and — for a sub-page — the section. The
// overview stops at the document. The document crumb always links to the
// overview so a sub-page can walk back up the trail.
func documentSectionCrumbs(doc *Document, section string) []nav.BreadcrumbItem {
	base := "/documents/" + url.PathEscape(doc.ID)
	switch section {
	case "chunks":
		return nav.Crumbs("Documents", "/documents", documentName(*doc), base, "Chunks")
	case "extractions":
		return nav.Crumbs("Documents", "/documents", documentName(*doc), base, "Extraction history")
	case "versions":
		return nav.Crumbs("Documents", "/documents", documentName(*doc), base, "Versions")
	default:
		return nav.Crumbs("Documents", "/documents", documentName(*doc))
	}
}

// documentDetailHeader renders the shared header for every document view. The
// section names the active sub-page ("chunks", "extractions", "versions"); any
// other value renders the overview trail. A single extraction run is a child of
// Extraction history: its own identity (short id, status) lives in the run
// header below, so the trail stops at the section.
templ documentDetailHeader(doc *Document, section string) {
	@detailHeader(crumbsActive(documentSectionCrumbs(doc, section)), "", documentName(*doc), "", detailHeaderOpts{Margin: "mb-6"}) {
		<div class="flex flex-wrap items-center gap-2">
			@countBadgeLabel(strconv.Itoa(doc.Chunks)+" chunk"+plural(doc.Chunks), "lucide--braces")
			@documentStatusBadge(doc.ExtractionStatus)
			<form method="post" action={ templ.URL("/documents/" + url.PathEscape(doc.ID) + "/delete") } hx-confirm="Delete this document? This cannot be undone.">
				@ui.Button(ui.ButtonProps{
					Type:      ui.ButtonTypeSubmit,
					Variant:   ui.ButtonError,
					Style:     ui.ButtonStyleOutline,
					Size:      ui.ButtonSM,
					Icon:      "lucide--trash-2",
					AriaLabel: "Delete " + documentName(*doc),
				}) {
					Delete
				}
			</form>
		</div>
	}
}

templ extractionCard(doc *Document, flashMsg string, flashErr error, blocked bool) {
	{{ extractAttrs := templ.Attributes{} }}
	{{ if blocked { extractAttrs = templ.Attributes{"disabled": true, "title": "Configure a provider and set a default generative model to run extraction."} } }}
	@components.PanelCard("", nil) {
		<div class="flex flex-wrap items-center justify-between gap-3">
		<div class="flex items-center gap-3">
			@ui.IconTile("lucide--sparkles", ui.IconTileProps{Tone: "accent"})
			<div>
				<h2 class="text-base font-semibold">Extraction</h2>
					@ui.EmptyNote() {
						if blocked {
							Extraction needs a generative model.
						} else if doc.ObjectsCreated > 0 {
							{ strconv.Itoa(doc.ObjectsCreated) } objects extracted
						} else {
							Run extraction to pull structured entities out of this document.
						}
					}
				</div>
			</div>
			<form method="post" action={ templ.URL("/documents/" + url.PathEscape(doc.ID) + "/extract") }>
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonAccent,
					Size:    ui.ButtonSM,
					Icon:    "lucide--sparkles",
					Attrs:   extractAttrs,
				}) {
					Extract data
				}
			</form>
		</div>
		if blocked {
			<div class="mt-3">
				@ui.Alert(ui.AlertProps{
					Type:    ui.AlertWarning,
					Style:   ui.AlertStyleSoft,
					Icon:    "lucide--alert-triangle",
					Message: "No generative model is configured. Add a provider and set a default model before running extraction.",
				})
				<a href="/settings/providers" class="link link-primary text-sm">Configure a model</a>
			</div>
		}
		@flashToasts(flashMsg, flashErr)
	}
}

// --- document sub-pages ---

// DocumentChunksPage renders the document Chunks sub-page: the shared detail
// header, the sub-navigation rail, and the document's chunks.
templ DocumentChunksPage(doc *Document, chunks []Chunk, loadErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		if loadErr != nil {
			@pageError("Document unavailable", loadErr)
		} else {
			@documentDetailHeader(doc, "chunks")
			@layout.Rail(documentSubNav(doc.ID, "chunks"), nil) {
				@chunksSection(chunks)
				@chunkRollbackDialog()
			}
		}
	}
}

// DocumentExtractionsPage renders the Extraction history sub-page: every
// extraction job for the document, newest first. A failed job-list fetch
// degrades the whole page to the error state. warnMsg surfaces a partial-merge
// warning (e.g. "M left for review"); hint carries the merged job's leftover
// count so its action row can render the review badge.
templ DocumentExtractionsPage(doc *Document, jobs []ExtractionJob, loadErr error, flashMsg string, warnMsg string, flashErr error, hint *mergeReviewHint) {
	@layout.Container(layout.ContainerLG, nil) {
		if loadErr != nil {
			@pageError("Failed to load extraction history", loadErr)
		} else {
			@documentDetailHeader(doc, "extractions")
			@layout.Rail(documentSubNav(doc.ID, "extractions"), nil) {
				@flashToastsWarn(flashMsg, warnMsg, flashErr)
				@extractionHistory(doc.ID, jobs, hint)
			}
		}
	}
}

// DocumentExtractionPage renders the dedicated extraction-run sub-page: the
// shared detail header, the sub-navigation rail, and — in order — the run
// header, summary strip, trace waterfall, error details, and the objects/
// relationships/branch/merge block. A failed document or job fetch degrades
// the whole page to the error state.
templ DocumentExtractionPage(doc *Document, d extractionJobDetail, loadErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		if loadErr != nil {
			@pageError("Extraction run unavailable", loadErr)
		} else {
			@documentDetailHeader(doc, "extractions")
			@layout.Rail(documentSubNav(doc.ID, "extractions"), nil) {
				@extractionRunHeader(doc, d)
				@components.PanelCard("", nil) {
					@extractionRunBody(doc.ID, d.Job.ID, d, extractionJobActive(d.Job.Status), false)
				}
				@extractionErrorBlock(d)
				@components.PanelCard("", nil) {
					@ExtractionJobDetail(doc.ID, d)
				}
			}
		}
	}
}

// extractionRunHeader renders the sub-page's run identity block: a back link to
// the extraction history, the run's creation time + short id, its status badge,
// and a "Live" indicator while the job is still running.
templ extractionRunHeader(doc *Document, d extractionJobDetail) {
	{{ job := d.Job }}
	<div class="mb-4 flex flex-wrap items-center gap-3" data-testid="extraction-run-header">
		@ui.Button(ui.ButtonProps{
			Type:    ui.ButtonTypeLink,
			Href:    documentExtractionsPath(doc.ID),
			Variant: ui.ButtonGhost,
			Size:    ui.ButtonSM,
			Icon:    "lucide--arrow-left",
		}) {
			All extractions
		}
		<div class="min-w-0 grow">
			<p class="text-sm font-medium">{ relTime(job.CreatedAt) }</p>
			<p class="text-muted-faint font-mono text-xs">{ shortID(job.ID) }</p>
		</div>
		@extractionRunStatus(d, false)
	</div>
}

// extractionRunStatus renders the run's status badge and — while the job is
// still running — its "Live" indicator. The group carries a stable id so the
// polling fragment can refresh it out-of-band (`oob` adds hx-swap-oob), letting
// the terminal status land without a full page reload.
templ extractionRunStatus(d extractionJobDetail, oob bool) {
	{{ job := d.Job
	attrs := templ.Attributes{"id": "extraction-run-status", "data-testid": "extraction-run-status", "class": "flex items-center gap-2"}
	if oob {
		attrs["hx-swap-oob"] = "true"
	} }}
	<div { attrs... }>
		@documentStatusBadge(job.Status)
		if extractionJobActive(job.Status) {
			@ui.Badge(ui.BadgeProps{Label: "Live", Variant: ui.BadgeInfo, Size: ui.BadgeSizeXS, Icon: "lucide--radio", Animate: true, Attrs: templ.Attributes{"data-testid": "extraction-live"}})
		}
	</div>
}

// extractionSummaryStrip renders the run's at-a-glance summary as a wrapping
// row of ghost badges: start/finish times, duration, progress counters
// (processed/total and failed), objects and relationships, model, token
// counts, estimated cost, and retry count. Every element hides when its data is
// absent.
templ extractionSummaryStrip(d extractionJobDetail) {
	{{ job := d.Job
	model, inTok, outTok := extractionTraceMeta(job.Spans) }}
	<div class="flex flex-wrap items-center gap-2" data-testid="extraction-summary-strip">
		<h3 class="sr-only">Run summary</h3>
		@ui.Badge(ui.BadgeProps{Label: "started " + relTime(job.StartedAt), Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS, Icon: "lucide--clock"})
		if job.CompletedAt != "" {
			@ui.Badge(ui.BadgeProps{Label: "finished " + relTime(job.CompletedAt), Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS, Icon: "lucide--flag"})
			@ui.Badge(ui.BadgeProps{Label: formatRunDuration(extractionDurationSeconds(job.StartedAt, job.CompletedAt)), Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS, Icon: "lucide--timer"})
		}
		if job.TotalItems > 0 {
			@ui.Badge(ui.BadgeProps{Label: fmt.Sprintf("%d/%d processed", job.ProcessedItems, job.TotalItems), Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS, Icon: "lucide--loader"})
		}
		if job.FailedItems > 0 {
			@ui.Badge(ui.BadgeProps{Label: strconv.Itoa(job.FailedItems) + " failed", Variant: ui.BadgeError, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: "lucide--triangle-alert"})
		}
		@ui.Badge(ui.BadgeProps{Label: strconv.Itoa(len(d.Objects)) + " object" + plural(len(d.Objects)), Variant: ui.BadgeInfo, Size: ui.BadgeSizeXS, Icon: "lucide--box"})
		@ui.Badge(ui.BadgeProps{Label: strconv.Itoa(len(d.Relationships)) + " relationship" + plural(len(d.Relationships)), Variant: ui.BadgeAccent, Size: ui.BadgeSizeXS, Icon: "lucide--link"})
		if model != "" {
			@ui.Badge(ui.BadgeProps{Label: model, Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS, Icon: "lucide--cpu"})
		}
		if inTok+outTok > 0 {
			@ui.Badge(ui.BadgeProps{Label: fmt.Sprintf("%d in · %d out", inTok, outTok), Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS, Icon: "lucide--gauge"})
		}
		if job.TraceCostUSD != nil {
			@ui.Badge(ui.BadgeProps{Label: "$" + formatTraceCostUSD(*job.TraceCostUSD), Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS, Icon: "lucide--circle-dollar-sign"})
		}
		if job.RetryCount > 0 {
			@ui.Badge(ui.BadgeProps{Label: countLabel(job.RetryCount, "retry", "retries"), Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS, Icon: "lucide--rotate-cw"})
		}
	</div>
}

// extractionRunBody is the polling root of the extraction-run sub-page: it
// bundles the summary strip and the trace panel so a running job's final
// duration, tokens, estimated cost, and object counts all land when the run
// finishes — the strip lives inside the swapped element, not beside it. While
// `poll` is true the root carries the HTMX interval; once the job is terminal
// the root renders with no hx attributes so the interval self-terminates (see
// projectsPendingRefreshNote in org_context.templ). `oobStatus` additionally
// renders the header status group with hx-swap-oob so the badge and its "Live"
// indicator update in the same swap.
templ extractionRunBody(documentID, jobID string, d extractionJobDetail, poll, oobStatus bool) {
	{{ attrs := templ.Attributes{"id": "extraction-run-body", "data-testid": "extraction-run-body"}
	if poll {
		attrs["hx-get"] = "/documents/" + url.PathEscape(documentID) + "/extractions/" + url.PathEscape(jobID) + "/trace"
		attrs["hx-trigger"] = "every 3s"
		attrs["hx-swap"] = "outerHTML"
		// The page shell's <main> carries hx-target="#main-content" and htmx's
		// implicit attribute inheritance would otherwise apply it here, so the
		// swap target is pinned to this element.
		attrs["hx-target"] = "this"
	} }}
	<div { attrs... }>
		@extractionSummaryStrip(d)
		@extractionTracePanel(d)
	</div>
	if oobStatus {
		@extractionRunStatus(d, true)
	}
}

// extractionTracePanel renders the run's OpenTelemetry trace: the span
// waterfall when spans exist, a "waiting for the first spans" note while the
// run is still active with no spans yet, and a "no trace recorded" note for
// terminal runs with no trace. The polling attributes live on the enclosing
// extractionRunBody root, not here.
templ extractionTracePanel(d extractionJobDetail) {
	{{ job := d.Job
	running := extractionJobActive(job.Status) }}
	<div id="extraction-trace" data-testid="extraction-trace">
		<h3 class="sr-only">Trace</h3>
		if len(job.Spans) > 0 {
			@TraceWaterfall(job.Spans)
		} else if running {
			@ui.SoftBox(ui.SoftBoxProps{Class: "mt-3 flex items-center gap-2"}) {
				<span class="htmx-indicator loading loading-spinner loading-xs" aria-hidden="true"></span>
				@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS}) { Waiting for the first spans… }
			}
		} else {
			@ui.SoftBox(ui.SoftBoxProps{Class: "mt-3"}) {
				@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS}) { No trace recorded for this run. }
				@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS, Class: "mt-1"}) { Tracing is recorded only when the server has OTEL enabled. }
			}
		}
	</div>
}

// extractionErrorBlock renders the run's failure: the error alert plus, when
// the server recorded structured error details, a collapsible pretty-JSON dump.
// Rendered only when the job carries an error message.
templ extractionErrorBlock(d extractionJobDetail) {
	{{ job := d.Job }}
	if job.ErrorMessage != nil && *job.ErrorMessage != "" {
		<div class="mb-4" data-testid="extraction-error-block">
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertError,
				Style:   ui.AlertStyleOutline,
				Icon:    "lucide--circle-x",
				Message: *job.ErrorMessage,
			})
			if len(job.ErrorDetails) > 0 {
				<details class="mt-2 rounded-box border border-base-content/10">
					<summary class="flex cursor-pointer items-center gap-2 list-none select-none px-3 py-2 [&::-webkit-details-marker]:hidden">
						<span class="iconify lucide--braces size-3.5 shrink-0 text-muted-faint" aria-hidden="true"></span>
						<span class="text-xs font-medium">Error details</span>
					</summary>
					<div class="border-t border-base-content/10 p-3">
						<pre class="overflow-x-auto text-xs whitespace-pre-wrap">{ prettyJSON(job.ErrorDetails) }</pre>
					</div>
				</details>
			}
		</div>
	}
}

// extractionHistory lists a document's extraction jobs newest-first. Each row
// carries the run's summary and lazily loads its detail (objects,
// relationships, branch, and merge action) over HTMX, avoiding N+1 requests on
// page load. hint threads the partial-merge leftover count into the merged
// job's lazy-detail URL.
templ extractionHistory(documentID string, jobs []ExtractionJob, hint *mergeReviewHint) {
	if len(jobs) == 0 {
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--history",
			Title:       "No extractions yet",
			Description: "Run extraction on this document to build its extraction history.",
			Bordered:    true,
			Class:       "py-12",
		})
	} else {
		<div class="flex flex-col gap-3" data-testid="extraction-history">
			for _, job := range jobs {
				@extractionJobRow(documentID, job, hint)
			}
		</div>
	}
}

templ extractionJobRow(documentID string, job ExtractionJob, hint *mergeReviewHint) {
	{{ detailHref := "/documents/" + url.PathEscape(documentID) + "/extractions/" + url.PathEscape(job.ID) + "/detail" }}
	{{ traceHref := "/documents/" + url.PathEscape(documentID) + "/extractions/" + url.PathEscape(job.ID) }}
	{{ if hint != nil && hint.JobID == job.ID && hint.Left > 0 { detailHref = detailHref + "?review=" + strconv.Itoa(hint.Left) } }}
	<div class="border border-line overflow-hidden" data-testid="extraction-job-row">
		<div class="flex flex-wrap items-center gap-2 px-4 py-3">
			@ui.IconTile("lucide--sparkles", ui.IconTileProps{Tone: "accent"})
			<div class="min-w-0 grow">
				<p class="text-sm font-medium">{ relTime(job.CreatedAt) }</p>
				<p class="text-muted-faint font-mono text-xs">{ shortID(job.ID) }</p>
			</div>
			@documentStatusBadge(job.Status)
			@ui.Badge(ui.BadgeProps{
				Label:   strconv.Itoa(job.ObjectCount()) + " object" + plural(job.ObjectCount()),
				Variant: ui.BadgeInfo,
				Size:    ui.BadgeSizeXS,
				Icon:    "lucide--box",
			})
			for _, t := range job.DiscoveredTypes {
				@ui.Badge(ui.BadgeProps{
					Label:   t,
					Variant: ui.BadgeNeutral,
					Style:   ui.BadgeStyleSoft,
					Size:    ui.BadgeSizeXS,
				})
			}
			<a class="link link-primary text-xs" href={ templ.URL(traceHref) } data-testid="extraction-view-trace">View trace →</a>
		</div>
		if job.ErrorMessage != nil && *job.ErrorMessage != "" {
			<div class="px-4 pb-3">
				@ui.Alert(ui.AlertProps{
					Type:    ui.AlertError,
					Style:   ui.AlertStyleOutline,
					Icon:    "lucide--alert-triangle",
					Message: *job.ErrorMessage,
				})
			</div>
		}
		<div
			id={ "extraction-detail-" + job.ID }
			data-testid="extraction-detail-target"
			hx-get={ templ.URL(detailHref) }
			hx-trigger="load"
			hx-target="this"
			hx-swap="outerHTML"
		>
			<div class="flex items-center gap-2 border-t border-base-content/10 px-4 py-3">
				<span class="htmx-indicator loading loading-spinner loading-xs" aria-hidden="true"></span>
				<span class="text-muted text-xs">Loading extraction detail…</span>
			</div>
		</div>
	</div>
}

// ExtractionJobDetail is the HTMX partial for one extraction job. It resolves
// the job's staging branch and shows the objects and relationships that run
// produced, the branch name and merge readiness, and — only for an unmerged
// branch — the merge action. Every failure degrades to a section-level
// message, never a broken page.
templ ExtractionJobDetail(documentID string, d extractionJobDetail) {
	<div id={ "extraction-detail-" + d.Job.ID } data-testid="extraction-job-detail" class="border-t border-base-content/10 px-4 py-3">
		if d.Err != nil {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertError,
				Style:   ui.AlertStyleOutline,
				Icon:    "lucide--alert-triangle",
				Message: "Failed to load this extraction's detail.",
			})
		} else {
			<div class="mb-3 flex flex-wrap items-center gap-2">
				@ui.Badge(ui.BadgeProps{
					Label:   strconv.Itoa(len(d.Objects)) + " object" + plural(len(d.Objects)),
					Variant: ui.BadgeInfo,
					Size:    ui.BadgeSizeXS,
					Icon:    "lucide--box",
				})
				@ui.Badge(ui.BadgeProps{
					Label:   strconv.Itoa(len(d.Relationships)) + " relationship" + plural(len(d.Relationships)),
					Variant: ui.BadgeAccent,
					Size:    ui.BadgeSizeXS,
					Icon:    "lucide--link",
				})
				if d.Branch != nil {
					@ui.Badge(ui.BadgeProps{
						Label:   d.Branch.Name,
						Variant: ui.BadgeGhost,
						Size:    ui.BadgeSizeXS,
						Icon:    "lucide--git-branch",
					})
					@extractionReadiness(d.Readiness)
				}
				if d.BranchID != "" {
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeLink,
						Href:    "/objects?branch=" + url.QueryEscape(d.BranchID),
						Variant: ui.ButtonGhost,
						Size:    ui.ButtonSM,
						Icon:    "lucide--external-link",
						Attrs:   templ.Attributes{"data-testid": "extraction-open-browser"},
					}) {
						Open in object browser
					}
				}
			</div>
			if d.NoBranch {
				if len(d.Objects) == 0 {
					@ui.EmptyNote(ui.EmptyNoteProps{Attrs: templ.Attributes{"data-testid": "extraction-detail-nobranch"}}) { This run has no staging branch — it produced no objects, or they are no longer available. }
				} else {
					@ui.EmptyNote(ui.EmptyNoteProps{Attrs: templ.Attributes{"data-testid": "extraction-detail-nobranch"}}) { This run's staging branch is no longer available — showing the objects on the main graph. }
					@extractedObjects(documentID, d.Job.ID, d.Objects)
					@extractedRelationships(d.Objects, d.Relationships)
				}
			} else {
				@extractedObjects(documentID, d.Job.ID, d.Objects)
				@extractedRelationships(d.Objects, d.Relationships)
			}
			if d.Branch != nil {
				if d.Branch.MergedAt == "" {
					@extractionMergeAction(documentID, d.Job.ID, d.LeftForReview)
				} else {
					@components.StatusBadge("Merged into main", ui.BadgeSuccess, "lucide--check", components.StatusBadgeOpts{Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS})
				}
			}
		}
	</div>
}

templ extractionReadiness(r *MergeReadiness) {
	if r != nil {
		if r.Ready {
			@ui.Badge(ui.BadgeProps{
				Label:   "Ready to merge",
				Variant: ui.BadgeSuccess,
				Style:   ui.BadgeStyleSoft,
				Size:    ui.BadgeSizeXS,
				Icon:    "lucide--check",
			})
		} else {
			@ui.Badge(ui.BadgeProps{
				Label:   strconv.Itoa(r.PendingEmbeddings) + " embedding" + plural(r.PendingEmbeddings) + " pending",
				Variant: ui.BadgeWarning,
				Style:   ui.BadgeStyleSoft,
				Size:    ui.BadgeSizeXS,
				Icon:    "lucide--loader",
			})
		}
	}
}

// extractionMergeAction offers merging the job's staging branch into main. The
// merge opens a preview modal (fetched lazily) so the user sees the predicted
// split before confirming. It is rendered only when the branch exists and is
// not already merged (hide, don't disable). leftForReview is the count of
// objects a prior partial merge left on the branch; when non-zero it renders a
// "N left for review" badge.
templ extractionMergeAction(documentID, jobID string, leftForReview int) {
	<div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-box bg-base-200/50 p-3" data-testid="extraction-merge">
		<div class="flex flex-wrap items-center gap-2">
			@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS}) { Merge applies clean additions and fast-forwards into the main graph; conflicts and similar objects stay on this branch for review. }
			if leftForReview > 0 {
				@ui.Badge(ui.BadgeProps{
					Label:   strconv.Itoa(leftForReview) + " left for review",
					Variant: ui.BadgeWarning,
					Size:    ui.BadgeSizeXS,
					Icon:    "lucide--git-branch",
					Attrs:   templ.Attributes{"data-testid": "extraction-merge-left"},
				})
			}
		</div>
		@ui.Button(ui.ButtonProps{
			Type:    ui.ButtonTypeButton,
			Variant: ui.ButtonPrimary,
			Size:    ui.ButtonSM,
			Icon:    "lucide--git-merge",
			Attrs: templ.Attributes{
				"data-testid": "extraction-merge-button",
				"hx-get":      "/documents/" + url.PathEscape(documentID) + "/extractions/" + url.PathEscape(jobID) + "/merge-preview",
				"hx-target":   "#merge-preview-target-" + jobID,
				"hx-swap":     "innerHTML",
			},
		}) {
			Merge into main
		}
	</div>
	<div id={ "merge-preview-target-" + jobID }></div>
}

// mergePreviewModal is the confirm-before-merge dialog. actionURL is the POST
// target for the confirm button (the document merge route or the inbox merge
// route). preview is the server's predicted split; previewErr renders the modal
// in its error state. The dialog auto-opens once the HTMX swap inserts it.
templ mergePreviewModal(actionURL string, preview *BranchMergeResult, previewErr error) {
	@ui.Dialog(ui.DialogProps{ID: "merge-preview-modal", BoxClass: "max-w-md", Attrs: templ.Attributes{"data-dialog-autoopen": "true", "data-testid": "merge-preview-modal"}}) {
		@ui.DialogTitle() { Review merge }
		@ui.EmptyNote(ui.EmptyNoteProps{Class: "mb-4"}) {
			Clean additions and fast-forwards merge into the main graph. Anything left over stays on this branch for review.
		}
		if previewErr != nil {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertError,
				Style:   ui.AlertStyleOutline,
				Icon:    "lucide--alert-triangle",
				Message: previewErr.Error(),
			})
		} else {
			@mergePreviewSummary(preview)
		}
		<form method="post" action={ templ.URL(actionURL) }>
			<div class="mt-4 flex justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Attrs:   templ.Attributes{"formmethod": "dialog"},
				}) {
					Cancel
				}
				if previewErr != nil {
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonGhost,
						Size:    ui.ButtonSM,
						Attrs:   templ.Attributes{"formmethod": "dialog"},
					}) {
						Close
					}
				} else {
					{{ confirmAttrs := templ.Attributes{"data-testid": "merge-preview-confirm"} }}
					{{ if mergePreviewDisabled(preview) { confirmAttrs["disabled"] = true } }}
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonPrimary,
						Size:    ui.ButtonSM,
						Icon:    "lucide--git-merge",
						Attrs:   confirmAttrs,
					}) {
						{ mergePreviewConfirmLabel(preview) }
					}
				}
			</div>
		</form>
	}
}

// mergePreviewSummary renders the predicted merge split as a short list of
// labeled counts: new objects, existing objects updated (fast-forwards — the
// only existing objects "partial" writes), conflicts, left for review, and the
// branch total. Similarity matches belong to "left for review" only: "partial"
// suggests them for review instead of applying them. Conflicts and
// left-for-review rows carry warning styling when non-zero.
templ mergePreviewSummary(preview *BranchMergeResult) {
	@mergePreviewRow("lucide--plus", "New objects", strconv.Itoa(mergePreviewAdded(preview)), false)
	@mergePreviewRow("lucide--refresh-cw", "Existing objects updated", strconv.Itoa(mergePreviewUpdated(preview)), false)
	@mergePreviewRow("lucide--triangle-alert", "Conflicts", strconv.Itoa(mergePreviewConflicts(preview)), mergePreviewConflicts(preview) > 0)
	@mergePreviewRow("lucide--git-branch", "Left for review", strconv.Itoa(mergePreviewLeft(preview)), mergePreviewLeft(preview) > 0)
	@mergePreviewRow("lucide--box", "Total", mergePreviewTotal(preview), false)
}

templ mergePreviewRow(icon, label, value string, warn bool) {
	<div class="flex items-center gap-2 py-1">
		@ui.IconSpan(icon, "size-4 shrink-0 text-muted-subtle")
		<span class={ "grow text-sm", templ.KV("text-muted", !warn), templ.KV("text-warning font-medium", warn) }>{ label }</span>
		<span class={ "text-sm tabular-nums", templ.KV("font-medium", warn) }>{ value }</span>
	</div>
}

// --- extraction results ---

// extractedObjectOrigin is the ?from= breadcrumb trail an extracted object links
// back through: the document and the run it came from. The object detail view
// resolves it into Documents > Document > Extraction history; the run's short id
// is already shown in the object's Source card, so it is not a crumb. It is
// built from the page's own identifiers, so the object view can present that
// document trail instead of a bare Objects trail.
func extractedObjectOrigin(documentID, jobID string) string {
	return "/documents/" + url.PathEscape(documentID) + "/extractions/" + url.PathEscape(jobID)
}

templ extractedObjects(documentID, jobID string, objects []GraphObject) {
	if len(objects) == 0 {
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--boxes",
			Title:       "No objects extracted",
			Description: "Extraction has not produced any entities yet.",
			Bordered:    true,
		})
	} else {
		{{ origin := extractedObjectOrigin(documentID, jobID) }}
		@cardList("", cardListProps{}) {
			for _, o := range objects {
				@extractedObjectRow(o, origin)
			}
		}
	}
}

templ extractedObjectRow(o GraphObject, origin string) {
	<a
		class="flex items-center gap-2 px-4 py-3 transition-colors hover:bg-base-200/50"
		href={ templ.URL("/objects/" + url.PathEscape(o.ID) + "?from=" + url.QueryEscape(origin)) }
	>
		@ui.Badge(ui.BadgeProps{
			Label:   o.Type,
			Variant: ui.BadgePrimary,
			Size:    ui.BadgeSizeXS,
			Icon:    "lucide--box",
		})
		<span class="truncate text-sm font-medium">{ graphObjectLabel(o) }</span>
		@monoMeta(shortID(o.ID), "text-muted-faint")
		@ui.IconSpan("lucide--chevron-right", "size-4 ml-auto shrink-0 text-muted-subtle")
	</a>
}

templ extractedRelationships(objects []GraphObject, relationships []GraphRelationship) {
	if len(relationships) > 0 {
		<div class="mt-4">
			@cardList("", cardListProps{}) {
				for _, r := range relationships {
					@extractedRelationshipRow(objects, r)
				}
			}
		</div>
	}
}

templ extractedRelationshipRow(objects []GraphObject, r GraphRelationship) {
	<div class="flex flex-wrap items-center gap-2 px-4 py-3">
		@ui.Badge(ui.BadgeProps{
			Label:   relationshipTypeLabel(r.Type),
			Variant: ui.BadgeSecondary,
			Size:    ui.BadgeSizeXS,
			Icon:    "lucide--link",
		})
		<span class="truncate text-sm">{ graphObjectLabelByID(objects, r.SrcID) }</span>
		@ui.IconSpan("lucide--arrow-right", "size-4 shrink-0 text-muted-subtle")
		<span class="truncate text-sm">{ graphObjectLabelByID(objects, r.DstID) }</span>
	</div>
}
