package main

import (
	"slices"
	"strconv"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/form"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// shareManageScriptOnce keeps the copy-button wiring to a single <script> per
// page, even when several panels render.
var shareManageScriptOnce = templ.NewOnceHandle()

// --- Owner share-link management --------------------------------------------
//
// The owner-facing surface is split into two pages, mirroring MCP Sharing:
//
//   - the list page (GET /agents/:id/share) shows the public-URL banner, every
//     link's card, and a "New share link" call to action;
//   - the create page (GET /agents/:id/share/new) holds the full form with its
//     own back-link.
//
// Create and rotate render the list page directly (no redirect) with a
// one-time reveal: the raw key exists only in that response and must never
// round-trip through a URL. The components below do no I/O of their own — every
// action is a real form POST, so the surface works without JavaScript; the
// script on this file only adds the copy-link affordance.

// ShareLinkStatus is a share link's lifecycle status.
type ShareLinkStatus string

const (
	ShareLinkActive  ShareLinkStatus = "active"
	ShareLinkExpired ShareLinkStatus = "expired"
	ShareLinkRevoked ShareLinkStatus = "revoked"
)

// ShareLinkRow is one existing share link.
type ShareLinkRow struct {
	ID    string
	Label string
	// URL is the full public link, including its key fragment. It is empty at
	// list time (the key is not stored); it is populated only for the link that
	// was just created/rotated in this response.
	URL string
	// Status drives the row's badge and which actions are available.
	Status ShareLinkStatus

	CreatedAt        string
	CreatedRelative  string
	LastUsedAt       string
	LastUsedRelative string
	// ExpiresAt is empty when the link never expires.
	ExpiresAt       string
	ExpiresRelative string
	ExpiresNever    bool

	// Access and limits summary.
	RequireEmail       bool
	ShowSessionList    bool
	Sandbox            bool
	MaxSessionsPerUser int
	BudgetMessages     int
	BudgetTokens       int

	// RotateURL / RevokeURL are the POST endpoints for this link's actions.
	// RotateURL empty hides the rotate action; RevokeURL empty hides revoke.
	RotateURL string
	RevokeURL string
	// RevealURL is the on-demand key-recovery endpoint. When URL is empty (the
	// key is not present at list time), the copy action fetches RevealURL to
	// recover it instead of copying a blank value.
	RevealURL string
}

// ShareToolOption is one tool the owner can allow on a link.
type ShareToolOption struct {
	ID          string
	Label       string
	Description string
	Selected    bool
	// Dangerous marks tools that can change data or reach the outside world.
	Dangerous bool
}

// ShareLinkCreateValues carries the create form's values, so a failed submit
// can re-render with the owner's input preserved. Numeric fields are strings to
// survive validation errors without a separate parse state.
type ShareLinkCreateValues struct {
	Label              string
	WelcomeMessage     string
	ExpiryDays         int
	NeverExpires       bool
	ToolIDs            []string
	RequireEmail       bool
	ShowSessionList    bool
	Sandbox            bool
	MaxSessionsPerUser string
	BudgetMessages     string
	BudgetTokens       string
}

// ShareLinksPageProps configures the list page body.
type ShareLinksPageProps struct {
	// NewLinkURL is the create page's address for the header call to action.
	NewLinkURL string
	// Links are the agent's existing share links, newest first.
	Links []ShareLinkRow
	// Error is a page-level error shown above the list.
	Error string
}

// ShareLinkCreatePageProps configures the create page body.
type ShareLinkCreatePageProps struct {
	// CreateAction is where the create form POSTs.
	CreateAction string
	// CancelURL returns to the list page.
	CancelURL string
	// Tools is the tool allowlist picker's options.
	Tools []ShareToolOption
	// Values preserves the create form across a failed submit.
	Values ShareLinkCreateValues
	// Error is a form-level error shown above the form.
	Error string
}

// ShareLinkReveal carries the one-time full URL rendered after a create or
// rotate. It exists only in that one response — the raw key is never persisted
// and never round-trips through a URL.
type ShareLinkReveal struct {
	// LinkID ties the reveal to the row that should show its URL.
	LinkID  string
	Heading string
	Label   string
	URL     string
}

// --- list page body ----------------------------------------------------------

// ShareLinksListPanel renders the list page body: the section header with its
// "New share link" call to action, and the links (or empty state).
templ ShareLinksListPanel(props ShareLinksPageProps) {
	<section class="space-y-6" data-testid="share-links-panel" aria-labelledby="share-links-heading">
		@ShareLinksHeader(props)
		if props.Error != "" {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertError,
				Style:   ui.AlertStyleSoft,
				Icon:    "lucide--alert-circle",
				Message: props.Error,
				Attrs:   templ.Attributes{"data-testid": "share-links-error"},
			})
		}
		@ShareLinksList(props.Links, props.NewLinkURL)
		@shareManageScript()
	</section>
}

// ShareLinksHeader labels the section and carries the primary call to action.
templ ShareLinksHeader(props ShareLinksPageProps) {
	<div class="flex flex-wrap items-start justify-between gap-3">
		<div>
			<h2 id="share-links-heading" class="text-lg font-semibold tracking-tight">Share links</h2>
			<p class="text-base-content/55 mt-1 max-w-xl text-sm">
				Let people outside your workspace chat with this agent. Each link has its own settings, and you can turn one off at any time.
			</p>
		</div>
		@ui.Button(ui.ButtonProps{
			Type:    ui.ButtonTypeLink,
			Href:    props.NewLinkURL,
			Variant: ui.ButtonPrimary,
			Size:    ui.ButtonSM,
			Icon:    "lucide--plus",
			Attrs:   templ.Attributes{"data-testid": "share-new-link"},
		}) {
			New share link
		}
	</div>
}

// ShareLinksList renders the existing links or the empty state.
templ ShareLinksList(links []ShareLinkRow, newLinkURL string) {
	<div data-testid="share-links-list">
		if len(links) == 0 {
			@shareLinksEmpty(newLinkURL)
		}
		if len(links) > 0 {
			<div class="space-y-4">
				for _, link := range links {
					@shareLinkRowItem(link)
				}
			</div>
		}
	</div>
}

// shareLinksEmpty is the no-links empty state with its own create call to
// action.
templ shareLinksEmpty(newLinkURL string) {
	<div data-testid="share-links-empty">
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--share-2",
			Title:       "No share links yet",
			Description: "Create a link to let someone outside your workspace chat with this agent.",
			IconStyle:   ui.EmptyStateIconTile,
			Bordered:    true,
			ActionHref:  newLinkURL,
			ActionLabel: "New share link",
			ActionIcon:  "lucide--plus",
		})
	</div>
}

// --- link card ---------------------------------------------------------------

// shareLinkRowItem is one link's card, in four bands: a title row (name, status,
// rotate/revoke actions); a prominent share-link block (readable URL + Copy
// link); a single tidy metadata line (created / last used / expires); and a
// labelled "Access & limits" section grouping the behaviour toggles and numeric
// caps.
templ shareLinkRowItem(link ShareLinkRow) {
	<div class="card card-border bg-base-100" data-testid="share-link-row" data-link-id={ link.ID }>
		<div class="card-body gap-4 p-4">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div class="flex min-w-0 items-center gap-2">
					@ui.IconSpan("lucide--link", "size-4 shrink-0 text-primary/70")
					<h3 class="truncate text-sm font-semibold">{ shareLinkTitle(link) }</h3>
					@shareLinkStatusBadge(link.Status)
				</div>
				<div class="flex shrink-0 items-center gap-1">
					if link.RotateURL != "" && link.Status == ShareLinkActive {
						<form method="post" action={ templ.URL(link.RotateURL) } hx-confirm="Rotate this link? The old URL stops working immediately and a new one is issued.">
							@ui.Button(ui.ButtonProps{
								Type:      ui.ButtonTypeSubmit,
								Variant:   ui.ButtonGhost,
								Size:      ui.ButtonSM,
								Shape:     ui.ButtonShapeSquare,
								Icon:      "lucide--refresh-cw",
								AriaLabel: "Rotate " + shareLinkTitle(link),
								Attrs:     templ.Attributes{"data-testid": "share-rotate-link", "title": "Issue a new URL and revoke this one"},
							})
						</form>
					}
					if link.RevokeURL != "" && link.Status != ShareLinkRevoked {
						<form method="post" action={ templ.URL(link.RevokeURL) } hx-confirm="Revoke this link? It stops working immediately.">
							@ui.Button(ui.ButtonProps{
								Type:       ui.ButtonTypeSubmit,
								Variant:    ui.ButtonGhost,
								Size:       ui.ButtonSM,
								Shape:      ui.ButtonShapeSquare,
								Icon:       "lucide--ban",
								ExtraClass: "text-error hover:text-error",
								AriaLabel:  "Revoke " + shareLinkTitle(link),
								Attrs:      templ.Attributes{"data-testid": "share-revoke-link", "title": "Revoke this link"},
							})
						</form>
					}
				</div>
			</div>
			@shareLinkURLBlock(link)
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-base-content/55">
				<span data-testid="share-link-created">
					@components.MetaChip("lucide--calendar-plus", "created "+shareTimeCell(link.CreatedAt, link.CreatedRelative))
				</span>
				<span data-testid="share-link-last-used">
					@components.MetaChip("lucide--clock", "last used "+shareTimeCell(link.LastUsedAt, link.LastUsedRelative))
				</span>
				<span data-testid="share-link-expires">
					@components.MetaChip("lucide--calendar-x", "expires "+shareLinkExpiresLabel(link))
				</span>
			</div>
			@shareLinkAccessSection(link)
		</div>
	</div>
}

// shareLinkURLBlock is the prominent share-link band: the copy control plus the
// full URL rendered in a readable, break-all field. At list time the key is not
// known, so the field is empty until the owner chooses Copy link (which fetches
// the reveal endpoint) or rotates the link.
templ shareLinkURLBlock(link ShareLinkRow) {
	if link.Status == ShareLinkRevoked {
		<div class="rounded-box border border-base-content/10 bg-base-200/30 px-3 py-2.5" data-testid="share-link-revoked">
			<p class="text-base-content/55 flex items-center gap-1.5 text-xs">
				@ui.IconSpan("lucide--ban", "size-3.5")
				This link was revoked and no longer works.
			</p>
		</div>
	} else {
		<div class="rounded-box border border-base-content/10 bg-base-200/40 p-3">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<p class="text-base-content/50 text-[11px] font-semibold tracking-wide uppercase">Share link</p>
				if link.URL != "" {
					@shareCopyButton(link.URL, "share-copy-link", "Copy link")
				} else if link.RevealURL != "" {
					@shareRevealCopyButton(link.RevealURL, "Copy link")
				}
			</div>
			<p class="text-base-content/75 mt-2 font-mono text-xs break-all" data-share-link-url>{ link.URL }</p>
			if link.URL == "" && link.RevealURL != "" {
				<p class="text-base-content/45 mt-1 text-xs">Copy link fetches the full URL. It isn't stored here until you do.</p>
			}
		</div>
	}
}

// shareLinkAccessSection groups the on/off behaviours and the numeric caps under
// one labelled heading, so the row reads as "what this link allows" rather than
// a flat chip dump.
templ shareLinkAccessSection(link ShareLinkRow) {
	<div class="rounded-box border border-base-200 bg-base-200/30 p-3" data-testid="share-link-access">
		<p class="text-base-content/50 text-[11px] font-semibold tracking-wide uppercase">Access &amp; limits</p>
		<div class="mt-2 flex flex-wrap gap-1.5">
			@shareBehaviourChip("lucide--mail", "Requires email", link.RequireEmail)
			@shareBehaviourChip("lucide--history", "Shows session list", link.ShowSessionList)
			@shareBehaviourChip("lucide--shield-alert", "Sandbox", link.Sandbox)
		</div>
		if shareLinkHasLimits(link) {
			<div class="mt-2 flex flex-wrap gap-1.5">
				if link.MaxSessionsPerUser > 0 {
					@ui.Badge(ui.BadgeProps{Label: strconv.Itoa(link.MaxSessionsPerUser) + " sessions / person", Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS})
				}
				if link.BudgetMessages > 0 {
					@ui.Badge(ui.BadgeProps{Label: strconv.Itoa(link.BudgetMessages) + " msg budget", Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS})
				}
				if link.BudgetTokens > 0 {
					@ui.Badge(ui.BadgeProps{Label: strconv.Itoa(link.BudgetTokens) + " token budget", Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS})
				}
			</div>
		} else {
			<p class="text-base-content/45 mt-2 text-xs">No session or usage limits.</p>
		}
	</div>
}

// shareLinkStatusBadge maps a link status to a badge.
templ shareLinkStatusBadge(status ShareLinkStatus) {
	{{
		intent := ui.BadgeSuccess
		label := "Active"
		icon := "lucide--circle-check"
		switch status {
		case ShareLinkExpired:
			intent, label, icon = ui.BadgeWarning, "Expired", "lucide--clock"
		case ShareLinkRevoked:
			intent, label, icon = ui.BadgeError, "Revoked", "lucide--ban"
		}
	}}
	<span data-testid="share-link-status">
		@ui.Badge(ui.BadgeProps{Label: label, Variant: intent, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: icon})
	</span>
}

// --- reveal modal ------------------------------------------------------------

// ShareLinkRevealModal is the one-time visible full URL shown, open, on the
// list page after a create or rotate. The raw key exists only in this response;
// closing the dialog returns to the list and the key is gone for good.
templ ShareLinkRevealModal(r ShareLinkReveal) {
	@components.SecretRevealModal(components.SecretRevealProps{
		Heading:      r.Heading,
		Name:         r.Label,
		Noun:         "link",
		SecretID:     "share-link-reveal-url",
		SecretTestID: "share-link-reveal-url",
		Secret:       r.URL,
		CopyLabel:    "Copy link",
		Warning:      "This full link is shown only once. If you lose it, rotate the link to issue a new one.",
		DialogID:     "share-link-reveal-modal",
		Attrs:        templ.Attributes{"data-share-link-reveal": "true"},
		AutoOpen:     true,
	})
}

// --- create page body --------------------------------------------------------

// ShareLinkCreatePanel is the create page body: the back-link, its heading, the
// form-level error, and the form itself.
templ ShareLinkCreatePanel(props ShareLinkCreatePageProps) {
	<section class="space-y-5" data-testid="share-create-panel" aria-labelledby="share-create-heading">
		<div>
			<a href={ templ.URL(props.CancelURL) } class="link link-hover text-base-content/60 inline-flex items-center gap-1 text-sm" data-testid="share-create-back">
				@ui.IconSpan("lucide--arrow-left", "size-4")
				Share links
			</a>
			<h2 id="share-create-heading" class="mt-2 text-lg font-semibold tracking-tight">New share link</h2>
			<p class="text-base-content/55 mt-1 max-w-xl text-sm">
				Choose how this link works. New links start active, and you can turn one off at any time.
			</p>
		</div>
		if props.Error != "" {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertError,
				Style:   ui.AlertStyleSoft,
				Icon:    "lucide--alert-circle",
				Message: props.Error,
				Attrs:   templ.Attributes{"data-testid": "share-create-error"},
			})
		}
		@ShareLinkCreateForm(props)
	</section>
}

// ShareLinkCreateForm is the create-link form. It posts plain form fields; the
// wiring lane interprets them.
templ ShareLinkCreateForm(props ShareLinkCreatePageProps) {
	<form
		id="share-create-link"
		data-testid="share-create-form"
		method="post"
		action={ templ.URL(props.CreateAction) }
		class="card card-border bg-base-100"
	>
		<div class="card-body gap-4 p-4">
			<div>
				<h3 class="text-sm font-semibold">Link settings</h3>
				<p class="text-base-content/50 mt-0.5 text-xs">Every field below applies to this one link.</p>
			</div>
			<div class="grid gap-4 sm:grid-cols-2">
				@form.FormField(form.FormFieldProps{
					Type:        form.FieldText,
					Name:        "label",
					Label:       "Label",
					Value:       props.Values.Label,
					Placeholder: "e.g. Product demo",
					Required:    true,
					Attrs:       templ.Attributes{"data-testid": "share-create-label"},
				})
				@form.FormField(form.FormFieldProps{
					Type:    form.FieldSelect,
					Name:    "expiryDays",
					Label:   "Expires",
					Value:   shareExpiryValue(props.Values),
					Options: shareExpiryOptions(),
					Attrs:   templ.Attributes{"data-testid": "share-create-expiry"},
				})
			</div>
			@form.FormField(form.FormFieldProps{
				Type:        form.FieldTextarea,
				Name:        "welcomeMessage",
				Label:       "Welcome message",
				Value:       props.Values.WelcomeMessage,
				Placeholder: "Shown at the top of the chat before the first message.",
				Rows:        2,
				Attrs:       templ.Attributes{"data-testid": "share-create-welcome"},
			})
			@shareToolPicker(props.Tools, props.Values.ToolIDs)
			<div class="space-y-3">
				@shareToggleRow("requireEmail", "Require email", "Ask visitors to enter an email before they can chat.", "lucide--mail", props.Values.RequireEmail, "share-create-require-email")
				@shareToggleRow("showSessionList", "Show session list", "Let each visitor see and resume their own past chats from this link.", "lucide--history", props.Values.ShowSessionList, "share-create-show-sessions")
				@shareSandboxToggle(props.Values.Sandbox)
			</div>
			<div class="grid gap-4 sm:grid-cols-3">
				@form.FormField(form.FormFieldProps{
					Type:        form.FieldNumber,
					Name:        "maxSessionsPerUser",
					Label:       "Max sessions per person",
					Value:       props.Values.MaxSessionsPerUser,
					Placeholder: "Unlimited",
					Class:       "input-sm",
					Attrs:       templ.Attributes{"data-testid": "share-create-max-sessions", "min": "0"},
				})
				@form.FormField(form.FormFieldProps{
					Type:        form.FieldNumber,
					Name:        "budgetMessages",
					Label:       "Message budget",
					Value:       props.Values.BudgetMessages,
					Placeholder: "Unlimited",
					Class:       "input-sm",
					Attrs:       templ.Attributes{"data-testid": "share-create-budget-messages", "min": "0"},
				})
				@form.FormField(form.FormFieldProps{
					Type:        form.FieldNumber,
					Name:        "budgetTokens",
					Label:       "Token budget",
					Value:       props.Values.BudgetTokens,
					Placeholder: "Unlimited",
					Class:       "input-sm",
					Attrs:       templ.Attributes{"data-testid": "share-create-budget-tokens", "min": "0"},
				})
			</div>
			<div class="flex justify-end gap-2 pt-1">
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    props.CancelURL,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Icon:    "lucide--x",
					Attrs:   templ.Attributes{"data-testid": "share-create-cancel"},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--link",
					Attrs:   templ.Attributes{"data-testid": "share-create-submit"},
				}) {
					Create link
				}
			</div>
		</div>
	</form>
}

// shareToolPicker is the tool allowlist: a scrollable checkbox list. Leaving all
// boxes unticked means "no tools" — the owner opts tools in explicitly.
templ shareToolPicker(tools []ShareToolOption, selected []string) {
	<fieldset class="rounded-lg border border-base-300 p-3" data-testid="share-create-tools">
		<legend class="px-1 text-xs font-semibold tracking-wider uppercase text-base-content/50">Allowed tools</legend>
		<p class="text-base-content/45 mb-2 text-xs">Only ticked tools can run. Leave empty to allow none.</p>
		if len(tools) == 0 {
			<p class="text-base-content/45 text-sm">This agent has no tools.</p>
		}
		if len(tools) > 0 {
			<div class="max-h-56 space-y-1 overflow-y-auto pr-1">
				for _, t := range tools {
					<label class="hover:bg-base-200/60 flex cursor-pointer items-start gap-3 rounded-md px-2 py-1.5">
						<input
							type="checkbox"
							name="toolIds"
							value={ t.ID }
							class="checkbox checkbox-sm mt-0.5"
							checked?={ shareToolSelected(t, selected) }
							data-testid="share-create-tool"
						/>
						<span class="min-w-0">
							<span class="flex items-center gap-1.5 text-sm">
								{ t.Label }
								if t.Dangerous {
									@ui.Badge(ui.BadgeProps{Label: "Can change data", Variant: ui.BadgeWarning, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS})
								}
							</span>
							if t.Description != "" {
								<p class="text-base-content/45 text-xs">{ t.Description }</p>
							}
						</span>
					</label>
				}
			</div>
		}
	</fieldset>
}

// shareToggleRow is a labelled toggle with a short explanation.
templ shareToggleRow(name string, label string, help string, icon string, checked bool, testID string) {
	<label class="flex cursor-pointer items-start gap-3" data-testid={ testID }>
		<input type="checkbox" name={ name } value="true" class="toggle toggle-sm mt-0.5" checked?={ checked }/>
		<span class="min-w-0">
			<span class="flex items-center gap-1.5 text-sm font-medium">
				@ui.IconSpan(icon, "size-4 text-base-content/50")
				{ label }
			</span>
			<span class="text-base-content/50 block text-xs">{ help }</span>
		</span>
	</label>
}

// shareSandboxToggle is the sandbox toggle plus its explicit risk warning.
templ shareSandboxToggle(checked bool) {
	<div class="share-sandbox-row rounded-lg border border-warning/30 bg-warning/5 p-3">
		<label class="flex cursor-pointer items-start gap-3" data-testid="share-create-sandbox">
			<input type="checkbox" name="sandbox" value="true" class="toggle toggle-sm toggle-warning mt-0.5" checked?={ checked }/>
			<span class="min-w-0">
				<span class="flex items-center gap-1.5 text-sm font-medium">
					@ui.IconSpan("lucide--shield-alert", "size-4 text-warning")
					Sandbox mode
				</span>
				<span class="text-base-content/55 block text-xs">Run the agent's tools in an isolated sandbox.</span>
			</span>
		</label>
		<p class="text-warning mt-2 flex items-start gap-2 text-xs" role="note" data-testid="share-sandbox-warning">
			@ui.IconSpan("lucide--triangle-alert", "size-4 shrink-0")
			<span>Turning this on is higher risk: it can run code and reach outside the sandbox. Only enable it for links you trust.</span>
		</p>
	</div>
}

// --- copy controls + script --------------------------------------------------

// shareCopyButton renders a copy-to-clipboard button for an already-known URL.
// The URL lives in a data attribute (never an inline handler) and
// shareManageScript() wires the click; without JavaScript the URL is still
// shown as text in the link block.
templ shareCopyButton(value string, testID string, label string) {
	<button
		type="button"
		class="btn btn-primary btn-sm gap-2"
		data-copy-link={ value }
		data-testid={ testID }
		aria-label={ label }
	>
		@ui.IconSpan("lucide--copy", "size-4")
		<span class="share-copy-label">{ label }</span>
	</button>
}

// shareRevealCopyButton is the row's copy action for an existing link whose key
// is not present at list time. It fetches the reveal endpoint on demand, copies
// the full URL, and fills the readable link field inline (see shareManageScript).
templ shareRevealCopyButton(revealURL string, label string) {
	<button
		type="button"
		class="btn btn-primary btn-sm gap-2"
		data-reveal-url={ revealURL }
		data-testid="share-copy-link"
		aria-label={ label }
	>
		@ui.IconSpan("lucide--copy", "size-4")
		<span class="share-copy-label">{ label }</span>
	</button>
}

// shareManageScript wires the copy buttons once per page.
templ shareManageScript() {
	@shareManageScriptOnce.Once() {
		<script>
		(function () {
			if (window.__memoryShareManageWired) return;
			window.__memoryShareManageWired = true;
			function copyText(text, done) {
				if (navigator.clipboard && navigator.clipboard.writeText) {
					navigator.clipboard.writeText(text).then(done, function () {});
				}
			}
			// Direct copy (URL already known, e.g. right after create/rotate).
			document.addEventListener("click", function (ev) {
				var btn = ev.target && ev.target.closest ? ev.target.closest("[data-copy-link]") : null;
				if (!btn) return;
				ev.preventDefault();
				var text = btn.getAttribute("data-copy-link") || "";
				var label = btn.querySelector(".share-copy-label");
				var restore = label ? label.textContent : "";
				copyText(text, function () {
					if (!label) return;
					label.textContent = "Copied";
					setTimeout(function () { label.textContent = restore; }, 1600);
				});
			});
			// On-demand reveal: fetch the key, build/copy the full URL, and show
			// it in the row's link field. The key is never rendered during list build.
			document.addEventListener("click", function (ev) {
				var btn = ev.target && ev.target.closest ? ev.target.closest("[data-reveal-url]") : null;
				if (!btn) return;
				ev.preventDefault();
				if (btn.dataset.revealing === "true") return;
				btn.dataset.revealing = "true";
				var label = btn.querySelector(".share-copy-label");
				var restore = label ? label.textContent : "";
				var url = btn.getAttribute("data-reveal-url") || "";
				var card = btn.closest(".card-body");
				var urlEl = card ? card.querySelector("[data-share-link-url]") : null;
				var finish = function (msg) {
					if (label) label.textContent = msg;
					setTimeout(function () {
						if (label) label.textContent = restore;
						btn.dataset.revealing = "false";
					}, 2000);
				};
				var showURL = function (text) {
					if (!urlEl) return;
					urlEl.textContent = text;
					urlEl.classList.remove("text-error");
					urlEl.classList.add("text-base-content/75");
				};
				var showError = function (text) {
					if (!urlEl) return;
					urlEl.textContent = text;
					urlEl.classList.remove("text-base-content/75");
					urlEl.classList.add("text-error");
				};
				fetch(url, { headers: { Accept: "application/json" } })
					.then(function (res) {
						return res.json().catch(function () { return {}; }).then(function (body) {
							return { ok: res.ok, body: body };
						});
					})
					.then(function (r) {
						if (r.ok && r.body && r.body.url) {
							showURL(r.body.url);
							copyText(r.body.url, function () {});
							finish("Copied");
						} else if (r.body && r.body.code === "not_recoverable") {
							showError("Not recoverable — rotate this link to issue a new one.");
							finish("Rotate to recover");
						} else {
							finish("Copy failed");
						}
					})
					.catch(function () { finish("Copy failed"); });
			});
		})();
		</script>
	}
}

// --- helpers -----------------------------------------------------------------

func shareLinkTitle(link ShareLinkRow) string {
	if link.Label != "" {
		return link.Label
	}
	return "Untitled link"
}

// shareTimeCell shows a relative time when known, with the absolute time as the
// title for hover, and an em dash when the value is empty.
func shareTimeCell(absolute string, relative string) string {
	if relative != "" {
		return relative
	}
	if absolute != "" {
		return absolute
	}
	return "—"
}

// shareLinkExpiresLabel is the expiry value shown in the metadata line: "Never"
// when the link has no expiry, else the relative/absolute time.
func shareLinkExpiresLabel(link ShareLinkRow) string {
	if link.ExpiresNever {
		return "Never"
	}
	return shareTimeCell(link.ExpiresAt, link.ExpiresRelative)
}

// shareLinkHasLimits reports whether the link sets any numeric cap.
func shareLinkHasLimits(link ShareLinkRow) bool {
	return link.MaxSessionsPerUser > 0 || link.BudgetMessages > 0 || link.BudgetTokens > 0
}

// shareBehaviourChip shows an on/off behaviour as a badge (off = ghost).
templ shareBehaviourChip(icon string, label string, on bool) {
	if on {
		@ui.Badge(ui.BadgeProps{Label: label, Variant: ui.BadgeInfo, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: icon})
	} else {
		@ui.Badge(ui.BadgeProps{Label: label, Variant: ui.BadgeGhost, Style: ui.BadgeStyleOutline, Size: ui.BadgeSizeXS, Icon: icon})
	}
}

func shareExpiryValue(v ShareLinkCreateValues) string {
	if v.NeverExpires {
		return "never"
	}
	if v.ExpiryDays <= 0 {
		return "30"
	}
	return strconv.Itoa(v.ExpiryDays)
}

func shareExpiryOptions() []form.SelectOption {
	return []form.SelectOption{
		{Value: "1", Label: "After 1 day"},
		{Value: "7", Label: "After 7 days"},
		{Value: "30", Label: "After 30 days"},
		{Value: "90", Label: "After 90 days"},
		{Value: "never", Label: "Never (not recommended)"},
	}
}

func shareToolSelected(t ShareToolOption, selected []string) bool {
	return t.Selected || slices.Contains(selected, t.ID)
}
