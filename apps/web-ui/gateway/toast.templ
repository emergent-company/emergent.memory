package main

import "github.com/emergent-company/go-daisy/components/alpine"

// toastQueue renders a fixed bottom-right toast queue backed by Alpine.js.
// Modeled on go-daisy's ui.ToastQueue, extended with a per-toast countdown
// progress bar and hover-to-pause. Toasts are pushed via window.MemoryApp.toast
// (app.js) or directly by calling queue.add({type, message, duration}).
templ toastQueue() {
	<div
		id="toast-container"
		class="fixed bottom-4 left-1/2 z-70 flex w-80 max-w-[calc(100vw-2rem)] -translate-x-1/2 flex-col gap-2 sm:left-auto sm:right-4 sm:translate-x-0"
		aria-live="polite"
		aria-atomic="false"
		{ alpine.XData(toastQueueState())... }
		x-init={ toastQueueInit() }
	>
		<template x-for="t in toasts" :key="t.id">
			<div
				class="alert shadow-lg cursor-pointer relative overflow-hidden"
				:class="'alert-' + t.type"
				x-show="true"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-y-2"
				x-transition:enter-end="opacity-100 translate-y-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-y-0"
				x-transition:leave-end="opacity-0 translate-y-2"
				@mouseenter="pause(t)"
				@mouseleave="resume(t)"
				@click="dismiss(t.id)"
				role="alert"
			>
				<span x-text="t.message"></span>
				<div
					class="toast-bar"
					:style="'animation-duration:' + t.duration + 'ms; animation-play-state:' + (t.paused ? 'paused' : 'running')"
				></div>
			</div>
		</template>
	</div>
}
