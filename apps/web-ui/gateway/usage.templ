package main

import (
	"strconv"

	"github.com/emergent-company/emergent.memory/apps/web-ui/webui"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/table"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Usage dashboard ---

// usagePageData is the rendered payload of the usage dashboard. It is a struct
// rather than a parameter list because the page has grown four independent
// concerns — the summary, the charts, the budget panels and PRG feedback — and
// a positional call with eight arguments is how a "days" ends up in an error
// slot.
type usagePageData struct {
	Summary *UsageSummaryResponse
	Series  *UsageTimeSeriesResponse
	Payload usageChartPayload
	// ByAgent is the per-agent breakdown over the range. Its RunCount is what
	// the "Agent runs" card shows, and its rows are the per-agent table.
	// Best-effort: nil (with ByAgentErr nil) means the backend did not answer.
	ByAgent    *UsageByAgentResponse
	ByAgentErr error
	MonthSpend float64
	// HasMonthSpend is false when the current-month spend call failed; the card
	// is then omitted rather than shown as $0.
	HasMonthSpend bool
	// Budget is the project's week/month budget position. Nil (with BudgetErr
	// nil) means the reading is unavailable and the section degrades.
	Budget *BudgetState
	// BudgetErr is a failed budget fetch: the page still renders, the budget
	// section says it is unavailable. A budget outage never fails the page.
	BudgetErr error
	FlashMsg  string
	FlashErr  error
	Days      int
	LoadErr   error
}

// UsagePage renders the usage dashboard: summary cards (total tokens, range
// cost, agent runs, current-month spend when available), daily token, cost and
// conversation charts, a per-agent table, a per-model table, the budget panels
// (remaining budget and reset timing for each window), and a 7/30/90-day range
// selector. A failed backend fetch renders the whole-page error state (no
// crash); the per-agent breakdown degrades on its own.
templ UsagePage(data usagePageData) {
	@layout.Container(layout.ContainerLG, nil) {
		@pageHeader("Project", "Usage", "LLM token consumption, agent activity and remaining budget for this project — costs are retail-price estimates.") {
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    usageSessionsHref(data.Days, "", 0),
				Variant: ui.ButtonSecondary,
				Size:    ui.ButtonSM,
				Icon:    "lucide--scroll-text",
				Attrs:   templ.Attributes{"data-testid": "usage-run-log"},
			}) {
				Run log
			}
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/settings/budget",
				Variant: ui.ButtonSecondary,
				Size:    ui.ButtonSM,
				Icon:    "lucide--wallet",
				Attrs:   templ.Attributes{"data-testid": "usage-manage-budget"},
			}) {
				Manage budget
			}
		}
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageErrorNotice("Failed to load usage", data.LoadErr)
		} else {
			@usageRangeSelector(data.Days)
			// The budget panels stand on their own: they render even when the
			// selected range has no usage rows, because "you are near your
			// limit" matters most when the page is otherwise empty.
			@usageBudgetSection(data.Budget, data.BudgetErr)
			if hasUsageData(data.Summary, data.Series) {
				@usageSummaryCards(data.Summary, data.ByAgent, data.MonthSpend, data.HasMonthSpend)
				@usageCharts(data.Payload)
				@usageAgentSection(data.ByAgent, data.ByAgentErr, data.Days)
				@usageModelSection(data.Summary)
				if note := usageNote(data.Summary, data.Series); note != "" {
					@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Tone: ui.EmptyNoteToneQuiet, Class: "mt-6"}) {
						{ note }
					}
				}
			} else {
				@usageEmpty()
			}
		}
	}
}

// usageRangeSelector renders the 7/30/90-day links; the active range is
// highlighted.
templ usageRangeSelector(days int) {
	<div class="mb-6 flex items-center gap-3">
		<span class="text-muted-faint text-xs">Range</span>
		<div class="join">
			@usageRangeLink(days, 7)
			@usageRangeLink(days, 30)
			@usageRangeLink(days, 90)
		</div>
	</div>
}

templ usageRangeLink(active, n int) {
	{{ var variant ui.ButtonVariant }}
	if active == n {
		{{ variant = ui.ButtonPrimary }}
	}
	@ui.Button(ui.ButtonProps{
		Type:       ui.ButtonTypeLink,
		Href:       "/usage?days=" + strconv.Itoa(n),
		Variant:    variant,
		Size:       ui.ButtonSM,
		ExtraClass: "join-item",
	}) {
		{ strconv.Itoa(n) }d
	}
}

// usageSummaryCards renders the summary stats.
//
// "Agent runs" counts the runs behind the range's spend (scheduled, delegated
// and chat runs alike), not chat conversations: a conversation can hold many
// runs, so a conversation count next to a multi-dollar figure reads as "one
// session for $10". The card is omitted — never shown as zero — when the
// per-agent breakdown is unavailable, because a zero would claim nothing ran.
//
// The spend card is labelled "Calendar month spend" rather than "Current month
// spend" because the budget section below can be showing an *anchored* monthly
// cycle (after a reset): two cards both saying "this month" would show two
// different figures for the same words.
templ usageSummaryCards(summary *UsageSummaryResponse, byAgent *UsageByAgentResponse, monthSpend float64, hasMonthSpend bool) {
	{{ cards := []ui.StatCardProps{
		{Label: "Total tokens", Value: compactNum(totalTokens(summary.Data)), Icon: "lucide--braces", IconColor: "bg-primary/15 text-primary", Attrs: templ.Attributes{"data-testid": "stat-total-tokens"}},
		{Label: "Estimated cost", Value: formatCost(totalCost(summary.Data)), Icon: "lucide--dollar-sign", IconColor: "bg-secondary/15 text-secondary", Attrs: templ.Attributes{"data-testid": "stat-estimated-cost"}},
	}
	if byAgent != nil {
		cards = append(cards, ui.StatCardProps{Label: "Agent runs", Value: compactNum(byAgent.RunCount), Icon: "lucide--bot", IconColor: "bg-info/15 text-info", Attrs: templ.Attributes{"data-testid": "stat-agent-runs"}})
	}
	if hasMonthSpend {
		cards = append(cards, ui.StatCardProps{Label: "Calendar month spend", Value: formatCost(monthSpend), Icon: "lucide--calendar-clock", IconColor: "bg-accent/15 text-accent", Attrs: templ.Attributes{"data-testid": "stat-month-spend"}})
	}
	// Keep one line at desktop widths whatever the card count; the default row
	// is two columns, so two cards need no extra class.
	cols := "lg:grid-cols-4"
	switch len(cards) {
	case 2:
		cols = ""
	case 3:
		cols = "lg:grid-cols-3"
	} }}
	@statRow(cards, StatRowOpts{Margin: "mt-6", ColsClass: cols})
}

// usageCharts renders the three daily charts plus the embedded JSON payload
// and the dependency-free SVG chart helper (usage-charts.js).
//
// The conversation chart stays, but it is labelled "Conversations per day":
// conversations are not agent runs, and the page's run figure comes from the
// per-agent breakdown instead.
templ usageCharts(payload usageChartPayload) {
	<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
		@ui.Section("Tokens per day", ui.SectionProps{Margin: "", BodyClass: "memory-density-compact"}) {
			<div id="usage-token-chart" class="w-full" data-testid="usage-token-chart"></div>
		}
		@ui.Section("Cost per day", ui.SectionProps{Margin: "", BodyClass: "memory-density-compact"}) {
			<div id="usage-cost-chart" class="w-full" data-testid="usage-cost-chart"></div>
		}
		@ui.Section("Conversations per day", ui.SectionProps{Margin: "", BodyClass: "memory-density-compact"}) {
			<div id="usage-session-chart" class="w-full" data-testid="usage-session-chart"></div>
		}
	</div>
	@templ.JSONScript("usage-timeseries", payload)
	<script src={ templ.SafeURL(webui.AssetPath("/js/usage-charts.js")) }></script>
}

// usageAgentSection lists spend per agent, highest cost first. Each agent name
// links to the run log filtered to that agent, which is the view that explains a
// surprising line. The unattributed bucket — spend from direct API and embedding
// calls, which belongs to no run — is shown without a link because there are no
// runs to list; it is what keeps the rows adding up to the range total.
templ usageAgentSection(byAgent *UsageByAgentResponse, err error, days int) {
	if err != nil || byAgent == nil || len(byAgent.Data) == 0 {
		@ui.Section("Per-agent usage", ui.SectionProps{Margin: "mt-6"}) {
			@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Tone: ui.EmptyNoteToneQuiet}) {
				The per-agent breakdown is unavailable right now. The totals above are unaffected.
			}
		}
	} else {
		@ui.Section("Per-agent usage", ui.SectionProps{Margin: "mt-6", CardClass: "overflow-hidden", BodyClass: "memory-density-flush"}) {
			@table.TableWithProps(table.TableProps{Bordered: false, WrapperClass: "stacked-table", Attrs: templ.Attributes{"data-testid": "usage-agent-table", "style": "--h1:'Agent';--h2:'Runs';--h3:'Tokens';--h4:'Cost'"}}) {
				@table.TableHead() {
					@table.TableHeadRow() {
						@table.TableHeadCell("Agent")
						@table.TableHeadCell("Runs")
						@table.TableHeadCell("Tokens")
						@table.TableHeadCell("Cost")
					}
				}
				@table.TableBody() {
					for i, r := range byAgent.Data {
						@usageAgentRow(strconv.Itoa(i), r, days)
					}
				}
			}
		}
	}
}

templ usageAgentRow(rowID string, r UsageByAgentRow, days int) {
	@table.TableRow(rowID, false, nil) {
		@table.TableCell("", nil) {
			if r.Attributed() {
				<a href={ templ.URL(usageSessionsHref(days, r.AgentID, 0)) } class="link link-hover text-sm" data-testid={ "usage-agent-" + shortID(r.AgentID) }>
					{ r.AgentName }
				</a>
			} else {
				<span class="text-muted-faint text-sm" data-testid="usage-agent-unattributed">Unattributed</span>
				<span class="text-muted-faint ml-1 text-xs">direct API calls</span>
			}
		}
		@table.TableCell("", nil) {
			<span class="text-sm">{ compactNum(r.RunCount) }</span>
		}
		@table.TableCell("", nil) {
			<span class="text-sm">{ compactNum(r.TokenCount()) }</span>
		}
		@table.TableCell("", nil) {
			<span class="text-sm font-medium">{ formatCost(r.EstimatedCostUSD) }</span>
		}
	}
}

// usageModelSection lists token usage grouped by model, sorted by cost.
templ usageModelSection(summary *UsageSummaryResponse) {
	@ui.Section("Per-model usage", ui.SectionProps{Margin: "mt-6", CardClass: "overflow-hidden", BodyClass: "memory-density-flush"}) {
		@table.TableWithProps(table.TableProps{Bordered: false, WrapperClass: "stacked-table", Attrs: templ.Attributes{"style": "--h1:'Model';--h2:'Provider';--h3:'Tokens';--h4:'Cost'"}}) {
			@table.TableHead() {
				@table.TableHeadRow() {
					@table.TableHeadCell("Model")
					@table.TableHeadCell("Provider")
					@table.TableHeadCell("Tokens")
					@table.TableHeadCell("Cost")
				}
			}
			@table.TableBody() {
				for i, r := range usageModels(summary.Data) {
					@usageModelRow(strconv.Itoa(i), r)
				}
			}
		}
	}
}

templ usageModelRow(rowID string, r UsageSummaryRow) {
	@table.TableRow(rowID, false, nil) {
		@table.TableCell("", nil) {
			<span class="font-mono text-sm">{ r.Model }</span>
		}
		@table.TableCell("", nil) {
			<span class="text-muted-strong text-sm" data-testid={ "usage-provider-" + usageInstanceSlug(r) }>
				{ usageInstanceSlug(r) }
				if usageDialectDistinct(r) {
					<span class="ml-1 text-muted-faint text-xs">{ r.Provider }</span>
				}
			</span>
		}
		@table.TableCell("", nil) {
			<span class="text-sm">{ compactNum(modelTokenCount(r)) }</span>
		}
		@table.TableCell("", nil) {
			<span class="text-sm">{ formatCost(r.EstimatedCostUSD) }</span>
		}
	}
}

// usageEmpty is the "no usage rows in the selected range" state.
templ usageEmpty() {
	@ui.EmptyState(ui.EmptyStateProps{
		Icon:        "lucide--chart-column",
		Title:       "No usage data",
		Description: "No token usage or sessions recorded in this range. Try a wider range or start a conversation.",
		Bordered:    true,
		Class:       "py-12",
	})
}
