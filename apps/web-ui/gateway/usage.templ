package main

import (
	"strconv"

	"github.com/emergent-company/emergent.memory/apps/web-ui/webui"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/table"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Usage dashboard ---

// usagePageData is the rendered payload of the usage dashboard. It is a struct
// rather than a parameter list because the page has grown four independent
// concerns — the summary, the charts, the budget panels and PRG feedback — and
// a positional call with eight arguments is how a "days" ends up in an error
// slot.
type usagePageData struct {
	Summary    *UsageSummaryResponse
	Series     *UsageTimeSeriesResponse
	Payload    usageChartPayload
	MonthSpend float64
	// HasMonthSpend is false when the current-month spend call failed; the card
	// is then omitted rather than shown as $0.
	HasMonthSpend bool
	// Budget is the project's week/month budget position. Nil (with BudgetErr
	// nil) means the reading is unavailable and the section degrades.
	Budget *BudgetState
	// BudgetErr is a failed budget fetch: the page still renders, the budget
	// section says it is unavailable. A budget outage never fails the page.
	BudgetErr error
	FlashMsg  string
	FlashErr  error
	Days      int
	LoadErr   error
}

// UsagePage renders the usage dashboard: summary cards (total tokens, range
// cost, sessions, current-month spend when available), a daily token chart, a
// sessions-per-day chart, a per-model table, the budget panels (remaining
// budget and reset timing for each window), and a 7/30/90-day range selector.
// A failed backend fetch renders the whole-page error state (no crash).
templ UsagePage(data usagePageData) {
	@layout.Container(layout.ContainerLG, nil) {
		@pageHeader("Project", "Usage", "LLM token consumption, session activity and remaining budget for this project — costs are retail-price estimates.") {
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/settings/budget",
				Variant: ui.ButtonSecondary,
				Size:    ui.ButtonSM,
				Icon:    "lucide--wallet",
				Attrs:   templ.Attributes{"data-testid": "usage-manage-budget"},
			}) {
				Manage budget
			}
		}
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageErrorNotice("Failed to load usage", data.LoadErr)
		} else {
			@usageRangeSelector(data.Days)
			// The budget panels stand on their own: they render even when the
			// selected range has no usage rows, because "you are near your
			// limit" matters most when the page is otherwise empty.
			@usageBudgetSection(data.Budget, data.BudgetErr)
			if hasUsageData(data.Summary, data.Series) {
				@usageSummaryCards(data.Summary, data.Payload, data.MonthSpend, data.HasMonthSpend)
				@usageCharts(data.Payload)
				@usageModelSection(data.Summary)
				if note := usageNote(data.Summary, data.Series); note != "" {
					@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Tone: ui.EmptyNoteToneQuiet, Class: "mt-6"}) {
						{ note }
					}
				}
			} else {
				@usageEmpty()
			}
		}
	}
}

// usageRangeSelector renders the 7/30/90-day links; the active range is
// highlighted.
templ usageRangeSelector(days int) {
	<div class="mb-6 flex items-center gap-3">
		<span class="text-muted-faint text-xs">Range</span>
		<div class="join">
			@usageRangeLink(days, 7)
			@usageRangeLink(days, 30)
			@usageRangeLink(days, 90)
		</div>
	</div>
}

templ usageRangeLink(active, n int) {
	{{ var variant ui.ButtonVariant }}
	if active == n {
		{{ variant = ui.ButtonPrimary }}
	}
	@ui.Button(ui.ButtonProps{
		Type:       ui.ButtonTypeLink,
		Href:       "/usage?days=" + strconv.Itoa(n),
		Variant:    variant,
		Size:       ui.ButtonSM,
		ExtraClass: "join-item",
	}) {
		{ strconv.Itoa(n) }d
	}
}

// usageSummaryCards renders the summary stats. The calendar-month spend card is
// omitted when memory does not report it.
//
// It is labelled "Calendar month spend" rather than "Current month spend"
// because the budget section below can be showing an *anchored* monthly cycle
// (after a reset): two cards both saying "this month" would show two different
// figures for the same words.
templ usageSummaryCards(summary *UsageSummaryResponse, payload usageChartPayload, monthSpend float64, hasMonthSpend bool) {
	{{ cards := []ui.StatCardProps{
		{Label: "Total tokens", Value: compactNum(totalTokens(summary.Data)), Icon: "lucide--braces", IconColor: "bg-primary/15 text-primary", Attrs: templ.Attributes{"data-testid": "stat-total-tokens"}},
		{Label: "Estimated cost", Value: formatCost(totalCost(summary.Data)), Icon: "lucide--dollar-sign", IconColor: "bg-secondary/15 text-secondary", Attrs: templ.Attributes{"data-testid": "stat-estimated-cost"}},
		{Label: "Sessions", Value: compactNum(chartSeriesTotal(payload.Sessions)), Icon: "lucide--messages-square", IconColor: "bg-info/15 text-info", Attrs: templ.Attributes{"data-testid": "stat-sessions"}},
	}
	if hasMonthSpend {
		cards = append(cards, ui.StatCardProps{Label: "Calendar month spend", Value: formatCost(monthSpend), Icon: "lucide--calendar-clock", IconColor: "bg-accent/15 text-accent", Attrs: templ.Attributes{"data-testid": "stat-month-spend"}})
	} }}
	@statRow(cards, StatRowOpts{Margin: "mt-6"})
}

// usageCharts renders the two daily charts plus the embedded JSON payload and
// the dependency-free SVG chart helper (usage-charts.js).
templ usageCharts(payload usageChartPayload) {
	<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
		@ui.Section("Tokens per day", ui.SectionProps{Margin: "", BodyClass: "memory-density-compact"}) {
			<div id="usage-token-chart" class="w-full" data-testid="usage-token-chart"></div>
		}
		@ui.Section("Sessions per day", ui.SectionProps{Margin: "", BodyClass: "memory-density-compact"}) {
			<div id="usage-session-chart" class="w-full" data-testid="usage-session-chart"></div>
		}
	</div>
	@templ.JSONScript("usage-timeseries", payload)
	<script src={ templ.SafeURL(webui.AssetPath("/js/usage-charts.js")) }></script>
}

// usageModelSection lists token usage grouped by model, sorted by cost.
templ usageModelSection(summary *UsageSummaryResponse) {
	@ui.Section("Per-model usage", ui.SectionProps{Margin: "mt-6", CardClass: "overflow-hidden", BodyClass: "memory-density-flush"}) {
		@table.TableWithProps(table.TableProps{Bordered: false, Attrs: templ.Attributes{"class": "stacked-table", "style": "--h1:'Model';--h2:'Provider';--h3:'Tokens';--h4:'Cost'"}}) {
			@table.TableHead() {
				@table.TableHeadRow() {
					@table.TableHeadCell("Model")
					@table.TableHeadCell("Provider")
					@table.TableHeadCell("Tokens")
					@table.TableHeadCell("Cost")
				}
			}
			@table.TableBody() {
				for i, r := range usageModels(summary.Data) {
					@usageModelRow(strconv.Itoa(i), r)
				}
			}
		}
	}
}

templ usageModelRow(rowID string, r UsageSummaryRow) {
	@table.TableRow(rowID, false, nil) {
		@table.TableCell("", nil) {
			<span class="font-mono text-sm">{ r.Model }</span>
		}
		@table.TableCell("", nil) {
			<span class="text-muted-strong text-sm" data-testid={ "usage-provider-" + usageInstanceSlug(r) }>
				{ usageInstanceSlug(r) }
				if usageDialectDistinct(r) {
					<span class="ml-1 text-muted-faint text-xs">{ r.Provider }</span>
				}
			</span>
		}
		@table.TableCell("", nil) {
			<span class="text-sm">{ compactNum(modelTokenCount(r)) }</span>
		}
		@table.TableCell("", nil) {
			<span class="text-sm">{ formatCost(r.EstimatedCostUSD) }</span>
		}
	}
}

// usageEmpty is the "no usage rows in the selected range" state.
templ usageEmpty() {
	@ui.EmptyState(ui.EmptyStateProps{
		Icon:        "lucide--chart-column",
		Title:       "No usage data",
		Description: "No token usage or sessions recorded in this range. Try a wider range or start a conversation.",
		Bordered:    true,
		Class:       "py-12",
	})
}
