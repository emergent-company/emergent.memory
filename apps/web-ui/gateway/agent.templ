package main

import (
	"net/url"
	"strconv"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/form"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Agent dashboard ---

// AgentDashboardPage renders the per-agent dashboard: summary, configured
// tools, and recent chats, plus a memories link. A failed agent fetch
// (LoadErr) renders the whole-page error state; a conversations failure
// (ChatsErr) degrades only the recent-chats section.
templ AgentDashboardPage(data agentDashboardData) {
	@layout.Container(layout.ContainerLG, nil) {
		if data.LoadErr != nil {
			@pageError("Agent unavailable", data.LoadErr)
		} else {
			@agentDashboardHeader(data.Agent, "")
			@layout.Rail(agentSubNav(data.Agent.ID, "dashboard", ""), nil) {
				@agentSummaryCard(data)
				@agentModelNotice(data)
				@agentToolsSection(data)
				@agentChatsSection(data)
			}
		}
	}
}

// agentSubNav is the vertical sub-navigation rail for the per-agent pages
// (dashboard / settings / sandbox / sessions). It stacks horizontally on small
// screens and becomes a sticky left rail on desktop.
templ agentSubNav(agentID string, active string, section string) {
	@components.SubNav("Agent sections") {
		@components.SubNavItem("/agents/"+url.PathEscape(agentID), active == "dashboard", "lucide--layout-dashboard", "Dashboard")
		@agentSettingsNavGroup(agentID, section)
		@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/sandbox", active == "sandbox", "lucide--box", "Sandbox")
		@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/sessions", active == "sessions", "lucide--messages-square", "Sessions")
		@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/share", active == "share", "lucide--share-2", "Share")
	}
}

// agentSettingsNavGroup renders the Settings rail entry together with its six
// subpage children, always visible in the agent details rail. A child is active
// when its section matches; the parent is a plain link into the settings hub and
// is never marked current (the General child shares its destination, so marking
// both would duplicate the current-page state). The children form a compact
// bordered cluster beside the parent on the small-screen horizontal rail and
// become an indented vertical column on the desktop rail.
templ agentSettingsNavGroup(agentID string, section string) {
	<div class="flex shrink-0 flex-row gap-1 lg:flex-col lg:gap-1">
		@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/settings", false, "lucide--settings", "Settings")
		<div class="flex shrink-0 flex-row gap-1 rounded-lg border border-base-content/10 p-0.5 lg:flex-col lg:gap-1 lg:rounded-none lg:border-0 lg:p-0 lg:pl-4">
			@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/settings", section == "general", "lucide--settings", "General")
			@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/settings/model", section == "model", "lucide--cpu", "Model")
			@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/settings/tools", section == "tools", "lucide--wrench", "Tools")
			@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/settings/skills", section == "skills", "lucide--sparkles", "Skills")
			@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/settings/delegation", section == "delegation", "lucide--users", "Delegation")
			@components.SubNavItem("/agents/"+url.PathEscape(agentID)+"/settings/mcp", section == "mcp", "lucide--plug", "MCP sharing")
		</div>
	</div>
}

templ agentDashboardHeader(a *AgentDefinition, section string) {
	{{ crumbs := crumbsActive(nav.Crumbs("Agents", "/agents", a.Name, "/agents/"+url.PathEscape(a.ID)))
	if section != "" {
		crumbs = crumbsActive(nav.Crumbs("Agents", "/agents", a.Name, "/agents/"+url.PathEscape(a.ID), section))
	} }}
	@detailHeader(crumbs, "", a.Name, a.Description, detailHeaderOpts{
		Margin:    "mb-6",
		Dashboard: true,
		Leading:   agentIconTile(agentIcon(a.UIConfig), agentColor(a.UIConfig)),
	}) {
		@ui.Badge(ui.BadgeProps{
			Label:   "updated " + relTime(a.UpdatedAt),
			Variant: ui.BadgeGhost,
			Size:    ui.BadgeSizeSM,
			Icon:    "lucide--clock",
		})
	}
}

templ agentSummaryCard(data agentDashboardData) {
	@components.PanelCard("", nil) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex items-center gap-3">
				@agentIconTile(agentIcon(data.Agent.UIConfig), agentColor(data.Agent.UIConfig))
				<h2 class="text-lg font-semibold">{ data.Agent.Name }</h2>
			</div>
			@ui.Badge(ui.BadgeProps{
				Label:   visibilityLabel(data.Agent.Visibility),
				Variant: visibilityIntent(data.Agent.Visibility),
				Size:    ui.BadgeSizeSM,
				Dot:     true,
			})
		</div>
		<div class="mt-5 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
			@agentSummaryField("Model") {
				if name, isDefault := agentModelName(data.Agent, data.DefaultModel); name != "" {
					<span class="font-mono text-sm">{ name }</span>
					if isDefault {
						<span class="text-base-content/40 text-sm"> (default)</span>
					}
				} else {
					<span class="text-base-content/40 text-sm">auto — default model</span>
				}
			}
			@agentSummaryField("Flow") {
				@ui.Badge(ui.BadgeProps{
					Label:   flowLabel(data.Agent.FlowType),
					Variant: ui.BadgeNeutral,
					Style:   ui.BadgeStyleSoft,
					Size:    ui.BadgeSizeXS,
				})
			}
			@agentSummaryField("Visibility") {
				@ui.Badge(ui.BadgeProps{
					Label:   visibilityLabel(data.Agent.Visibility),
					Variant: visibilityIntent(data.Agent.Visibility),
					Size:    ui.BadgeSizeXS,
					Dot:     true,
				})
			}
			@agentSummaryField("Tools") {
				@ui.Badge(ui.BadgeProps{
					Label:   strconv.Itoa(data.Agent.ToolCount) + " tool" + plural(data.Agent.ToolCount),
					Variant: ui.BadgeGhost,
					Size:    ui.BadgeSizeXS,
					Icon:    "lucide--wrench",
				})
			}
		</div>
		<div class="mt-5 flex flex-wrap items-center gap-2 border-t border-base-200 pt-4">
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/chat?agent=" + url.QueryEscape(data.Agent.ID),
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonSM,
				Icon:    "lucide--messages-square",
			}) {
				Chat with this agent
			}
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/agents/" + url.PathEscape(data.Agent.ID) + "/memories",
				Variant: ui.ButtonOutline,
				Size:    ui.ButtonSM,
				Icon:    "lucide--brain",
			}) {
				Memories
			}
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/agents/" + url.PathEscape(data.Agent.ID) + "/settings/mcp",
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--share-2",
			}) {
				Share via MCP
			}
		</div>
	}
}

// agentModelNotice warns under the dashboard summary card when the agent's
// model can't be served: an agent with no explicit model is error when the
// project has no configured provider (chats can't run) and warning while the
// model is only a provider-credential fallback (no pinned project default);
// an explicit model is error when its provider prefix matches no configured
// provider (or none is configured).
templ agentModelNotice(data agentDashboardData) {
	if sev, msg := agentModelDashboardIssue(data.Agent, data.DefaultModel, data.ModelConfigKnown, data.HasProviders, data.ProviderNames); sev != "" {
		<div class="mt-6">
			@agentModelWarningBox(sev, msg)
		</div>
	}
}

// agentModelSettingsWarning alerts in the settings Model section when the
// agent's model can't be served (see agentModelNotice for the rules).
templ agentModelSettingsWarning(data agentSettingsData) {
	if sev, msg := agentModelSettingsIssue(data.Agent, data.DefaultModel, data.ModelConfigKnown, data.HasProviders, data.ProviderNames); sev != "" {
		@agentModelWarningBox(sev, msg)
	}
}

// agentModelWarningBox is the shared warning visual: a severity alert with a
// link to the providers settings (where providers and the default model are
// configured) on the same row, stretching to match the alert's height.
templ agentModelWarningBox(sev, message string) {
	<div class="flex items-stretch gap-2">
		<div class="min-w-0 flex-1">
			@ui.Alert(ui.AlertProps{
				Type:    modelWarningAlertType(sev),
				Style:   ui.AlertStyleOutline,
				Icon:    "lucide--alert-triangle",
				Message: message,
			})
		</div>
		@ui.Button(ui.ButtonProps{
			Type:       ui.ButtonTypeLink,
			Href:       "/settings/providers",
			Variant:    ui.ButtonOutline,
			Size:       ui.ButtonXS,
			Icon:       "lucide--server",
			ExtraClass: "h-auto",
		}) {
			if sev == "error" {
				Configure a provider
			} else {
				Set a default model
			}
		}
	</div>
}

templ agentSummaryField(label string) {
	<div>
		@ui.Eyebrow(label, ui.EyebrowProps{Size: "text-[11px]"})
		<div class="mt-1.5">{ children... }
</div>
	</div>
}

templ agentToolsSection(data agentDashboardData) {
	@ui.Section("Configured tools", ui.SectionProps{
		Margin:    "mt-6",
		BodyClass: "p-5",
		Empty:     len(data.Agent.Tools) == 0 && len(data.Agent.BannedTools) == 0,
		EmptyIcon: "lucide--wrench", EmptyTitle: "No tools configured", EmptyDesc: "This agent has no tool overrides — it uses the platform defaults.",
	}) {
		<div class="flex flex-col gap-4">
			<div>
				@ui.Eyebrow("Allowed tools", ui.EyebrowProps{Size: "text-[11px]", Margin: "mb-2"})
				if len(data.Agent.Tools) == 0 {
					<p class="text-base-content/40 text-sm italic">None</p>
				} else {
					<div class="flex flex-wrap gap-1.5">
						for _, t := range data.Agent.Tools {
							@ui.Badge(ui.BadgeProps{
								Label:   t,
								Variant: ui.BadgeInfo,
								Style:   ui.BadgeStyleSoft,
								Size:    ui.BadgeSizeXS,
								Icon:    "lucide--wrench",
							})
						}
					</div>
				}
			</div>
			if len(data.Agent.BannedTools) > 0 {
				<div>
					@ui.Eyebrow("Banned tools", ui.EyebrowProps{Size: "text-[11px]", Margin: "mb-2"})
					<div class="flex flex-wrap gap-1.5">
						for _, t := range data.Agent.BannedTools {
							@ui.Badge(ui.BadgeProps{
								Label:   t,
								Variant: ui.BadgeError,
								Style:   ui.BadgeStyleSoft,
								Size:    ui.BadgeSizeXS,
								Icon:    "lucide--ban",
							})
						}
					</div>
				</div>
			}
		</div>
	}
}

// agentChatsList renders the shared conversations list: a titled Section with
// an error alert on ChatsErr, otherwise a cardList of chatLinkRow. Shared by
// the dashboard's "Recent chats" section and the dedicated Sessions page.
templ agentChatsList(chatsErr error, chats []Conversation, title, margin, emptyTitle string) {
	@ui.Section(title, ui.SectionProps{
		Margin:    margin,
		Empty:     chatsErr == nil && len(chats) == 0,
		EmptyIcon: "lucide--messages-square", EmptyTitle: emptyTitle, EmptyDesc: "Start a conversation with this agent and it will show up here.",
		Raw: true,
	}) {
		if chatsErr != nil {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertError,
				Style:   ui.AlertStyleOutline,
				Icon:    "lucide--alert-triangle",
				Message: "Failed to load conversations: " + chatsErr.Error(),
			})
		} else {
			@cardList("", cardListProps{}) {
				for _, c := range chats {
					@chatLinkRow(c)
				}
			}
		}
	}
}

templ agentChatsSection(data agentDashboardData) {
	@agentChatsList(data.ChatsErr, data.Chats, "Recent chats", "mt-6", "No chats yet")
}

templ chatLinkRow(c Conversation) {
	@components.ListRow(templ.URL("/chat?c="+url.QueryEscape(c.ID)), ui.IconSpan("lucide--messages-square", "size-4 shrink-0 text-base-content/40"), chatTitle(c), relTime(c.UpdatedAt))
}

// --- Agent settings ---

// AgentSettingsPage renders one agent-settings subpage: header, sub-nav, and a
// single section panel selected by data.Section. A failed agent fetch (LoadErr)
// renders the whole-page error state; FlashMsg/FlashErr surface PRG feedback
// from the update flow.
templ AgentSettingsPage(data agentSettingsData) {
	@layout.Container(layout.ContainerLG, nil) {
		if data.LoadErr != nil {
			@pageError("Agent unavailable", data.LoadErr)
		} else {
			@agentDashboardHeader(data.Agent, "Settings")
			@flashToasts(data.FlashMsg, data.FlashErr)
			@layout.Rail(agentSubNav(data.Agent.ID, "settings", data.Section), nil) {
				@agentSettingsSectionPanel(data)
			}
		}
	}
}

// agentSettingsSectionPanel renders exactly one settings subpage's panel based
// on data.Section ("" defaults to the General landing page).
templ agentSettingsSectionPanel(data agentSettingsData) {
	switch data.Section {
	case "model":
		@agentModelSettingsForm(data)
	case "tools":
		@agentToolsSettingsForm(data)
	case "skills":
		@agentSkillsSettingsForm(data)
	case "delegation":
		@agentDelegationSettingsForm(data)
	case "mcp":
		@agentMCPSection(data)
	default:
		@agentGeneralSettingsForm(data)
	}
}

// agentSettingsSave is the shared PRG form footer: a primary submit button in
// the same FormActions wrapper every settings subpage uses.
templ agentSettingsSave() {
	<div class="mt-6">
		@form.FormActions("", "") {
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeSubmit,
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonSM,
				Icon:    "lucide--save",
			}) {
				Save changes
			}
		}
	</div>
}

// agentGeneralSettingsForm is the General subpage (PRG → POST
// /agents/:id/settings/general): name, system prompt, language, and visibility.
templ agentGeneralSettingsForm(data agentSettingsData) {
	<form class="flex flex-col" method="post" action={ templ.URL("/agents/" + url.PathEscape(data.Agent.ID) + "/settings/general") }>
		@ui.Section("General", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="flex flex-col gap-4">
				@form.FormControl("agent-settings-name", "Name", form.LabelAbove, "", "", nil) {
					<input id="agent-settings-name" name="name" type="text" required value={ data.Agent.Name } placeholder="e.g. Support Butler" class="input w-full"/>
				}
				@form.FormControl("agent-settings-prompt", "System prompt", form.LabelAbove, "Sets tone, constraints, and how the agent uses memory.", "", nil) {
					<textarea id="agent-settings-prompt" name="systemPrompt" rows="5" placeholder="You are Memory, the household agent. You answer concisely, with wit and precision…" class="textarea w-full resize-none">{ data.Agent.SystemPrompt }</textarea>
				}
				@form.FormControl("agent-settings-language", "Language", form.LabelAbove, "Voice language — drives speech-to-text and text-to-speech. Leave empty for auto-detection.", "", nil) {
					<select id="agent-settings-language" name="language" class="select w-full">
						<option value="">Auto — detect language</option>
						for _, l := range agentLanguages {
							<option value={ l.Code } selected?={ agentLanguageCode(agentLanguageValue(data.Agent)) == l.Code }>{ l.Label }</option>
						}
					</select>
				}
			</div>
		}
		@ui.Section("Appearance", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
				<div class="flex min-w-0 flex-col [&>fieldset]:min-w-0 [&>fieldset]:grow [&_.label-text-alt]:whitespace-normal">
					@form.FormControl("agent-settings-icon", "Icon", form.LabelAbove, "Pick a supported Lucide icon. The default falls back to the bot.", "", nil) {
						@ui.IconPicker(ui.IconPickerProps{
							ID:           "agent-settings-icon",
							Name:         "icon",
							Value:        agentIcon(data.Agent.UIConfig),
							Options:      supportedIconPickerOptions(),
							DefaultValue: "",
							DefaultLabel: "Default icon",
							DefaultClass: "lucide--bot",
						})
					}
				</div>
				<div class="flex min-w-0 flex-col [&>fieldset]:min-w-0 [&>fieldset]:grow [&_.label-text-alt]:whitespace-normal">
					@form.FormControl("agent-settings-color", "Color", form.LabelAbove, "Any CSS color; tints the agent tile and chip (e.g. #4F46E5).", "", nil) {
						@ui.ColorPicker(ui.ColorPickerProps{
							ID:         "agent-settings-color",
							Name:       "color",
							Value:      agentColor(data.Agent.UIConfig),
							AllowEmpty: true,
							Presets:    schemaColorPresets,
						})
					}
				</div>
			</div>
		}
		@ui.Section("Visibility", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="flex flex-col gap-4">
				<p class="text-base-content/70 text-sm">Controls who can discover this agent. Changes take effect after you save.</p>
				@form.FormControl("agent-settings-visibility", "Visibility", form.LabelAbove, agentVisibilityDescription(agentVisibilityValue(data.Agent)), "", nil) {
					<select id="agent-settings-visibility" name="visibility" class="select w-full">
						for _, opt := range agentVisibilityOptions {
							<option value={ opt.Value } selected?={ agentVisibilityValue(data.Agent) == opt.Value }>{ opt.Label } — { opt.Description }</option>
						}
					</select>
				}
				if agentVisibilityValue(data.Agent) == agentVisibilityExternal {
					@ui.Alert(ui.AlertProps{
						Type:    ui.AlertWarning,
						Style:   ui.AlertStyleSoft,
						Icon:    "lucide--shield-alert",
						Message: agentVisibilityExternalWarning,
					})
				} else if agentVisibilityValue(data.Agent) == agentVisibilityInternal {
					@ui.Alert(ui.AlertProps{
						Type:    ui.AlertInfo,
						Style:   ui.AlertStyleSoft,
						Icon:    "lucide--info",
						Message: agentVisibilityInternalNote,
					})
				}
			</div>
		}
		@agentSettingsSave()
	</form>
}

// agentModelSettingsForm is the Model subpage (PRG → POST
// /agents/:id/settings/model): the model picker, temperature, max tokens, and
// the model-misconfiguration warning box.
templ agentModelSettingsForm(data agentSettingsData) {
	<form class="flex flex-col" method="post" action={ templ.URL("/agents/" + url.PathEscape(data.Agent.ID) + "/settings/model") }>
		@ui.Section("Model", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="flex flex-col gap-4">
				@agentModelSettingsWarning(data)
				@modelSelect("agent-settings-model", data.Models, data.Agent.Model, agentAutoModelName(data.Agent, data.DefaultModel), nil)
				@modelParamsGrid("agent-settings", data.Agent.Model)
			</div>
		}
		@agentSettingsSave()
	</form>
}

// agentToolsSettingsForm is the Tools subpage (PRG → POST
// /agents/:id/settings/tools): the default-approval select and the grouped tool
// checkbox picker.
templ agentToolsSettingsForm(data agentSettingsData) {
	<form class="flex flex-col" method="post" action={ templ.URL("/agents/" + url.PathEscape(data.Agent.ID) + "/settings/tools") }>
		@ui.Section("Tools", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
				<span class="text-sm font-medium">Default approval</span>
				<select name="defaultToolPolicy" class="select select-sm w-40">
					<option value="allow" if data.Agent.DefaultToolPolicy == "allow" { selected }>Allow</option>
					<option value="ask" if data.Agent.DefaultToolPolicy == "ask" { selected }>Ask</option>
					<option value="deny" if data.Agent.DefaultToolPolicy == "deny" { selected }>Deny</option>
				</select>
			</div>
			@agentToolPicker(data)
		}
		@agentSettingsSave()
	</form>
}

// agentSkillsSettingsForm is the Skills subpage (PRG → POST
// /agents/:id/settings/skills): the skill checkbox picker.
templ agentSkillsSettingsForm(data agentSettingsData) {
	<form class="flex flex-col" method="post" action={ templ.URL("/agents/" + url.PathEscape(data.Agent.ID) + "/settings/skills") }>
		@ui.Section("Skills", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			@form.FormControl("agent-settings-skills", "", form.LabelAbove, "Reusable capabilities this agent can call.", "", nil) {
				@checkboxPicker(checkboxPickerProps{
					Name:          "skill",
					EmptyNote:     skillEmptyNote(),
					LabelClass:    "items-start gap-2 py-1.5",
					CheckboxClass: "checkbox checkbox-sm mt-0.5",
					TitleClass:    "block text-sm font-medium",
					DescClass:     "text-base-content/50 block text-xs",
					WrapTitle:     true,
					Items:         skillPickerItems(data.Skills, func(name string) bool { return containsString(data.Agent.Skills, name) }),
				})
			}
		}
		@agentSettingsSave()
	</form>
}

// agentDelegationSettingsForm is the Delegation subpage (PRG → POST
// /agents/:id/settings/delegation): the enable toggle and the delegation-target
// agent picker.
templ agentDelegationSettingsForm(data agentSettingsData) {
	<form class="flex flex-col" method="post" action={ templ.URL("/agents/" + url.PathEscape(data.Agent.ID) + "/settings/delegation") }>
		@ui.Section("Delegation", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			@form.FormControl("agent-settings-delegation", "", form.LabelAbove, "If on, this agent can hand off to the agents you select.", "", nil) {
				<label class="label flex w-full justify-between gap-3">
					<span class="text-sm font-medium">Can delegate to other agents</span>
					<input
						id="agent-settings-delegation-enabled"
						name="delegationEnabled"
						type="checkbox"
						if data.Agent.Delegation != nil && data.Agent.Delegation.Enabled {
							checked
						}
						class="checkbox"
					/>
				</label>
				@checkboxPicker(checkboxPickerProps{
					Name:          "delegation-target",
					Wrapped:       true,
					EmptyNote:     delegateEmptyNote(),
					LabelClass:    "gap-2 py-1",
					CheckboxClass: "checkbox",
					TitleClass:    "text-base-content/80 text-sm",
					Items:         delegatePickerItems(data.Agents, data.Agent.Name, func(name string) bool { return data.Agent.Delegation != nil && containsString(data.Agent.Delegation.Targets, name) }),
				})
			}
		}
		@agentSettingsSave()
	</form>
}

// --- Agent sandbox ---

// AgentSandboxPage renders the per-agent sandbox (workspace) config page:
// header, sub-nav, and a form mirroring the AgentSettingsPage layout. A failed
// agent/config fetch (LoadErr) renders the whole-page error state;
// FlashMsg/FlashErr surface PRG feedback from the update flow.
templ AgentSandboxPage(data agentSandboxData) {
	@layout.Container(layout.ContainerLG, nil) {
		if data.LoadErr != nil {
			@pageError("Agent unavailable", data.LoadErr)
		} else {
			@agentDashboardHeader(data.Agent, "Sandbox")
			@flashToasts(data.FlashMsg, data.FlashErr)
			@layout.Rail(agentSubNav(data.Agent.ID, "sandbox", ""), nil) {
				@agentSandboxForm(data)
			}
		}
	}
}

// sandboxProviderAvailability renders the compact per-provider availability
// list under the provider select: a colour-coded badge plus the reason for
// unavailable providers. When the provider list is empty (fetch failed or
// sandboxes disabled) it shows an inline warning instead of implying anything
// is available.
templ sandboxProviderAvailability(data agentSandboxData) {
	<div id="agent-sandbox-provider-status" class="flex flex-col gap-2">
		if len(data.Providers) == 0 {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertWarning,
				Style:   ui.AlertStyleSoft,
				Icon:    "lucide--alert-triangle",
				Message: sandboxProviderWarning(data),
			})
		} else {
			<ul class="flex flex-col gap-1.5">
				for _, p := range data.Providers {
					<li class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs">
						<span class="text-base-content/70 font-medium">{ sandboxProviderDisplayName(p) }</span>
						if p.Healthy {
							@components.StatusBadge("available", ui.BadgeSuccess, "", components.StatusBadgeOpts{Size: ui.BadgeSizeXS, Dot: true})
						} else {
							@components.StatusBadge("unavailable", ui.BadgeError, "", components.StatusBadgeOpts{Size: ui.BadgeSizeXS, Dot: true})
							if p.Message != "" {
								<span class="text-base-content/60">{ p.Message }</span>
							}
						}
					</li>
				}
			</ul>
		}
	</div>
}

// agentSandboxForm is the sandbox edit form (PRG → POST
// /agents/:id/sandbox/update). Empty tools means "all allowed"; repo_source
// url is only honored for a fixed source.
templ agentSandboxForm(data agentSandboxData) {
	<form class="flex flex-col" method="post" action={ templ.URL("/agents/" + url.PathEscape(data.Agent.ID) + "/sandbox/update") }>
		@ui.Section("Provider", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="flex flex-col gap-4">
				@form.FormControl("agent-sandbox-enabled", "", form.LabelAbove, "Enable a sandboxed workspace for this agent.", "", nil) {
					<label class="label flex w-full justify-between gap-3">
						<span class="text-sm font-medium">Enable sandbox</span>
						<input id="agent-sandbox-enabled" name="enabled" type="checkbox" checked?={ sandboxConfigEnabled(data.Config) } class="checkbox"/>
					</label>
				}
				@form.FormControl("agent-sandbox-provider", "Provider", form.LabelAbove, "Sandbox runtime. Auto picks a healthy provider.", "", nil) {
					<select id="agent-sandbox-provider" name="provider" class="select w-full" aria-describedby="agent-sandbox-provider-status">
						<option value="" selected?={ sandboxConfigProvider(data.Config) == "" }>Auto</option>
						for _, p := range data.Providers {
							// A disabled option is omitted from the submitted form data, so
							// disabling the SELECTED option would drop a stored-but-unavailable
							// provider and silently persist Auto. Keep the stored provider's
							// option selectable (still labelled unavailable); every other
							// unavailable provider stays disabled.
							<option value={ p.Type } selected?={ sandboxConfigProvider(data.Config) == p.Type } disabled?={ !p.Healthy && sandboxConfigProvider(data.Config) != p.Type } title={ p.Message }>{ sandboxProviderOptionLabel(p) }</option>
						}
						if saved := sandboxConfigProvider(data.Config); saved != "" && !sandboxProviderListed(data.Providers, saved) {
							<option value={ saved } selected title="The server no longer reports this provider.">{ sandboxSavedProviderLabel(saved) }</option>
						}
					</select>
				}
				@sandboxProviderAvailability(data)
				@form.FormControl("agent-sandbox-base-image", "Base image", form.LabelAbove, "Container image for the workspace.", "", nil) {
					<input id="agent-sandbox-base-image" name="baseImage" type="text" value={ sandboxBaseImage(data.Config) } placeholder="memory-workspace:latest" class="input w-full" list="sandbox-base-images"/>
					<datalist id="sandbox-base-images">
						for _, img := range data.Images {
							<option value={ img.Name }></option>
						}
					</datalist>
				}
			</div>
		}
		@ui.Section("Repository", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="flex flex-col gap-4">
				@form.FormControl("agent-sandbox-repo-type", "Source", form.LabelAbove, "", "", nil) {
					<select id="agent-sandbox-repo-type" name="repoSourceType" class="select w-full">
						<option value="none" selected?={ sandboxRepoSourceType(data.Config) == "none" }>No checkout (empty workspace)</option>
						<option value="fixed" selected?={ sandboxRepoSourceType(data.Config) == "fixed" }>Fixed repository</option>
						<option value="task_context" selected?={ sandboxRepoSourceType(data.Config) == "task_context" }>From task context</option>
					</select>
				}
				@form.FormControl("agent-sandbox-repo-url", "Repository URL", form.LabelAbove, "Used when source is Fixed.", "", nil) {
					<input id="agent-sandbox-repo-url" name="repoSourceUrl" type="text" value={ sandboxRepoSourceURL(data.Config) } placeholder="https://github.com/org/repo" class="input w-full"/>
				}
				@form.FormControl("agent-sandbox-repo-branch", "Branch", form.LabelAbove, "Default branch; overridden by task context.", "", nil) {
					<input id="agent-sandbox-repo-branch" name="repoSourceBranch" type="text" value={ sandboxRepoSourceBranch(data.Config) } placeholder="main" class="input w-full"/>
				}
			</div>
		}
		@ui.Section("Tools", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="flex flex-col gap-2.5">
				for _, tool := range sandboxToolNames {
					<label class="flex cursor-pointer items-center gap-2.5">
						<input type="checkbox" name="sandboxTool" value={ tool } checked?={ sandboxToolEnabled(data.Config, tool) } class="checkbox"/>
						<span class="font-mono text-[13px]">{ tool }</span>
					</label>
				}
				<p class="text-base-content/50 mt-2 text-xs">If none selected, all tools are allowed.</p>
			</div>
		}
		@ui.Section("Resources", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
				@form.FormControl("agent-sandbox-cpu", "CPU", form.LabelAbove, "", "", nil) {
					<input id="agent-sandbox-cpu" name="cpu" type="text" value={ sandboxResourceValue(data.Config, "cpu") } placeholder="2" class="input w-full"/>
				}
				@form.FormControl("agent-sandbox-memory", "Memory", form.LabelAbove, "", "", nil) {
					<input id="agent-sandbox-memory" name="memory" type="text" value={ sandboxResourceValue(data.Config, "memory") } placeholder="4G" class="input w-full"/>
				}
				@form.FormControl("agent-sandbox-disk", "Disk", form.LabelAbove, "", "", nil) {
					<input id="agent-sandbox-disk" name="disk" type="text" value={ sandboxResourceValue(data.Config, "disk") } placeholder="10G" class="input w-full"/>
				}
			</div>
		}
		@ui.Section("Setup & environment", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "p-5",
		}) {
			<div class="flex flex-col gap-4">
				@form.FormControl("agent-sandbox-setup", "Setup commands", form.LabelAbove, "Run on workspace start, one per line.", "", nil) {
					<textarea id="agent-sandbox-setup" name="setupCommands" rows="4" placeholder="pip install -r requirements.txt" class="textarea w-full resize-none">{ sandboxSetupCommands(data.Config) }</textarea>
				}
				@form.FormControl("agent-sandbox-env", "Environment variables", form.LabelAbove, "KEY=VALUE, one per line.", "", nil) {
					<textarea id="agent-sandbox-env" name="envVars" rows="4" placeholder="FOO=bar" class="textarea w-full resize-none">{ sandboxEnvVars(data.Config) }</textarea>
				}
			</div>
		}
		<div class="mt-6">
			@form.FormActions("", "") {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--save",
				}) {
					Save changes
				}
			}
		</div>
	</form>
}

// agentToolPicker is the tools panel body, grouped by source first. When the
// agent definition carries a server-computed tool taxonomy it renders a
// top-level "Built-in" section (memory's native tools as capability groups with
// enable switches + tri-state policies, their members as direct rows) followed
// by one top-level sibling block per external MCP server and per relay node.
// When memory reports no groups (older server) it falls back to the previous
// source-only grouping unchanged. Either way, tools that nothing covers stay
// reachable so saving the panel never drops them.
templ agentToolPicker(data agentSettingsData) {
	{{ view := buildToolPickerView(data)
	relayGroups := relayPickerGroups(data.RelayNodes)
	unlisted := unlistedTools(data.Agent, data.MCPServers, data.RelayNodes) }}
	if len(view.BuiltinGroups) > 0 {
		<div class="flex flex-col gap-3" data-testid="tool-groups">
			@agentToolBuiltinSection(view.BuiltinGroups)
			for _, src := range view.Servers {
				@agentToolGroup(src)
			}
			for _, node := range view.Relays {
				@agentToolGroup(node)
			}
			if len(view.Other) > 0 {
				@agentToolUncoveredGroup(view.Other)
			}
		</div>
	} else if len(data.MCPServers) == 0 && len(relayGroups) == 0 && len(unlisted) == 0 {
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--wrench",
			Title:       "No tools available",
			Description: "Register an MCP server, or connect an external MCP node, to give this agent tools to call.",
			ActionHref:  "/settings/mcp-servers",
			ActionLabel: "Register an MCP server",
			ActionIcon:  "lucide--plus",
		})
	} else {
		<div class="flex flex-col gap-3">
			for _, srv := range data.MCPServers {
				@agentToolServerGroup(srv, data.Agent)
			}
			for _, node := range relayGroups {
				@agentToolRelayGroup(node, data.Agent)
			}
			if len(unlisted) > 0 {
				@agentToolOtherGroup(unlisted, data.Agent)
			}
		</div>
	}
}

// agentToolCountBadge renders the ghost XS "N tool(s)" wrench badge shown in a
// tool-group header (capability groups and source sub-groups alike).
templ agentToolCountBadge(n int) {
	@ui.Badge(ui.BadgeProps{
		Label:   countLabel(n, "tool", "tools"),
		Variant: ui.BadgeGhost,
		Size:    ui.BadgeSizeXS,
		Icon:    "lucide--wrench",
	})
}

// agentToolBuiltinSection is the top-level "Built-in" container: memory's
// native tools organised into capability groups whose members render as direct
// rows. It is the sibling of the external MCP-server and relay-node source
// blocks and uses a lighter container tone so it reads as the built-in origin.
// The named `group/builtin` keeps its chevron independent of the nested
// capability-group chevrons.
templ agentToolBuiltinSection(groups []toolGroupView) {
	@ui.Disclosure(ui.DisclosureProps{
		GroupClass:   "group/builtin",
		ItemsStart:   true,
		DetailsBase:  "rounded-box border border-base-content/10 bg-base-100/60",
		BodyBase:     "flex flex-col gap-2 border-t border-base-content/10 p-3",
		Open:         true,
		Attrs:        templ.Attributes{"data-testid": "tool-source-builtin"},
		SummaryAttrs: templ.Attributes{"data-testid": "tool-source-header-builtin"},
	}, agentToolBuiltinLeading(), agentToolCountBadge(builtinToolCount(groups))) {
		for _, gv := range groups {
			@agentToolCapabilityGroup(gv)
		}
	}
}

// agentToolBuiltinLeading is the Built-in section's summary leading block: the
// package icon, the plain "Built-in" label, and a one-line explanation.
templ agentToolBuiltinLeading() {
	<div class="flex min-w-0 flex-col gap-0.5">
		<div class="flex min-w-0 items-center gap-2.5">
			@ui.IconSpan("lucide--package", "size-4 shrink-0 text-primary/70")
			<span class="truncate text-sm font-semibold">Built-in</span>
		</div>
		<p class="text-base-content/50 truncate pl-[26px] text-xs">Tools that ship with Memory.</p>
	</div>
}

// agentToolCapabilityGroup renders one capability group inside the Built-in
// section: a collapsible header (label, description, member count) carrying the
// group enable switch (groupEnabled.<id>) and policy select (groupPolicy.<id>),
// and a body of the group's native member tools as direct rows. The nested
// per-source sub-group is gone — external sources render as their own top-level
// blocks. The header uses a named `group/cap` so nested details don't rotate
// each other's chevrons.
templ agentToolCapabilityGroup(gv toolGroupView) {
	@ui.Disclosure(ui.DisclosureProps{
		GroupClass:   "group/cap",
		ItemsStart:   true,
		DetailsBase:  "rounded-box border border-base-content/10",
		Attrs:        templ.Attributes{"data-testid": "tool-group", "data-tool-group": gv.Group.ID},
		SummaryAttrs: templ.Attributes{"data-testid": "tool-group-header-" + gv.Group.ID},
		Open:         gv.Open,
	}, agentToolCapabilityLeading(gv), agentToolCapabilityControls(gv)) {
		<div class="flex flex-col divide-y divide-base-content/10 overflow-hidden rounded-box border border-base-content/10">
			for _, t := range gv.Rows {
				@agentToolRowView(t, true)
			}
		</div>
	}
}

// agentToolCapabilityLeading is the capability-group summary's leading block:
// the layers icon, label, member-count badge, and optional description.
templ agentToolCapabilityLeading(gv toolGroupView) {
	<div class="flex min-w-0 flex-col gap-0.5">
		<div class="flex min-w-0 items-center gap-2.5">
			@ui.IconSpan("lucide--layers", "size-4 shrink-0 text-base-content/40")
			<span class="truncate text-sm font-medium">{ gv.Group.Label }</span>
			@agentToolCountBadge(gv.Count)
		</div>
		if gv.Group.Description != "" {
			<p class="text-base-content/50 truncate pl-[26px] text-xs">{ gv.Group.Description }</p>
		}
	</div>
}

// agentToolCapabilityControls is the capability-group summary's trailing
// controls: the group enable switch (groupEnabled.<id> with its
// groupWasEnabled.<id> baseline) and, for every group except the display-only
// "other" group, the group policy select.
templ agentToolCapabilityControls(gv toolGroupView) {
	<div class="flex shrink-0 items-center gap-2" onclick="event.stopPropagation()">
		<input
			type="hidden"
			name={ "groupWasEnabled." + gv.Group.ID }
			value={ groupWasEnabledValue(gv.Enabled) }
		/>
		<label class="flex cursor-pointer items-center gap-1.5" title="Turn every tool in this group on or off">
			@form.ToggleInput(form.ToggleInputProps{
				Name:    "groupEnabled." + gv.Group.ID,
				Value:   "on",
				Checked: gv.Enabled,
				Class:   "toggle toggle-sm",
				Attrs: templ.Attributes{
					"aria-label":  "Enable " + gv.Group.Label + " tools",
					"data-testid": "tool-group-enabled-" + gv.Group.ID,
					"onchange":    "this.closest('[data-tool-group]').querySelectorAll('input[name=tool]').forEach(function(cb){cb.checked=this.checked;cb.dispatchEvent(new Event('change'))},this)",
				},
			})
		</label>
		if gv.Group.ID != toolGroupOtherID {
			<select
				name={ "groupPolicy." + gv.Group.ID }
				class="select select-xs w-24"
				aria-label={ gv.Group.Label + " approval policy" }
				data-testid={ "tool-group-policy-" + gv.Group.ID }
			>
				@agentPolicyOptions(gv.Policy, "inherit")
			</select>
		}
	</div>
}

// agentToolOtherContainer renders the shared dashed "Other" fallback container:
// a dashed-border box with the "Other" eyebrow, a one-line explanation, and the
// tool rows as children. withTestID emits the data-testid="tool-group-other"
// marker (only the uncovered-group variant carries it, so tests can assert the
// grouped-picker fallback).
templ agentToolOtherContainer(desc string, withTestID bool) {
	<div
		class="rounded-box border border-dashed border-base-content/20 bg-base-200/40 p-3"
		if withTestID {
			data-testid="tool-group-other"
		}
	>
		@ui.Eyebrow("Other", ui.EyebrowProps{Size: "text-[11px]"})
		<p class="text-base-content/50 mt-0.5 mb-2 text-xs">{ desc }</p>
		<div class="flex flex-col divide-y divide-base-content/10">
			{ children... }
		</div>
	</div>
}

// agentToolUncoveredGroup lists tools the rendered capability groups do not
// cover — the agent's existing tools plus any catalog tool whose group is
// missing — so a taxonomy gap can never drop a tool on save. It is not a
// capability group: it carries no group enable switch or group policy, and each
// row keeps its own per-tool policy select.
templ agentToolUncoveredGroup(rows []agentToolRow) {
	@agentToolOtherContainer("Not offered by a source yet — kept so existing tools aren't dropped on save.", true) {
		for _, t := range rows {
			@agentToolRowView(t, true)
		}
	}
}

// agentToolGroupProps configures one collapsible tool group in the agent tools
// picker. The callers — external MCP-server source blocks and relay-node source
// blocks (plus the no-groups fallback) — share the <details> shell and tool-row
// shape; only the border tone, summary icon, remote badge, per-tool policy
// select, and optional TestID differ.
type agentToolGroupProps struct {
	BorderClass     string
	BodyBorderClass string
	Icon            string
	IconClass       string
	Title           string
	TitleMono       bool
	RemoteBadge     bool
	TestID          string
	Count           int
	Open            bool
	Tools           []agentToolRow
	WithPolicy      bool
}

// agentToolRow is one pre-resolved tool in a group: Name is the agent-facing
// tool name (submitted and displayed), Checked whether the agent whitelists it,
// PolicyValue its explicit per-tool policy ("" = none), Hint the full
// non-interactive inheritance note shown beside the policy select on wider
// screens, and HintShort its compact all-widths form.
type agentToolRow struct {
	Name        string
	Description string
	Checked     bool
	PolicyValue string
	Hint        string
	HintShort   string
}

// agentToolGroupLeading is the source-group summary's leading block: the group
// icon, title (mono for relay instances), and optional remote badge.
templ agentToolGroupLeading(p agentToolGroupProps) {
	<div class="flex min-w-0 items-center gap-2.5">
		@ui.IconSpan(p.Icon, "size-4 shrink-0 "+p.IconClass)
		if p.TitleMono {
			<span class="truncate font-mono text-sm font-semibold">{ p.Title }</span>
		} else {
			<span class="truncate text-sm font-semibold">{ p.Title }</span>
		}
		if p.RemoteBadge {
			@ui.Badge(ui.BadgeProps{
				Label:   "remote",
				Variant: ui.BadgeWarning,
				Style:   ui.BadgeStyleSoft,
				Size:    ui.BadgeSizeXS,
				Icon:    "lucide--radio",
			})
		}
	</div>
}

// agentToolGroup renders one collapsible <details> tool group: a summary
// (icon + title + optional remote badge + tool count) and a body listing each
// tool as a toggle row, with an optional per-tool policy select (registry
// servers only). TestID, when set, marks the top-level source block.
templ agentToolGroup(p agentToolGroupProps) {
	{{ attrs := templ.Attributes{}
	if p.TestID != "" {
		attrs["data-testid"] = p.TestID
	} }}
	@ui.Disclosure(ui.DisclosureProps{
		DetailsBase: "rounded-box border " + p.BorderClass,
		BodyBase:    "flex flex-col border-t " + p.BodyBorderClass,
		Open:        p.Open,
		Attrs:       attrs,
	}, agentToolGroupLeading(p), agentToolCountBadge(p.Count)) {
		for _, t := range p.Tools {
			@agentToolRowView(t, p.WithPolicy)
		}
	}
}

// agentToolRowView is one tool row shared by every group body: an enable toggle
// bound to the flat "tool" list, the tool name + description, an optional
// per-tool policy select, and the non-interactive inheritance hint ("" hides
// it). The toggle's onchange disables/dims the policy select while the tool is
// off.
//
// Two row variants exist. The default (`px-3` + hover background) suits rows
// inside a plain group body, where the surrounding container has no horizontal
// padding. The "Other" fallback container already supplies `p-3`, so its rows
// pass the legacy inset-free class (no `px-3`, no hover background) to keep the
// pre-refactor alignment with the "Other" eyebrow.
templ agentToolRowView(t agentToolRow, withPolicy bool, rowClass ...string) {
	{{ cls := "flex items-center gap-2.5 px-3 py-2 transition-colors hover:bg-base-200/50"
	if len(rowClass) > 0 {
		cls = rowClass[0]
	} }}
	{{ toolAttrs := templ.Attributes{}
	if withPolicy {
		toolAttrs["onchange"] = "var s=this.closest('[data-tool-row]').querySelector('[data-tool-policy]'); if (s) s.disabled = !this.checked;"
	} }}
	<div class={ cls } data-tool-row>
		<label class="flex min-w-0 flex-1 cursor-pointer items-center gap-2.5">
			@form.ToggleInput(form.ToggleInputProps{
				Name:    "tool",
				Value:   t.Name,
				Checked: t.Checked,
				Class:   "toggle toggle-sm shrink-0",
				Attrs:   toolAttrs,
			})
			<span class="min-w-0">
				<span class="block font-mono text-[13px] font-medium">{ t.Name }</span>
				if t.Description != "" {
					<span class="text-base-content/50 block truncate text-xs">{ t.Description }</span>
				}
			</span>
		</label>
		if withPolicy {
			@toolPolicySelectValue("toolPolicy."+t.Name, t.Name, t.PolicyValue, !t.Checked)
		}
		if t.Hint != "" {
			<span class="text-base-content/40 hidden w-44 shrink-0 truncate text-right text-[11px] md:block" title={ t.Hint }>{ t.Hint }</span>
		}
		if t.HintShort != "" {
			<span class="text-base-content/40 w-16 shrink-0 truncate text-right text-[11px] md:hidden" title={ t.Hint }>{ t.HintShort }</span>
		}
	</div>
}

// serverToolRows pre-resolves a registry server's tools into group rows.
func serverToolRows(srv MCPServer, agent *AgentDefinition) []agentToolRow {
	rows := make([]agentToolRow, 0, len(srv.Tools))
	for _, t := range srv.Tools {
		rows = append(rows, agentToolRow{
			Name:        t.ToolName,
			Description: t.Description,
			Checked:     containsString(agent.Tools, t.ToolName),
			PolicyValue: toolPolicyValue(agent, t.ToolName),
		})
	}
	return rows
}

// relayToolRows pre-resolves a relay node's tools into group rows, using each
// tool's agent-facing <instance>_<tool> name.
func relayToolRows(node relayNode, agent *AgentDefinition) []agentToolRow {
	rows := make([]agentToolRow, 0, len(node.Tools))
	for _, t := range node.Tools {
		name := relayAgentToolName(node.Session.InstanceID, t.Name)
		rows = append(rows, agentToolRow{
			Name:        name,
			Description: t.Description,
			Checked:     containsString(agent.Tools, name),
			PolicyValue: toolPolicyValue(agent, name),
		})
	}
	return rows
}

// agentToolServerGroup builds a group for one registry MCP server: a per-tool
// policy select, neutral border tone, no remote badge. It opens by default when
// the agent already uses a tool from that server, so active picks stay visible
// without dumping every tool (e.g. "builtin" has ~124).
templ agentToolServerGroup(srv MCPServer, agent *AgentDefinition) {
	@agentToolGroup(agentToolGroupProps{
		BorderClass:     "border-base-content/10 bg-base-200/40",
		BodyBorderClass: "border-base-content/10",
		Icon:            "lucide--server",
		IconClass:       "text-base-content/40",
		Title:           srv.Name,
		Count:           srv.ToolCount,
		Open:            mcpServerInUse(srv, agent),
		Tools:           serverToolRows(srv, agent),
		WithPolicy:      true,
	})
}

// agentToolRelayGroup builds a group for one connected external MCP relay node:
// allow-only (no per-tool policy select), a remote badge, and a primary border
// tone to distinguish it from registry server groups.
templ agentToolRelayGroup(node relayNode, agent *AgentDefinition) {
	@agentToolGroup(agentToolGroupProps{
		BorderClass:     "border-primary/25 bg-primary/[0.04]",
		BodyBorderClass: "border-primary/15",
		Icon:            "lucide--radio",
		IconClass:       "text-primary/60",
		Title:           node.Session.InstanceID,
		TitleMono:       true,
		RemoteBadge:     true,
		Count:           len(node.Tools),
		Open:            relayNodeInUse(node, agent),
		Tools:           relayToolRows(node, agent),
	})
}

// agentToolOtherGroup lists the agent's current tools that no registered MCP
// server offers (e.g. the bridge's Home Assistant tools). Always checked —
// they're preserved so the picker never drops them on save.
templ agentToolOtherGroup(tools []string, agent *AgentDefinition) {
	@agentToolOtherContainer("Not from a registered MCP server — kept so existing tools aren't dropped on save.", false) {
		for _, t := range tools {
			@agentToolRowView(agentToolRow{Name: t, Checked: true, PolicyValue: toolPolicyValue(agent, t)}, true, "flex items-center gap-2.5 py-2")
		}
	}
}

// agentPolicyOptions renders the shared Inherit / Allow / Ask / Deny option set
// for a policy <select>. inheritValue is the Inherit option's submitted value —
// "inherit" for the group select (its value space spells the absent policy) and
// "" for the per-tool select ("" = no override) — and value selects the current
// option.
templ agentPolicyOptions(value, inheritValue string) {
	<option value={ inheritValue } if value == inheritValue { selected }>Inherit</option>
	<option value="allow" if value == "allow" { selected }>Allow</option>
	<option value="ask" if value == "ask" { selected }>Ask</option>
	<option value="deny" if value == "deny" { selected }>Deny</option>
}

// toolPolicySelectValue is the value-driven form of the per-tool policy
// dropdown: name is the form field, key the tool name carried in
// data-tool-policy for the row's onchange lookup, and value the stored policy
// ("" = Inherit). A group-policy row reuses it with the group's stored value.
templ toolPolicySelectValue(name, key, value string, disabled bool) {
	<select
		name={ name }
		class="select select-xs w-32 shrink-0"
		if disabled {
			disabled
		}
		data-tool-policy={ key }
	>
		@agentPolicyOptions(value, "")
	</select>
}

// --- Agent sessions ---

// AgentSessionsPage renders the full conversation list for one agent. A
// failed agent fetch (LoadErr) renders the whole-page error state; a
// conversations failure (ChatsErr) degrades only the list section.
templ AgentSessionsPage(data agentSessionsData) {
	@layout.Container(layout.ContainerLG, nil) {
		if data.LoadErr != nil {
			@pageError("Agent unavailable", data.LoadErr)
		} else {
			@agentDashboardHeader(data.Agent, "Sessions")
			@layout.Rail(agentSubNav(data.Agent.ID, "sessions", ""), nil) {
				@agentChatsList(data.ChatsErr, data.Chats, "Sessions", "", "No sessions yet")
			}
		}
	}
}

// --- Agent memories ---

// MemoriesPage renders the memory browser for one agent: a search form, a
// list of memories (content, category, confidence), or a detail view when
// selected is non-nil. Mirrors the iOS memory browser semantics: empty query
// lists all, a query searches.
templ MemoriesPage(id string, name string, query string, memories []Memory, selected *Memory, loadErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Agents", "/agents", name, "/agents/"+url.PathEscape(id), "Memories")), "", "Memories for "+name, "", detailHeaderOpts{Margin: "mb-6"}) {
			if loadErr == nil {
				@countBadgeLabel(countLabel(len(memories), "memory", "memories"), "lucide--brain")
			}
		}
		<form class="mb-6 w-full sm:max-w-md" method="get" action={ templ.URL("/agents/" + url.PathEscape(id) + "/memories") }>
			<label class="input input-bordered flex w-full items-center gap-2">
				@ui.IconSpan("lucide--search", "size-4 shrink-0 opacity-50")
				<input type="search" name="q" value={ query } placeholder="Search memories…" class="grow"/>
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonGhost, Size: ui.ButtonSM, AriaLabel: "Search"}) { Search }
			</label>
		</form>
		if loadErr != nil {
			@pageError("Failed to load memories", loadErr)
		} else if selected != nil {
			@memoryDetail(id, query, *selected)
		} else if len(memories) == 0 {
			@memoriesEmpty(query)
		} else {
			@memoriesList(id, query, memories)
		}
	}
}

templ memoriesList(id string, query string, memories []Memory) {
	@cardList("", cardListProps{}) {
		for _, m := range memories {
			@memoryRow(id, query, m)
		}
	}
}

templ memoryRow(id string, query string, m Memory) {
	<a
		class="flex flex-col gap-1.5 px-4 py-3 transition-colors hover:bg-base-200/50"
		href={ templ.URL(memoryDetailURL(id, query, m.ID)) }
	>
		<div class="flex flex-wrap items-center gap-2">
			if m.Category != "" {
				@ui.Badge(ui.BadgeProps{Label: m.Category, Variant: memoryCategoryIntent(m.Category), Size: ui.BadgeSizeXS})
			}
			if m.Score > 0 {
				@ui.Badge(ui.BadgeProps{
					Label:   matchLabel(m.Score),
					Variant: ui.BadgeInfo,
					Size:    ui.BadgeSizeXS,
					Icon:    "lucide--search",
				})
			} else if m.Confidence > 0 {
				@ui.Badge(ui.BadgeProps{
					Label:   confidenceLabel(m.Confidence),
					Variant: ui.BadgeGhost,
					Size:    ui.BadgeSizeXS,
					Icon:    "lucide--gauge",
				})
			}
		</div>
		<p class="line-clamp-2 text-sm text-base-content/80">{ m.Content }</p>
	</a>
}

templ memoryDetail(id string, query string, m Memory) {
	@components.PanelCard("", nil) {
		<div class="flex flex-wrap items-center gap-2">
			if m.Category != "" {
				@ui.Badge(ui.BadgeProps{Label: m.Category, Variant: memoryCategoryIntent(m.Category), Size: ui.BadgeSizeSM})
			}
			if m.Score > 0 {
				@ui.Badge(ui.BadgeProps{
					Label:   matchLabel(m.Score),
					Variant: ui.BadgeInfo,
					Size:    ui.BadgeSizeSM,
					Icon:    "lucide--search",
				})
			} else if m.Confidence > 0 {
				@ui.Badge(ui.BadgeProps{
					Label:   confidenceLabel(m.Confidence),
					Variant: ui.BadgeGhost,
					Size:    ui.BadgeSizeSM,
					Icon:    "lucide--gauge",
				})
			}
			<a class="ms-auto text-sm font-medium hover:text-primary" href={ templ.URL(memoryListURL(id, query)) }>Back to list</a>
		</div>
		<div class="bg-base-200/40 rounded-box mt-4 p-4">
			<p class="text-sm" style="white-space: pre-wrap">{ m.Content }</p>
		</div>
		<div class="mt-4 border-t border-base-200 pt-3">
			<span class="text-base-content/40 font-mono text-xs">{ m.ID }</span>
		</div>
	}
}

// memoriesEmpty is the Memories page's full-surface empty state (list
// replacement); py-12 keeps the panel present under the search form.
templ memoriesEmpty(query string) {
	if query != "" {
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--search",
			Title:       "No matching memories",
			Description: "Nothing stored matches your search.",
			Bordered:    true,
			Class:       "py-12",
		})
	} else {
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--brain",
			Title:       "No memories yet",
			Description: "Memories will show up here once the memory service stores something.",
			Bordered:    true,
			Class:       "py-12",
		})
	}
}
