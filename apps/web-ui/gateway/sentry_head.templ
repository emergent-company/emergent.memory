package main

// Sentry browser SDK wiring, shared by the three document heads (the app shell,
// the sign-in page, and the public share page). It is a separate component
// because the block used to be pasted into all three, and one copy drifting back
// to a parse-blocking <script> would silently put a ~280 kB third-party fetch on
// the critical path of that surface again.
//
// Why everything here is `defer`-ed: the SDK bundle is served from
// browser.sentry-cdn.com and is ~281 kB. Loaded synchronously it blocks HTML
// parsing, which also delays the parser reaching the stylesheet <link> further
// down the head — so first paint waited on a third-party DNS+TLS+RTT+download on
// every hard navigation (issue #209: 0.44–1.16 s measured). A deferred script
// downloads in parallel with parsing and runs before DOMContentLoaded, so the
// stylesheet is discovered immediately and `Sentry.init` still runs as early as
// it usefully can.
//
// Ordering is preserved by the inline bootstrap rather than by document order:
// deferred scripts execute *after* parsing and before DOMContentLoaded, so a
// DOMContentLoaded listener added here is guaranteed to run once the SDK has
// loaded — and degrades to a no-op when the CDN fails (matching the
// `window.Sentry &&` guards at the app.js/chat.js capture sites).

// sentryHeadOpts carries one document's Sentry configuration. Zero rates are
// valid (they disable the corresponding sampling); an empty DSN disables the
// whole block, leaving only the meta tags the client-side code reads.
type sentryHeadOpts struct {
	DSN                     string
	Environment             string
	TracesSampleRate        float64
	ReplaySessionSampleRate float64
	ReplayOnErrorSampleRate float64
}

// sentryHead emits the Sentry meta tags plus, when a DSN is configured, the
// deferred SDK and its init bootstrap.
templ sentryHead(opts sentryHeadOpts) {
	<meta name="sentry-dsn" content={ opts.DSN }/>
	<meta name="sentry-environment" content={ opts.Environment }/>
	<meta name="sentry-traces-sample-rate" content={ opts.TracesSampleRate }/>
	<meta name="sentry-replay-session-sample-rate" content={ opts.ReplaySessionSampleRate }/>
	<meta name="sentry-replay-on-error-sample-rate" content={ opts.ReplayOnErrorSampleRate }/>
	if opts.DSN != "" {
		<!-- defer: never let a third-party bundle block parsing or the
		     stylesheet discovery (issue #209). -->
		<script defer src="https://browser.sentry-cdn.com/10.73.0/bundle.tracing.replay.feedback.min.js" crossorigin="anonymous"></script>
		<script>
			// Deferred scripts run before DOMContentLoaded, so this fires after
			// the SDK above has executed; absent Sentry (CDN failure, blocked by
			// an extension) it stays a no-op instead of throwing.
			document.addEventListener('DOMContentLoaded', function () {
				if (!window.Sentry) return;
				var m = function (n) { var e = document.querySelector('meta[name="' + n + '"]'); return e ? e.content : ""; };
				Sentry.init({
					dsn: m("sentry-dsn"),
					environment: m("sentry-environment"),
					integrations: [
						Sentry.browserTracingIntegration(),
						Sentry.replayIntegration({ maskAllText: true, maskAllInputs: true, blockAllMedia: true })
					],
					tracesSampleRate: parseFloat(m("sentry-traces-sample-rate")),
					replaysSessionSampleRate: parseFloat(m("sentry-replay-session-sample-rate")),
					replaysOnErrorSampleRate: parseFloat(m("sentry-replay-on-error-sample-rate"))
				});
			}, { once: true });
		</script>
	}
}
