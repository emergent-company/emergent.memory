package components

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// SelectOption is one option of a grouped select.
type SelectOption struct {
	Value    string
	Label    string
	Selected bool
}

// SelectOptionGroup is a labelled group of options, rendered as an <optgroup>.
type SelectOptionGroup struct {
	Label   string
	Options []SelectOption
}

// SelectOptionGroups renders grouped options for a select control. Grouping is
// the caller's domain decision; this component only renders it.
templ SelectOptionGroups(groups []SelectOptionGroup) {
	for _, g := range groups {
		<optgroup label={ g.Label }>
			for _, o := range g.Options {
				<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
			}
		</optgroup>
	}
}

// SaveChangesButton renders the shared primary submit button every settings and
// mutation form footer uses: primary, small, save icon, "Save changes" label.
//
// In-flight state: while the enclosing form runs an htmx request the save icon
// is swapped for a spinner (the .htmx-request class htmx puts on the form/button
// drives the swap via CSS) and the button is truly disabled — the form owns
// `hx-disable="find button.memory-save-btn"`, since htmx v4 resolves hx-disable
// from the request's source element (the form), not the submit button.
//
// The surrounding FormActions/margin wrapper stays at each call site because it
// varies (gap-4 forms, cancel/create branches, raw footers with a cancel link),
// so only the button itself is a clean shared unit.
templ SaveChangesButton() {
	@ui.Button(ui.ButtonProps{
		Type:       ui.ButtonTypeSubmit,
		Variant:    ui.ButtonPrimary,
		Size:       ui.ButtonSM,
		ExtraClass: "memory-save-btn",
	}) {
		<span class="memory-save-btn__icon inline-flex" aria-hidden="true">
			@ui.IconSpan("lucide--save", "size-4")
		</span>
		<span class="memory-save-btn__spinner loading loading-spinner loading-xs" aria-hidden="true"></span>
		<span>Save changes</span>
	}
}

// ToggleField renders a settings row that pairs a toggle with a label and an
// optional explanatory tip. attrs carries the row's htmx wiring.
templ ToggleField(name, label, tip string, checked bool, attrs templ.Attributes) {
	<label class="cursor-pointer label justify-start gap-3">
		<input type="checkbox" id={ name } name={ name } class="toggle" checked?={ checked } { attrs... }/>
		<span class="label-text flex items-center gap-1.5">
			<span>{ label }</span>
			if tip != "" {
				@ui.InfoTip(tip)
			}
		</span>
	</label>
}
