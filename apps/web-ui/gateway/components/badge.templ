package components

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// StatusBadge renders a status badge from an explicit intent and icon. Domain
// status vocabularies stay in the calling package, which maps its own status
// values to an intent here.
templ StatusBadge(label string, intent ui.BadgeIntent, icon string) {
	@ui.Badge(ui.BadgeProps{
		Label:   label,
		Variant: intent,
		Size:    ui.BadgeSizeSM,
		Icon:    icon,
	})
}
