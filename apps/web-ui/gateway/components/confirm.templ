package components

import (
	"cmp"

	ui "github.com/emergent-company/go-daisy/components/ui"
)

// ConfirmIcon renders the destructive-confirm icon circle: the error-tinted
// rounded-field square holding an icon. It is the shared leading glyph for delete /
// revoke / remove confirmation dialogs. The icon defaults to the trash glyph;
// pass an override (for example "lucide--alert-triangle") for non-destructive
// error confirmations.
templ ConfirmIcon(icon string) {
	<div class="bg-error/10 text-error grid size-10 shrink-0 place-items-center rounded-full">
		@ui.IconSpan(cmp.Or(icon, "lucide--trash-2"), "size-5")
	</div>
}
