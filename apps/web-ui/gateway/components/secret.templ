package components

import (
	"github.com/emergent-company/go-daisy/components/form"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// SecretRevealProps configures a one-time secret reveal dialog.
type SecretRevealProps struct {
	// Heading is the reveal heading, e.g. "MCP share created".
	Heading string
	// Name is the secret owner's name. When set it prefixes the one-time notice.
	Name string
	// Noun is the noun used in the one-time notice. Empty defaults to "key".
	Noun string
	// SecretID is the element id holding the secret value; it is also the copy
	// target for the copy control.
	SecretID string
	// SecretTestID optionally adds a data-testid to the secret element.
	SecretTestID string
	// Secret is the plaintext secret. It exists only in the response that mints
	// or rotates it.
	Secret string
	// CopyLabel is the secret copy control's label. Empty defaults to "Copy key".
	CopyLabel string
	// EndpointID is the element id holding the endpoint value, when shown.
	EndpointID string
	// Endpoint is the MCP endpoint clients connect to. Empty omits the row.
	Endpoint string
	// Warning is the rotation warning shown under the secret.
	Warning string
	// BundleURL is an optional one-click Claude Desktop bundle download link
	// (a .mcpb file). Empty omits the row.
	BundleURL string
	// BundleTestID optionally adds a data-testid to the bundle download link.
	BundleTestID string
	// BundleCopyTestID optionally adds a data-testid to the bundle link's copy
	// control.
	BundleCopyTestID string
	// InstallURL is an optional /api/mcp/install redirect that opens Claude
	// Desktop and installs this server. It carries the key, so it is a private
	// link like the bundle URL. Empty omits the row.
	InstallURL string
	// InstallTestID optionally adds a data-testid to the install link's copy
	// control.
	InstallTestID string
	// DeliveryNote is an optional confirmation line rendered under the
	// endpoint, e.g. "Invite emailed to alice@example.com". Empty omits it.
	DeliveryNote string
	// DeliveryWarn is an optional delivery-problem line rendered as a warning
	// under the delivery note. Empty omits it.
	DeliveryWarn string

	// DialogID is the modal <dialog> element id.
	DialogID string
	// Attrs are extra attributes on the <dialog>.
	Attrs templ.Attributes
	// Snippets is the client-setup list. Nil omits the section entirely.
	Snippets templ.Component
	// AutoOpen marks the modal for automatic opening by the client.
	AutoOpen bool
	// DismissHref, when set, makes the primary action a link to that destination
	// (leaving the page) instead of a dialog-closing button. Used by pages whose
	// reveal sits over a form that must not be submitted a second time.
	DismissHref string
}

// SecretRevealModal renders the one-time secret reveal as a modal dialog: the
// secret, the endpoint, the rotation warning, and ready-to-paste client
// snippets. The secret exists only in this response; closing the dialog and
// navigating away loses it for good.
templ SecretRevealModal(p SecretRevealProps) {
	{{
		dismissType := ui.ButtonTypeSubmit
		if p.DismissHref != "" {
			dismissType = ui.ButtonTypeLink
		}
	}}
	<dialog
		id={ p.DialogID }
		class="modal"
		hx-boost="false"
		if p.AutoOpen {
			data-dialog-autoopen="true"
		}
		{ p.Attrs... }
	>
		<div class="modal-box max-w-[63rem]">
			<div class="flex items-center gap-3">
				@ui.IconTile("lucide--key-round", ui.IconTileProps{Tone: "primary"})
				<div class="min-w-0">
					@ui.DialogTitle() {
						{ p.Heading }
					}
					@secretRevealNotice(p)
				</div>
			</div>
			@secretRevealSecret(p)
			@secretRevealEndpoint(p)
			@secretRevealDelivery(p)
			@secretRevealBundle(p)
			if p.Warning != "" {
				<div class="mt-3">
					@ui.Alert(ui.AlertProps{
						Type:    ui.AlertWarning,
						Style:   ui.AlertStyleOutline,
						Icon:    "lucide--triangle-alert",
						Message: p.Warning,
					})
				</div>
			}
			if p.Snippets != nil {
				<div class="mt-5 flex flex-col gap-3">
					@ui.Eyebrow("Client setup", ui.EyebrowProps{Size: "text-[11px]", Margin: ""})
					@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "-mt-2"}) {
						Paste one of these into your MCP client. Each already contains the endpoint and key. 
					}
					@p.Snippets
				</div>
			}
			<form method="dialog" class="modal-action">
				@ui.Button(ui.ButtonProps{
					Type:       dismissType,
					Href:       p.DismissHref,
					Variant:    ui.ButtonPrimary,
					Size:       ui.ButtonSM,
					Icon:       "lucide--check",
					ExtraClass: "w-full sm:w-auto",
				}) {
					Done — I've saved the key
				}
			</form>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>
}

templ secretRevealNotice(p SecretRevealProps) {
	@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-0.5"}) {
		if p.Name != "" {
			{ p.Name } — this { p.noun() } is shown only once. Store it somewhere safe.
		} else {
			This { p.noun() } is shown only once. Store it somewhere safe.
		}
	}
}

templ secretRevealSecret(p SecretRevealProps) {
	{{
		attrs := templ.Attributes{}
		if p.SecretTestID != "" {
			attrs["data-testid"] = p.SecretTestID
		}
	}}
	<div class="mt-4" { attrs... }>
		@form.ClipboardCopy([]form.ClipboardCopyItem{
			{
				ID:          p.SecretID,
				Value:       p.Secret,
				ButtonLabel: p.copyLabel(),
			},
		})
	</div>
}

templ secretRevealEndpoint(p SecretRevealProps) {
	if p.Endpoint != "" {
		<div class="mt-3">
			@form.ClipboardCopy([]form.ClipboardCopyItem{
				{
					ID:          p.EndpointID,
					Label:       "Endpoint",
					Value:       p.Endpoint,
					ButtonLabel: "Copy",
					Mono:        true,
				},
			})
		</div>
	}
}

// secretRevealDelivery renders the optional invite-delivery status lines.
templ secretRevealDelivery(p SecretRevealProps) {
	if p.DeliveryNote != "" {
		<div class="mt-3">
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertInfo,
				Style:   ui.AlertStyleOutline,
				Icon:    "lucide--mail-check",
				Message: p.DeliveryNote,
			})
		</div>
	}
	if p.DeliveryWarn != "" {
		<div class="mt-3">
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertWarning,
				Style:   ui.AlertStyleOutline,
				Icon:    "lucide--mail-x",
				Message: p.DeliveryWarn,
			})
		</div>
	}
}

// secretRevealBundle renders the optional Claude Desktop setup block: the
// one-click .mcpb download plus copy controls for the two private links that
// carry the key — the bundle itself and the /api/mcp/install redirect. The
// download is a plain <a href> (never an htmx action); the copy controls use
// the input variant of ClipboardCopy so the key-bearing URL is never inlined
// into an onclick attribute.
templ secretRevealBundle(p SecretRevealProps) {
	if p.BundleURL != "" || p.InstallURL != "" {
		<div class="mt-3 flex flex-col gap-2">
			@ui.Eyebrow("Claude Desktop", ui.EyebrowProps{Size: "text-[11px]", Margin: ""})
			<div class="min-w-0 rounded-box border border-base-content/15 bg-base-200/50 px-3 py-2 text-xs">
				Download a <code class="font-mono">.mcpb</code> bundle and double-click it to add this server, or copy a private link to hand to someone else. Both links carry this key.
			</div>
			if p.BundleURL != "" {
				{{
					attrs := templ.Attributes{"download": ""}
					if p.BundleTestID != "" {
						attrs["data-testid"] = p.BundleTestID
					}
				}}
				<div class="flex flex-wrap items-center gap-2">
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeLink,
						Href:    p.BundleURL,
						Variant: ui.ButtonPrimary,
						Size:    ui.ButtonSM,
						Icon:    "lucide--download",
						Attrs:   attrs,
					}) {
						Download bundle
					}
				</div>
				<div data-testid={ p.BundleCopyTestID }>
					@form.ClipboardCopy([]form.ClipboardCopyItem{
						{
							ID:          p.DialogID + "-bundle-url",
							Label:       "Bundle link (private — contains this key)",
							Value:       p.BundleURL,
							ButtonLabel: "Copy link",
						},
					})
				</div>
			}
			if p.InstallURL != "" {
				<div data-testid={ p.InstallTestID }>
					@form.ClipboardCopy([]form.ClipboardCopyItem{
						{
							ID:          p.DialogID + "-install-url",
							Label:       "Install link (private — contains this key)",
							Value:       p.InstallURL,
							ButtonLabel: "Copy link",
						},
					})
				</div>
			}
		</div>
	}
}
