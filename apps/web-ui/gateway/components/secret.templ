package components

import (
	"strings"

	ui "github.com/emergent-company/go-daisy/components/ui"
)

// SecretRevealProps configures a one-time secret reveal.
//
// The modal and panel variants share this shape so a caller switching between
// them does not translate fields. Modal-only fields are DialogID, Snippets and
// AutoOpen; panel-only field is Footer.
type SecretRevealProps struct {
	// Heading is the reveal heading, e.g. "MCP share created".
	Heading string
	// Name is the secret owner's name. When set it prefixes the one-time notice.
	Name string
	// Noun is the noun used in the one-time notice. Empty defaults to "key".
	Noun string
	// SecretID is the element id holding the secret value; it is also the copy
	// target for the copy control.
	SecretID string
	// SecretTestID optionally adds a data-testid to the secret element.
	SecretTestID string
	// Secret is the plaintext secret. It exists only in the response that mints
	// or rotates it.
	Secret string
	// CopyLabel is the secret copy control's label. Empty defaults to "Copy key".
	CopyLabel string
	// EndpointID is the element id holding the endpoint value, when shown.
	EndpointID string
	// Endpoint is the MCP endpoint clients connect to. Empty omits the row.
	Endpoint string
	// Warning is the rotation warning shown under the secret.
	Warning string

	// DialogID is the modal <dialog> element id (modal variant only).
	DialogID string
	// Attrs are extra attributes: on the <dialog> for the modal variant, on the
	// card for the panel variant.
	Attrs templ.Attributes
	// Snippets is the client-setup list (modal variant only). Nil omits the
	// section entirely.
	Snippets templ.Component
	// AutoOpen marks the modal for automatic opening by the client.
	AutoOpen bool
	// Footer is extra content rendered under the copy row (panel variant only).
	Footer templ.Component
	// CardClass is an extra card class for the panel variant, appended to the
	// standard treatment (for example an accent border).
	CardClass string
}

// SecretRevealModal renders the one-time secret reveal as a modal dialog: the
// secret, the endpoint, the rotation warning, and ready-to-paste client
// snippets. The secret exists only in this response; closing the dialog and
// navigating away loses it for good.
templ SecretRevealModal(p SecretRevealProps) {
	<dialog id={ p.DialogID } class="modal" hx-boost="false" if p.AutoOpen { data-dialog-autoopen="true" } { p.Attrs... }>
		<div class="modal-box max-w-[63rem]">
			<div class="flex items-center gap-3">
				@ui.IconTile("lucide--key-round", ui.IconTileProps{Tone: "primary"})
				<div class="min-w-0">
					<h3 class="text-lg font-semibold">{ p.Heading }</h3>
					@secretRevealNotice(p)
				</div>
			</div>
			@secretRevealSecret(p)
			@secretRevealEndpoint(p)
			if p.Warning != "" {
				<div class="mt-3">
					@ui.Alert(ui.AlertProps{
						Type:    ui.AlertWarning,
						Style:   ui.AlertStyleOutline,
						Icon:    "lucide--triangle-alert",
						Message: p.Warning,
					})
				</div>
			}
			if p.Snippets != nil {
				<div class="mt-5 flex flex-col gap-3">
					@ui.Eyebrow("Client setup", ui.EyebrowProps{Size: "text-[11px]", Margin: ""})
					<p class="text-base-content/50 -mt-2 text-xs">Paste one of these into your MCP client. Each already contains the endpoint and key.</p>
					@p.Snippets
				</div>
			}
			<form method="dialog" class="modal-action">
				@ui.Button(ui.ButtonProps{
					Type:       ui.ButtonTypeSubmit,
					Variant:    ui.ButtonPrimary,
					Size:       ui.ButtonSM,
					Icon:       "lucide--check",
					ExtraClass: "w-full sm:w-auto",
				}) {
					Done — I've saved the key
				}
			</form>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>
}

// SecretRevealPanel renders the same reveal anatomy inline, for pages that show
// the secret in the page body instead of a dialog.
templ SecretRevealPanel(p SecretRevealProps) {
	@ui.CardRaw(strings.TrimSpace("card-border "+p.CardClass), "p-5", p.Attrs) {
		<div class="flex items-center gap-3">
			@ui.IconTile("lucide--key-round", ui.IconTileProps{Tone: "primary"})
			<div class="min-w-0">
				<p class="text-sm font-semibold">{ p.Heading }</p>
				@secretRevealNotice(p)
			</div>
		</div>
		@secretRevealSecret(p)
		@secretRevealEndpoint(p)
		if p.Footer != nil {
			@p.Footer
		}
	}
}

templ secretRevealNotice(p SecretRevealProps) {
	<p class="text-base-content/50 mt-0.5 text-xs">
		if p.Name != "" {
			{ p.Name } — this { p.noun() } is shown only once. Store it somewhere safe.
		} else {
			This { p.noun() } is shown only once. Store it somewhere safe.
		}
	</p>
}

templ secretRevealSecret(p SecretRevealProps) {
	{{ attrs := templ.Attributes{}
	if p.SecretTestID != "" {
		attrs["data-testid"] = p.SecretTestID
	} }}
	<div class="mt-4 flex flex-wrap items-center gap-2">
		<div id={ p.SecretID } class="min-w-0 flex-1 rounded-box border border-base-content/15 bg-base-200/50 px-3 py-2 font-mono text-xs break-all" { attrs... }>{ p.Secret }</div>
		@ui.Button(ui.ButtonProps{
			Type:    ui.ButtonTypeButton,
			Variant: ui.ButtonPrimary,
			Size:    ui.ButtonSM,
			Icon:    "lucide--copy",
			Attrs:   templ.Attributes{"data-copy-target": "#" + p.SecretID},
		}) {
			{ p.copyLabel() }
		}
	</div>
}

templ secretRevealEndpoint(p SecretRevealProps) {
	if p.Endpoint != "" {
		<div class="mt-3 flex flex-wrap items-center gap-2">
			@ui.Eyebrow("Endpoint", ui.EyebrowProps{Size: "text-[11px]", Margin: ""})
			<div id={ p.EndpointID } class="min-w-0 flex-1 rounded-box border border-base-content/15 bg-base-200/50 px-3 py-2 font-mono text-xs break-all">{ p.Endpoint }</div>
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeButton,
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--copy",
				Attrs:   templ.Attributes{"data-copy-target": "#" + p.EndpointID},
			}) {
				Copy
			}
		</div>
	}
}
