package main

import (
	"net/url"
	"strconv"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/layout"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- object wiki page ---------------------------------------------------------
//
// The wiki is the reading surface: browsing links here instead of into the
// editor. There is one layout (the object page). Nothing on this page mutates an
// object — Edit, History and Chat are links to the object's own pages.

// objectWikiPage renders the wiki shell: a content header, then the page's body.
// There is deliberately no breadcrumb trail and no page-action row: the wiki is
// reached from a list, and the reader's job here is to read, so the content
// starts immediately under the object's own name.
//
// The head reads like a browse card: the type icon on the left, the type and ref
// as the first line, the object's name as the second. The quiet Chat and Edit
// links sit in the top-right corner.
templ objectWikiPage(data objectWikiPageData) {
	@layout.Container(layout.ContainerLG, nil) {
		if data.LoadErr != nil {
			@pageError("Object unavailable", data.LoadErr)
		} else {
			@objectWikiHead(data)
			@objectWikiObjectPage(data)
		}
	}
}


// objectWikiHead is the wiki's content header: a reusable component with its own
// boundary, because it is the surface a reader points at when they report a
// problem with an object page. The
// `data-component` attribute is what the element-level feedback overlay reads to
// name this component; without it the nearest annotated ancestor is the page's
// `layout/Container`, and the overlay reports a layout primitive instead.
//
// The header carries no state chips. The branch and the embedding state live in
// the rail's Metadata block, beside the other facts about this version, and the
// workflow status lives in the rail's Workflow group next to the assignee —
// state belongs with the facts that give it meaning, and a chip row here
// repeated them without that context. The data class and the write credential
// are in the rail's provenance list for the same reason: one sentence says how
// the version was made and by which credential.
templ objectWikiHead(data objectWikiPageData) {
	{{ tui := typeUIOf(data.TypeUIByType, data.Obj.Type) }}
	<div class="mb-7 flex flex-col gap-3" data-testid="object-wiki-head">
		<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
			@objectHeader(objectHeaderProps{
				Variant:        objectHeaderLead,
				Type:           data.Obj.Type,
				Icon:           tui.Icon,
				Color:          tui.Color,
				Ref:            objectDisplayRef(data.Obj.Ref, data.Obj.ID),
				Label:          graphObjectLabel(*data.Obj),
				TestID:         "object-wiki-header",
				IdentityTestID: "object-wiki-identity",
			})
			<div class="flex shrink-0 flex-wrap items-center gap-2">
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    "/objects/" + url.PathEscape(data.Obj.ID) + "/chat",
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Icon:    "lucide--messages-square",
					Attrs:   templ.Attributes{"data-testid": "object-wiki-chat", "title": "Chat about this object"},
				}) {
					Chat
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    "/objects/" + url.PathEscape(data.Obj.ID),
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Icon:    "lucide--pencil",
					Attrs:   templ.Attributes{"data-testid": "object-wiki-edit", "title": "Edit this object"},
				}) {
					Edit
				}
			</div>
		</div>
	</div>
}

// objectWikiObjectPage is the wiki's single layout — the shape an auto-rendered
// wiki entry takes: the prose overview first, then key facts, then one section
// per relationship group. It is the page a reader lands on when they want the
// whole object in one column, with the summaries a browsable page needs.
//
// The overview leads because it is the only prose on the page: a reader who
// arrives from a list wants to know what the object *is* before reading its
// fields. It is omitted entirely when the object carries no prose (no summary,
// description, content or other conventional prose property) — an empty
// "Overview" heading over a "No description yet" panel on a page whose job is
// the record itself is just noise, so the facts and relationships start the page
// instead.
templ objectWikiObjectPage(data objectWikiPageData) {
	{{ prose := objectArticleFor(*data.Obj, data.PropDefs)
	hasProse := prose.Lead != "" || prose.BodyHTML != "" }}
	<div class="grid grid-cols-1 gap-10 xl:grid-cols-[minmax(0,1fr)_17rem]" data-testid="object-wiki-page">
		<div class="flex min-w-0 flex-col gap-8">
			if hasProse {
				@ui.Section("Overview", ui.SectionProps{BodyClass: "memory-density-comfortable"}) {
					@objectWikiProse(prose)
				}
			}
			{{ facts := objectRailPropertyRows(*data.Obj, data.PropDefs, prose) }}
			{{ valuedFacts, unsetFacts := objectPropertyRowsSplit(facts) }}
			if len(facts) > 0 {
				// The heading is the same "<type label> Properties" the rail and
				// the editor's card use (typePropertiesPanelTitle), because the
				// page view is where a reader looks up a value and the name should
				// not change between two surfaces that list the same fields.
				@ui.Section(typePropertiesPanelTitle(data.TypeLabel), ui.SectionProps{BodyClass: "memory-density-comfortable"}) {
					// Two columns and one row per field: the reader is looking up a
					// value, and a table is the shape of a lookup. The eye folds the
					// declared-but-unset rows away, which is the only state that needs
					// a control — a wall of em dashes buries the fields that do carry
					// a value. With every field unset nothing is folded, so the
					// section still says "declared, not filled" instead of going blank.
					<table class="table table-sm" id="object-wiki-key-facts" data-testid="object-wiki-key-facts">
						<tbody>
							for _, r := range facts {
								{{ value := objectPropertyDisplay(r)
								unset := value == ""
								folded := unset && len(valuedFacts) > 0 }}
								<tr data-empty?={ unset } style={ templ.KV("display:none", folded) }>
									<th scope="row" class="text-muted-faint w-40 py-1 align-top text-xs font-medium whitespace-normal">{ r.Label }</th>
									<td class="py-1 text-sm break-words">
										if unset {
											@components.EmptyDash()
										} else {
											{ value }
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
					// The control sits at the foot of the box, left-aligned with the
					// table's first column: it reads as part of the list it unfolds
					// rather than as section chrome competing with the heading.
					if len(unsetFacts) > 0 && len(valuedFacts) > 0 {
						<div class="mt-2 flex justify-start">
							@objectUnsetPropertiesToggle("object-wiki-key-facts")
						</div>
					}
				}
			}
			for _, section := range data.Sections {
				@objectWikiSection(data, section)
			}
		</div>
		<aside class="flex min-w-0 flex-col gap-6" aria-label="Object metadata">
			// No properties here: this view lists every one of them in the body
			// card above, and the rail repeating them pushed the facts a reader
			// cannot find elsewhere (labels, history, provenance) down the page.
			// The relationships rail carries the per-type breakdown instead of
			// the flat count, because this is the whole-object view.
			@objectWikiDetailsRail(data)
		</aside>
	</div>
}

// objectWikiProse renders the object's prose: the lead paragraph and the
// markdown body. It is only called when there is prose — the Overview section is
// omitted entirely otherwise, so there is no empty state here.
templ objectWikiProse(prose objectArticleProse) {
	if prose.Lead != "" {
		<p class="text-base-content/85 mb-6 text-[1.05rem] leading-relaxed" data-testid="object-lead">{ prose.Lead }</p>
	}
	if prose.BodyHTML != "" {
		<div class="memory-md text-sm leading-relaxed" data-testid="object-body">@templ.Raw(prose.BodyHTML)</div>
	}
}

// objectWikiSection renders one relationship group of the object-page variant.
// Rows carry the neighbour's own summary, so the page reads like a wiki hub
// instead of a list of identifiers. The section stays bounded: Total keeps the
// real count visible, and "All relationships" is the way to the full edge list.
templ objectWikiSection(data objectWikiPageData, section objectViewSection) {
	@ui.Section(section.Title, ui.SectionProps{
		CardClass: "overflow-hidden",
		BodyClass: "memory-density-flush",
	}) {
		<div class="divide-y divide-base-200" data-testid="object-wiki-section">
			for _, row := range section.Rows {
				@objectWikiRelationRow(data, row, section.ShowDirection)
			}
			if section.Total > len(section.Rows) {
				<div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-xs">
					<span class="text-muted-subtle">+{ strconv.Itoa(section.Total - len(section.Rows)) } more not shown</span>
					<a href={ templ.URL("/objects/" + url.PathEscape(data.Obj.ID) + "/relationships") } class="link link-hover font-medium">All relationships</a>
				</div>
			}
		</div>
	}
}

// objectWikiRelationRow is one neighbour inside a relationship group. It wears
// the same layout as a browse card, because a related object is still an object:
// type icon on the left, the type and ref as the first line, the name as the
// second, then the neighbour's own summary. The direction cue (only in a group
// that mixes directions) sits at the end of the identity line.
templ objectWikiRelationRow(data objectWikiPageData, row objectViewItem, showDirection bool) {
	{{ tui := typeUIOf(data.TypeUIByType, row.Neighbour.Type)
	href := ""
	if row.Resolved {
		href = objectWikiHref(relationshipEndpointTarget(row.Neighbour))
	}
	direction := ""
	if showDirection {
		direction = row.direction()
	}
	excerpt := objectExcerpt(row.Neighbour.Properties) }}
	<div class="min-w-0 px-4 py-3" data-testid="object-wiki-relation-row" data-relationship-type={ row.RelType } data-direction={ row.direction() }>
		@objectHeader(objectHeaderProps{
			Variant:        objectHeaderRow,
			Type:           row.Neighbour.Type,
			Icon:           tui.Icon,
			Color:          tui.Color,
			Ref:            objectDisplayRef(row.Neighbour.Ref, row.Neighbour.ID),
			Label:          graphObjectLabel(row.Neighbour),
			Href:           href,
			Unresolved:     !row.Resolved,
			Direction:      direction,
			Excerpt:        excerpt,
			IdentityTestID: "object-wiki-identity",
			// Only a tall row — one whose excerpt wraps — puts the tile on the
			// identity line; a row with no summary is two lines and reads
			// better with the tile centred (feedback on this row).
			TopAlign: excerpt != "",
		})
	</div>
}

// objectMetadataRail is the object rail's Metadata group, shared by the wiki and
// the object Overview so the two sidebars read the same. It carries the facts
// about the version on screen: the type, the branch and the embedding state as
// badge values (a branch is only remarkable beside the object's other facts, and
// an embedding state needs the date behind it), then the version number and the
// canonical id.
//
// There is deliberately no Created fact: the read path's created_at is the
// timestamp of the version on screen, not of the object's first version, and the
// provenance chain's write line names the time instead.
templ objectMetadataRail(obj *GraphObject, branch objectBranchRef) {
	@objectWikiRail("Metadata") {
		// data-testid is the object editor's contract: the e2e suite reads
		// Version here, and the same group now serves both surfaces.
		<dl class="flex flex-col gap-2.5 text-sm" data-testid="object-record-facts">
			@objectRecordFact("Type", obj.Type, false)
			@objectWikiBadgeFact("Branch") {
				@objectBranchChip(branch)
			}
			if obj.EmbeddingStatus != "" {
				@objectWikiBadgeFact("Embedding") {
					@objectEmbeddingBadge(obj)
				}
			}
			@objectRecordFact("Version", objectPreviewVersionLabel(obj.Version), false)
			@objectRecordFact("ID", objectPreviewCanonicalID(*obj), true)
		</dl>
	}
}

// objectProvenanceRail is the object rail's Provenance group, shared by the wiki
// and the object Overview. It is a chain, oldest first — the document(s) the data
// was extracted from, how this version was classified, then who wrote the
// version on screen and when — and it renders nothing at all when the object
// carries none of it, so the rail never grows an empty group.
//
// The write line degrades gracefully: a surface that does not resolve identities
// (or a version whose actor is not resolvable) passes a zero Provenance and gets
// the source and class entries only.
templ objectProvenanceRail(obj *GraphObject, sources []objectSource, prov objectVersionProvenance) {
	{{ classLabel, classVariant, classIcon, classHint := dataClassChip(obj.DataClass) }}
	{{ written := prov.Actor != "" || prov.How != "" || prov.When != "" }}
	if len(sources) > 0 || classLabel != "" || written {
		@objectWikiRail("Provenance") {
			// A list, not a fact grid: these are a chain, oldest first — the
			// document(s) the data was extracted from, how this version was
			// classified, then who wrote the version on screen and when. An object
			// can carry a source and then several enrichment passes, so the shape
			// has to grow with the history rather than assume two values.
			<ol class="flex flex-col gap-3" data-testid="object-wiki-provenance">
				for _, src := range sources {
					<li class="flex min-w-0 items-start gap-2">
						@objectSourceRow(src)
					</li>
				}
				if classLabel != "" {
					<li class="flex min-w-0 items-center gap-2" data-testid="object-wiki-provenance-class" title={ classHint }>
						@ui.Badge(ui.BadgeProps{Label: classLabel, Variant: classVariant, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: classIcon})
					</li>
				}
				if written {
					<li class="flex min-w-0 items-start gap-2 text-sm" data-testid="object-wiki-provenance-write">
						@ui.IconSpan("lucide--pencil", "mt-0.5 size-4 shrink-0 text-muted-subtle")
						// A row, not a sentence of adjacent inline text: templ drops the
						// whitespace between sibling elements, which ran the parts together
						// ("Version 3written by"). The gap spaces them the way the history
						// timeline does, and each part wraps on its own.
						<span class="inline-flex min-w-0 flex-wrap items-baseline gap-x-1 gap-y-0.5">
							<span>Version { strconv.Itoa(obj.Version) }</span>
							// An agent's write is ordered by a person, and that person is what
							// makes the entry accountable — so they lead, exactly as they do in
							// the history timeline. The credential is not repeated when the order
							// already explains how the write happened.
							if prov.OrderedBy != "" {
								<span class="text-muted-faint">on</span>
								<span class="min-w-0 font-medium" title={ prov.OrderedByTitle }>{ objectPossessive(prov.OrderedBy) } order</span>
								if prov.Actor != "" {
									<span class="text-muted-faint">·</span>
									<span class="text-muted-faint">written by</span>
									if prov.ActorHref != "" {
										<a class="link link-hover font-medium" href={ templ.URL(prov.ActorHref) } title={ prov.ActorTitle }>{ prov.Actor }</a>
									} else {
										<span class="font-medium" title={ prov.ActorTitle }>{ prov.Actor }</span>
									}
								}
							} else if prov.Actor != "" {
								<span class="text-muted-faint">written by</span>
								if prov.ActorHref != "" {
									<a class="link link-hover font-medium" href={ templ.URL(prov.ActorHref) } title={ prov.ActorTitle }>{ prov.Actor }</a>
								} else {
									<span class="font-medium" title={ prov.ActorTitle }>{ prov.Actor }</span>
								}
							}
							if prov.How != "" && prov.OrderedBy == "" {
								<span class="text-muted-faint">via { prov.How }</span>
							}
							if prov.When != "" {
								<span class="text-muted-faint" title={ prov.WhenTitle }>{ prov.When }</span>
							}
							if prov.Run != "" {
								<span class="text-muted-faint" title={ prov.RunTitle }>{ prov.Run }</span>
							}
						</span>
					</li>
				}
			</ol>
		}
	}
}

// objectWikiDetailsRail is the factual rail: the metadata, the workflow group,
// the provenance, the labels, the per-type relationship breakdown and the
// history. The type's declared properties are not repeated here — the page's
// key-facts table above lists them, and a rail copy pushed the facts a reader
// cannot find elsewhere down the page.
templ objectWikiDetailsRail(data objectWikiPageData) {
	// The Metadata and Provenance groups are the object rail's shared blocks
	// (objectMetadataRail, objectProvenanceRail): the object Overview renders the
	// same components, so the two sidebars cannot drift apart.
	@objectMetadataRail(data.Obj, data.Branch)
	// Workflow state has its own group above the provenance chain: the status and
	// the assignee are the object's position in its type's work process, not
	// facts about the version, and the type's own `status` property (if it
	// declares one) stays with the other properties below.
	@objectWikiWorkflowRail(data)
	// There is no "Created" fact: the read path's created_at is the timestamp of
	// the version on screen, not of the object's first version (they differ — the
	// object history is the only place that holds the first one), so the write
	// line in the provenance chain carries the time instead of a fact that would
	// misname it.
	@objectProvenanceRail(data.Obj, data.Sources, data.Provenance)
	if len(data.Obj.Labels) > 0 {
		@objectWikiRail("Labels") {
			<div class="flex flex-wrap gap-1">
				for _, l := range data.Obj.Labels {
					@ui.Badge(ui.BadgeProps{Label: l, Variant: ui.BadgeNeutral, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS})
				}
			</div>
		}
	}
	@objectWikiRail("Relationships") {
		// The per-type breakdown: this is the whole-object view, and the rail is
		// the only place the breakdown appears. An object with no counted edges
		// falls back to the flat line, so the block never goes empty.
		{{ byType := len(data.RelationCounts) > 0 }}
		if byType {
			<dl class="flex flex-col gap-1.5 text-sm">
				for _, rc := range data.RelationCounts {
					<div class="flex items-baseline justify-between gap-2">
						<dt class="min-w-0 truncate">{ rc.Label }</dt>
						<dd class="text-muted-faint shrink-0 text-xs tabular-nums">{ strconv.Itoa(rc.Count) }</dd>
					</div>
				}
			</dl>
		}
		<a href={ templ.URL("/objects/" + url.PathEscape(data.Obj.ID) + "/relationships") } class={ "link link-hover inline-flex items-center gap-1.5 text-sm", templ.KV("mt-1 text-xs", byType) }>
			@ui.IconSpan("lucide--link", "size-3.5 shrink-0 text-muted-faint")
			if data.EdgeCount == 0 {
				No relationships yet
			} else if byType {
				All { strconv.Itoa(data.EdgeCount) } relationships
			} else {
				{ strconv.Itoa(data.EdgeCount) } relationships
			}
		</a>
	}
	// History lives in the shared rail rather than in the page-action row, so
	// both variants carry it and neither repeats it. The count comes from
	// objectVersionCount, which falls back to the version number when the server
	// reports no revision_count; without that fallback this block claimed "No
	// versions recorded" for an object whose history had three rows.
	@objectWikiRail("History") {
		{{ versions := "View history"
		if n, known := objectVersionCount(*data.Obj); known {
			versions = objectVersionCountLabel(n)
		} }}
		<a href={ templ.URL("/objects/" + url.PathEscape(data.Obj.ID) + "/history") } class="link link-hover inline-flex items-center gap-1.5 text-sm">
			@ui.IconSpan("lucide--history", "size-3.5 shrink-0 text-muted-faint")
			{ versions }
		</a>
	}
}

// objectWikiRail is one labelled block in the details rail. The blocks are
// separated by a hairline instead of being separate cards: a rail of six panels
// reads as a second page.
// objectWikiRail is one section of the details rail: a small uppercase heading
// over its rows.
templ objectWikiRail(title string) {
	<section class="border-base-content/10 flex min-w-0 flex-col gap-2 border-t pt-4 first:border-t-0 first:pt-0">
		<h2 class="text-muted-faint text-[11px] font-semibold tracking-wider uppercase">{ title }</h2>
		{ children... }
	</section>
}

// objectWikiWorkflowRail is the rail's Workflow group: the workflow status and
// the assignee, which together say where the object sits in its type's work
// process.
//
// It renders only for a type that declares a workflow (an allowed-status set, or
// the boardEnabled flag) — the same predicate that decides whether the object
// page gets an editable picker. A type that declares none has no workflow: its
// `status` is an ordinary schema property and is rendered with the other
// properties under "<Type> Properties", which is why this group is the only
// place a workflow status appears on the wiki. A schema outage hides the group
// rather than resurrecting the mirrored column value beside the property.
//
// Both values are read-only — the wiki is the reading surface, and the pickers
// live on the object page, which the group's pencil links to. The assignee is
// the stored display name (a runtime agent's name or a member's display name),
// so showing it needs no candidate fetch.
templ objectWikiWorkflowRail(data objectWikiPageData) {
	if !objectWorkControlDisabled(data.Status) {
		@objectWikiRail("Workflow") {
			<dl class="flex flex-col gap-2.5 text-sm" data-testid="object-wiki-workflow">
				@objectWikiBadgeFact("Status") {
					if data.Obj.Status != "" {
						@components.StatusBadge(boardStatusLabel(data.Obj.Status), boardStatusIntent(data.Obj.Status), "", components.StatusBadgeOpts{
							Size:  ui.BadgeSizeSM,
							Dot:   true,
							Attrs: templ.Attributes{"data-status": data.Obj.Status, "title": "Workflow status — the lane this object sits in."},
						})
					} else {
						<span class="text-muted-faint text-sm">No status</span>
					}
				}
				@objectWikiBadgeFact("Assignee") {
					if data.Obj.Assignee != "" {
						<span class="inline-flex min-w-0 items-center gap-1.5 text-sm">
							@ui.IconSpan("lucide--user", "size-3.5 shrink-0 text-muted-faint")
							<span class="min-w-0 break-words">{ data.Obj.Assignee }</span>
						</span>
					} else {
						<span class="text-muted-faint text-sm">Unassigned</span>
					}
					// The group's one action trails its last row rather than taking
					// a line of its own: the wiki is the reading surface, and a
					// sentence about where editing happens is chrome the pencil
					// carries on its own.
					@objectWikiWorkflowEdit(data.Obj.ID)
				}
			</dl>
		}
	}
}

// objectWikiWorkflowEdit is the Workflow group's single action: a pencil at the
// end of its last row, opening the object page where the status and the assignee
// are actually editable. The rail says everything else in words, so this is
// icon-only — labelled for screen readers and named on hover, but taking no line
// of its own.
templ objectWikiWorkflowEdit(id string) {
	<a
		href={ templ.URL("/objects/" + url.PathEscape(id)) }
		class="link link-hover ml-auto inline-flex items-center text-muted-faint hover:text-base-content"
		data-testid="object-wiki-workflow-edit"
		aria-label="Edit the workflow on the object page"
		title="Edit the workflow on the object page"
	>
		@ui.IconSpan("lucide--pencil", "size-3.5 shrink-0")
	</a>
}

// objectWikiBadgeFact is one Metadata row whose value is a control — a badge or
// a link — rather than plain text. The label still sits above the value like
// every other fact, so the rail keeps one reading order.
templ objectWikiBadgeFact(label string) {
	<div class="flex min-w-0 flex-col gap-1">
		<dt class="text-muted-faint text-xs font-medium">{ label }</dt>
		<dd class="flex flex-wrap items-center gap-1.5">{ children... }</dd>
	</div>
}

// objectEmbeddingBadge is the embedding state as a rail value: outlined, so the
// border and the text carry the state colour and the badge does not compete with
// the rail's filled labels, and titled with the date the vector was last written
// — the one thing a status glance cannot show. States that hold no vector
// explain themselves in the tooltip instead.
templ objectEmbeddingBadge(obj *GraphObject) {
	{{ label, intent := embeddingStatusOutline(obj.EmbeddingStatus) }}
	if label != "" {
		@ui.Badge(ui.BadgeProps{
			Label:   label,
			Variant: intent,
			Style:   ui.BadgeStyleOutline,
			Size:    ui.BadgeSizeSM,
			Attrs:   templ.Attributes{"data-testid": "object-embedding", "data-embedding-status": obj.EmbeddingStatus, "title": objectEmbeddingTitle(obj)},
		})
	}
}

// objectUnsetPropertiesToggle is the eye that unfolds the property rows a section
// folds because they carry no value. It sits at the foot of the list, left-aligned
// with the labels above it, so it reads as part of that list rather than as
// section chrome. It only ever adds: the folded state is the rendered state
// (those rows ship with an inline `display:none`, which no daisy table rule can
// out-specify), so with no script the list simply reads shorter. app.js owns the
// flip — one delegated listener, re-applied across HTMX swaps — and swaps the
// glyph, `aria-pressed` and both labels from the data-* attributes below.
templ objectUnsetPropertiesToggle(scopeID string) {
	@ui.Button(ui.ButtonProps{
		Type:       ui.ButtonTypeButton,
		Variant:    ui.ButtonGhost,
		Size:       ui.ButtonXS,
		Icon:       "lucide--eye",
		ExtraClass: "h-6 min-h-0 gap-1 px-1 text-muted-faint",
		AriaLabel:  "Show all",
		Attrs: templ.Attributes{
			"data-empties-toggle": scopeID,
			"aria-controls":       scopeID,
			"aria-pressed":        "false",
			"data-label-show":     "Show all",
			"data-label-hide":     "Hide empty",
			"title":               "Show all",
		},
	}) {
		<span data-empties-label>Show all</span>
	}
}
