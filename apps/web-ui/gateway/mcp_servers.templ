package main

import (
	"net/url"

	"github.com/emergent-company/go-daisy/components/form"
	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- MCP Servers management pages (/settings/mcp-servers) ---
//
// One crumb-framed list page plus standalone create (/new) and edit
// (/:id/edit) pages sharing a single transport form, mirroring the api_tokens
// trio's structure. Each list row is an expandable <details> in the same
// visual language as the agent tool picker (agentToolServerGroup): the
// summary carries name / type badge / enabled badge / tool count; the expanded
// body holds the row's sync/inspect/edit/delete actions and the cached tool
// rows with per-tool toggles (D4/D6). Sync / inspect / toggles run through
// inline JS (mcpServersScript); create/update/delete are PRG posts.

// MCPServersPage renders the registry list (/settings/mcp-servers): one
// expandable row per registered server (builtin + external). A project with no
// servers renders the shared EmptyState with a CTA to /new.
templ MCPServersPage(data mcpServersPageData) {
	@layout.Container(layout.ContainerLG, templ.Attributes{"data-mcp-list-root": ""}) {
		{{ crumbs := crumbsActive(nav.Crumbs("Settings", "/settings", "MCP Servers")) }}
		@detailHeader(crumbs, "", "MCP Servers", "Register and maintain the MCP servers that power agent tools.", detailHeaderOpts{Margin: "mb-6"}) {
			if data.LoadErr == nil {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    mcpShareSettingsBase,
					Variant: ui.ButtonOutline,
					Size:    ui.ButtonSM,
					Icon:    "lucide--share-2",
				}) {
					Sharing
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    mcpServerSettingsBase + "/new",
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--plus",
				}) {
					New server
				}
			}
		}
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageErrorNotice("MCP servers unavailable", data.LoadErr)
		} else if len(data.Servers) == 0 {
			@ui.EmptyState(ui.EmptyStateProps{
				Icon:        "lucide--server",
				Title:       "No MCP servers yet",
				Description: "Register an MCP server to give agents tools from external sources — a local command, an SSE endpoint, or an HTTP API.",
				Bordered:    true,
				Class:       "py-12",
				ActionHref:  mcpServerSettingsBase + "/new",
				ActionLabel: "Register a server",
				ActionIcon:  "lucide--plus",
			})
		} else {
			@sectionCount(countLabel(len(data.Servers), "server", "servers"))
			@components.TableCard(nil) {
				<div class="flex flex-col divide-y divide-base-200">
					for _, srv := range data.Servers {
						@mcpServerRow(srv)
					}
				</div>
			}
		}
		@mcpToolInvokeDialog()
		@mcpServersScript()
	}
}

// mcpServerRow is one registry entry: a collapsible <details> whose summary
// shows the server identity (name, transport badge, enabled badge, cached
// tool count) and whose body lists the cached tools. Builtin servers render
// read-only: no action buttons, no enabled toggle, no per-tool toggles. The
// builtin row shows "Memory tools" with a package mark and a "Built-in" badge
// instead of the literal name + duplicated type badge; its cached tools render
// grouped by capability, fetched when the row is first opened (see
// mcpServerToolsList).
templ mcpServerRow(srv MCPServer) {
	{{ builtin := mcpServerIsBuiltin(srv) }}
	<details
		class="group rounded-box border border-base-content/10 bg-base-200/40"
		data-mcp-row
		data-mcp-server={ srv.ID }
	>
		<summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2.5 select-none [&::-webkit-details-marker]:hidden">
			<div class="flex min-w-0 items-center gap-2.5">
				@ui.IconSpan(mcpServerSummaryIcon(srv), mcpServerSummaryIconClass(srv))
				<span class="truncate text-sm font-medium">{ mcpServerDisplayName(srv) }</span>
				if builtin {
					@ui.Badge(ui.BadgeProps{Label: "Built-in", Variant: ui.BadgePrimary, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: "lucide--package"})
				} else {
					@ui.Badge(ui.BadgeProps{Label: mcpServerTransportForDisplay(srv.Type), Variant: mcpServerBadgeIntent(srv.Type), Size: ui.BadgeSizeXS})
				}
			if srv.Enabled {
				@ui.Badge(ui.BadgeProps{Label: "enabled", Variant: ui.BadgeSuccess, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: "lucide--check"})
			} else {
				@ui.Badge(ui.BadgeProps{Label: "disabled", Variant: ui.BadgeNeutral, Size: ui.BadgeSizeXS, Icon: "lucide--pause"})
			}
			if mcpServerIsDevice(srv) {
				@ui.Badge(ui.BadgeProps{
					Label:   "device",
					Variant: ui.BadgeInfo,
					Style:   ui.BadgeStyleSoft,
					Size:    ui.BadgeSizeXS,
					Icon:    "lucide--monitor-smartphone",
					Attrs:   templ.Attributes{"data-testid": "mcp-device-badge", "data-mcp-target": srv.ID},
				})
				if srv.TargetInstanceID != "" {
					<span class="text-muted-faint truncate font-mono text-[11px]" data-testid="mcp-device-instance">{ srv.TargetInstanceID }</span>
				}
			}
			if srv.NeedsConfiguration {
				@ui.Badge(ui.BadgeProps{
					Label:   "Needs configuration",
					Variant: ui.BadgeWarning,
					Style:   ui.BadgeStyleSoft,
					Size:    ui.BadgeSizeXS,
					Icon:    "lucide--triangle-alert",
					Attrs:   templ.Attributes{"data-mcp-needs-config": srv.ID},
				})
			}
		</div>
			<div class="flex shrink-0 items-center gap-2">
				@ui.Badge(ui.BadgeProps{
					Label:   countLabel(len(srv.Tools), "tool", "tools"),
					Variant: ui.BadgeGhost,
					Size:    ui.BadgeSizeXS,
					Icon:    "lucide--wrench",
					Attrs: templ.Attributes{
						"data-mcp-count": srv.ID,
					},
				})
				@ui.IconSpan("lucide--chevron-down", "size-4 shrink-0 text-muted-faint transition-transform group-open:rotate-180")
			</div>
		</summary>
		<div class="flex flex-col border-t border-base-content/10">
			if srv.NeedsConfiguration {
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-content/10 px-3 py-2">
					@ui.Alert(ui.AlertProps{
						Type:    ui.AlertWarning,
						Style:   ui.AlertStyleOutline,
						Icon:    "lucide--triangle-alert",
						Message: "Missing configuration: " + mcpMissingKeysList(srv.MissingConfigKeys) + ".",
						Attrs:   templ.Attributes{"data-mcp-needs-config-alert": srv.ID},
					})
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeLink,
						Href:    mcpServerSettingsBase + "/" + url.PathEscape(srv.ID) + "/edit?configure=1",
						Variant: ui.ButtonPrimary,
						Size:    ui.ButtonSM,
						Icon:    "lucide--settings-2",
						Attrs:   templ.Attributes{"data-mcp-configure-link": srv.ID},
					}) {
						Configure
					}
				</div>
			}
			if !builtin {
				@mcpServerRowActions(srv)
			}
			if mcpServerIsDevice(srv) {
				@mcpServerDeviceNote()
			}
			@mcpServerOAuthControls(srv)
			if srv.Type == "stdio" && !mcpServerIsDevice(srv) {
				@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSize2XS, Icon: "lucide--shield-alert", IconClass: "size-3.5 shrink-0 text-warning", Class: "px-3 pt-2"}) {
					Runs <span class="font-mono">{ srv.Command }</span> on the memory host.
				}
			}
			@mcpServerToolsList(srv)
			@mcpServerInspectArea(srv.ID)
			if !builtin {
				@mcpServerDeleteDialog(srv)
			}
		</div>
	</details>
}

// mcpServerRowActions is the expanded-body action toolbar for one external
// server: the enabled toggle and the Sync / Inspect / Edit / Delete actions.
templ mcpServerRowActions(srv MCPServer) {
	<div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-content/10 px-3 py-2">
		<label class="flex cursor-pointer items-center gap-2" title="Enable or disable this server. Disabled servers stop offering tools to agents.">
			@form.ToggleInput(form.ToggleInputProps{
				Checked: srv.Enabled,
				Class:   "toggle toggle-sm",
				Attrs: templ.Attributes{
					"aria-label":              "Enable " + srv.Name,
					"data-mcp-enabled-toggle": true,
					"data-mcp-server":         srv.ID,
				},
			})
			<span class="text-muted-strong text-xs">Enabled</span>
		</label>
		<div class="flex items-center gap-1">
			if !mcpServerIsDevice(srv) {
				@ui.Button(ui.ButtonProps{
					Type:      ui.ButtonTypeButton,
					Variant:   ui.ButtonGhost,
					Size:      ui.ButtonSM,
					Shape:     ui.ButtonShapeSquare,
					Icon:      "lucide--refresh-cw",
					AriaLabel: "Sync " + srv.Name,
					Attrs: templ.Attributes{
						"data-mcp-action": "sync",
						"data-mcp-server": srv.ID,
						"title":           "Re-discover tools from this server",
					},
				})
				@ui.Button(ui.ButtonProps{
					Type:      ui.ButtonTypeButton,
					Variant:   ui.ButtonGhost,
					Size:      ui.ButtonSM,
					Shape:     ui.ButtonShapeSquare,
					Icon:      "lucide--scan",
					AriaLabel: "Inspect " + srv.Name,
					Attrs: templ.Attributes{
						"data-mcp-action": "inspect",
						"data-mcp-server": srv.ID,
						"title":           "Probe this server's capabilities",
					},
				})
			}
			@ui.Button(ui.ButtonProps{
				Type:      ui.ButtonTypeLink,
				Href:      mcpServerSettingsBase + "/" + url.PathEscape(srv.ID) + "/edit",
				Variant:   ui.ButtonGhost,
				Size:      ui.ButtonSM,
				Shape:     ui.ButtonShapeSquare,
				Icon:      "lucide--sliders-horizontal",
				AriaLabel: "Edit " + srv.Name,
				Attrs:     templ.Attributes{"title": "Edit connection details"},
			})
			@ui.Button(ui.ButtonProps{
				Type:      ui.ButtonTypeButton,
				Variant:   ui.ButtonGhost,
				Size:      ui.ButtonSM,
				Shape:     ui.ButtonShapeSquare,
				Icon:      "lucide--trash-2",
				ExtraClass: "text-error hover:text-error",
				AriaLabel: "Delete " + srv.Name,
				OnClick:   templ.JSFuncCall("openDialogByID", "mcp-server-delete-"+srv.ID),
			})
		</div>
	</div>
}

// mcpServerDeviceNote is the expanded-body strip for a device-targeted server:
// it tells the admin the server runs on a connector (pushed over the relay)
// rather than being connected outbound by the shared host, and so the row
// offers no sync/inspect/connect affordances.
templ mcpServerDeviceNote() {
	<div class="flex items-center gap-2 border-b border-base-content/10 px-3 py-2" data-testid="mcp-device-note">
		@ui.IconSpan("lucide--monitor-smartphone", "size-4 shrink-0 text-muted-faint")
		@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS}) {
			Runs on a connector device — Memory pushes this server's configuration over the relay; it is never connected outbound by the shared host.
		}
	</div>
}

// mcpServerOAuthControls is the expanded-body OAuth connect/disconnect strip for
// one remote (http/sse) server that participates in OAuth connect. It renders
// nothing for builtin, stdio, or non-OAuth servers. When the server is
// connected it shows a "Connected" chip (with the authorization server as
// secondary text) plus a Disconnect action; otherwise a Connect action. Below
// the connect strip it also offers a pre-registered-client form (for providers
// that reject dynamic registration) and, when one is stored, a "Client
// configured" chip plus a Clear action.
templ mcpServerOAuthControls(srv MCPServer) {
	if mcpServerOAuthShown(srv) {
		<div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-content/10 px-3 py-2">
			if srv.OAuth.Connected {
				<div class="flex min-w-0 items-center gap-2" data-testid="mcp-oauth-status">
					@ui.Badge(ui.BadgeProps{Label: "Connected", Variant: ui.BadgeSuccess, Size: ui.BadgeSizeXS, Dot: true})
					if srv.OAuth.AuthorizationServer != nil && *srv.OAuth.AuthorizationServer != "" {
						<span class="text-muted-faint truncate text-[11px]">{ *srv.OAuth.AuthorizationServer }</span>
					}
				</div>
				<form method="post" action={ templ.URL(mcpServerSettingsBase + "/" + url.PathEscape(srv.ID) + "/oauth/disconnect") }>
					@ui.Button(ui.ButtonProps{
						Type:      ui.ButtonTypeSubmit,
						Variant:   ui.ButtonGhost,
						Size:      ui.ButtonSM,
						Icon:      "lucide--unplug",
						AriaLabel: "Disconnect " + srv.Name,
						Attrs:     templ.Attributes{"data-testid": "mcp-oauth-disconnect"},
					}) {
						Disconnect
					}
				</form>
			} else {
				<div class="flex min-w-0 items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Not connected", Variant: ui.BadgeNeutral, Size: ui.BadgeSizeXS, Dot: true})
				</div>
				// hx-boost is off: the handler redirects to the provider's
				// authorization server (cross-origin), which a boosted fetch
				// (mode: same-origin) cannot follow. The browser must navigate.
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    mcpServerSettingsBase + "/" + url.PathEscape(srv.ID) + "/oauth/start",
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--plug-zap",
					Attrs:   templ.Attributes{"data-testid": "mcp-oauth-connect", "hx-boost": "false"},
				}) {
					Connect
				}
			}
		</div>
		if srv.OAuth.ClientConfigured {
			<div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-content/10 px-3 py-2" data-testid="mcp-oauth-client-status">
				<div class="flex min-w-0 items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Client configured", Variant: ui.BadgeInfo, Size: ui.BadgeSizeXS, Dot: true})
				</div>
				<form method="post" action={ templ.URL(mcpServerSettingsBase + "/" + url.PathEscape(srv.ID) + "/oauth/client/clear") }>
					@ui.Button(ui.ButtonProps{
						Type:      ui.ButtonTypeSubmit,
						Variant:   ui.ButtonGhost,
						Size:      ui.ButtonSM,
						Icon:      "lucide--trash-2",
						AriaLabel: "Clear OAuth client for " + srv.Name,
						Attrs:     templ.Attributes{"data-testid": "mcp-oauth-client-clear"},
					}) {
						Clear
					}
				</form>
			</div>
		}
		@ui.Disclosure(ui.DisclosureProps{
			DetailsBase: "rounded-box border border-base-content/10 bg-base-200/40",
			Attrs:       templ.Attributes{"data-testid": "mcp-oauth-client-disclosure"},
		}, mcpOAuthClientDisclosureLeading()) {
			<form method="post" action={ templ.URL(mcpServerSettingsBase + "/" + url.PathEscape(srv.ID) + "/oauth/client") } data-testid="mcp-oauth-client-form">
				<div class="flex flex-col gap-3">
					@form.FormControl("mcp-oauth-client-id", "Client ID", form.LabelAbove, "The client ID your authorization provider issued.", "", nil) {
						<input id="mcp-oauth-client-id" name="client_id" type="text" required class="input w-full font-mono" autocomplete="off"/>
					}
					@form.FormControl("mcp-oauth-client-secret", "Client secret", form.LabelAbove, "Optional — leave blank if your provider issued only a client ID.", "", nil) {
						<input id="mcp-oauth-client-secret" name="client_secret" type="password" class="input w-full font-mono" autocomplete="off"/>
					}
				</div>
				<div class="flex items-center justify-end gap-2">
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonPrimary,
						Size:    ui.ButtonSM,
						Icon:    "lucide--key-round",
						Attrs:   templ.Attributes{"data-testid": "mcp-oauth-client-save"},
					}) {
						Save client
					}
				</div>
			</form>
		}
	}
}

// mcpOAuthClientDisclosureLeading is the pre-registered-client disclosure's
// summary: a key icon plus the short literal label.
templ mcpOAuthClientDisclosureLeading() {
	<div class="flex min-w-0 flex-col gap-0.5">
		<div class="flex min-w-0 items-center gap-2.5">
			@ui.IconSpan("lucide--key-round", "size-4 shrink-0 text-muted-faint")
			<span class="truncate text-sm font-medium">Use a pre-registered OAuth client</span>
		</div>
	</div>
}

// mcpServerToolsList renders the "Cached tools" section for one server. The
// rows are NOT part of the page: a project whose builtin catalogue is fully
// populated carries ~140 kB of tool-row markup — half the page's weight — inside
// a row the user has not opened (#210). The rows are fetched on the row's first
// expand and swapped into data-mcp-tools-host, which is also the hook a
// completed sync swaps into (mcpToolsFragment).
templ mcpServerToolsList(srv MCPServer) {
	<div class="flex flex-col">
		<div class="flex items-center justify-between px-3 pt-2">
			@ui.Eyebrow("Cached tools", ui.EyebrowProps{Size: "text-[10px]", Margin: ""})
			if len(srv.Tools) > 0 && !mcpServerIsBuiltin(srv) && !mcpServerIsDevice(srv) {
				<span class="text-muted-faint text-[10px]">sync refreshes this list</span>
			}
		</div>
		<div data-mcp-tools-host={ srv.ID } data-mcp-tools-url={ mcpServerToolsFragmentPath(srv.ID) }>
			@mcpServerToolsPlaceholder(srv)
		</div>
	</div>
}

// mcpServerToolsPlaceholder stands in for the rows until the row is opened. It
// keeps the data-mcp-tools hook so a sync that lands before the first expand
// replaces it exactly as it replaces a loaded container.
templ mcpServerToolsPlaceholder(srv MCPServer) {
	<div class="flex flex-col" data-mcp-tools={ srv.ID }>
		<div class="text-muted-faint px-3 py-2 text-[11px]" data-mcp-tools-pending>
			if mcpServerIsDevice(srv) {
				Expand to load the tools discovered on the device.
			} else {
				Expand to load the cached tools.
			}
		</div>
	</div>
}

// mcpServerToolsError is the rows container's content when the deferred fetch
// fails. htmx does not swap a non-2xx response, so the failure has to arrive as
// readable markup instead of a status code.
templ mcpServerToolsError(serverID string, msg string) {
	<div class="flex flex-col" data-mcp-tools={ serverID }>
		@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS, Class: "px-3 py-2"}) {
			Could not load cached tools: { msg }
		}
	</div>
}

// mcpServerToolsContainer is the data-mcp-tools rows container for one
// server's cached tools: per-tool rows (with toggle-sm for external servers,
// read-only for builtin) or the no-tools hint. Rendered identically on the
// initial page and into the sync JSON payload. For the builtin server with a
// non-empty taxonomy it switches to the grouped view (mcpServerBuiltinTools);
// external servers always render the flat list.
templ mcpServerToolsContainer(srv MCPServer, tools []MCPTool, builtinGroups []BuiltinToolGroup) {
	<div class="flex flex-col" data-mcp-tools={ srv.ID }>
		if len(tools) == 0 {
			@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS, Class: "px-3 py-2"}) {
				No tools cached yet
				if !mcpServerIsBuiltin(srv) {
					if mcpServerIsDevice(srv) {
						— tools are discovered on the device.
					} else {
						— run Sync to discover what this server offers.
					}
				} else {
					.
				}
			}
		} else if mcpServerIsBuiltin(srv) && len(builtinGroups) > 0 {
			@mcpServerBuiltinTools(srv, tools, builtinGroups)
		} else {
			for _, t := range tools {
				@mcpServerToolRow(srv, t)
			}
		}
	</div>
}

// mcpServerBuiltinTools renders the builtin server's cached tools grouped by
// memory's capability taxonomy, mirroring the agent tool picker's grouped
// language: one collapsed Disclosure per group (layers icon + label + tool
// count + optional description). Cached tools the taxonomy does not cover stay
// reachable in the dashed "Other" fallback.
templ mcpServerBuiltinTools(srv MCPServer, tools []MCPTool, builtinGroups []BuiltinToolGroup) {
	{{ grouped, other := mcpBuiltinToolGroups(tools, builtinGroups) }}
	<div class="flex flex-col gap-2 p-3" data-mcp-builtin-groups>
		for _, gv := range grouped {
			@mcpBuiltinToolGroup(srv, gv)
		}
		if len(other) > 0 {
			@mcpBuiltinOtherGroup(srv, other)
		}
	</div>
}

// mcpBuiltinToolGroup is one capability group inside the builtin server's
// grouped tool view: a collapsed ui.Disclosure (default collapsed — the builtin
// source carries well over a hundred tools) whose header shows the group label,
// member count, and optional description, and whose body lists the group's
// cached tool rows. The named `group/cap` keeps nested disclosure chevrons
// independent.
templ mcpBuiltinToolGroup(srv MCPServer, gv mcpBuiltinToolGroupView) {
	@ui.Disclosure(ui.DisclosureProps{
		GroupClass:  "group/cap",
		ItemsStart:  true,
		DetailsBase: "rounded-box border border-base-content/10",
		Attrs:       templ.Attributes{"data-testid": "mcp-builtin-group", "data-mcp-group": gv.Group.ID},
		SummaryAttrs: templ.Attributes{
			"data-testid": "mcp-builtin-group-header-" + gv.Group.ID,
		},
	}, mcpBuiltinGroupLeading(gv), agentToolCountBadge(len(gv.Rows))) {
		<div class="flex flex-col divide-y divide-base-content/10 overflow-hidden rounded-box border border-base-content/10">
			for _, t := range gv.Rows {
				@mcpServerToolRow(srv, t)
			}
		</div>
	}
}

// mcpBuiltinGroupLeading is a builtin capability-group header's leading block:
// the layers icon, the group label, and the optional description — matching
// the agent tool picker's capability-group header.
templ mcpBuiltinGroupLeading(gv mcpBuiltinToolGroupView) {
	<div class="flex min-w-0 flex-col gap-0.5">
		<div class="flex min-w-0 items-center gap-2.5">
			@ui.IconSpan("lucide--layers", "size-4 shrink-0 text-muted-faint")
			<span class="truncate text-sm font-medium">{ gv.Group.Label }</span>
		</div>
		if gv.Group.Description != "" {
			@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "truncate pl-[26px]"}) {
				{ gv.Group.Description }
			}
		}
	</div>
}

// mcpBuiltinOtherGroup is the builtin grouped view's dashed "Other" fallback,
// mirroring the agent picker's other container: it keeps cached tools no
// capability group covers reachable (so they can still be run from here).
templ mcpBuiltinOtherGroup(srv MCPServer, tools []MCPTool) {
	<div class="rounded-box border border-dashed border-base-content/20 bg-base-200/40 p-3" data-testid="mcp-builtin-group-other">
		@ui.Eyebrow("Other", ui.EyebrowProps{Size: "text-[11px]"})
		@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-0.5 mb-2"}) {
			Not part of a capability group.
		}
		<div class="flex flex-col divide-y divide-base-content/10">
			for _, t := range tools {
				@mcpServerToolRow(srv, t)
			}
		</div>
	</div>
}

// mcpServerToolRow is one cached tool row: a toggle-sm (external servers)
// plus the tool name (mono) and its muted description, mirroring the agent
// tool picker row visuals. Builtin rows drop the toggle (read-only). Every row
// carries a "Run" affordance that opens the shared invoke dialog pre-filled
// with this row's server + tool.
templ mcpServerToolRow(srv MCPServer, t MCPTool) {
	<div class="flex items-center gap-2.5 px-3 py-1.5" data-mcp-tool-row>
		if !mcpServerIsBuiltin(srv) {
			@form.ToggleInput(form.ToggleInputProps{
				Checked: t.Enabled,
				Class:   "toggle toggle-sm shrink-0",
				Attrs: templ.Attributes{
					"aria-label":           "Toggle " + t.ToolName,
					"data-mcp-tool-toggle": true,
					"data-mcp-server":      srv.ID,
					"data-mcp-tool":        t.ID,
				},
			})
		}
		<span class="min-w-0 flex-1">
			<span class="block font-mono text-[13px] font-medium">{ t.ToolName }</span>
			if t.Description != "" {
				<span class="text-muted block truncate text-xs">{ t.Description }</span>
			}
		</span>
		@ui.Button(ui.ButtonProps{
			Type:       ui.ButtonTypeButton,
			Variant:    ui.ButtonGhost,
			Size:       ui.ButtonSM,
			Shape:      ui.ButtonShapeSquare,
			Icon:       "lucide--play",
			ExtraClass: "shrink-0",
			AriaLabel:  "Run " + t.ToolName,
			Attrs: templ.Attributes{
				"data-mcp-invoke-open": true,
				"data-mcp-server":      srv.ID,
				"data-mcp-tool":        t.ToolName,
				"data-testid":          "mcp-tool-run",
				"title":                "Run this tool with arguments",
			},
		})
	</div>
}

// mcpToolInvokeDialog is the single shared per-page invoke dialog the tool rows
// open: a JSON-arguments textarea (empty = no arguments), a Run button, and a
// result region. The dialog's server + tool are set by mcpServersScript when a
// row's Run button is clicked; the result is built as DOM nodes (never
// innerHTML) since tool output is untrusted.
templ mcpToolInvokeDialog() {
	@ui.Dialog(ui.DialogProps{
		ID:       "mcp-tool-invoke-dialog",
		BoxClass: "max-w-2xl",
		Attrs:    templ.Attributes{"data-testid": "mcp-tool-invoke-dialog"},
	}) {
		<div class="flex flex-col gap-3">
			<div class="flex min-w-0 items-start justify-between gap-3">
				<div class="flex min-w-0 flex-col gap-0.5">
					<div class="flex items-center gap-2">
						@ui.IconSpan("lucide--play", "size-4 shrink-0 text-primary")
						<span class="text-sm font-semibold">Run tool</span>
					</div>
					<span class="text-muted truncate font-mono text-xs" data-mcp-invoke-title data-testid="mcp-tool-invoke-title"></span>
				</div>
			</div>
			@form.FormControl("mcp-tool-invoke-args", "Arguments", form.LabelAbove, "Optional JSON object passed as the tool's arguments. Leave empty to run with no arguments.", "", nil) {
				<textarea id="mcp-tool-invoke-args" name="arguments" rows="5" placeholder="{}" class="textarea w-full resize-y font-mono" data-testid="mcp-tool-invoke-args"></textarea>
			}
			<p class="text-error -mt-2 text-xs" data-mcp-invoke-args-error data-testid="mcp-tool-invoke-args-error" hidden></p>
			<div class="flex items-center justify-end gap-2">
				<form method="dialog">
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonGhost,
						Size:    ui.ButtonSM,
						Attrs:   templ.Attributes{"data-testid": "mcp-tool-invoke-close"},
					}) {
						Close
					}
				</form>
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeButton,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--play",
					Attrs: templ.Attributes{
						"data-mcp-invoke-run": "",
						"data-testid":         "mcp-tool-invoke-run",
					},
				}) {
					Run
				}
			</div>
			<div data-mcp-invoke-result data-testid="mcp-tool-invoke-result" hidden></div>
		</div>
	}
}

// mcpServerInspectArea is the per-row target for the inspect result rendered
// by mcpServersScript after a POST /inspect round-trip (D5). Empty until the
// user inspects a server.
templ mcpServerInspectArea(serverID string) {
	<div class="border-t border-base-content/10 px-3 py-2" data-mcp-inspect-area={ serverID } hidden></div>
}

// mcpServerDeleteDescription is the delete-confirm detail paragraph.
templ mcpServerDeleteDescription(srv MCPServer) {
	@components.DeleteWarning(srv.Name, "and its cached tools. Agents referencing its tools stop offering them immediately. Irreversible.")
}

// mcpServerDeleteDialog confirms deletion before the POST to
// /settings/mcp-servers/:id/delete. One dialog per row (its action is fixed).
templ mcpServerDeleteDialog(srv MCPServer) {
	@ui.ConfirmDialog(ui.ConfirmDialogProps{ID: "mcp-server-delete-" + srv.ID, Noun: "MCP server"}, mcpServerDeleteDescription(srv)) {
		<form method="post" action={ templ.URL(mcpServerSettingsBase + "/" + url.PathEscape(srv.ID) + "/delete") }>
			@form.FormActions("", "") {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Attrs:   templ.Attributes{"formmethod": "dialog"},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonError,
					Size:    ui.ButtonSM,
					Icon:    "lucide--trash-2",
				}) {
					Delete server
				}
			}
		</form>
	}
}

// MCPServerNewPage renders the create page (GET /settings/mcp-servers/new):
// name + transport choice + transport fields, posting to POST .../new.
// ?err= surfaces PRG feedback from the create flow; FieldErrs render inline
// under the offending field groups on validation re-renders.
templ MCPServerNewPage(data mcpServerFormData) {
	<div class={ pageFormChromeClass } data-mcp-form="">
		@detailHeader(crumbsActive(nav.Crumbs("Settings", "/settings", "MCP Servers", mcpServerSettingsBase, "New server")), "", "New MCP server", "Name the server and pick a transport — stdio runs a command on the memory host, sse/http dial a remote endpoint.", detailHeaderOpts{Margin: "mb-6"}) {}
		@flashToasts("", data.FlashErr)
	</div>
	@mcpServerFormBody(data, false)
	@mcpServersScript()
}

// MCPServerEditPage renders the edit page (GET /settings/mcp-servers/:id/edit):
// the server's connection details pre-filled, posting to POST .../:id/update.
// LoadErr / NotFound render their own states; ?err= surfaces PRG feedback.
templ MCPServerEditPage(data mcpServerFormData) {
	{{ crumbs := crumbsActive(nav.Crumbs("Settings", "/settings", "MCP Servers", mcpServerSettingsBase, "Edit server")) }}
	if data.LoadErr != nil {
		@layout.Container(layout.ContainerLG, templ.Attributes{"data-mcp-form": ""}) {
			@detailHeader(crumbs, "", "Edit server", "", detailHeaderOpts{Margin: "mb-6"}) {}
			@pageErrorNotice("Server unavailable", data.LoadErr)
			@mcpServersScript()
		}
	} else if data.NotFound || data.ID == "" {
		@layout.Container(layout.ContainerLG, templ.Attributes{"data-mcp-form": ""}) {
			@detailHeader(crumbs, "", "Edit server", "", detailHeaderOpts{Margin: "mb-6"}) {}
			@ui.EmptyState(ui.EmptyStateProps{
				Icon:        "lucide--server",
				Title:       "MCP server not found",
				Description: "No MCP server with this id.",
				Bordered:    true,
			})
			@mcpServersScript()
		}
	} else {
		{{ title, subtitle := mcpFormPageHeading(true, data.Name) }}
		<div class={ pageFormChromeClass } data-mcp-form="">
			@detailHeader(crumbs, "", title, subtitle, detailHeaderOpts{Margin: "mb-6"}) {}
			@flashToasts("", data.FlashErr)
			if data.ConfigureMode && len(data.MissingConfigKeys) > 0 {
				@ui.Alert(ui.AlertProps{
					Type:    ui.AlertWarning,
					Style:   ui.AlertStyleOutline,
					Icon:    "lucide--triangle-alert",
					Message: "This server needs configuration before it can be enabled. Missing: " + mcpMissingKeysList(data.MissingConfigKeys) + ".",
					Attrs:   templ.Attributes{"data-mcp-configure-banner": data.ID},
				})
				{{ details := mcpMissingConfigDetails(data.MissingConfigKeys, data.RequiredConfig) }}
				{{ docsLabel, docsHref := mcpCredentialDocs(data.RegistryRepositoryURL) }}
				@ui.SoftBox(ui.SoftBoxProps{Padding: "px-3 py-2.5", Class: "-mt-3", Attrs: templ.Attributes{"data-mcp-configure-help": data.ID}}) {
					<ul class="flex flex-col gap-1.5">
						for _, det := range details {
							<li class="text-xs leading-snug">
								<span class="font-mono text-base-content/80">{ det.Name }</span>
								if det.Description != "" {
									<span class="text-muted"> — { det.Description }</span>
								}
							</li>
						}
					</ul>
					if docsHref != "" {
						<a class="link link-primary mt-1.5 inline-block text-xs" href={ templ.URL(docsHref) } target="_blank" rel="noopener noreferrer" data-mcp-credential-docs={ data.ID }>{ docsLabel }</a>
					}
				}
			}
		</div>
		@mcpServerFormBody(data, true)
		@mcpServersScript()
	}
}

// mcpServerFormBody is the shared create/edit form card. editing selects the
// POST target (/new vs /:id/update), the submit label, and whether the
// transport radio group shows the transport-change hint (edit lets the user
// switch a server's transport; memory clears the previous transport's
// connection fields).
templ mcpServerFormBody(data mcpServerFormData, editing bool) {
	{{ action := mcpServerSettingsBase + "/new"
	if editing {
		action = mcpServerSettingsBase + "/" + url.PathEscape(data.ID) + "/update"
	} }}
	<form method="post" action={ templ.URL(action) } data-mcp-form-fields hx-disable="find button.memory-save-btn">
		<div class={ pageFormFieldsClass }>
			@components.PanelCard("", nil) {
				<div class="flex flex-col gap-4">
					if editing {
						<input type="hidden" name="serverId" value={ data.ID }/>
					}
					@form.FormControl("mcp-server-name", "Name", form.LabelAbove, "Unique within this project. Agents reference servers by name.", data.FieldErrs.Name, nil) {
						<input id="mcp-server-name" name="name" type="text" required maxlength="255" value={ data.Name } placeholder="e.g. github-mcp-server" class="input w-full"/>
					}
					@mcpServerTransportGroup(data, editing)
					if data.GeneralErr != nil {
						@ui.Alert(ui.AlertProps{
							Type:    ui.AlertError,
							Style:   ui.AlertStyleOutline,
							Icon:    "lucide--alert-triangle",
							Message: data.GeneralErr.Error(),
						})
					}
					@mcpServerTransportFields(data)
					<label class="label flex w-full justify-between gap-3">
						<span class="text-sm font-medium">Enabled</span>
						<input id="mcp-server-enabled" name="enabled" type="checkbox" checked?={ data.Enabled } class="checkbox"/>
					</label>
					<div data-mcp-test-result hidden></div>
				</div>
			}
		</div>
		@components.StickyFormActions(components.StickyFormActionsProps{}) {
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeButton,
				Variant: ui.ButtonOutline,
				Size:    ui.ButtonSM,
				Icon:    "lucide--plug-zap",
				Attrs:   templ.Attributes{"data-mcp-test": ""},
			}) {
				Test connection
			}
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    mcpServerSettingsBase,
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--x",
			}) {
				Cancel
			}
			if editing {
				@components.SaveChangesButton()
			} else {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--server",
				}) {
					Create server
				}
			}
		}
	</form>
}

// mcpServerTransportGroup renders the transport radio picker (stdio/sse/http).
// Panels show/hide via mcpServersScript; the type fieldset error renders under
// the radios. In edit mode a muted hint explains that switching transport
// replaces the previous transport's connection settings.
templ mcpServerTransportGroup(data mcpServerFormData, editing bool) {
	<div class="flex flex-col gap-1.5">
		@ui.Eyebrow("Transport", ui.EyebrowProps{Size: "text-[11px]", Margin: ""})
		<div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
			for _, t := range mcpTransportOptions {
				<label class="flex cursor-pointer items-start gap-2 rounded-box border border-base-content/10 bg-base-100 px-3 py-2 transition-colors hover:border-base-content/25">
					<input type="radio" name="type" value={ t.Value } class="radio radio-sm mt-0.5" data-mcp-transport checked?={ data.Type == t.Value || (!editing && data.Type == "" && t.Value == "stdio") }/>
					<span class="min-w-0">
						<span class="block font-mono text-xs font-medium">{ t.Title }</span>
						<span class="text-muted block text-[11px] leading-snug">{ t.Desc }</span>
					</span>
				</label>
			}
		</div>
		if editing {
			@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSize2XS}) {
				Changing transport replaces the previous transport's connection settings.
			}
		}
		if data.FieldErrs.Type != "" {
			<p class="text-error text-xs">{ data.FieldErrs.Type }</p>
		}
	</div>
}

// mcpServerTransportFields renders the transport-conditional connection
// fields. Both panels stay in the DOM (a no-JS submission is still safe: the
// server maps only the selected transport's fields); mcpServersScript shows
// the panel matching the checked radio. sse and http share one remote panel —
// their fields (url + headers) are identical.
templ mcpServerTransportFields(data mcpServerFormData) {
	{{ remote := data.Type == "sse" || data.Type == "http" }}
	<div class="flex flex-col gap-4">
		<div data-mcp-transport-panel="stdio" hidden?={ remote }>
			@form.FormControl("mcp-server-command", "Command", form.LabelAbove, "The process memory spawns on its host. Include the full path or a resolvable binary.", data.FieldErrs.Command, nil) {
				<input id="mcp-server-command" name="command" type="text" value={ data.Command } placeholder="e.g. npx -y @modelcontextprotocol/server-github" class="input w-full font-mono"/>
			}
			<div class="mt-3">
				@form.FormControl("mcp-server-args", "Arguments", form.LabelAbove, "One argument per line, passed to the command in order.", "", nil) {
					<textarea id="mcp-server-args" name="args" rows="3" class="textarea w-full resize-none font-mono">{ mcpArgsText(data.Args) }</textarea>
				}
			</div>
			<div class="mt-3">
				@mcpServerKVEditor("mcp-server-env", "env", "Environment variables", "KEY=VALUE pairs set on the spawned process.", data.Env, data.FieldErrs.Env)
			</div>
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertWarning,
				Style:   ui.AlertStyleOutline,
				Icon:    "lucide--shield-alert",
				Message: "stdio servers run a process on the memory host with the environment and arguments below — same trust boundary as the backend itself.",
			})
		</div>
		<div data-mcp-transport-panel="remote" hidden?={ !remote }>
			@form.FormControl("mcp-server-url", "Server URL", form.LabelAbove, "The endpoint this server listens on.", data.FieldErrs.URL, nil) {
				<input id="mcp-server-url" name="url" type="text" value={ data.URL } placeholder="https://mcp.example.com/sse" class="input w-full font-mono"/>
			}
			<div class="mt-3">
				@mcpServerKVEditor("mcp-server-headers", "headers", "HTTP headers", "Optional headers sent with every request — e.g. an Authorization token.", data.Headers, data.FieldErrs.Headers)
			</div>
		</div>
	</div>
}

// mcpServerKVEditor renders a key/value row editor with an add-row button.
// The rows post as name="<prefix>.key"/"<prefix>.value" pairs plus an
// always-submitted name="<prefix>.secret" select (Plain -> "", Secret -> "1")
// and are parsed back by mcpKVFieldsFromForm. The select (rather than a
// checkbox) is what keeps the secret values index-aligned with their rows:
// unchecked checkboxes are simply omitted from the POST body.
// inputNamePrefix matches the data-mcp-kv grouping used by mcpServersScript.
templ mcpServerKVEditor(id, prefix, label, hint string, rows []mcpKVField, fieldErr string) {
	@form.FormControl(id, label, form.LabelAbove, hint, fieldErr, nil) {
		<div class="flex flex-col gap-1.5" data-mcp-kv data-mcp-kv-prefix={ prefix }>
			for _, r := range rows {
				@mcpServerKVRow(prefix, r)
			}
			@mcpServerKVRow(prefix, mcpKVField{})
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Icon: "lucide--plus", ExtraClass: "mt-1 self-start", Attrs: templ.Attributes{"data-mcp-kv-add": ""}}) { Add row }
		</div>
		@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS, Class: "mt-2"}) {
			Values are stored in plaintext and shown only in this form. Mark a value Secret to store it write-only — after saving it is never shown again, and leaving it blank keeps the stored value.
		}
	}
}

// mcpKVValuePlaceholder tweaks the value input's placeholder for the row's
// required/missing state: a missing required secret row prompts for the value
// (it has no stored secret yet), a non-missing secret row keeps the
// leave-blank contract, and a plain row just says "Value".
func mcpKVValuePlaceholder(secret, missing bool) string {
	if missing {
		return "Enter value"
	}
	if secret {
		return "Leave blank to keep stored value"
	}
	return "Value"
}

// mcpKVValuePlaceholderFor picks the value input's placeholder: a registry
// value template (ValueHint) wins when present so the user sees the expected
// shape (e.g. "Bearer {API_TOKEN}"); otherwise the required/missing secret-state
// copy applies. The template is only ever a placeholder — never prefilled.
func mcpKVValuePlaceholderFor(r mcpKVField) string {
	if r.Placeholder != "" {
		return r.Placeholder
	}
	return mcpKVValuePlaceholder(r.Secret, r.Missing)
}

// mcpKVSecretTitle is the secret-select tooltip copy.
func mcpKVSecretTitle() string {
	return "Store this value as a secret — it is write-only and never shown again."
}

// mcpServerKVRow is one key/value input row plus a Secret select (a blank row
// is always appended so the user can add the first pair without JS). Secret
// rows pre-fill with an empty value and carry a "leave blank to keep" hint;
// required rows carry a "Required" marker, the registry's guidance (Hint) when
// declared, and a missing required row prompts for a value instead. A required
// key's registry value template, when present, becomes the value input's
// placeholder. The select always submits, so its index stays aligned with the
// key/value inputs even when earlier rows are Plain.
//
// A required Authorization header (r.Auth) renders instead as a scheme picker
// plus a token field: the key is fixed, the secret is implied, and submit
// assembles "<scheme> <token>". Every row posts .auth/.scheme hidden fields (even
// when empty for plain rows) so the arrays stay index-aligned with .key/.value.
templ mcpServerKVRow(prefix string, r mcpKVField) {
	<div class="flex flex-col gap-1" data-mcp-kv-row>
		<div class="flex items-center gap-1.5">
			if r.Auth {
				<input type="hidden" name={ prefix + ".key" } value={ r.Key }/>
				<input type="hidden" name={ prefix + ".auth" } value="1"/>
				<input type="hidden" name={ prefix + ".secret" } value="1"/>
				<select name={ prefix + ".scheme" } class="select select-sm shrink-0" aria-label="Authorization scheme" data-mcp-kv-scheme>
					for _, opt := range mcpAuthSchemeOptions(r.AuthScheme) {
						<option value={ opt.Value } selected?={ opt.Value == r.AuthScheme }>{ opt.Label }</option>
					}
				</select>
				<input type="text" name={ prefix + ".value" } value="" placeholder={ mcpAuthTokenPlaceholder(r) } class="input input-sm min-w-0 flex-1 font-mono" autocomplete="off"/>
			} else {
				<input type="text" name={ prefix + ".key" } value={ r.Key } placeholder="Name" class="input input-sm min-w-0 flex-1 font-mono"/>
				<input type="text" name={ prefix + ".value" } value={ r.Value } placeholder={ mcpKVValuePlaceholderFor(r) } class="input input-sm min-w-0 flex-1 font-mono"/>
				<input type="hidden" name={ prefix + ".auth" } value=""/>
				<input type="hidden" name={ prefix + ".scheme" } value=""/>
				<select name={ prefix + ".secret" } class="select select-sm shrink-0" title={ mcpKVSecretTitle() } aria-label="Row visibility">
					<option value="" selected?={ !r.Secret }>Plain</option>
					<option value="1" selected?={ r.Secret }>Secret</option>
				</select>
			}
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Shape: ui.ButtonShapeSquare, Icon: "lucide--x", ExtraClass: "shrink-0", AriaLabel: "Remove row", Attrs: templ.Attributes{"data-mcp-kv-remove": ""}})
			if r.Required {
				<span class="text-warning shrink-0 text-[10px] font-semibold uppercase tracking-wide" data-mcp-kv-required>Required</span>
			}
		</div>
		if r.Hint != "" {
			@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS, Class: "pl-1", Attrs: templ.Attributes{"data-mcp-kv-hint": ""}}) {
				{ r.Hint }
			}
		}
		if r.Missing {
			<p class="text-warning pl-1 text-xs" data-mcp-kv-missing>Required — enter a value.</p>
		} else if r.Secret {
			@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS, Class: "pl-1"}) {
				Leave blank to keep the stored value.
			}
		}
	</div>
}

// mcpArgsText joins one arg per line for the stdio arguments textarea.
func mcpArgsText(args []string) string {
	out := ""
	for i, a := range args {
		if i > 0 {
			out += "\n"
		}
		out += a
	}
	return out
}

// mcpServerTransportForDisplay labels a server's type for the list badge
// (stdio/sse/http/builtin; unknown types render verbatim).
func mcpServerTransportForDisplay(t string) string {
	switch t {
	case "", "stdio", "sse", "http", "builtin":
		return t
	default:
		return t
	}
}

// mcpServersScript wires the client-side behaviors of both pages (design D5):
//   - list: sync (POST → re-render cached-tool list from the returned HTML,
//     surface pruned-tool names), inspect (render the probe result into the
//     row's inspect area), server-level enabled toggle, per-tool toggles;
//   - create/edit: transport radio panel switching, kv row add/remove.
//
// Listeners attach once to document (delegation survives hx-boost swaps); the
// wiring flag prevents double-attach on in-page navigation.
templ mcpServersScript() {
	<script type="text/javascript">
		(function () {
			if (window.__mcpUIWired) return;
			var listRoot = document.querySelector('[data-mcp-list-root], [data-mcp-form]');
			if (!listRoot) return;
			window.__mcpUIWired = true;

			// Errors persist (duration 0, dismissed via the close button); every
			// other kind auto-dismisses. Mirrors toastDuration() in app.js and
			// toastDurationMs() in ui.go.
			function toast(kind, message) {
				var duration = kind === 'error' ? 0 : 4200;
				try {
					var c = document.getElementById('toast-container');
					if (c && window.Alpine) {
						var q = window.Alpine.$data(c);
						if (q && q.add) { q.add({ type: kind, message: message, duration: duration }); return; }
					}
					// Stash uses the "kind" key that flushStashedToast (app.js) reads.
					sessionStorage.setItem('memory-toast', JSON.stringify({ kind: kind, message: message }));
				} catch (e) {}
			}
			function plural(n) { return n === 1 ? '' : 's'; }
			function rowFor(el) { return el.closest('[data-mcp-row]'); }
			function setBusy(btn, busy) { if (btn) btn.disabled = busy; }

			async function readJSON(resp) {
				var j = null;
				try { j = await resp.json(); } catch (e) {}
				return j || {};
			}

			async function syncServer(btn) {
				var id = btn.getAttribute('data-mcp-server');
				setBusy(btn, true);
				try {
					var resp = await fetch('/api/mcp-servers/' + encodeURIComponent(id) + '/sync', { method: 'POST' });
					var j = await readJSON(resp);
					if (!resp.ok) {
						toast('error', j.error || ('Sync failed (' + resp.status + ').'));
						return;
					}
					var tools = j.tools || [];
					var panel = document.querySelector('[data-mcp-tools="' + id + '"]');
					if (panel && j.html) panel.outerHTML = j.html;
					var count = document.querySelector('[data-mcp-count="' + id + '"]');
					if (count) count.textContent = tools.length + ' tool' + plural(tools.length);
					var msg = 'Synced — ' + tools.length + ' tool' + plural(tools.length) + '.';
					if (j.pruned && j.pruned.length) {
						msg += ' Removed: ' + j.pruned.join(', ');
					}
					toast('success', msg);
				} finally {
					setBusy(btn, false);
				}
			}

			async function inspectServer(btn) {
				var id = btn.getAttribute('data-mcp-server');
				setBusy(btn, true);
				try {
					var resp = await fetch('/api/mcp-servers/' + encodeURIComponent(id) + '/inspect', { method: 'POST' });
					var j = await readJSON(resp);
					if (!resp.ok) {
						toast('error', j.error || ('Inspect failed (' + resp.status + ').'));
						return;
					}
					var area = document.querySelector('[data-mcp-inspect-area="' + id + '"]');
					if (!area) return;
					var row = rowFor(btn);
					if (row) row.open = true;
					renderInspect(area, j);
				} finally {
					setBusy(btn, false);
				}
			}

			// testConnection probes the live form configuration (including
			// unsaved kv rows) without persisting. The form serializes to
			// FormData so secret/blank rows ride the same shape the create/update
			// posts use; the serverId hidden field lets edit mode backfill stored
			// secrets left blank.
			async function testConnection(btn) {
				var form = btn.closest('form');
				if (!form) return;
				var area = form.querySelector('[data-mcp-test-result]');
				setBusy(btn, true);
				try {
					var resp = await fetch('/api/mcp-servers/test', {
						method: 'POST',
						body: new FormData(form)
					});
					var j = await readJSON(resp);
					if (!resp.ok) {
						toast('error', j.error || ('Test failed (' + resp.status + ').'));
						return;
					}
					if (area) renderInspect(area, j);
				} catch (e) {
					toast('error', 'Test failed: ' + (e && e.message ? e.message : 'network error'));
				} finally {
					setBusy(btn, false);
				}
			}

			function renderInspect(area, r) {
				area.hidden = false;
				area.innerHTML = '';
				var box = document.createElement('div');
				box.className = 'rounded-box border px-3 py-2.5 text-xs';
				var head = document.createElement('p');
				head.className = 'flex items-center gap-1.5 text-sm font-semibold';
				area.appendChild(box);
				if (r.status === 'auth_required') {
					box.className += ' border-warning/30 bg-warning/5';
					head.appendChild(icon('lucide--key-round'));
					head.appendChild(textNode('Authorization required'));
					box.appendChild(head);
					var explain = document.createElement('p');
					explain.className = 'text-muted-strong mt-1';
					explain.textContent = 'This server requires OAuth authorization before it can connect.';
					box.appendChild(explain);
					var auth = r.auth || {};
					if (auth.unavailable) {
						// The provider publishes no discoverable OAuth metadata, so the
						// browser connect flow cannot work: show the token-header remedy
						// and render Connect disabled (no /oauth/start navigation).
						var remedy = document.createElement('p');
						remedy.className = 'text-warning mt-1';
						remedy.textContent = auth.remedy || 'This provider publishes no OAuth authorization metadata, so the browser connect flow cannot be used — configure a token header for this server instead (e.g. Authorization: Bearer <token>).';
						box.appendChild(remedy);
						var disabledBtn = document.createElement('button');
						disabledBtn.type = 'button';
						disabledBtn.disabled = true;
						disabledBtn.setAttribute('aria-disabled', 'true');
						disabledBtn.setAttribute('data-testid', 'mcp-oauth-connect-disabled');
						disabledBtn.className = 'link link-primary mt-1.5 inline-flex items-center gap-1.5 opacity-50 pointer-events-none';
						disabledBtn.appendChild(icon('lucide--plug-zap'));
						disabledBtn.appendChild(textNode('Connect'));
						box.appendChild(disabledBtn);
						return;
					}
					var meta = [];
					if (auth.authorizationServer) meta.push(auth.authorizationServer);
					var scopes = auth.scopes || [];
					if (scopes.length) meta.push('scopes: ' + scopes.join(', '));
					if (meta.length) {
						var mline = document.createElement('p');
						mline.className = 'text-muted mt-0.5';
						mline.textContent = meta.join(' · ');
						box.appendChild(mline);
					}
					var link = document.createElement('a');
					link.className = 'link link-primary mt-1.5 inline-flex items-center gap-1.5';
					link.setAttribute('data-testid', 'mcp-oauth-connect');
					link.href = '/settings/mcp-servers/' + encodeURIComponent(r.serverId || '') + '/oauth/start';
					link.appendChild(icon('lucide--plug-zap'));
					link.appendChild(textNode('Connect'));
					box.appendChild(link);
					return;
				}
				if (r.status !== 'ok') {
					box.className += ' border-error/25 bg-error/5';
					head.appendChild(icon('lucide--circle-x'));
					head.appendChild(textNode('Inspect failed'));
					box.appendChild(head);
					var err = document.createElement('p');
					err.className = 'text-error mt-1';
					err.textContent = r.error || r.status || 'connection error';
					box.appendChild(err);
					return;
				}
				box.className += ' border-base-content/15 bg-base-200/40';
				head.appendChild(icon('lucide--check-circle'));
				var who = '';
				if (r.serverInfo) {
					who = r.serverInfo.name;
					if (r.serverInfo.version) who += ' v' + r.serverInfo.version;
				}
				head.appendChild(textNode('Reachable' + (who ? ' — ' + who : '') + (r.latencyMs ? ' (' + r.latencyMs + 'ms)' : '')));
				box.appendChild(head);
				var kinds = [
					{ label: 'tools', items: r.tools || [] },
					{ label: 'prompts', items: r.prompts || [] },
					{ label: 'resources', items: r.resources || [] },
					{ label: 'resource templates', items: r.resourceTemplates || [] }
				];
				var listed = false;
				for (var i = 0; i < kinds.length; i++) {
					var k = kinds[i];
					if (!k.items.length) continue;
					listed = true;
					var line = document.createElement('p');
					line.className = 'text-muted-strong mt-1.5';
					var names = [];
					for (var j = 0; j < k.items.length && j < 5; j++) {
						names.push(k.items[j].name || k.items[j].uri || k.items[j].uriTemplate || '?');
					}
					line.textContent = k.items.length + ' ' + k.label + ': ' + names.join(', ') + (k.items.length > 5 ? '…' : '');
					box.appendChild(line);
				}
				if (!listed) {
					var none = document.createElement('p');
					none.className = 'text-muted-faint mt-1.5';
					none.textContent = 'No tools, prompts, or resources advertised.';
					box.appendChild(none);
				}
			}

			function icon(name) {
				var i = document.createElement('span');
				i.className = name + ' size-4 shrink-0';
				i.setAttribute('aria-hidden', 'true');
				return i;
			}
			function textNode(s) { return document.createTextNode(s); }

			// --- per-tool invoke (shared dialog) ---------------------------
			// One dialog per page; opening a row's Run button points it at that
			// server + tool and resets the previous args/result.
			function invokeDialog() { return document.getElementById('mcp-tool-invoke-dialog'); }

			function openInvoke(btn) {
				var dlg = invokeDialog();
				if (!dlg) return;
				dlg.setAttribute('data-mcp-invoke-server', btn.getAttribute('data-mcp-server') || '');
				dlg.setAttribute('data-mcp-invoke-tool', btn.getAttribute('data-mcp-tool') || '');
				var title = dlg.querySelector('[data-mcp-invoke-title]');
				if (title) title.textContent = dlg.getAttribute('data-mcp-invoke-tool') || '';
				var args = dlg.querySelector('[data-mcp-invoke-args]');
				if (args) args.value = '';
				hideArgsError(dlg);
				var result = dlg.querySelector('[data-mcp-invoke-result]');
				if (result) { result.hidden = true; result.replaceChildren(); }
				if (typeof dlg.showModal === 'function' && !dlg.open) dlg.showModal();
			}

			function argsErrorEl(dlg) { return dlg.querySelector('[data-mcp-invoke-args-error]'); }
			function showArgsError(dlg, msg) {
				var el = argsErrorEl(dlg);
				if (!el) return;
				el.textContent = msg;
				el.hidden = false;
			}
			function hideArgsError(dlg) {
				var el = argsErrorEl(dlg);
				if (el) { el.hidden = true; el.textContent = ''; }
			}

			// prettyJSONText re-indents text that is valid JSON; plain text is
			// returned unchanged.
			function prettyJSONText(s) {
				var t = String(s == null ? '' : s);
				try { return JSON.stringify(JSON.parse(t), null, 2); } catch (e) { return t; }
			}

			async function runInvoke(btn) {
				var dlg = btn.closest('dialog');
				if (!dlg) return;
				var server = dlg.getAttribute('data-mcp-invoke-server') || '';
				var tool = dlg.getAttribute('data-mcp-invoke-tool') || '';
				var argsEl = dlg.querySelector('[data-mcp-invoke-args]');
				var raw = argsEl ? argsEl.value.trim() : '';
				var args = {};
				if (raw !== '') {
					try {
						args = JSON.parse(raw);
					} catch (e) {
						showArgsError(dlg, 'Arguments must be valid JSON.');
						return;
					}
					if (args === null || typeof args !== 'object' || Array.isArray(args)) {
						showArgsError(dlg, 'Arguments must be a JSON object, e.g. {"key": "value"}.');
						return;
					}
				}
				hideArgsError(dlg);
				setBusy(btn, true);
				try {
					var resp = await fetch('/api/mcp-servers/' + encodeURIComponent(server) + '/tools/' + encodeURIComponent(tool) + '/call', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ arguments: args })
					});
					var j = await readJSON(resp);
					if (!resp.ok) {
						renderInvokeError(dlg, j.error || ('Call failed (' + resp.status + ').'));
						return;
					}
					renderInvokeResult(dlg, j);
				} catch (e) {
					renderInvokeError(dlg, 'Call failed: ' + (e && e.message ? e.message : 'network error'));
				} finally {
					setBusy(btn, false);
				}
			}

			// renderInvokeResult builds the result box from DOM nodes (never
			// innerHTML) because tool output is untrusted: text content blocks
			// are pretty-printed when they are JSON, other block types fall back
			// to a label, and isError gets a clear error treatment.
			function renderInvokeResult(dlg, r) {
				var box = dlg.querySelector('[data-mcp-invoke-result]');
				if (!box) return;
				box.hidden = false;
				box.replaceChildren();
				var isErr = !!(r && r.isError);
				var wrap = document.createElement('div');
				wrap.className = 'rounded-box border px-3 py-2.5 text-xs ' +
					(isErr ? 'border-error/30 bg-error/5' : 'border-base-content/15 bg-base-200/40');
				var head = document.createElement('p');
				head.className = 'mb-1.5 flex items-center gap-1.5 text-xs font-semibold' + (isErr ? ' text-error' : '');
				head.appendChild(icon(isErr ? 'lucide--circle-x' : 'lucide--check-circle'));
				head.appendChild(textNode(isErr ? 'Tool reported an error' : 'Result'));
				wrap.appendChild(head);
				var blocks = (r && r.content) || [];
				var rendered = 0;
				for (var i = 0; i < blocks.length; i++) {
					var b = blocks[i] || {};
					if (b.type === 'text') {
						var pre = document.createElement('pre');
						pre.className = 'mt-1 max-h-80 overflow-auto break-words whitespace-pre-wrap font-mono text-[11px] leading-relaxed';
						pre.textContent = prettyJSONText(b.text || '');
						wrap.appendChild(pre);
						rendered++;
					} else {
						var note = document.createElement('p');
						note.className = 'text-muted mt-1';
						note.textContent = '[' + (b.type || 'unknown') + ' content]';
						wrap.appendChild(note);
						rendered++;
					}
				}
				if (!rendered && r && r.structuredContent) {
					var pre = document.createElement('pre');
					pre.className = 'mt-1 max-h-80 overflow-auto break-words whitespace-pre-wrap font-mono text-[11px] leading-relaxed';
					pre.textContent = prettyJSONText(JSON.stringify(r.structuredContent));
					wrap.appendChild(pre);
					rendered++;
				}
				if (!rendered) {
					var none = document.createElement('p');
					none.className = 'text-muted-faint';
					none.textContent = 'Tool returned no content.';
					wrap.appendChild(none);
				}
				box.appendChild(wrap);
			}

			function renderInvokeError(dlg, msg) {
				var box = dlg.querySelector('[data-mcp-invoke-result]');
				if (!box) return;
				box.hidden = false;
				box.replaceChildren();
				var wrap = document.createElement('div');
				wrap.className = 'rounded-box border border-error/30 bg-error/5 px-3 py-2.5 text-xs';
				var head = document.createElement('p');
				head.className = 'mb-1.5 flex items-center gap-1.5 text-xs font-semibold text-error';
				head.appendChild(icon('lucide--circle-x'));
				head.appendChild(textNode('Call failed'));
				wrap.appendChild(head);
				var err = document.createElement('p');
				err.className = 'text-error';
				err.textContent = msg;
				wrap.appendChild(err);
				box.appendChild(wrap);
			}

			async function toggleServerEnabled(input) {
				var id = input.getAttribute('data-mcp-server');
				var enabled = input.checked;
				input.disabled = true;
				try {
					var resp = await fetch('/settings/mcp-servers/' + encodeURIComponent(id) + '/toggle', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: 'enabled=' + (enabled ? 'true' : 'false')
					});
					var j = await readJSON(resp);
					if (!resp.ok) {
						input.checked = !enabled;
						toast('error', j.error || ('Update failed (' + resp.status + ').'));
					}
				} finally {
					input.disabled = false;
				}
			}

			async function toggleTool(input) {
				var id = input.getAttribute('data-mcp-server');
				var tool = input.getAttribute('data-mcp-tool');
				var enabled = input.checked;
				input.disabled = true;
				try {
					var resp = await fetch('/api/mcp-servers/' + encodeURIComponent(id) + '/tools/' + encodeURIComponent(tool), {
						method: 'PATCH',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ enabled: enabled })
					});
					if (!resp.ok) {
						input.checked = !enabled;
						var j = await readJSON(resp);
						toast('error', j.error || ('Update failed (' + resp.status + ').'));
					}
				} finally {
					input.disabled = false;
				}
			}

			function showTransportPanel(form, type) {
				if (!form) return;
				var radios = form.querySelectorAll('input[data-mcp-transport]');
				var panels = form.querySelectorAll('[data-mcp-transport-panel]');
				for (var i = 0; i < panels.length; i++) {
					var p = panels[i];
					var active = p.getAttribute('data-mcp-transport-panel') === 'remote'
						? (type === 'sse' || type === 'http')
						: p.getAttribute('data-mcp-transport-panel') === type;
					if (active) { p.hidden = false; } else { p.hidden = true; }
				}
			}

			function kvPrefix(container) {
				return container.getAttribute('data-mcp-kv-prefix') || 'kv';
			}
			function addKVRow(container) {
				var prefix = kvPrefix(container);
				var wrap = document.createElement('div');
				wrap.className = 'flex flex-col gap-1';
				wrap.setAttribute('data-mcp-kv-row', '');
				var row = document.createElement('div');
				row.className = 'flex items-center gap-1.5';
				var key = document.createElement('input');
				key.type = 'text'; key.className = 'input input-sm min-w-0 flex-1 font-mono';
				key.name = prefix + '.key'; key.placeholder = 'Name';
				var val = document.createElement('input');
				val.type = 'text'; val.className = 'input input-sm min-w-0 flex-1 font-mono';
				val.name = prefix + '.value'; val.placeholder = 'Value';
				var secret = document.createElement('select');
				secret.className = 'select select-sm shrink-0';
				secret.name = prefix + '.secret';
				secret.title = 'Store this value as a secret — it is write-only and never shown again.';
				secret.setAttribute('aria-label', 'Row visibility');
				var plainOpt = document.createElement('option');
				plainOpt.value = ''; plainOpt.textContent = 'Plain'; plainOpt.selected = true;
				var secretOpt = document.createElement('option');
				secretOpt.value = '1'; secretOpt.textContent = 'Secret';
				secret.appendChild(plainOpt); secret.appendChild(secretOpt);
				var rm = document.createElement('button');
				rm.type = 'button'; rm.className = 'btn btn-ghost btn-sm btn-square shrink-0';
				rm.setAttribute('data-mcp-kv-remove', '');
				rm.setAttribute('aria-label', 'Remove row');
				var x = document.createElement('span');
				x.className = 'lucide--x size-4';
				x.setAttribute('aria-hidden', 'true');
				rm.appendChild(x);

				// Every row carries .auth/.scheme hidden fields (empty for plain
				// rows) so the arrays stay index-aligned with .key/.value.
				var auth = document.createElement('input');
				auth.type = 'hidden'; auth.name = prefix + '.auth'; auth.value = '';
				var scheme = document.createElement('input');
				scheme.type = 'hidden'; scheme.name = prefix + '.scheme'; scheme.value = '';

				row.appendChild(key); row.appendChild(val); row.appendChild(secret); row.appendChild(auth); row.appendChild(scheme); row.appendChild(rm);
				wrap.appendChild(row);
				var addBtn = container.querySelector('[data-mcp-kv-add]');
				container.insertBefore(wrap, addBtn);
				key.focus();
			}

			document.addEventListener('click', function (e) {
				var btn = e.target && e.target.closest ? e.target.closest('button, a') : null;
				if (!btn) return;
				var testBtn = btn.closest('[data-mcp-test]');
				if (testBtn) { e.preventDefault(); testConnection(testBtn); return; }
				if (btn.hasAttribute('data-mcp-action')) {
					var action = btn.getAttribute('data-mcp-action');
					if (action === 'sync') { e.preventDefault(); syncServer(btn); }
					else if (action === 'inspect') { e.preventDefault(); inspectServer(btn); }
					return;
				}
				var invokeOpen = btn.closest('[data-mcp-invoke-open]');
				if (invokeOpen) { e.preventDefault(); openInvoke(invokeOpen); return; }
				var invokeRun = btn.closest('[data-mcp-invoke-run]');
				if (invokeRun) { e.preventDefault(); runInvoke(invokeRun); return; }
				var kvAdd = btn.closest('[data-mcp-kv-add]');
				if (kvAdd) { e.preventDefault(); addKVRow(kvAdd.closest('[data-mcp-kv]')); return; }
				var kvRemove = btn.closest('[data-mcp-kv-remove]');
				if (kvRemove) { e.preventDefault(); kvRemove.closest('[data-mcp-kv-row]').remove(); return; }
			});

			document.addEventListener('change', function (e) {
				var t = e.target;
				if (!t || !t.closest) return;
				var form = t.closest('[data-mcp-form-fields]');
				if (t.hasAttribute('data-mcp-transport') && form) {
					showTransportPanel(form, t.value);
					return;
				}
				var enabled = t.closest('[data-mcp-enabled-toggle]');
				if (enabled) { toggleServerEnabled(enabled); return; }
				var tool = t.closest('[data-mcp-tool-toggle]');
				if (tool) { toggleTool(tool); return; }
			});

			// Deferred cached-tool rows (#210): a row's tool rows are fetched on
			// its first expand. `toggle` does not bubble, so the listener is
			// registered in the capture phase and reuses the same container the
			// sync path swaps in.
			document.addEventListener('toggle', function (e) {
				var row = e.target;
				if (!row || row.tagName !== 'DETAILS' || !row.open) return;
				if (!row.hasAttribute('data-mcp-row')) return;
				var host = row.querySelector('[data-mcp-tools-host]');
				if (!host || host.hasAttribute('data-mcp-tools-loaded')) return;
				var url = host.getAttribute('data-mcp-tools-url');
				if (!url) return;
				// App paths are emitted unscoped; the session's scope base lives in
				// the URL, so resolve it the way app.js resolves every JS-built path.
				if (window.MemoryScope && window.MemoryScope.path) {
					url = window.MemoryScope.path(url);
				}
				host.setAttribute('data-mcp-tools-loaded', '1');
				htmx.ajax('GET', url, { target: host, swap: 'innerHTML' });
			}, true);

			// One-time panel visibility per current radio state.
			var forms = document.querySelectorAll('[data-mcp-form-fields]');
			for (var i = 0; i < forms.length; i++) {
				var f = forms[i];
				var checkedRadio = f.querySelector('input[data-mcp-transport]:checked');
				if (checkedRadio) showTransportPanel(f, checkedRadio.value);
			}
		})();
	</script>
}
