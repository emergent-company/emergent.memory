package main

import (
	"net/url"
	"strconv"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/form"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// SourceAppsPage is the organization's GitHub App registry: one table row per
// registered App, with a standalone register page (/settings/source-apps/new)
// and a per-App edit page (/settings/source-apps/:appId) — the settings
// convention of a table plus a separate add/edit page rather than an inline
// form. The API behind it is org-admin only, so a caller who cannot administer
// the org gets sourceAppsForbidden instead of an empty list and dead controls.
templ SourceAppsPage(data dsSourceAppsPageData) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Settings", "/settings", "Source apps")), "", "Source apps", dsSourceAppsSubtitle(data.OrgName), detailHeaderOpts{Margin: "mb-6"}) {
			if data.LoadErr == nil && !data.Forbidden {
				@sourceAppAddAction()
			}
		}
		@flashToasts(data.FlashMsg, data.FlashErr)
		@layout.Rail(settingsSubNav("source-apps", data.ProvidersMissing), nil) {
			if data.LoadErr != nil {
				@pageErrorNotice("Source apps unavailable", data.LoadErr)
			} else if data.Forbidden {
				@sourceAppsForbidden()
			} else {
				@sourceAppsList(data)
			}
		}
	}
}

// sourceAppAddAction is the header action: a link to the standalone register
// page, so the list page never carries a form.
templ sourceAppAddAction() {
	@ui.Button(ui.ButtonProps{
		Type:    ui.ButtonTypeLink,
		Href:    dsSourceAppsPath + "/new",
		Variant: ui.ButtonPrimary,
		Size:    ui.ButtonSM,
		Icon:    "lucide--plus",
		Attrs:   templ.Attributes{"data-testid": "ds-source-app-add"},
	}) {
		Register app
	}
}

// sourceAppsForbidden is the org-admin-only state: the page exists for every
// project member (the settings rail links here), but nothing is listed and no
// write control is rendered that the API would answer with 403.
templ sourceAppsForbidden() {
	<div data-testid="ds-source-apps-forbidden">
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--lock",
			Title:       "Organization administrators only",
			Description: "Source Apps are organization-wide GitHub App credentials, so only an organization administrator can register, view, or remove them. Ask an administrator if a GitHub App source needs one.",
			Bordered:    true,
			Class:       "py-12",
		})
	</div>
}

// sourceAppsList is the registered Apps as the standard table: identity and
// numeric id, the webhook URL GitHub must deliver to (shortened to the cell, the
// full value in the title), when the App was registered, and the action that
// opens its edit page.
templ sourceAppsList(data dsSourceAppsPageData) {
	<div data-testid="ds-source-apps">
		if len(data.Rows) == 0 {
			@ui.EmptyState(ui.EmptyStateProps{
				Icon:        "lucide--webhook",
				Title:       "No GitHub Apps registered yet",
				Description: "One App can back several GitHub App sources across this organization's projects. Register an App, then point its webhook at the delivery URL its page shows.",
				ActionHref:  dsSourceAppsPath + "/new",
				ActionLabel: "Register app",
				ActionIcon:  "lucide--plus",
				Bordered:    true,
				Class:       "py-12",
				Attrs:       templ.Attributes{"data-testid": "ds-source-apps-empty"},
			})
		} else {
			@sectionCount(countLabel(len(data.Rows), "App", "Apps"))
			@components.TableCard(nil) {
				<div class="overflow-x-auto stacked-table" style="--h1:'App';--h2:'App ID';--h3:'Webhook';--h4:'Registered';--h5:''">
					<table class="table table-sm" data-testid="ds-source-apps-table">
						<thead>
							<tr>
								<th>App</th>
								<th>App ID</th>
								<th>Webhook</th>
								<th>Registered</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range data.Rows {
								@sourceAppRow(row)
							}
						</tbody>
					</table>
				</div>
			}
		}
	</div>
}

// sourceAppRow is one registered App. Identity and the delivery URL are
// metadata only: the private key and webhook secret are write-only and never
// rendered, here or on the edit page.
templ sourceAppRow(row dsSourceAppRow) {
	<tr data-testid="ds-source-app-row" data-app-row-id={ row.ID }>
		<td>
			<div class="flex min-w-0 items-center gap-2">
				@ui.IconSpan("lucide--github", "size-4 shrink-0 text-muted-faint")
				<span class="truncate font-medium" data-testid="ds-source-app-slug">{ row.Slug }</span>
			</div>
		</td>
		<td>
			<span class="font-mono text-xs whitespace-nowrap text-muted" data-testid="ds-source-app-id">{ strconv.FormatInt(row.AppID, 10) }</span>
		</td>
		<td>
			if row.WebhookURL == "" {
				@components.EmptyDash()
			} else {
				<span class="block max-w-[18rem] truncate font-mono text-xs text-muted" title={ row.WebhookURL } data-testid="ds-source-app-webhook-url">{ row.WebhookURL }</span>
			}
		</td>
		<td class="whitespace-nowrap text-muted">{ relTimeOrDash(row.CreatedAt) }</td>
		<td class="text-right">
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    dsSourceAppsPath + "/" + url.PathEscape(row.ID),
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--settings",
				Attrs:   templ.Attributes{"data-testid": "ds-source-app-manage"},
			}) {
				Manage
			}
		</td>
	</tr>
}

// SourceAppFormPage creates or edits one org App. Both secrets are write-only:
// on the add page they are required, on the edit page they are optional and a
// blank field keeps the stored value. The App ID and the webhook key are fixed
// after registration, so the edit page shows them read-only — the App ID because
// it is the binding identity, the delivery URL because rotating the key would
// silently break every source whose webhook is already configured with it.
templ SourceAppFormPage(data dsSourceAppFormData) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Settings", "/settings", "Source apps", data.BackHref, sourceAppFormTitle(data))), "", sourceAppFormTitle(data), dsSourceAppsSubtitle(data.OrgName), detailHeaderOpts{Margin: "mb-6"}) {
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    data.BackHref,
				Variant: ui.ButtonOutline,
				Size:    ui.ButtonSM,
				Icon:    "lucide--arrow-left",
				Attrs:   templ.Attributes{"data-testid": "ds-source-app-back"},
			}) {
				Back
			}
		}
		if data.FlashMsg != "" {
			@flashToasts(data.FlashMsg, nil)
		}
		if data.FlashErr != nil {
			@pageErrorNotice("Source App not saved", data.FlashErr)
		}
		<div class="flex flex-col gap-4" data-testid="ds-source-app-form-page">
			if data.App == nil {
				@sourceAppGitHubGuide(data)
			}
			@components.PanelCard("", templ.Attributes{"data-testid": "ds-source-app-form-card"}) {
				<form method="post" action={ templ.URL(data.Action) } class="flex flex-col gap-4" data-testid="ds-source-app-form">
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<div class="flex flex-col gap-1">
							<label class="text-sm font-medium" for="source-app-id">App ID
								if data.App == nil {
									<span class="text-error" aria-hidden="true">*</span>
								}
							</label>
							if data.App != nil {
								<input id="source-app-id" type="text" readonly class="input w-full font-mono text-xs" value={ strconv.FormatInt(data.App.AppID, 10) } data-testid="ds-source-app-app-id"/>
							} else {
								<input id="source-app-id" name="appId" type="number" min="1" step="1" required class="input w-full" data-testid="ds-source-app-app-id"/>
							}
							@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS}) {
								The numeric App ID from GitHub's App settings, not the client id.
								if data.App != nil {
									It identifies the App this credential belongs to and cannot be changed here.
								}
							}
						</div>
						<div class="flex flex-col gap-1">
							<label class="text-sm font-medium" for="source-app-slug">Slug <span class="text-error" aria-hidden="true">*</span></label>
							<input id="source-app-slug" name="slug" type="text" required class="input w-full" placeholder="my-org-bot" value={ sourceAppSlug(data) } data-testid="ds-source-app-slug-input"/>
							@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS}) {
								The App's URL slug on GitHub, used as its label when binding a source.
							}
						</div>
					</div>
					<div class="flex flex-col gap-1">
						<label class="text-sm font-medium" for="source-app-private-key">Private key
							if data.App == nil {
								<span class="text-error" aria-hidden="true">*</span>
							}
						</label>
						<textarea id="source-app-private-key" name="privateKey" rows="4" class="textarea w-full font-mono text-xs" placeholder={ sourceAppPrivateKeyPlaceholder(data) } required?={ data.App == nil } data-testid="ds-source-app-private-key"></textarea>
						@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS}) {
							if data.App != nil {
								The PEM private key GitHub generated for the App. It is write-only: leave the field empty to keep the stored key, or paste a new one to rotate it.
							} else {
								The PEM private key GitHub generated for the App. It is write-only and never shown again.
							}
						}
					</div>
					<div class="flex flex-col gap-1">
						<label class="text-sm font-medium" for="source-app-webhook-secret">Webhook secret
							if data.App == nil {
								<span class="text-error" aria-hidden="true">*</span>
							}
						</label>
						<input id="source-app-webhook-secret" name="webhookSecret" type="password" autocomplete="new-password" class="input w-full" placeholder={ sourceAppWebhookSecretPlaceholder(data) } required?={ data.App == nil } data-testid="ds-source-app-webhook-secret"/>
						@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS}) {
							if data.App != nil {
								The secret set on the App's webhook. It is write-only: leave the field empty to keep the stored secret, or enter a new one to rotate it.
							} else {
								The secret set on the App's webhook. It is write-only: every delivery is verified against the stored copy.
							}
						}
					</div>
					if data.WebhookURL != "" {
						<div class="flex flex-col gap-1" data-testid="ds-source-app-webhook">
							if data.JustCreated {
								@ui.SoftBox(ui.SoftBoxProps{Padding: "p-4", Class: "mb-2 flex flex-col gap-1", Attrs: templ.Attributes{"data-testid": "ds-source-app-created-next"}}) {
									<p class="text-sm font-semibold">Next: finish the webhook in GitHub</p>
									@ui.EmptyNote(ui.EmptyNoteProps{Class: "max-w-prose"}) {
										In the GitHub App tick Active, enter the same secret, paste this delivery URL, and subscribe to the Pull request event — the event list appears with the active webhook. GitHub's ping then proves Memory verified the signature.
									}
								}
							}
							<span class="text-sm font-medium">Webhook URL</span>
							@form.ClipboardCopy([]form.ClipboardCopyItem{
								{
									ID:          "ds-source-app-webhook-url",
									Label:       "Delivery URL",
									Value:       data.WebhookURL,
									ButtonLabel: "Copy",
									Mono:        true,
								},
							})
							@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS}) {
								Point this App's webhook at this URL in GitHub. It is fixed for the App: rotating the webhook secret does not change it.
							}
						</div>
					}
					<div class="flex items-center justify-end">
						@ui.Button(ui.ButtonProps{
							Type:    ui.ButtonTypeSubmit,
							Variant: ui.ButtonPrimary,
							Size:    ui.ButtonSM,
							Icon:    "lucide--save",
							Attrs:   templ.Attributes{"data-testid": "ds-source-app-save"},
						}) {
							if data.App != nil {
								Save
							} else {
								Register app
							}
						}
					</div>
				</form>
				if data.DeleteHref != "" {
					<div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-base-content/10 pt-4" data-testid="ds-source-app-danger">
						@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "max-w-prose"}) {
							Removal is refused while any github_app source is still bound to this App; delete or switch those sources first. The server names them when it refuses.
						}
						<form method="post" action={ templ.URL(data.DeleteHref) } class="inline-flex" hx-confirm="Remove this GitHub App registration? Sources still bound to it must be deleted or switched first.">
							@ui.Button(ui.ButtonProps{
								Type:    ui.ButtonTypeSubmit,
								Variant: ui.ButtonGhost,
								Size:    ui.ButtonSM,
								Icon:    "lucide--trash-2",
								Attrs:   templ.Attributes{"data-testid": "ds-source-app-delete"},
							}) {
								Remove
							}
						</form>
					</div>
				}
			}
		</div>
	}
}

// sourceAppGitHubGuide is the register page's GitHub setup checklist. The App
// has to exist in GitHub before this form can be filled in, and the two secrets
// only line up if the webhook is created inactive — the delivery URL does not
// exist until Memory issues it at registration — so the order that actually
// works is spelled out here. It renders only on the add page: an existing App
// already has its credentials, and its delivery URL lives on its own page.
templ sourceAppGitHubGuide(data dsSourceAppFormData) {
	@ui.SoftBox(ui.SoftBoxProps{Padding: "p-4", Class: "flex flex-col gap-3", Attrs: templ.Attributes{"data-testid": "ds-source-app-gh-guide"}}) {
		<div class="flex flex-col gap-1">
			<h3 class="text-sm font-semibold">Create the App in GitHub first</h3>
			@ui.EmptyNote(ui.EmptyNoteProps{Class: "max-w-prose"}) {
				Register a GitHub App at
				<a class="link link-primary" href="https://github.com/settings/apps/new" target="_blank" rel="noreferrer">github.com/settings/apps/new</a>
				, then copy its values into this form. These fields are the ones that have to be right.
			}
		</div>
		<ol class="text-muted flex list-decimal flex-col gap-1 pl-5 text-sm">
			<li>
				<span class="font-medium">Basic information.</span>
				Set the Homepage URL to this deployment's web address (shown below); GitHub requires a value, Memory never reads it.
			</li>
			<li>
				<span class="font-medium">Leave the Callback URL empty</span> (some GitHub screens label it Redirect URI).
				No user-authorization flow is configured: <em>Request user authorization (OAuth) during installation</em> stays unchecked and the Setup URL stays empty, because Memory authenticates as the installation, not as a signed-in GitHub user.
			</li>
			<li>
				<span class="font-medium">Create the webhook inactive.</span>
				The delivery URL does not exist until you register the App here, and GitHub only offers the webhook URL, secret and event fields once it is active — that is step 6. Generate the webhook secret now (any random string, such as
				<code class="font-mono text-xs">openssl rand -hex 24</code>
				), keep it, and enter the same value here and in GitHub.
			</li>
			<li>
				<span class="font-medium">Repository permissions:</span>
				Contents <span class="font-medium">read</span>; Issues, Checks and Pull requests <span class="font-medium">read and write</span>. Metadata read is added automatically and is mandatory.
			</li>
			<li>
				<span class="font-medium">Generate a private key</span> on the App's page and download the <code class="font-mono text-xs">.pem</code> file; paste its contents into the field below.
			</li>
			<li>
				<span class="font-medium">Register, then finish the webhook in GitHub.</span>
				Registration opens the App's page here with its delivery URL. In the GitHub App tick <span class="font-medium">Active</span>, enter the same secret, paste the delivery URL, and subscribe to the <span class="font-medium">Pull request event</span> — the event list appears with the active webhook — then save. GitHub's ping proves Memory verified the signature.
			</li>
			<li>
				<span class="font-medium">Install the App</span> on the repositories to sync, then enter the installation id when you connect the data source: it is the number in
				<code class="font-mono text-xs">github.com/settings/installations/&lt;id&gt;</code>
				.
			</li>
		</ol>
		if data.PublicBaseURL != "" {
			<div class="flex flex-col gap-1" data-testid="ds-source-app-gh-homepage">
				@form.ClipboardCopy([]form.ClipboardCopyItem{
					{
						ID:          "ds-source-app-gh-homepage-url",
						Label:       "Homepage URL",
						Value:       data.PublicBaseURL,
						ButtonLabel: "Copy",
						Mono:        true,
					},
				})
				@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS}) {
					This deployment's web URL. It is only a label on GitHub's side.
				}
			</div>
		}
	}
}

// sourceAppFormTitle names the page by its job: registering a new App or
// editing one that already exists.
func sourceAppFormTitle(data dsSourceAppFormData) string {
	if data.App != nil {
		return "Edit source app"
	}
	return "Register source app"
}

// sourceAppSlug prefills the slug on the edit page.
func sourceAppSlug(data dsSourceAppFormData) string {
	if data.App != nil {
		return data.App.Slug
	}
	return ""
}

// sourceAppPrivateKeyPlaceholder states the keep-or-rotate contract in the
// field itself, because the stored key cannot be rendered back.
func sourceAppPrivateKeyPlaceholder(data dsSourceAppFormData) string {
	if data.App != nil {
		return "Saved — leave empty to keep"
	}
	return "-----BEGIN RSA PRIVATE KEY-----"
}

// sourceAppWebhookSecretPlaceholder is the password field's hint.
func sourceAppWebhookSecretPlaceholder(data dsSourceAppFormData) string {
	if data.App != nil {
		return "Saved — leave empty to keep"
	}
	return ""
}
