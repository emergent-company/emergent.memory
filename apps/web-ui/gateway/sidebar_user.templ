package main

import (
	"github.com/emergent-company/go-daisy/components/layout"
)

// --- Sidebar ---

// appSidebar is the app's left navigation. It mirrors go-daisy's
// layout.Sidebar markup element-for-element (same #_layout-sidebar id and the
// same inner classes: the header/fold button, .sidebar-menu with .menu-label
// group labels and .menu-item links), so every shared CSS rule — including the
// <64rem fixed drawer whose toggle relies on
// #_layout-sidebar-toggle-trigger being a preceding sibling of
// #_layout-sidebar — keeps working unchanged. Signed-in identity now lives in
// the topbar account menu, not in a sidebar footer.
//
// The script mirrors go-daisy's layout.Sidebar behavior (close the drawer
// after tapping a link on small screens; keep the active nav item in sync
// across htmx navigations). It is idempotent via window._sidebarInit.
//
// providersMissing surfaces a warning indicator on the Settings hub entry
// (see sidebarSettingsHref: "/settings" under any link base) when the project
// has no LLM provider configured yet.
templ appSidebar(groups []layout.SidebarGroup, providersMissing bool) {
	<div id="_layout-sidebar" class="flex flex-col bg-base-100">
		<!-- Header: logo -->
		<div class="flex h-16 items-center gap-3 px-5 shrink-0">
			@memoryLogo()
		</div>
		<!-- Nav menu (grows + scrolls) -->
		<div class="sidebar-menu grow overflow-y-auto">
			<div class="mb-3 space-y-0.5 px-2.5 pt-4">
				for i, group := range groups {
					if group.Label != "" {
						<p class={ "menu-label px-2.5 pb-1.5", templ.KV("pt-5", i > 0), templ.KV("pt-0", i == 0) }>{ group.Label }</p>
					}
				for _, item := range group.Items {
					{{ if providersMissing && sidebarSettingsHref(item.Href) { item.Warn = sidebarProviderWarning() } }}
					@layout.SidebarNavItem(item)
				}
				}
			</div>
		</div>
		<!-- Footer: build version. Durable and always reachable so a reporter can
		     copy the running build into an issue (the same value /api/health
		     exposes) instead of answering "version not shown in the UI". -->
		<div class="border-base-content/10 shrink-0 border-t px-5 py-3">
			<p class="text-muted-faint font-mono text-[11px] select-all" data-testid="app-version" title="Build version">{ buildVersionLabel() }</p>
		</div>
	</div>
	<script>
	(function() {
		if (window._sidebarInit) return;
		window._sidebarInit = true;
		var sidebar = document.getElementById('_layout-sidebar');
		if (!sidebar) return;

		// go-daisy renders the drawer trigger as a <label> for the hidden
		// checkbox. Decorate it into a focusable, keyboard-operable button so
		// the navigation is reachable without a pointer (WCAG 2.1.1); the
		// checkbox stays visually hidden and the CSS :checked mechanics are
		// untouched.
		//
		// This component is rendered BEFORE the topbar, so the trigger does not
		// exist yet when this inline script runs. Defer the decoration until the
		// document has parsed (or run immediately if it already has), otherwise
		// the querySelector returns null and the trigger stays a plain label.
		function decorateSidebarTrigger() {
			var tgl = document.getElementById('_layout-sidebar-toggle-trigger');
			var trigger = document.querySelector('#_layout-topbar label[for="_layout-sidebar-toggle-trigger"]');
			if (!tgl || !trigger) return;
			trigger.setAttribute('role', 'button');
			trigger.setAttribute('tabindex', '0');
			trigger.setAttribute('aria-controls', '_layout-sidebar');
			function syncExpanded() { trigger.setAttribute('aria-expanded', tgl.checked ? 'true' : 'false'); }
			syncExpanded();
			tgl.addEventListener('change', syncExpanded);
			trigger.addEventListener('keydown', function(e) {
				if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
					e.preventDefault();
					tgl.checked = !tgl.checked;
					tgl.dispatchEvent(new Event('change', { bubbles: true }));
				}
			});
		}
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', decorateSidebarTrigger, { once: true });
		} else {
			decorateSidebarTrigger();
		}

		sidebar.addEventListener('click', function(e) {
			if (window.innerWidth >= 1024) return;
			var link = e.target.closest('a');
			if (!link) return;
			var cb = document.getElementById('_layout-sidebar-toggle-trigger');
			if (cb) {
				cb.checked = false;
				cb.dispatchEvent(new Event('change', { bubbles: true }));
			}
		});

		function updateActiveSidebarItem(path) {
			path = path || window.location.pathname;
			var links = sidebar.querySelectorAll('a.menu-item[href]');
			var bestMatch = null;
			var bestLen = 0;
			links.forEach(function(link) {
				link.classList.remove('active');
				var href = link.getAttribute('href');
				if (href && href !== '/' && path.indexOf(href) === 0 && href.length > bestLen) {
					bestMatch = link;
					bestLen = href.length;
				}
			});
			if (bestMatch) bestMatch.classList.add('active');
		}

		updateActiveSidebarItem();
		document.addEventListener('htmx:after:history:push', function(e) {
			updateActiveSidebarItem(e.detail && e.detail.path);
		});
		document.addEventListener('htmx:after:history:replace', function(e) {
			updateActiveSidebarItem(e.detail && e.detail.path);
		});
	})();
	</script>
}

// sidebarProviderWarning is the app-specific warning indicator shown after the
// "Settings" sidebar entry when the project has no LLM provider configured yet.
// It is passed through layout.SidebarItem.Warn; the copy stays local (go-daisy's
// SidebarNavItem only carries the slot, not this copy).
templ sidebarProviderWarning() {
	<span class="iconify lucide--alert-triangle size-3.5 shrink-0 text-warning" role="img" aria-label="No provider configured — open Settings" title="No provider configured — open Settings"></span>
}
