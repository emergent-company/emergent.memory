package main

import (
	"net/url"
	"strings"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/form"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- MCP Sharing pages (/settings/mcp-servers/shares) ---
//
// A crumb-framed list page plus standalone create (/new), duplicate
// (/:id/duplicate, the create page seeded from an existing share) and edit
// (/:id/edit) pages, nested under the MCP Servers settings area. Create and
// rotate render the one-time key reveal page — the raw key lives only in that
// response and is never stored or logged. Revoke and rotate are confirmed in
// dialogs before posting.

// MCPSharesPage renders the share list. A project with no shares renders the
// shared EmptyState with a CTA; a failed list fetch renders the error state.
templ MCPSharesPage(data mcpSharesPageData) {
	@layout.Container(layout.ContainerLG, templ.Attributes{"data-mcp-shares-root": ""}) {
		{{ crumbs := crumbsActive(nav.Crumbs("Settings", "/settings", "MCP Servers", mcpServerSettingsBase, "Sharing")) }}
		@detailHeader(crumbs, "", "MCP Sharing", "Hand an outside MCP client a scoped key that exposes only the memory tools you choose. To share one agent, use that agent's own MCP endpoint instead.", detailHeaderOpts{Margin: "mb-6"}) {
			if data.LoadErr == nil {
				// Agent sharing lives on the agent's own configuration surface:
				// each agent's Settings page owns its MCP endpoint and keys.
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    "/agents",
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Icon:    "lucide--bot",
				}) {
					Manage an agent endpoint
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    mcpShareSettingsBase + "/new",
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--plus",
				}) {
					New share
				}
			}
		}
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageErrorNotice("MCP shares unavailable", data.LoadErr)
		} else if len(data.Shares) == 0 {
			@ui.EmptyState(ui.EmptyStateProps{
				Icon:        "lucide--share-2",
				Title:       "No MCP shares yet",
				Description: "Create a share to expose a chosen set of memory tools to an outside MCP client, with its own API key. To share an agent, use that agent's own MCP endpoint.",
				Bordered:    true,
				Class:       "py-12",
				ActionHref:  mcpShareSettingsBase + "/new",
				ActionLabel: "Create a share",
				ActionIcon:  "lucide--plus",
			})
		} else {
			@sectionCount(countLabel(len(data.Shares), "share", "shares"))
			@components.TableCard(nil) {
				<div class="flex flex-col divide-y divide-base-200">
					for _, inst := range data.Shares {
						@mcpShareRow(inst)
					}
				</div>
			}
		}
		if data.Reveal != nil {
			@mcpShareRevealModal(*data.Reveal)
		}
		@ui.PopoverScript()
		@mcpShareScripts()
	}
}

// mcpShareRow is one share: identity + status, tool counts, timestamps,
// and the edit/duplicate/invite/rotate/revoke actions. Legacy shares render
// read-only apart from Duplicate, which creates a new share rather than
// touching them.
templ mcpShareRow(inst MCPShareInstance) {
	<div class="flex flex-col gap-3 px-4 py-3.5" data-mcp-share-row={ inst.ID }>
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="flex flex-wrap items-center gap-2">
					@ui.IconSpan("lucide--share-2", "size-4 shrink-0 text-primary/70")
					<span class="truncate text-sm font-medium">{ inst.Name }</span>
					@mcpShareStatusBadge(inst)
					if inst.IsLegacy {
						@ui.Badge(ui.BadgeProps{Label: "legacy", Variant: ui.BadgeWarning, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: "lucide--history"})
					}
				</div>
				if inst.Description != "" {
					@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-1"}) {
						{ inst.Description }
					}
				}
			</div>
			<div class="flex shrink-0 items-center gap-1">
				if inst.IsLegacy {
					// Legacy instances cannot be edited, rotated or revoked here,
					// but they CAN be copied: the copy is an ordinary named share,
					// which is the documented way off a legacy share. Nothing about
					// the source changes. Their writes are still attributable — the
					// row id IS the token id — so the activity link stays.
					if inst.TokenID != "" {
						@ui.Button(ui.ButtonProps{
							Type:    ui.ButtonTypeLink,
							Href:    mcpShareActivityHref(inst),
							Variant: ui.ButtonGhost,
							Size:    ui.ButtonSM,
							Shape:   ui.ButtonShapeSquare,
							Icon:    "lucide--history",
							Attrs: templ.Attributes{
								"title":       "View writes from " + inst.Name,
								"aria-label":  "View writes from " + inst.Name,
								"data-testid": "mcp-share-activity-link-" + inst.ID,
							},
						})
					}
					@mcpShareDuplicateButton(inst)
				} else {
					@mcpShareActionsMenu(inst)
				}
			</div>
		</div>
		<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-muted">
			@components.MetaChip("lucide--wrench", countLabel(inst.ToolCount, "tool", "tools"))
			@components.MetaChip("lucide--calendar-plus", "created "+relTime(inst.CreatedAt))
			@components.MetaChip("lucide--clock", "last used "+mcpShareLastUsedLabel(inst))
			if len(inst.RecipientEmails) > 0 {
				<span title={ mcpShareRecipientsTitle(inst.RecipientEmails) }>
					@components.MetaChip("lucide--mail", mcpShareRecipientsLabel(inst.RecipientEmails))
				</span>
			}
			if !inst.ReadOnly && !inst.IsLegacy {
				@components.MetaChip("lucide--pencil", "read & write")
			}
		</div>
	</div>
	@mcpShareRevokeDialog(inst)
	@mcpShareRotateDialog(inst)
	@mcpShareInviteDialog(inst)
}

// mcpShareActionsMenu is the row's overflow menu. It replaces three bare icon
// buttons so the row can grow (invite is the newest action) without turning
// into an icon strip, and so every action has a visible label. go-daisy's
// Popover owns positioning, click-away, Escape and exclusivity; the destructive
// and modal items only open the row's dialog, they never post.
templ mcpShareActionsMenu(inst MCPShareInstance) {
	@ui.Popover(ui.PopoverRootProps{}) {
		@ui.PopoverTrigger(ui.PopoverTriggerProps{
			Class: "btn btn-ghost btn-sm btn-square",
			Attrs: templ.Attributes{
				"aria-haspopup": "menu",
				"aria-label":    "Actions for " + inst.Name,
				"title":         "Share actions",
				"data-testid":   "mcp-share-actions-" + inst.ID,
			},
		}) {
			@ui.IconSpan("lucide--ellipsis-vertical", "size-5")
		}
		@ui.PopoverContent(ui.PopoverContentProps{
			Placement: ui.PopoverBottomEnd,
			Offset:    4,
			Exclusive: true,
			Class:     "w-56",
			Attrs:     templ.Attributes{"role": "menu"},
		}) {
			<ul class="menu menu-sm p-1">
				<li>
					<a href={ templ.URL(mcpShareSettingsBase + "/" + url.PathEscape(inst.ID) + "/edit") } class="flex items-center gap-2" data-testid={ "mcp-share-edit-link-" + inst.ID }>
						@ui.IconSpan("lucide--sliders-horizontal", "size-4")
						<span>Edit tools</span>
					</a>
				</li>
				<li>
					<a href={ templ.URL(mcpShareSettingsBase + "/" + url.PathEscape(inst.ID) + "/duplicate") } class="flex items-center gap-2" data-testid={ "mcp-share-duplicate-link-" + inst.ID }>
						@ui.IconSpan("lucide--copy", "size-4")
						<span>Duplicate share</span>
					</a>
				</li>
				if inst.TokenID != "" {
					<li>
						<a href={ templ.URL(mcpShareActivityHref(inst)) } class="flex items-center gap-2" data-testid={ "mcp-share-activity-link-" + inst.ID }>
							@ui.IconSpan("lucide--history", "size-4")
							<span>View writes</span>
						</a>
					</li>
				}
				<li>
					<button type="button" class="flex items-center gap-2" data-dialog-open={ "mcp-share-invite-" + inst.ID } data-testid={ "mcp-share-invite-open-" + inst.ID }>
						@ui.IconSpan("lucide--mail-plus", "size-4")
						<span>Invite by email</span>
					</button>
				</li>
				<li>
					<button type="button" class="flex items-center gap-2" data-dialog-open={ "mcp-share-rotate-" + inst.ID } data-testid={ "mcp-share-rotate-open-" + inst.ID }>
						@ui.IconSpan("lucide--refresh-cw", "size-4")
						<span>Issue a new key</span>
					</button>
				</li>
				<li>
					<button type="button" class="flex items-center gap-2 text-error" data-dialog-open={ "mcp-share-revoke-" + inst.ID } data-testid={ "mcp-share-revoke-open-" + inst.ID }>
						@ui.IconSpan("lucide--trash-2", "size-4")
						<span>Revoke share</span>
					</button>
				</li>
			</ul>
		}
	}
}

// mcpShareDuplicateButton is the legacy row's one available action: start a new
// share from this one. Legacy instances are otherwise read-only, and copying
// does not touch them.
templ mcpShareDuplicateButton(inst MCPShareInstance) {
	@ui.Button(ui.ButtonProps{
		Type:    ui.ButtonTypeLink,
		Href:    mcpShareSettingsBase + "/" + url.PathEscape(inst.ID) + "/duplicate",
		Variant: ui.ButtonGhost,
		Size:    ui.ButtonSM,
		Icon:    "lucide--copy",
		Attrs: templ.Attributes{
			"title":       "Start a new share from " + inst.Name,
			"data-testid": "mcp-share-duplicate-link-" + inst.ID,
		},
	}) {
		Duplicate share
	}
}

// mcpShareStatusBadge renders the share's status badge.
templ mcpShareStatusBadge(inst MCPShareInstance) {
	@components.StatusBadge(mcpShareStatusLabel(inst.Status), mcpShareStatusIntent(inst.Status), "", components.StatusBadgeOpts{
		Style: ui.BadgeStyleSoft,
		Size:  ui.BadgeSizeXS,
		Dot:   true,
	})
}

// mcpShareRevokeDescription is the share-revoke detail paragraph.
templ mcpShareRevokeDescription(name string) {
	@ui.EmptyNote(ui.EmptyNoteProps{Class: "mt-1"}) {
		This immediately invalidates <span class="font-medium text-base-content">{ name }</span>'s key. Any MCP client using it stops working. This cannot be undone.
	}
}

// mcpShareRevokeDialog confirms revocation before POST .../shares/:id/revoke.
templ mcpShareRevokeDialog(inst MCPShareInstance) {
	@ui.ConfirmDialog(ui.ConfirmDialogProps{ID: "mcp-share-revoke-" + inst.ID, Title: "Revoke share?"}, mcpShareRevokeDescription(inst.Name)) {
		<form method="post" action={ templ.URL(mcpShareSettingsBase + "/" + url.PathEscape(inst.ID) + "/revoke") }>
			@form.FormActions("", "") {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Attrs:   templ.Attributes{"formmethod": "dialog"},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonError,
					Size:    ui.ButtonSM,
					Icon:    "lucide--trash-2",
				}) {
					Revoke share
				}
			}
		</form>
	}
}

// mcpShareRotateDialog confirms rotation before POST .../shares/:id/rotate.
templ mcpShareRotateDialog(inst MCPShareInstance) {
	@ui.Dialog(ui.DialogProps{ID: "mcp-share-rotate-" + inst.ID, BoxClass: "max-w-sm"}) {
		<div class="mb-4 flex items-start gap-3">
			@components.IconCircle("lucide--refresh-cw", components.IconCircleToneWarning)
			<div>
				@ui.DialogTitle() {
					Rotate key? 
				}
				@ui.EmptyNote(ui.EmptyNoteProps{Class: "mt-1"}) {
					A new key is issued for <span class="font-medium text-base-content">{ inst.Name }</span> and the current key stops working immediately. The new key is shown once.
				}
			</div>
		</div>
		<form method="post" action={ templ.URL(mcpShareSettingsBase + "/" + url.PathEscape(inst.ID) + "/rotate") }>
			<div class="mb-4">
				@form.FormControl("mcp-share-rotate-emails-"+inst.ID, "Email the new key to (optional)", form.LabelAbove, "Separate several addresses with commas.", "", nil) {
					<input id={ "mcp-share-rotate-emails-" + inst.ID } name="emails" type="text" placeholder="alice@example.com" class="input input-sm w-full"/>
				}
			</div>
			@form.FormActions("", "") {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Attrs:   templ.Attributes{"formmethod": "dialog"},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--refresh-cw",
				}) {
					Rotate key
				}
			}
		</form>
	}
}

// mcpShareInviteDialog emails an ALREADY-CREATED share's current key, without
// rotating it: the backend recovers the plaintext from encrypted storage, so
// everyone already using the share keeps working. A share whose key predates
// key encryption cannot be recovered; the dialog keeps the rotate flow one
// click away ("Issue a new key instead") for exactly that case, using the same
// recipient field.
templ mcpShareInviteDialog(inst MCPShareInstance) {
	@ui.Dialog(ui.DialogProps{ID: "mcp-share-invite-" + inst.ID, BoxClass: "max-w-sm"}) {
		<div class="mb-4 flex items-start gap-3">
			@components.IconCircle("lucide--mail-plus", components.IconCircleTonePrimary)
			<div>
				@ui.DialogTitle() {
					Email the share key? 
				}
				@ui.EmptyNote(ui.EmptyNoteProps{Class: "mt-1"}) {
					<span class="font-medium text-base-content">{ inst.Name }</span>'s current key and client setup instructions are emailed to the addresses below. The key does not change, so anyone already using the share keeps working.
				}
			</div>
		</div>
		<form method="post" action={ templ.URL(mcpShareSettingsBase + "/" + url.PathEscape(inst.ID) + "/invite") }>
			<div class="mb-4">
				@form.FormControl("mcp-share-invite-emails-"+inst.ID, "Email to", form.LabelAbove, "Separate several addresses with commas.", "", nil) {
					<input id={ "mcp-share-invite-emails-" + inst.ID } name="emails" type="text" required placeholder="alice@example.com" class="input input-sm w-full"/>
				}
				@ui.EmptyNote(ui.EmptyNoteProps{Class: "mt-2"}) {
					Shares created before key encryption was enabled cannot be recovered — use “Issue a new key instead” for those.
				}
			</div>
			@form.FormActions("", "") {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Attrs:   templ.Attributes{"formmethod": "dialog"},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Icon:    "lucide--refresh-cw",
					Attrs: templ.Attributes{
						"formaction":  mcpShareSettingsBase + "/" + url.PathEscape(inst.ID) + "/rotate",
						"data-testid": "mcp-share-invite-rotate-" + inst.ID,
					},
				}) {
					Issue a new key instead
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--send",
					Attrs:   templ.Attributes{"data-testid": "mcp-share-invite-send-" + inst.ID},
				}) {
					Send invite
				}
			}
		</form>
	}
}

// MCPShareNewPage renders the create page (GET .../shares/new), which is also
// the "Duplicate MCP share" page when the draft was seeded from an existing
// share — the only difference is the page copy.
templ MCPShareNewPage(data mcpShareFormData) {
	{{
		crumb := "New share"
		if data.CopyFrom != "" || data.NotFound {
			crumb = "Duplicate share"
		}
	}}
	<div class={ pageFormChromeClass } data-mcp-share-form="">
		@detailHeader(crumbsActive(nav.Crumbs("Settings", "/settings", "MCP Servers", mcpServerSettingsBase, "Sharing", mcpShareSettingsBase, crumb)), "", mcpShareNewPageHeading(data), mcpShareNewPageSubtitle(data), detailHeaderOpts{Margin: "mb-6"})
		@flashToasts("", data.FlashErr)
	</div>
	if data.NotFound {
		<div class={ pageFormFieldsClass }>
			@ui.EmptyState(ui.EmptyStateProps{
				Icon:        "lucide--share-2",
				Title:       "MCP share not found",
				Description: "No share with this id to duplicate.",
				Bordered:    true,
			})
		</div>
	} else if data.LoadErr != nil {
		<div class={ pageFormFieldsClass }>
			@pageErrorNotice("Tool catalog unavailable", data.LoadErr)
		</div>
	} else {
		@mcpShareFormBody(data, false)
	}
	@mcpShareScripts()
}

// MCPShareEditPage renders the edit page (GET .../shares/:id/edit).
templ MCPShareEditPage(data mcpShareFormData) {
	{{ crumbs := crumbsActive(nav.Crumbs("Settings", "/settings", "MCP Servers", mcpServerSettingsBase, "Sharing", mcpShareSettingsBase, "Edit share")) }}
	if data.NotFound {
		@layout.Container(layout.ContainerLG, templ.Attributes{"data-mcp-share-form": ""}) {
			@detailHeader(crumbs, "", "Edit share", "", detailHeaderOpts{Margin: "mb-6"})
			@ui.EmptyState(ui.EmptyStateProps{
				Icon:        "lucide--share-2",
				Title:       "MCP share not found",
				Description: "No share with this id.",
				Bordered:    true,
			})
			@mcpShareScripts()
		}
	} else if data.LoadErr != nil {
		<div class={ pageFormChromeClass } data-mcp-share-form="">
			@detailHeader(crumbs, "", "Edit share", "Changes update what the share can reach. The existing key keeps working.", detailHeaderOpts{Margin: "mb-6"})
			@flashToasts("", data.FlashErr)
		</div>
		<div class={ pageFormFieldsClass }>
			@pageErrorNotice("Tool catalog unavailable", data.LoadErr)
		</div>
		@mcpShareScripts()
	} else {
		<div class={ pageFormChromeClass } data-mcp-share-form="">
			@detailHeader(crumbs, "", "Edit share", "Changes update what the share can reach. The existing key keeps working.", detailHeaderOpts{Margin: "mb-6"})
			@flashToasts("", data.FlashErr)
		</div>
		@mcpShareFormBody(data, true)
		@mcpShareScripts()
	}
}

// mcpShareFormBody is the shared create/edit form card.
templ mcpShareFormBody(data mcpShareFormData, editing bool) {
	{{
		action := mcpShareSettingsBase + "/new"
		if editing {
			action = mcpShareSettingsBase + "/" + url.PathEscape(data.ID) + "/update"
		}
	}}
	<form method="post" action={ templ.URL(action) } data-mcp-share-form-fields hx-disable="find button.memory-save-btn">
		if data.CopyFrom != "" {
			// Carried as a hidden field so an inline validation re-render keeps
			// the "duplicated from X" framing. It is display-only.
			<input type="hidden" name="copyFrom" value={ data.CopyFrom }/>
		}
		<div class={ pageFormFieldsClass }>
			@components.PanelCard("", nil) {
				<div class="flex flex-col gap-5">
					@form.FormControl("mcp-share-name", "Name", form.LabelAbove, "Unique within this project. Shown in your share list.", data.FieldErrs.Name, nil) {
						<input id="mcp-share-name" name="name" type="text" required maxlength="255" value={ data.Name } placeholder="e.g. research-assistant" class="input w-full"/>
					}
					@form.FormControl("mcp-share-description", "Description", form.LabelAbove, "Optional note about who or what this share is for.", "", nil) {
						<textarea id="mcp-share-description" name="description" rows="2" placeholder="e.g. Read-only access for the analyst bot" class="textarea w-full resize-none">{ data.Description }</textarea>
					}
					if !editing {
						@form.FormControl("mcp-share-emails", "Email the key (optional)", form.LabelAbove, "The key, endpoint, and client setup go to these addresses. Separate several with commas.", data.FieldErrs.Emails, nil) {
							<input id="mcp-share-emails" name="emails" type="text" value={ data.Emails } placeholder="alice@example.com, bob@example.com" class="input w-full"/>
						}
					}
					@mcpShareToolPicker(data, editing)
					if data.GeneralErr != nil {
						@ui.Alert(ui.AlertProps{
							Type:    ui.AlertError,
							Style:   ui.AlertStyleOutline,
							Icon:    "lucide--alert-triangle",
							Message: data.GeneralErr.Error(),
						})
					}
				</div>
			}
		</div>
		@components.StickyFormActions(components.StickyFormActionsProps{}) {
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    mcpShareSettingsBase,
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--x",
			}) {
				Cancel
			}
			if editing {
				@components.SaveChangesButton()
			} else {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--share-2",
				}) {
					Create share
				}
			}
		}
	</form>
}

// mcpShareToolPicker is the searchable, category-grouped multi-select of memory
// tools, preceded by the share preset row. At least one tool is required; the
// inline error renders under the header.
templ mcpShareToolPicker(data mcpShareFormData, editing bool) {
	<div class="flex flex-col gap-2" data-mcp-tool-picker>
		if len(data.Templates) > 0 {
			@ui.SoftBox(ui.SoftBoxProps{Class: "flex flex-col gap-1.5"}) {
				<div class="flex flex-wrap items-center justify-between gap-2">
					@ui.Eyebrow("Start from a preset", ui.EyebrowProps{Size: "text-[11px]", Margin: ""})
					<span class="text-muted-faint text-[10px]">replaces the current selection</span>
				</div>
				<div class="flex flex-wrap gap-1.5" data-mcp-share-templates>
					{{ activeTaken := false }}
					for _, t := range data.Templates {
						{{ active := !activeTaken && mcpShareSameToolSet(data.Tools, t.Tools) }}
						{{
							if active {
								activeTaken = true
							}
						}}
						@ui.Button(ui.ButtonProps{
							Type:       ui.ButtonTypeButton,
							Variant:    ui.ButtonOutline,
							Size:       ui.ButtonXS,
							ExtraClass: mcpShareTemplateActiveClass(active),
							Attrs: templ.Attributes{
								"data-share-template":       t.ID,
								"data-share-template-tools": mcpShareTemplateToolsAttr(t),
								"title":                     t.Description,
								"aria-pressed":              mcpShareAriaPressed(active),
							},
						}) {
							{ t.Label }
							@ui.Badge(ui.BadgeProps{Label: countLabel(t.ToolCount, "tool", "tools"), Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS})
						}
					}
				</div>
			}
		}
		<div class="flex flex-wrap items-center justify-between gap-2">
			@ui.Eyebrow("Memory tools", ui.EyebrowProps{Size: "text-[11px]", Margin: ""})
			<div class="flex items-center gap-1">
				<span class="text-muted text-[11px]" data-mcp-tool-count aria-live="polite">{ mcpShareSelectedLabel(data.Tools) }</span>
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonXS, Attrs: templ.Attributes{"data-mcp-tool-select-all": ""}}) {
					Select all
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonXS, Attrs: templ.Attributes{"data-mcp-tool-clear": ""}}) {
					Clear
				}
			</div>
		</div>
		@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "-mt-1"}) {
			Only the checked tools are exposed to this share. Pick at least one.
		}
		<input type="search" data-mcp-tool-search placeholder="Search tools…" aria-label="Search tools" class="input input-sm w-full"/>
		if data.FieldErrs.Tools != "" {
			<p class="text-error text-xs">{ data.FieldErrs.Tools }</p>
		}
		if len(data.Catalog) == 0 {
			@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS}) {
				No memory tools are available in the catalog.
			}
		} else {
			<div class="flex max-h-96 flex-col gap-3 overflow-y-auto rounded-box border border-base-content/10 bg-base-200/30 p-3">
				for _, g := range mcpShareToolGroups(data.Catalog) {
					<div class="flex flex-col gap-1" data-mcp-tool-group>
						<p class="text-muted-strong text-[11px] font-semibold tracking-wide uppercase">{ g.Category }</p>
						for _, t := range g.Tools {
							<label
								class="flex cursor-pointer items-start gap-2.5 rounded-box px-2 py-1.5 transition-colors hover:bg-base-100"
								data-mcp-tool-option
								data-tool-search={ mcpShareToolSearchHay(t) }
							>
								<input type="checkbox" name="tools" value={ t.Name } class="checkbox checkbox-sm mt-0.5" checked?={ mcpShareContains(data.Tools, t.Name) }/>
								<span class="min-w-0">
									<span class="block font-mono text-xs font-medium">{ t.Name }</span>
									if t.Description != "" {
										<span class="text-muted block text-[11px] leading-snug">{ t.Description }</span>
									}
									if t.RequiredScope != "" {
										<span class="text-muted-faint mt-0.5 block text-[10px]">requires { t.RequiredScope }</span>
									}
								</span>
							</label>
						}
					</div>
				}
			</div>
		}
		if missing := mcpShareMissingCatalogTools(data.Catalog, data.Tools); editing && len(missing) > 0 {
			// Saved allowlists can name per-verb tools the consolidated catalog no
			// longer lists. They stay callable aliases; render them so saving the
			// edit form resubmits them instead of dropping the share's access.
			@ui.SoftBox(ui.SoftBoxProps{Class: "flex flex-col gap-1"}) {
				<p class="text-muted-strong text-[11px] font-semibold tracking-wide uppercase">Saved tools no longer in the catalog</p>
				@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "-mt-1"}) {
					Keep these checked to preserve the share's existing access, or uncheck one to remove it.
				}
				for _, name := range missing {
					<label
						class="flex cursor-pointer items-start gap-2.5 rounded-box px-2 py-1.5 transition-colors hover:bg-base-100"
						data-mcp-tool-option
						data-tool-search={ strings.ToLower(name) }
					>
						<input type="checkbox" name="tools" value={ name } class="checkbox checkbox-sm mt-0.5" checked/>
						<span class="min-w-0">
							<span class="block font-mono text-xs font-medium">{ name }</span>
							<span class="text-muted-faint mt-0.5 block text-[10px]">deprecated alias — still callable</span>
						</span>
					</label>
				}
			}
		}
	</div>
}

// mcpShareRevealModal is the one-time key reveal shown, open, on the list page
// after create/rotate. The raw key exists only in this response; closing the
// dialog returns to the list and the key is gone for good.
templ mcpShareRevealModal(r mcpShareReveal) {
	@components.SecretRevealModal(components.SecretRevealProps{
		Heading:      r.Heading,
		Name:         r.Name,
		SecretID:     "mcp-share-key",
		Secret:       r.Token,
		EndpointID:   "mcp-share-endpoint",
		Endpoint:     r.MCPURL,
		Warning:      "This key will not be shown again. You can email it to someone later from the share's ⋯ menu; if you lose it, issue a new key.",
		BundleURL:    r.BundleURL,
		BundleTestID: "mcp-share-bundle-link",
		DialogID:     "mcp-share-reveal-modal",
		Attrs:        templ.Attributes{"data-mcp-share-reveal": "true"},
		Snippets:     mcpShareSnippetBlocks(r.Snippets),
		AutoOpen:     true,
		DeliveryNote: mcpShareDeliveryNote(r.EmailsSent),
		DeliveryWarn: mcpShareDeliveryWarn(r.EmailWarn),
	})
}

// mcpShareSnippetBlocks renders the reveal's client snippet list.
templ mcpShareSnippetBlocks(snippets []mcpShareSnippet) {
	for _, s := range snippets {
		@components.SnippetCard(s.Label, s.Code)
	}
}

// mcpShareScripts wires the tool picker's search filter and select-all/clear
// controls. Listeners attach once to document (delegation survives hx-boost
// swaps); the wiring flag prevents double-attach on in-page navigation.
templ mcpShareScripts() {
	<script type="text/javascript">
		(function () {
			function clearMcpShareTemplateActive(picker) {
				setMcpShareTemplateActive(picker, null);
			}

			function setMcpShareTemplateActive(picker, activeEl) {
				var tpls = picker.querySelectorAll('[data-share-template]');
				for (var t = 0; t < tpls.length; t++) {
					var on = activeEl !== null && tpls[t] === activeEl;
					tpls[t].classList.toggle('btn-active', on);
					tpls[t].setAttribute('aria-pressed', on ? 'true' : 'false');
				}
			}

			function syncMcpShareToolCount(picker) {
				var label = picker.querySelector('[data-mcp-tool-count]');
				if (!label) return;
				var boxes = picker.querySelectorAll('[data-mcp-tool-option] input[type="checkbox"]');
				var count = 0;
				for (var i = 0; i < boxes.length; i++) { if (boxes[i].checked) count++; }
				label.textContent = count + ' selected';
			}

			var root = document.querySelector('[data-mcp-shares-root], [data-mcp-share-form], [data-mcp-share-reveal]');
			if (!root) return;
			// Render-time sync must run on every page swap (hx-boost re-renders the
			// markup but the listeners below are already attached once).
			var renderedPicker = document.querySelector('[data-mcp-tool-picker]');
			if (renderedPicker) syncMcpShareToolCount(renderedPicker);
			if (window.__mcpShareUIWired) return;
			window.__mcpShareUIWired = true;

			document.addEventListener('input', function (e) {
				var search = e.target && e.target.closest ? e.target.closest('[data-mcp-tool-search]') : null;
				if (!search) return;
				var picker = search.closest('[data-mcp-tool-picker]');
				if (!picker) return;
				var q = (search.value || '').toLowerCase().trim();
				var groups = picker.querySelectorAll('[data-mcp-tool-group]');
				for (var i = 0; i < groups.length; i++) {
					var opts = groups[i].querySelectorAll('[data-mcp-tool-option]');
					var visible = 0;
					for (var j = 0; j < opts.length; j++) {
						var hay = opts[j].getAttribute('data-tool-search') || '';
						var show = q === '' || hay.indexOf(q) !== -1;
						opts[j].hidden = !show;
						if (show) visible++;
					}
					groups[i].hidden = visible === 0;
				}
			});

			document.addEventListener('click', function (e) {
				var tpl = e.target && e.target.closest ? e.target.closest('[data-share-template]') : null;
				if (tpl) {
					e.preventDefault();
					var picker = tpl.closest('[data-mcp-tool-picker]');
					if (!picker) return;
					var wanted = {};
					try {
						var names = JSON.parse(tpl.getAttribute('data-share-template-tools') || '[]');
						for (var n = 0; n < names.length; n++) { wanted[names[n]] = true; }
					} catch (err) { return; }
					var boxes = picker.querySelectorAll('[data-mcp-tool-option] input[type="checkbox"]');
					for (var b = 0; b < boxes.length; b++) { boxes[b].checked = !!wanted[boxes[b].value]; }
					setMcpShareTemplateActive(picker, tpl);
					syncMcpShareToolCount(picker);
					return;
				}

				var btn = e.target && e.target.closest ? e.target.closest('[data-mcp-tool-select-all], [data-mcp-tool-clear]') : null;
				if (!btn) return;
				e.preventDefault();
				var picker = btn.closest('[data-mcp-tool-picker]');
				if (!picker) return;
				var check = btn.hasAttribute('data-mcp-tool-select-all');
				var boxes = picker.querySelectorAll('[data-mcp-tool-option] input[type="checkbox"]');
				for (var i = 0; i < boxes.length; i++) { boxes[i].checked = check; }
				clearMcpShareTemplateActive(picker);
				syncMcpShareToolCount(picker);
			});

			document.addEventListener('change', function (e) {
				var box = e.target && e.target.closest ? e.target.closest('[data-mcp-tool-picker] input[type="checkbox"]') : null;
				if (!box) return;
				var picker = box.closest('[data-mcp-tool-picker]');
				clearMcpShareTemplateActive(picker);
				syncMcpShareToolCount(picker);
			});
		})();
	</script>
}
