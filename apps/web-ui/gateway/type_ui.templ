package main

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

// --- Type-level ui accent rendering ---
//
// Compiled object types may declare a per-type ui block (icon + color). These
// partials render that accent on object and schema surfaces, falling back to
// the generic box icon when a type declares nothing:
//   - Lucide names — bare ("FileText", "file-text") or iconify ("lucide--…") —
//     resolve through the supportedTypeIconClasses catalog and render as the
//     usual iconify span; a name outside the catalog falls back to the box;
//   - a raw glyph (emoji, symbol) renders as text at the same size;
//   - a declared color tints the tile/chip via inline style (arbitrary CSS
//     color), mirroring the house "primary/10 bg + primary/15 border" tile look.

// typeGlyph renders one type icon value inside a tile or chip. A catalogued
// Lucide name uses the standard iconify span (iconClass carries the size);
// anything unresolved is either a text glyph (glyphClass, a text-size class,
// carries the size — emoji scale with the font, not the utility width/height
// classes) or the generic box. Decorative either way.
templ typeGlyph(icon, iconClass, glyphClass string) {
	if class := typeIconClass(icon); class != "" {
		<span class={ "iconify shrink-0", class, iconClass } aria-hidden="true"></span>
	} else {
		<span class={ "shrink-0 leading-none", glyphClass } aria-hidden="true">{ icon }</span>
	}
}

// typeIconTileSize selects a tile's size variant. One component renders every
// type tile in the product; the variant says how many text rows the tile stands
// beside, so an object's icon is never shorter than the lines it labels.
type typeIconTileSize string

const (
	// typeIconTileRow is the default: one identity line plus a name — a list
	// row, a card, or a relationship endpoint block (size-9).
	typeIconTileRow typeIconTileSize = ""
	// typeIconTileLead is a page head's leading tile: it spans the identity line
	// and the object's name, so it is the height of those two rows (size-11,
	// size-12 from the sm breakpoint).
	typeIconTileLead typeIconTileSize = "lead"
	// typeIconTileCompact is the dense-menu tile: filter options and type
	// headers inside a dropdown, where a row is one line high (size-6).
	typeIconTileCompact typeIconTileSize = "compact"
)

// typeIconTile renders the leading icon tile for an object/type surface: a
// colored rounded square holding the type's declared icon, falling back to the
// generic primary box. A declared icon/color resolves through the catalog then
// delegates to ui.IconTile's Color/Glyph props; the lead variant renders the
// same recipe at page-head scale with a larger glyph.
templ typeIconTile(icon, color string, size ...typeIconTileSize) {
	{{ variant := typeIconTileRow
	if len(size) > 0 {
		variant = size[0]
	}
	cls := typeIconClass(icon)
	glyph := ""
	if cls == "" {
		glyph = icon
	} }}
	if variant == typeIconTileLead {
		{{ name := icon
		if name == "" {
			name = "lucide--box"
		}
		neutral := icon == "" && color == "" }}
		<div class={ "grid shrink-0 place-items-center rounded-xl border size-11 sm:size-12", templ.KV("bg-primary/10 text-primary border-primary/15", neutral) } style={ typeColorStyle(color) } { devmode.Attrs(ctx, "gateway/TypeIconTile")... }>
			@typeGlyph(name, "size-6", "text-2xl")
		</div>
	} else if icon == "" && color == "" {
		@ui.IconTile("lucide--box", ui.IconTileProps{Tone: "primary", Size: typeIconTileSizeClass(variant)})
	} else {
		@ui.IconTile(cls, ui.IconTileProps{Color: color, Glyph: glyph, Size: typeIconTileSizeClass(variant)})
	}
}

// typeIconTileSizeClass maps a variant to ui.IconTile's Size class. Empty means
// IconTile's own default (size-9).
func typeIconTileSizeClass(variant typeIconTileSize) string {
	if variant == typeIconTileCompact {
		return "size-6"
	}
	return ""
}

// typeNameChip renders the type-name chip used on object/type detail headers:
// the type's name with its declared icon prefix and color accent. Without a
// declaration it is the same badge with the generic box icon as before
// (variant carries the badge tone, e.g. primary or ghost). A declared
// icon/color resolves through the catalog then delegates to ui.Badge's
// Color/Glyph/LabelClass props.
templ typeNameChip(label string, variant ui.BadgeIntent, icon string, color string) {
	if icon == "" && color == "" {
		@ui.Badge(ui.BadgeProps{
			Label:   label,
			Variant: variant,
			Size:    ui.BadgeSizeSM,
			Icon:    "lucide--box",
		})
	} else {
		{{ cls := typeIconClass(icon)
			glyph := ""
			if cls == "" {
				glyph = icon
			}
			labelClass := ""
			if color != "" {
				labelClass = "text-base-content"
			} }}
		@ui.Badge(ui.BadgeProps{
			Label:      label,
			Variant:    variant,
			Size:       ui.BadgeSizeSM,
			Color:      color,
			Icon:       cls,
			Glyph:      glyph,
			LabelClass: labelClass,
		})
	}
}
