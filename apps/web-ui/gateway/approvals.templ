package main

import (
	"net/url"
	"strconv"

	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// ApprovalsPage renders the project-wide human-input surface: any pending agent
// question that can be answered here, followed by the tool-approval audit trail
// (every approve / reject / cancel decision, newest first, with the tool name,
// redacted argument summary, decision, and optional reject message). It is the
// notification fallback for a run with no chat conversation (issue #1375), so
// an open-ended ask_user question is answerable on this page.
templ ApprovalsPage(approvals []ToolApprovalItem, questions []AgentQuestionItem, loadErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Settings", "/settings", "Approvals")), "", "Approvals", "Human-in-the-loop input — answer pending agent questions and review every tool-approval decision.", detailHeaderOpts{Margin: "mb-6", SubtitleFull: true}) {
			@ui.Badge(ui.BadgeProps{
				Label:   "audit",
				Variant: ui.BadgeGhost,
				Size:    ui.BadgeSizeSM,
				Icon:    "lucide--shield-check",
			})
		}
		if loadErr != nil {
			@pageError("Approvals unavailable", loadErr)
		} else {
			if len(questions) > 0 {
				<section class="mb-6 flex flex-col gap-2">
					<h2 class="text-sm font-semibold">Pending questions</h2>
					for _, q := range questions {
						@questionRow(q)
					}
				</section>
			}
			if len(approvals) == 0 {
				<div class="card card-border bg-base-100">
					<div class="card-body items-center gap-2 memory-density-stack text-center">
						<p class="text-sm font-medium">No approval decisions yet.</p>
						<p class="text-xs text-muted">When an agent asks to run a gated tool, its decision appears here.</p>
					</div>
				</div>
			} else {
				<div class="flex flex-col gap-2">
					for _, a := range approvals {
						@approvalRow(a)
					}
				</div>
			}
		}
	}
}

// questionRow renders one pending agent question with an answer control shaped
// by its interaction type: option buttons for a single-choice question, a
// free-text input for an open-ended one, or a checkbox group for a multi-select
// one. All post to the same respond route the approval rows use, which resolves
// the question and resumes the paused run.
templ questionRow(q AgentQuestionItem) {
	{{ isText := q.InteractionType == "text" || len(q.Options) == 0 }}
	{{ isMulti := q.InteractionType == "multi_select" }}
	<div class="card card-border bg-base-100" data-testid="pending-question" data-question-id={ q.ID }>
		<div class="card-body gap-3 memory-density-compact">
			<p class="text-sm whitespace-pre-wrap break-words">{ q.Question }</p>
			if isText {
				<div class="flex flex-wrap items-center gap-2">
					<form method="post" action={ "/settings/approvals/" + q.ID + "/respond" } class="flex min-w-56 flex-1 items-center gap-2">
						<input
							type="text"
							name="response"
							required
							aria-label={ q.Question }
							placeholder={ questionPlaceholder(q) }
							if q.MaxLength > 0 {
								maxlength={ strconv.Itoa(q.MaxLength) }
							}
							class="input input-bordered w-full"
						/>
						@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonPrimary, Size: ui.ButtonSM}) { Send }
					</form>
					<form method="post" action={ "/settings/approvals/" + q.ID + "/cancel" }>
						@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonGhost, Size: ui.ButtonSM}) { Cancel }
					</form>
				</div>
			} else if isMulti {
				<div class="flex flex-wrap items-center gap-2">
					<form method="post" action={ "/settings/approvals/" + q.ID + "/respond" } class="flex flex-wrap items-center gap-2" role="group" aria-label={ q.Question }>
						<input type="hidden" name="multi" value="1"/>
						for i, opt := range q.Options {
							<label class="flex items-center gap-2 text-sm">
								<input type="checkbox" name="response" value={ opt.Value } class="checkbox checkbox-sm" required?={ i == 0 }/>
								<span>{ opt.Label }</span>
							</label>
						}
						@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonPrimary, Size: ui.ButtonSM}) { Send }
					</form>
					<form method="post" action={ "/settings/approvals/" + q.ID + "/cancel" }>
						@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonGhost, Size: ui.ButtonSM}) { Cancel }
					</form>
				</div>
			} else {
				<div class="flex flex-wrap items-center gap-2" role="group" aria-label={ q.Question }>
					for _, opt := range q.Options {
						<form method="post" action={ "/settings/approvals/" + q.ID + "/respond" }>
							@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonPrimary, Size: ui.ButtonSM, Attrs: templ.Attributes{"name": "response", "value": opt.Value}}) {
								{ opt.Label }
							}
						</form>
					}
					<form method="post" action={ "/settings/approvals/" + q.ID + "/cancel" }>
						@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonGhost, Size: ui.ButtonSM}) { Cancel }
					</form>
				</div>
			}
		</div>
	</div>
}

templ approvalRow(a ToolApprovalItem) {
	<div class="card card-border bg-base-100">
		<div class="card-body gap-2 memory-density-compact">
			<div class="flex items-start justify-between gap-3">
				<div class="flex min-w-0 flex-wrap items-center gap-2">
					<span class="font-mono text-sm font-semibold">{ a.ToolName }</span>
					@ui.Badge(ui.BadgeProps{
						Label:   a.Decision,
						Variant: ui.StatusIntentFor(a.Decision),
						Size:    ui.BadgeSizeXS,
					})
				</div>
				<div class="flex shrink-0 items-center gap-3">
					if a.ConversationID != "" {
						<a href={ templ.URL("/chat?c=" + url.QueryEscape(a.ConversationID)) } class="inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline">
							@ui.IconSpan("lucide--messages-square", "size-3.5")
							<span>Session</span>
						</a>
					}
					<span class="text-xs text-muted">{ a.CreatedAt.Format("Jan 02, 15:04") }</span>
				</div>
			</div>
			if a.Message != "" {
				<p class="text-sm text-muted-strong">{ a.Message }</p>
			}
			if args := formatArgsJSON(a.ArgsSummary); args != "" {
				<pre class="max-h-32 overflow-y-auto rounded-box bg-base-200/60 p-2 font-mono text-xs whitespace-pre-wrap break-words">{ args }</pre>
			}
			if a.Decision == "pending" {
				@approvalActions(a.QuestionID)
			}
		</div>
	</div>
}

templ approvalActions(questionID string) {
	<div class="flex flex-wrap items-center gap-2 border-t border-base-content/10 pt-3">
		<input type="text" name="message" form={ "approval-respond-" + questionID } placeholder="Reject reason (optional)" maxlength="500" class="input input-bordered flex-1 min-w-56"/>
		<div class="flex items-center gap-2">
			<form method="post" action={ "/settings/approvals/" + questionID + "/cancel" }>
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonGhost, Size: ui.ButtonSM}) { Cancel }
			</form>
			<form id={ "approval-respond-" + questionID } method="post" action={ "/settings/approvals/" + questionID + "/respond" }>
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonGhost, Size: ui.ButtonSM, ExtraClass: "text-error", Attrs: templ.Attributes{"name": "response", "value": "reject"}}) { Reject }
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonPrimary, Size: ui.ButtonSM, Attrs: templ.Attributes{"name": "response", "value": "approve"}}) { Approve }
			</form>
		</div>
	</div>
}
