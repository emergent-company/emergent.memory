package main

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- agent-level ui accent rendering ---
//
// These partials render an agent definition's user-picked icon + color (its
// uiConfig blob) wherever an agent is shown. They delegate to the object-type
// typeGlyph/typeIconTile/typeNameChip/typeColorStyle partials so there is
// exactly one tile implementation; the only agent-specific rule is the
// fallback glyph: agents default to "lucide--bot" (object types default to
// "lucide--box"), and an agent with no declared appearance keeps today's
// neutral primary bot tile byte-for-byte.

// agentGlyph renders one agent icon value inside a tile, chip, or avatar.
// Undeclared icons fall back to the bot glyph (see agentIconName).
templ agentGlyph(icon, iconClass, glyphClass string) {
	@typeGlyph(agentIconName(icon), iconClass, glyphClass)
}

// agentIconTile renders the leading icon tile for an agent list row / summary.
// Without a declared appearance it is the default primary bot tile (identical
// to today's rows); a declared icon/color delegates to the shared type tile.
templ agentIconTile(icon string, color string) {
	if icon == "" && color == "" {
		@ui.IconTile("lucide--bot", ui.IconTileProps{Tone: "primary"})
	} else {
		@typeIconTile(agentIconName(icon), color)
	}
}

// agentNameChip renders an agent-name chip: the label with the agent's icon
// prefix and color accent. Without a declaration it is the same badge with the
// bot icon as before (variant carries the badge tone, e.g. primary or ghost).
templ agentNameChip(label string, variant ui.BadgeIntent, icon string, color string) {
	if icon == "" && color == "" {
		@ui.Badge(ui.BadgeProps{
			Label:   label,
			Variant: variant,
			Size:    ui.BadgeSizeSM,
			Icon:    "lucide--bot",
		})
	} else {
		@typeNameChip(label, variant, agentIconName(icon), color)
	}
}

// agentInlineGlyph renders an agent's icon as a bare inline glyph — no tile, no
// border, no badge — for tight meta rows where the agent name is small text
// (e.g. the chat session rail). A declared color tints the glyph text only
// (agentInlineGlyphStyle, not typeColorStyle — no background tint); without one
// it stays the neutral muted bot, matching the generic icon it replaces.
templ agentInlineGlyph(icon string, color string) {
	if style := agentInlineGlyphStyle(color); style != "" {
		<span class="inline-flex shrink-0 items-center" style={ style }>
			@agentGlyph(icon, "size-4", "text-base")
		</span>
	} else {
		<span class="inline-flex shrink-0 items-center text-muted-faint">
			@agentGlyph(icon, "size-4", "text-base")
		</span>
	}
}

// agentAvatarBubble renders an agent's identity mark at picker size: the
// neutral pill an agent name is listed behind (the objects actor picker, the
// chat rail's agent filter and its menu rows). It carries the agent's declared
// glyph, or the fallback bot, and is decorative by contract — every caller also
// renders the name, so the bubble is aria-hidden and the name carries the
// accessible label. attrs exist for the caller's own hook (data-actor-avatar /
// data-agent-avatar, which the client-side pickers key off), because the mark
// has to stay one element: an extra wrapper would drift from this partial.
templ agentAvatarBubble(icon string, color string, attrs templ.Attributes) {
	<span class="bg-base-200 text-base-content/70 inline-flex size-6 shrink-0 items-center justify-center rounded-full" aria-hidden="true" { attrs... }>
		@agentInlineGlyph(icon, color)
	</span>
}

// agentAllBubble is the "every agent" mark of a picker: the same neutral bubble
// an agent row wears, carrying the group glyph instead of one agent's. It is the
// resting state of the chat rail's agent filter (chat.js restores it whenever
// that row is picked) and of the run log's agent picker, so the two controls
// read as the same picker over different collections.
//
// Decorative like agentAvatarBubble: the row's label names the selection.
templ agentAllBubble() {
	<span class="bg-base-200 text-base-content/60 inline-flex size-6 shrink-0 items-center justify-center rounded-full" aria-hidden="true" data-agent-avatar="all">
		@ui.IconSpan("lucide--users", "size-3.5")
	</span>
}
