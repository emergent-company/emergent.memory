package main

import (
	"strconv"

	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Schema discovery list ---

// SchemaDiscoveryPage lists the project's schema discovery runs. It exists
// because a failed run used to be unreachable from the UI: the attention panel
// pointed at the schema browser, which knows nothing about discovery, and the
// only way to re-run the work was the API or CLI.
templ SchemaDiscoveryPage(jobs []DiscoveryJob, loadErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Schema", "/schema", "Discovery")), "", "Schema discovery", "Runs that propose object and relationship types from your documents. Retrying a failed run starts a new one with its recorded configuration and keeps the failed attempt in history.") {
			<div class="flex flex-wrap items-center gap-2">
				if loadErr == nil {
					@countBadgeLabel(countLabel(len(jobs), "run", "runs"), "lucide--sparkles")
				}
			</div>
		}
		@layout.Rail(schemaSubNav("discovery"), nil) {
			if loadErr != nil {
				@pageError("Failed to load discovery runs", loadErr)
			} else if len(jobs) == 0 {
				@ui.EmptyState(ui.EmptyStateProps{
					Icon:        "lucide--sparkles",
					Title:       "No discovery runs yet",
					Description: "Run schema discovery from the CLI or an agent to propose types from a set of documents. Failed runs and their retries appear here.",
					Bordered:    true,
					ActionHref:  "/schema",
					ActionLabel: "Back to schema",
					ActionIcon:  "lucide--git-branch",
				})
			} else {
				<div class="flex flex-col gap-2" data-testid="discovery-jobs">
					for _, job := range jobs {
						@discoveryJobRow(job)
					}
				</div>
			}
		}
	}
}

// discoveryJobRow is one run: state, when it started, how many types it
// proposed, the terminal error when it has one, and the retry when it failed.
templ discoveryJobRow(job DiscoveryJob) {
	<div class="flex flex-wrap items-start justify-between gap-3 border border-line px-3 py-2" data-testid="discovery-job-row" data-status={ job.Status }>
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-2">
				<span class="text-sm font-medium">Discovery run</span>
				@ui.Badge(ui.BadgeProps{
					Label:   discoveryStatusLabel(job.Status),
					Variant: discoveryStatusIntent(job.Status),
					Size:    ui.BadgeSizeXS,
				})
				if job.CanRetry() {
					<span class="text-muted-faint text-xs">stopped — configuration kept for a retry</span>
				}
				if n := discoveryTypeCount(job); n > 0 {
					<span class="text-muted-faint text-xs">{ strconv.Itoa(n) } type{ plural(n) } proposed</span>
				}
			</div>
			if msg := job.FailureText(); msg != "" {
				<pre class="mt-1 max-h-40 overflow-auto whitespace-pre-wrap break-words rounded bg-base-200 p-2 text-[11px]">{ msg }</pre>
			}
			@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSize2XS, Class: "mt-1"}) {
				{ relTime(job.CreatedAt) }
			}
		</div>
		<div class="flex flex-wrap items-center gap-2">
			if job.CanRetry() {
				<form method="post" action={ templ.URL(discoveryRetryHref(job.ID)) } hx-confirm="Retry this discovery run with its recorded configuration? The failed attempt stays in history.">
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonSecondary,
						Size:    ui.ButtonSM,
						Icon:    "lucide--rotate-ccw",
					}) {
						Retry discovery
					}
				</form>
			}
			if job.SchemaID != nil && *job.SchemaID != "" {
				<a class="link text-xs" href={ templ.URL("/schema/packs/" + *job.SchemaID) }>View schema</a>
			}
		</div>
	</div>
}

// discoveryTypeCount is how many types a run proposed.
func discoveryTypeCount(job DiscoveryJob) int {
	return len(job.DiscoveredTypes)
}
