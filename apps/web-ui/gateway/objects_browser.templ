package main

import (
	"net/url"
	"strconv"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

// --- Objects browser ---
//
// The objects page: a responsive card grid with per-card selection and a grouped
// action bar, one compact toolbar card that stacks the search field over a single
// filter line, a single stats strip instead of three stat cards, and "Ask the
// graph" behind a header dialog instead of a permanent card.
//
// data.Preview marks a dev-gallery render: pagination, search submission, and
// bulk mutations render without their live wiring (no hx-* attributes, no
// backend form action) so the sample page stays inert.

// ObjectsPage renders the objects browser surface. The agent-scoped view
// (data.AgentID) keeps its own header and omits the stats, the global search and
// the Q&A dialog: those are project-wide surfaces the agent route cannot scope.
//
// The outer x-data carries the selection model shared by the visible checkbox
// column, the bulk action bar, and the bulk dialogs. Selection is Alpine-only
// (the bulk bar and the dialogs are Alpine-driven too), so row checkboxes carry
// no `name` and are never submitted: each dialog form submits the selection as
// one comma-separated `ids` value. That keeps table rows out of any form and
// lets htmx-appended rows work without re-registering anything.
templ ObjectsPage(data objectsPageData) {
	@layout.Container(layout.ContainerSize("max-w-[100rem]"), nil) {
		<div x-data={ objectsBrowserSelectionJS } data-status-options={ data.StatusOptionsJSON } data-object-select-root>
			@flashToasts(data.FlashMsg, data.FlashErr)
			if data.AgentID != "" {
				@objectsAgentHeader(data)
			} else {
				@objectsBrowserHeader(data)
			}
			if data.LoadErr != nil {
				@pageErrorNotice("Failed to load objects", data.LoadErr)
			} else {
				if data.Query == "" && data.AgentID == "" && data.CredentialID != "" {
					@objectsCredentialScopeNotice(data)
				}
				// Project-wide totals would misdescribe a share-scoped list, so a
				// scoped view drops them the same way the agent-scoped view does.
				if data.Query == "" && data.AgentID == "" && data.CredentialID == "" {
					@objectsBrowserStats(data)
				}
				@objectsBrowserToolbar(data)
				@objectsBrowserResults(data)
				@objectsBrowserBulkBar()
				@objectsBrowserBulkDialogs(data)
				if data.AgentID == "" {
					@objectsBrowserKnowledgeDialog(data)
				}
			}
		</div>
	}
}

// objectsBrowserHeader is the page header with the two primary affordances:
// asking the graph (a dialog) and creating an object.
templ objectsBrowserHeader(data objectsPageData) {
	@pageHeader("Memory", "Objects", "Entities in the knowledge graph — people, tasks, notes, and everything else memory stores.") {
		<div class="flex items-center gap-2">
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeButton,
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--sparkles",
				Attrs:   templ.Attributes{"onclick": "MemoryApp.openDialog('objects-knowledge-dialog')"},
			}) {
				Ask the graph
			}
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/objects/new",
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonSM,
				Icon:    "lucide--plus",
			}) {
				New object
			}
		</div>
	}
}

// objectsBrowserStats renders the browse overview as one daisyUI stats strip.
// The three separate stat cards it replaces read as three equally loud panels;
// the strip keeps the same three numbers in one quiet band.
//
// The strip is deferred (the count and the embedding-queue aggregates are slow,
// issues #1096/#1098) and it is branch-scoped, so it refetches itself when the
// branch filter changes: #objects-stats listens for objects-stats-refresh,
// which app.js fires from the branch <select>, and hx-include carries the
// filter form's current values so the request is scoped to the new branch
// instead of the one in the page's own URL.
//
// Both the placeholder and the loaded strip carry the same wiring, because the
// loaded strip replaces this element (swap: outerHTML) and must stay
// refreshable. Preview mode renders it without the fetch: the gallery has no
// project behind it.
templ objectsBrowserStats(data objectsPageData) {
	{{
		statsAttrs := templ.Attributes{
			"id":           "objects-stats",
			"class":        "mb-4 [&>.stats]:w-full max-sm:[&_.stat]:min-w-0 max-sm:[&_.stat]:px-2 max-sm:[&_.stat-title]:whitespace-normal max-sm:[&_.stat-title]:leading-tight max-sm:[&_.stat-title]:text-[10px] max-sm:[&_.stat-value]:text-xl max-sm:[&_.stat-desc]:text-[10px]",
			"aria-live":    "polite",
			"hx-target":    "this",
			"hx-swap":      "outerHTML",
			"hx-trigger":   "load, objects-stats-refresh",
			"hx-include":   "#objects-filters-form",
			"hx-get":       "/objects/stats",
		}
		if data.Preview {
			// The gallery has no project behind it: keep the strip's chrome and
			// drop the fetch.
			delete(statsAttrs, "hx-get")
			delete(statsAttrs, "hx-trigger")
			delete(statsAttrs, "hx-target")
			delete(statsAttrs, "hx-swap")
			delete(statsAttrs, "hx-include")
		}
	}}
	<div { statsAttrs... }>
		if data.Stats == nil {
			@ui.StatsGroup([]ui.StatsGroupItem{
				{Title: "objects", Value: "…"},
				{Title: "pending embeddings", Value: "…"},
				{Title: "failed embeddings", Value: "…"},
			})
		} else {
			{{
				s := *data.Stats
				total := groupDigits(int64(s.TotalObjects))
				pending := strconv.FormatInt(s.PendingEmbed, 10)
				failed := strconv.FormatInt(s.FailedEmbed, 10)
				totalDesc := ""
				embedDesc := ""
				failedColor := "text-error"
				if s.TotalErr != nil {
					total = "—"
					totalDesc = "unavailable"
				}
				if s.EmbedErr != nil {
					pending = "—"
					failed = "—"
					embedDesc = "unavailable"
					failedColor = ""
				}
			}}
			@ui.StatsGroup([]ui.StatsGroupItem{
				{Title: "objects", Value: total, Desc: totalDesc},
				{Title: "pending embeddings", Value: pending, Desc: embedDesc, Color: "text-warning"},
				{Title: "failed embeddings", Value: failed, Desc: embedDesc, Color: failedColor},
			})
		}
	</div>
}

// objectsBrowserToolbar puts search and filters in one card: the search form
// keeps the split mode button (mode rides on the submit button), and the filter
// form applies each control on change (the actor picker applies on pick). They
// stay two forms because a single form cannot carry both a submitted search mode
// and a filter change without dropping one of them — so each form carries the
// other's state as hidden inputs, and the results fragment refreshes both sets
// (see objectsSearchHiddenFilters / objectsFilterHiddenFilters).
//
// Both forms refresh #objects-results in place (see objectsFormAttrs): a filter
// click changes the rows, not the page.
//
// The agent-scoped view has no search form (the server's search endpoints cannot
// be provenance-scoped), so its card is the filter line alone and the divider
// that separates the two rows goes with it.
templ objectsBrowserToolbar(data objectsPageData) {
	{{
		searchAction := "/objects"
		filterAction := objectsTargetURL(data)
		if data.Preview {
			// Preview forms post nowhere: the gallery must not navigate away or
			// reach a project that does not exist.
			searchAction = "#"
			filterAction = "#"
		}
		searching := data.AgentID == ""
		filterClass := "flex min-w-0 flex-wrap items-end gap-x-3 gap-y-2"
		if searching {
			filterClass = "border-base-content/10 border-t pt-3 " + filterClass
		}
	}}
	<div class="mb-4">
		@components.PanelCard("", nil, components.PanelCardOpt{BodyClass: "p-3 sm:p-4"}) {
			<div class="flex flex-col gap-3">
				if searching {
					<form id="objects-search-form" class="min-w-0" method="get" action={ templ.URL(searchAction) } { objectsFormAttrs(data, false, searchAction)... } { objectsPreviewGuards(data.Preview)... }>
						@objectsSearchControls(data)
					</form>
				}
				<form id="objects-filters-form" class={ filterClass } method="get" action={ templ.URL(filterAction) } { objectsFormAttrs(data, true, filterAction)... } { objectsPreviewGuards(data.Preview)... }>
					<div id="objects-filter-hidden" class="contents">
						@objectsFilterHiddenFilters(data)
					</div>
					<div id="objects-filter-controls" class="contents">
						@objectsFilterControls(data)
					</div>
					<span id="objects-results-loading" class="htmx-indicator loading loading-spinner loading-xs mb-2" aria-hidden="true"></span>
				</form>
			</div>
		}
	</div>
}

// objectsBrowserResultsNote is the one-line search summary above the table:
// how many rows matched and how they are ranked.
templ objectsBrowserResultsNote(data objectsPageData) {
	<div class="mb-2 flex flex-wrap items-center justify-between gap-2 px-1">
		@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "min-w-0 truncate"}) {
			{ countLabel(len(data.Results), "result", "results") } matching "{ data.Query }"
		}
		<span class="text-muted-faint shrink-0 text-xs">Ranked by relevance</span>
	</div>
}

// objectsBrowserResults is the swap region for every objects filter: the results
// note, the table (or its empty state), and the footer. Its id is the HX-Target
// the toolbar's forms request (objectsResultsRegion) and the region a filter
// response replaces — the page around it never moves.
templ objectsBrowserResults(data objectsPageData) {
	<div id="objects-results" data-testid="objects-results" data-objects-list-refresh="true">
		if data.LoadErr != nil {
			// A filter request that failed to load keeps the page: the error
			// replaces the list instead of the whole surface. The page renders
			// its header unconditionally, so this is a notice, never a second h1.
			@pageErrorNotice("Failed to load objects", data.LoadErr)
		} else {
			if data.Query != "" {
				@objectsBrowserResultsNote(data)
			}
			@objectsBrowserCards(data)
		}
	</div>
}

// objectsResultsFragment is the response body for a filter request: the region
// above plus the out-of-band refreshes a region swap cannot carry itself.
//
// The toolbar's two forms each hold the other's state as hidden inputs, so both
// blocks are refreshed from the applied filters (otherwise a search after a
// branch change would silently drop the branch, which is exactly the class of
// bug the actor filter had, #131).
//
// The filter *row* is replaced only when its rendered content can differ from
// what is already on screen: an actor pick (the trigger's label and avatar, the
// menu's checks, and the provenance toggle all follow it) and a search starting
// or ending (the actor picker and provenance toggle are browse-only, so search
// mode hides them). Replacing it on every change would drop focus out of the
// select the user just operated, so branch/type/sort responses leave it alone.
templ objectsResultsFragment(data objectsPageData, refreshRow bool) {
	@objectsBrowserResults(data)
	<div id="objects-search-hidden" class="contents" hx-swap-oob="innerHTML">
		@objectsSearchHiddenFilters(data)
	</div>
	<div id="objects-filter-hidden" class="contents" hx-swap-oob="innerHTML">
		@objectsFilterHiddenFilters(data)
	</div>
	if refreshRow {
		<div id="objects-filter-controls" class="contents" hx-swap-oob="innerHTML">
			@objectsFilterControls(data)
		</div>
	}
}

// objectsSearchHiddenFilters carries the filter state the search form cannot see
// on its own: branch and type live in the sibling filter form, and a search must
// resend them or it would drop the applied filters.
templ objectsSearchHiddenFilters(data objectsPageData) {
	if data.TypeFilter != "" {
		<input type="hidden" name="type" value={ data.TypeFilter }/>
	}
	if data.BranchID != "" {
		<input type="hidden" name="branch" value={ data.BranchID }/>
	}
}

// objectsFilterHiddenFilters is the mirror of the block above: a filter change
// must resend the query, mode, and sort order the search row currently shows.
templ objectsFilterHiddenFilters(data objectsPageData) {
	if data.Query != "" {
		<input type="hidden" name="q" value={ data.Query }/>
		<input type="hidden" name="mode" value={ data.Mode }/>
	}
	if data.Order != "" {
		<input type="hidden" name="order" value={ data.Order }/>
	}
}

// objectsBrowserCards is the unified results surface: browse objects and search
// hits render as the same card, so switching between browsing and searching does
// not change the page's shape. Unified search hits carry no status or embedding
// state (the endpoint does not return them), so the card drops those badges in
// that mode instead of rendering empty ones.
//
// One grid serves every width. It used to be a desktop table plus a hidden
// mobile list, which meant every object existed twice in the DOM and "Load more"
// had to append to both; the card is responsive instead.
templ objectsBrowserCards(data objectsPageData) {
	{{
		rows := objectsBrowserRows(data)
		search := data.Query != ""
		unified := search && data.Mode == "unified"
	}}
	if len(rows) == 0 {
		if search {
			@objectsSearchEmpty()
		} else {
			@objectsEmpty(data.TypeFilter)
		}
	} else {
		@objectsBrowserResultsBar(data)
		<div
			id="objects-cards"
			data-testid="objects-cards"
			class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4"
		>
			for _, r := range rows {
				@objectsBrowserCard(r, search, unified, data.WikiView, data.Preview)
			}
		</div>
		@objectsBrowserFooter(data)
	}
}

// objectsBrowserResultsBar sits above the grid: select-all on the left, the sort
// control on the right. Select-all moved here from the table header it lost with
// the table — it applies to the cards currently rendered, which is what the
// Alpine model reads anyway.
templ objectsBrowserResultsBar(data objectsPageData) {
	<div
		class="mb-3 flex flex-wrap items-center justify-between gap-2 px-1"
		data-testid="objects-results-bar"
	>
		<label class="text-muted-faint inline-flex cursor-pointer items-center gap-2 text-xs font-medium">
			<input
				type="checkbox"
				class="checkbox checkbox-sm"
				aria-label="Select all objects"
				@change="toggleAll($el.checked)"
				:checked="all"
				:indeterminate="some"
			/>
			<span>Select all</span>
		</label>
		<div class="flex flex-wrap items-center gap-3">
			@objectsBrowserWikiViewSwitch(data)
			@objectsBrowserSortControl(data)
		</div>
	</div>
}

// objectsBrowserWikiViewSwitch is the global wiki-variant switch, in the place a
// list/card toggle usually sits. It decides which wiki variant a card opens, and
// the handler persists it as a cookie so opening a card directly keeps the
// choice. Each option is a plain link: no JavaScript, no state to lose on reload.
templ objectsBrowserWikiViewSwitch(data objectsPageData) {
	<div class="join" role="group" aria-label="Object page view">
		for _, opt := range objectWikiViewOptions() {
			{{ active := normalizeObjectWikiView(data.WikiView) == opt.Value
			attrs := templ.Attributes{"data-testid": "objects-wiki-view-" + opt.Value}
			href := objectsWikiViewHref(data, opt.Value)
			variant := ui.ButtonGhost
			if active {
				variant = ui.ButtonPrimary
				attrs["aria-current"] = "page"
			} }}
			@ui.Button(ui.ButtonProps{
				Type:       ui.ButtonTypeLink,
				Href:       href,
				Variant:    variant,
				Size:       ui.ButtonXS,
				Icon:       opt.Icon,
				ExtraClass: "join-item gap-1.5 font-normal",
				Attrs:      attrs,
			}) {
				<span>{ opt.Label }</span>
			}
		}
	</div>
}

// objectsBrowserSortControl is the list's order control. It replaces the
// sortable "Created" column header: with no table there is no column to click,
// and burying the only sort in a header the user has to find was the table's
// problem to begin with. Search results are relevance-ranked, so the control
// states that instead of offering an order the result set ignores.
templ objectsBrowserSortControl(data objectsPageData) {
	if data.Query != "" {
		<span class="text-muted-faint inline-flex items-center gap-1.5 text-xs">
			@ui.IconSpan("lucide--sparkles", "size-3.5 shrink-0")
			Best match first
		</span>
	} else {
		{{
			dir := objectsSortDir(data)
			href := objectsSortHref(data, objectsNextSortDir(data))
			label := "Newest first"
			icon := "lucide--arrow-down"
			if dir == "asc" {
				label = "Oldest first"
				icon = "lucide--arrow-up"
			}
			var attrs templ.Attributes
			if !data.Preview {
				attrs = regionFilterAttrs(href, objectsResultsRegion)
				attrs["data-objects-list-refresh"] = "true"
			} else {
				attrs = templ.Attributes{}
			}
			attrs["aria-label"] = "Sort: " + label
		}}
		@ui.Button(ui.ButtonProps{
			Type:       ui.ButtonTypeLink,
			Href:       href,
			Variant:    ui.ButtonGhost,
			Size:       ui.ButtonXS,
			Icon:       icon,
			ExtraClass: "gap-1.5 font-normal",
			Attrs:      attrs,
		}) {
			<span>{ label }</span>
		}
	}
}

// objectsBrowserCard is one object in the grid. The card opens the object, and
// the checkbox is a sibling of the card's anchor rather than a child: interactive
// content nested inside a link is invalid and a click would navigate away instead
// of selecting.
//
// The card answers "what is this, and should I open it?" — the shared object
// header (type tile, type · ref identity line, name, first paragraph of prose),
// its workflow state and labels, who last wrote it. Everything else (the full
// property set, relationships, the audit trail) is the object page's job.
//
// The name is plain text inside the header and the whole card is one stretched
// link instead: an object is introduced by the same component as a page head and
// a relationship row, while the card keeps a full-size click target. The
// checkbox and the footer links sit above that overlay.
templ objectsBrowserCard(r objectsBrowserRowView, search, unified bool, wikiView string, preview bool) {
	{{ href := objectWikiHref(r.ID, wikiView)
	linkAttrs := templ.Attributes{}
	if preview {
		// The gallery preview has no backend and no real objects behind it, so a
		// card must not navigate the preview iframe away from the sample page.
		href = "#"
		linkAttrs["onclick"] = "return false"
	} }}
	<div
		class="border-base-content/10 bg-base-100 rounded-box group relative flex h-full flex-col border transition-shadow hover:shadow-md"
		data-testid="object-card"
		{ devmode.Attrs(ctx, "gateway/ObjectCard")... }
	>
		<div class="flex items-start justify-between gap-2 p-3 pb-0">
			<div class="flex min-w-0 flex-1">
				@objectHeader(objectHeaderProps{
					Variant:      objectHeaderRow,
					Type:         r.Type,
					Icon:         r.UI.Icon,
					Color:        r.UI.Color,
					Ref:          objectDisplayRef(r.Ref, r.ID),
					Label:        r.Label,
					Excerpt:      r.Excerpt,
					ExcerptClass: "line-clamp-3",
					NameClass:    "group-hover:text-primary",
				})
			</div>
			<label class="relative z-10 flex shrink-0 items-center pt-0.5">
				<input
					type="checkbox"
					class="checkbox checkbox-sm"
					value={ r.ID }
					data-object-select
					data-object-type={ r.Type }
					aria-label={ "Select " + r.Label }
					x-model="sel"
				/>
			</label>
		</div>
		<div class="mt-auto flex min-h-6 flex-wrap items-center gap-1 px-3 pb-2 empty:hidden">
			if r.DataClassLabel != "" {
				<span class="tooltip tooltip-top inline-flex" data-tip={ r.DataClassHint }>
					@ui.Badge(ui.BadgeProps{Label: r.DataClassLabel, Icon: r.DataClassIcon, Variant: r.DataClassIntent, Size: ui.BadgeSizeXS})
				</span>
			}
			if !unified {
				if r.Status != "" {
					@components.StatusBadge(r.StatusLabel, r.StatusIntent, "", components.StatusBadgeOpts{
						Size:  ui.BadgeSizeXS,
						Dot:   true,
						Attrs: templ.Attributes{"data-status": r.Status},
					})
				}
				// Only an object that is not embedded earns a badge: "Embedded" on
				// every card is noise, a pending or failed embedding is a reason to
				// open it.
				if r.EmbeddingLabel != "" && r.EmbeddingIcon != "lucide--circle-check" {
					<span class={ "tooltip tooltip-top inline-flex", r.EmbeddingClass } data-tip={ r.EmbeddingLabel }>
						<span class={ "iconify shrink-0 text-base ", r.EmbeddingIcon } aria-hidden="true"></span>
						<span class="sr-only">{ r.EmbeddingLabel }</span>
					</span>
				}
			}
			for _, l := range firstLabels(r.Labels, 3) {
				@ui.Badge(ui.BadgeProps{Label: l, Variant: ui.BadgeNeutral, Size: ui.BadgeSizeXS})
			}
			if len(r.Labels) > 3 {
				@ui.Badge(ui.BadgeProps{Label: "+" + strconv.Itoa(len(r.Labels)-3), Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS})
			}
			if search {
				<span class="text-muted-faint ml-auto inline-flex shrink-0 items-center gap-1" title="Relevance score">
					@ui.IconSpan("lucide--sparkles", "size-3 shrink-0")
					<span class="text-xs font-medium tabular-nums">{ searchScoreLabel(r.Score) }</span>
				</span>
			}
		</div>
		<div class="border-base-content/10 text-muted-faint relative z-10 flex flex-wrap items-center justify-between gap-x-2 gap-y-1 border-t px-3 py-2 text-[11px]">
			@objectsCardWriter(r)
			if r.HasRevisionCount {
				<a
					href={ templ.URL("/objects/" + url.PathEscape(r.ID) + "/history") }
					class="hover:text-base-content relative z-10 shrink-0 hover:underline"
					aria-label={ "Version history of " + r.Label }
				>{ objectVersionCountLabel(r.RevisionCount) }</a>
			}
		</div>
		// The card's single link: the whole surface opens the object, with the
		// checkbox and the footer links raised above it.
		<a href={ templ.URL(href) } { linkAttrs... } class="absolute inset-0" aria-label={ "Open " + r.Label }>
			<span class="sr-only">Open { r.Label }</span>
		</a>
	</div>
}

// objectsCardWriter renders the card's footer provenance: who wrote this version,
// through which credential, and how long ago. Every part degrades away — a
// version written before the write stamp existed shows nothing rather than a
// guessed actor — and only the age falls back to the object's created time.
templ objectsCardWriter(r objectsBrowserRowView) {
	<span class="inline-flex min-w-0 items-center gap-1">
		if r.Writer.Actor != "" {
			<span class="truncate" title={ r.Writer.ActorTitle }>
				if r.Writer.ActorHref != "" {
					<a href={ templ.URL(r.Writer.ActorHref) } class="hover:text-base-content relative z-10 font-medium hover:underline">{ r.Writer.Actor }</a>
				} else {
					<span class="text-base-content/70 font-medium">{ r.Writer.Actor }</span>
				}
			</span>
			if r.Writer.How != "" {
				<span class="shrink-0" aria-hidden="true">·</span>
				<span class="shrink-0">via { r.Writer.How }</span>
			}
			if r.When != "" && r.When != "—" {
				<span class="shrink-0" aria-hidden="true">·</span>
				<span class="shrink-0" title={ r.CreatedAt }>{ r.When }</span>
			}
		} else if r.When != "" && r.When != "—" {
			<span class="shrink-0" title={ r.CreatedAt }>{ r.When }</span>
		}
	</span>
}

// objectVersionCountLabel names a version count in the card footer.
func objectVersionCountLabel(n int) string {
	if n == 1 {
		return "1 version"
	}
	return strconv.Itoa(n) + " versions"
}


// objectsBrowserFooter sits below the grid: the cursor-pagination trigger on the
// right. The order note that used to sit on the left now lives in the results bar
// as the sort control, so the footer has one job. #objects-load-more is the OOB
// swap target the /objects/partial response replaces when a page is appended.
templ objectsBrowserFooter(data objectsPageData) {
	<div class="mt-3 flex flex-wrap items-center justify-end gap-2 px-1">
		<div id="objects-load-more">
			if data.HasMore {
				@objectsBrowserLoadMoreButton(data)
			}
		</div>
	</div>
}

// objectsBrowserLoadMoreButton is the cursor-pagination trigger. In the gallery
// preview the wiring is suppressed (the preview has no backend), so the button
// renders as a static visual sample.
templ objectsBrowserLoadMoreButton(data objectsPageData) {
	{{
		var attrs templ.Attributes
		if !data.Preview {
			attrs = templ.Attributes{
				"hx-get":    objectsPartialURL(data),
				"hx-target": "#objects-cards",
				"hx-swap":   "beforeend",
			}
		}
	}}
	@ui.Button(ui.ButtonProps{
		Type:       ui.ButtonTypeButton,
		Variant:    ui.ButtonOutline,
		Size:       ui.ButtonSM,
		Icon:       "lucide--chevron-down",
		ExtraClass: "gap-2 px-5",
		Attrs:      attrs,
	}) {
		Load more
	}
}

// objectsBrowserRowsPartial is the HTMX fragment returned by /objects/partial:
// the next page's cards (appended to #objects-cards) and a replacement
// load-more slot. One grid at every width means one append target — the old
// fragment had to duplicate the page into a mobile list nobody could see.
templ objectsBrowserRowsPartial(data objectsPageData) {
	{{
		search := data.Query != ""
		unified := search && data.Mode == "unified"
		rows := objectsBrowserRows(data)
	}}
	for _, r := range rows {
		@objectsBrowserCard(r, search, unified, data.WikiView, data.Preview)
	}
	<div id="objects-load-more" hx-swap-oob="true">
		if data.HasMore {
			@objectsBrowserLoadMoreButton(data)
		}
	</div>
}

// objectsKnowledgeAnswer renders a grounded answer as sanitized markdown using
// the shared .memory-md prose styles, with the conversation id as a muted
// caption when the stream reported one. It is the HTMX response the "Ask the
// graph" dialog swaps into #objects-knowledge-answer.
templ objectsKnowledgeAnswer(answer, sessionID string) {
	@components.PanelCard("memory-rise", nil, components.PanelCardOpt{BodyClass: "p-4"}) {
		<div class="mb-2 flex items-center gap-2">
			@ui.IconSpan("lucide--sparkles", "size-3.5 shrink-0 text-accent")
			<span class="text-muted-faint text-xs font-medium tracking-wide uppercase">Answer</span>
		</div>
		<div class="memory-md text-sm leading-relaxed">
			@templ.Raw(renderMarkdown(answer))
		</div>
		if sessionID != "" {
			<p class="text-muted-faint mt-3 border-t border-base-content/10 pt-2 font-mono text-[11px]">Session { sessionID }</p>
		}
	}
}

// objectsKnowledgeError renders the inline error state for a failed Q&A.
templ objectsKnowledgeError(err error) {
	<div class="border-error/25 bg-error/10 text-error rounded-box flex items-center gap-2 border px-3 py-2 text-sm" role="alert">
		@ui.IconSpan("lucide--triangle-alert", "size-4 shrink-0")
		<span>Could not get an answer. Try again in a moment.</span>
	</div>
}

// objectsAgentHeader is the agent-scoped objects view's header: a breadcrumb
// back through the agent, with the provenance-scoped subtitle.
templ objectsAgentHeader(data objectsPageData) {
	@detailHeader(
		crumbsActive(nav.Crumbs("Agents", "/agents", data.AgentName, "/agents/"+url.PathEscape(data.AgentID), "Objects")),
		"",
		"Objects",
		objectsScopeDescription(data.AgentName),
		detailHeaderOpts{Margin: "mb-6"},
	)
}

// objectsBrowserBulkBar is the grouped action bar for the current selection:
// label/status edits and soft delete. It is pinned to the viewport bottom while
// rows are selected, so actions stay reachable without scrolling back to a
// toolbar. The count comes from the Alpine model on the page root.
templ objectsBrowserBulkBar() {
	<div id="objects-bulk-bar" data-testid="objects-bulk-bar" x-show="count > 0" style="display: none" class="fixed inset-x-0 bottom-4 z-40 flex justify-center px-4 print:hidden">
		<div class="border-base-content/10 bg-base-100 shadow-xl rounded-box flex flex-wrap items-center gap-1.5 border px-3 py-2 sm:px-4">
			<span class="px-1 text-sm font-medium">
				<span x-text="count" class="tabular-nums"></span>
				selected
			</span>
			<div class="bg-base-content/10 mx-1 h-5 w-px" aria-hidden="true"></div>
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeButton,
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--tag",
				Attrs:   templ.Attributes{"onclick": "MemoryApp.openDialog('objects-bulk-label-add-dialog')"},
			}) {
				Add label
			}
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeButton,
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--tag",
				Attrs:   templ.Attributes{"onclick": "MemoryApp.openDialog('objects-bulk-label-remove-dialog')"},
			}) {
				Remove label
			}
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeButton,
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--circle-dot-dashed",
				Attrs:   templ.Attributes{"onclick": "MemoryApp.openDialog('objects-bulk-status-dialog')"},
			}) {
				Set status
			}
			@ui.Button(ui.ButtonProps{
				Type:       ui.ButtonTypeButton,
				Variant:    ui.ButtonGhost,
				Size:       ui.ButtonSM,
				Icon:       "lucide--trash-2",
				ExtraClass: "text-error hover:bg-error/10",
				Attrs:      templ.Attributes{"onclick": "MemoryApp.openDialog('objects-bulk-delete-dialog')"},
			}) {
				Delete
			}
			<div class="bg-base-content/10 mx-1 h-5 w-px" aria-hidden="true"></div>
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeButton,
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--x",
				Attrs:   templ.Attributes{"@click": "clear()", "aria-label": "Clear selection"},
			}) {
				Clear
			}
		</div>
	</div>
}

// objectsBrowserBulkDialogs renders the four bulk action dialogs. Each dialog
// owns its own <form> — one shared form would make HTML constraint validation
// apply to every dialog's controls, including the closed ones, so an empty
// required field in the Add-label dialog would silently block Delete, and the
// identically named label fields would collide. Selection reaches the handler as
// one comma-separated `ids` value kept in sync by the Alpine model, so the table
// rows never nest inside a form and htmx-appended rows need no re-registration.
templ objectsBrowserBulkDialogs(data objectsPageData) {
	{{ action := objectsBulkAction(data) }}
	@ui.Dialog(ui.DialogProps{ID: "objects-bulk-label-add-dialog", BoxClass: "max-w-md"}) {
		<form method="post" action={ templ.URL(action) } class="flex flex-col gap-3" { objectsPreviewGuards(data.Preview)... }>
			@objectsBulkFormFields(data, "label_add")
			@ui.DialogTitle(ui.DialogTitleProps{Size: ui.DialogTitleSizeMD}) {
				Add label
			}
			@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "-mt-1"}) {
				The label is added to every selected object. Existing labels are kept.
			}
			<label class="flex flex-col gap-1">
				<span class="text-xs font-medium">Label</span>
				<input type="text" name="label" class="input input-sm w-full" placeholder="e.g. needs-review" autocomplete="off" required/>
			</label>
			<div class="modal-action">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Attrs: templ.Attributes{"data-dialog-close": "true"}}) {
					Cancel 
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonPrimary, Size: ui.ButtonSM}) {
					Add label
				}
			</div>
		</form>
	}
	@ui.Dialog(ui.DialogProps{ID: "objects-bulk-label-remove-dialog", BoxClass: "max-w-md"}) {
		<form method="post" action={ templ.URL(action) } class="flex flex-col gap-3" { objectsPreviewGuards(data.Preview)... }>
			@objectsBulkFormFields(data, "label_remove")
			@ui.DialogTitle(ui.DialogTitleProps{Size: ui.DialogTitleSizeMD}) {
				Remove label
			}
			@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "-mt-1"}) {
				The label is removed from every selected object that carries it.
			}
			<label class="flex flex-col gap-1">
				<span class="text-xs font-medium">Label</span>
				<input type="text" name="label" class="input input-sm w-full" placeholder="e.g. needs-review" autocomplete="off" required/>
			</label>
			<div class="modal-action">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Attrs: templ.Attributes{"data-dialog-close": "true"}}) {
					Cancel 
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonPrimary, Size: ui.ButtonSM}) {
					Remove label
				}
			</div>
		</form>
	}
	@ui.Dialog(ui.DialogProps{ID: "objects-bulk-status-dialog", BoxClass: "max-w-md"}) {
		<form method="post" action={ templ.URL(action) } class="flex flex-col gap-3" { objectsPreviewGuards(data.Preview)... }>
			@objectsBulkFormFields(data, "status")
			@ui.DialogTitle(ui.DialogTitleProps{Size: ui.DialogTitleSizeMD}) {
				Set status
			}
			@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "-mt-1"}) {
				Options are the statuses every selected type declares. Types without a workflow cannot take a status.
			}
			<label class="flex flex-col gap-1">
				<span class="text-xs font-medium">Status</span>
				<select name="status" class="select select-sm w-full" required :disabled="!statusActionable">
					<option value="" disabled selected>Pick a status…</option>
					<template x-for="s in statusOptions" :key="s">
						<option :value="s" x-text="s"></option>
					</template>
				</select>
			</label>
			<p x-show="!statusActionable" class="text-warning text-xs" data-testid="objects-bulk-status-unavailable">
				The selected objects' types declare no common workflow status, so bulk Set status is unavailable.
			</p>
			<div class="modal-action">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Attrs: templ.Attributes{"data-dialog-close": "true"}}) {
					Cancel 
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonPrimary, Size: ui.ButtonSM, Attrs: templ.Attributes{":disabled": "!statusActionable"}}) {
					Set status
				}
			</div>
		</form>
	}
	@ui.Dialog(ui.DialogProps{ID: "objects-bulk-delete-dialog", BoxClass: "max-w-md"}) {
		<form method="post" action={ templ.URL(action) } class="flex flex-col gap-3" { objectsPreviewGuards(data.Preview)... }>
			@objectsBulkFormFields(data, "delete")
			<div class="flex items-start gap-3">
				@ui.IconTile("lucide--trash-2", ui.IconTileProps{Tone: "error"})
				<div class="min-w-0">
					@ui.DialogTitle(ui.DialogTitleProps{Size: ui.DialogTitleSizeMD}) {
						Delete
						<span x-text="count" class="tabular-nums"></span>
						selected?
					}
					@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-1"}) {
						Selected objects are removed from the browser. Branch history keeps the versions, so a deleted object can be restored from its branch.
					}
				</div>
			</div>
			<div class="modal-action">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Attrs: templ.Attributes{"data-dialog-close": "true"}}) {
					Cancel 
				}
				@ui.Button(ui.ButtonProps{
					Type:       ui.ButtonTypeSubmit,
					Variant:    ui.ButtonError,
					Size:       ui.ButtonSM,
					Icon:       "lucide--trash-2",
					ExtraClass: "gap-2",
				}) {
					Delete selected
				}
			</div>
		</form>
	}
}

// objectsBulkFormFields is the per-dialog hidden prefix: the selected ids as one
// comma-separated value (kept in sync by the Alpine model), the action the
// handler dispatches on, the branch the page is filtered to, and the filtered
// page to return to. Every bulk dialog carries its own copy so each submits as
// an independent form.
//
// `branch` is not decoration: delete resolves the object on that branch, and
// without it the endpoint removes the MAIN head while the branch-scoped list
// still shows the object.
templ objectsBulkFormFields(data objectsPageData, actionValue string) {
	<input type="hidden" name="ids" :value="sel.join(',')"/>
	<input type="hidden" name="action" value={ actionValue }/>
	<input type="hidden" name="branch" value={ data.BranchID }/>
	<input type="hidden" name="back" value={ objectsBulkBackURL(data) }/>
}

// objectsBrowserKnowledgeDialog is the "Ask the graph" Q&A, moved off the page
// body and behind a header button: it is an occasional tool, not permanent page
// chrome. The answer still swaps into #objects-knowledge-answer.
templ objectsBrowserKnowledgeDialog(data objectsPageData) {
	{{
		action := "/objects/knowledge"
		if data.Preview {
			action = "#"
		}
		var formAttrs templ.Attributes
		if !data.Preview {
			formAttrs = templ.Attributes{
				"hx-post":   "/objects/knowledge",
				"hx-target": "#objects-knowledge-answer",
				"hx-swap":   "innerHTML",
			}
		}
	}}
	@ui.Dialog(ui.DialogProps{ID: "objects-knowledge-dialog", BoxClass: "max-w-2xl"}) {
		<div class="flex items-start gap-3">
			@ui.IconTile("lucide--sparkles", ui.IconTileProps{Tone: "accent"})
			<div class="min-w-0">
				@ui.DialogTitle(ui.DialogTitleProps{Size: ui.DialogTitleSizeMD}) {
					Ask the graph 
				}
				@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-1"}) {
					Ask a question in plain language. The answer is grounded in the objects memory has stored.
				}
			</div>
		</div>
		<form class="mt-4 flex flex-col gap-3" action={ templ.URL(action) } { formAttrs... } { objectsPreviewGuards(data.Preview)... }>
			<textarea id="objects-knowledge-question" name="question" rows="4" placeholder="Ask a question about your knowledge graph…" class="textarea w-full" autocomplete="off" aria-label="Ask the graph"></textarea>
			if data.BranchID != "" {
				<input type="hidden" name="branch" value={ data.BranchID }/>
			}
			<div class="flex flex-wrap items-center gap-2">
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--messages-square",
				}) {
					Ask
				}
				<span class="htmx-indicator loading loading-spinner loading-xs" aria-hidden="true"></span>
				<span class="text-muted-faint text-xs">Answers can take a few seconds.</span>
			</div>
		</form>
		<div id="objects-knowledge-answer" class="mt-3"></div>
	}
}
