package main

import (
	"cmp"
	"net/url"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Credentials (project settings) ---
//
// Credentials are OAuth *apps*: a vendor-level client (e.g. "Google OAuth app")
// that can back one or more data-source providers. They live on their own
// project settings page, rendered as the standard table, and never on the Data
// Sources connections table. Every project member can view the table; only
// project admins can open a per-provider editor and change the project app.
// Organization-wide apps appear as organization-scope rows, managed from the
// org settings page.

// CredentialsPage renders the project's Credentials page as two separately
// headed sections: saved credentials first (reusable tokens and other
// write-only secrets), then the OAuth apps table. The saved-credentials section
// lists what the project has stored; the OAuth-apps section lists one row per
// OAuth-capable provider for the project scope, plus the organization-scope row
// when that app is configured, with the resolved scope marked "In use". A failed
// member-safe credentials fetch renders the whole-page error state; the rail
// still renders so the page is navigable.
templ CredentialsPage(data dsCredentialsPageData) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Settings", "/settings", "Credentials")), "", "Credentials", dsCredentialsSubtitle(data.ProjectName, data.OrgName), detailHeaderOpts{Margin: "mb-6"})
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageErrorNotice("Credentials unavailable", data.LoadErr)
		} else {
			@layout.Rail(settingsSubNav("credentials", data.Nav.ProvidersMissing), nil) {
				<div class="flex flex-col gap-6" data-testid="ds-credentials">
					@dsSavedCredentialsSection(data)
					<section class="flex flex-col gap-3" data-testid="ds-oauth-apps">
						<div>
							<h2 class="text-base font-semibold">OAuth apps</h2>
							@ui.EmptyNote(ui.EmptyNoteProps{Class: "mt-1"}) {
								OAuth apps are shared by their vendor and can back more than one data source. A project app overrides the organization-wide app for this project only. Every project member can view this page; project admins manage the project app, and org admins manage the organization app.
							}
						</div>
						if data.DeploymentNote != "" {
							@ui.Alert(ui.AlertProps{
								Type:    ui.AlertInfo,
								Style:   ui.AlertStyleOutline,
								Icon:    "lucide--server",
								Message: data.DeploymentNote,
							})
						}
						@dsCredentialTable(data.Rows)
					</section>
					if data.SavedCredentialPicker.ShowModal {
						@savedCredentialModal(data.SavedCredentialPicker, nil)
					}
				</div>
			}
		}
	}
}

// dsSavedCredentialsSection lists the project's saved credentials above the
// OAuth apps: reusable write-only secrets referenced by data sources.
templ dsSavedCredentialsSection(data dsCredentialsPageData) {
	<section class="flex flex-col gap-3" data-testid="ds-saved-credentials">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h2 class="text-base font-semibold">Saved credentials</h2>
				@ui.EmptyNote(ui.EmptyNoteProps{Class: "mt-1"}) {
					Tokens and other credentials saved for this project. One credential can back several data sources, and editing it changes every source that uses it. Secrets are stored encrypted and never shown again. 
				}
			</div>
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeButton,
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonSM,
				Icon:    "lucide--plus",
				Attrs: templ.Attributes{
					"data-testid": "ds-saved-credential-add",
					"onclick":     "dsSavedCredentialOpenNew()",
				},
			}) {
				Add credential
			}
		</div>
		if data.SavedCredentialsErr != nil {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertError,
				Style:   ui.AlertStyleSoft,
				Icon:    "lucide--alert-triangle",
				Message: "Saved credentials could not be loaded. Reload the page to try again.",
			})
		} else if len(data.SavedCredentials) == 0 {
			@ui.EmptyState(ui.EmptyStateProps{
				Icon:        "lucide--key-round",
				Title:       "No saved credentials yet",
				Description: "Add a credential to connect a provider with a personal access token, then reuse it for more sources.",
				Bordered:    true,
				Class:       "py-8",
			})
		} else {
			@components.TableCard(nil) {
				<div class="overflow-x-auto stacked-table" style="--h1:'Name';--h2:'Provider';--h3:'Used by';--h4:'Updated';--h5:''">
					<table class="table table-sm" data-testid="ds-saved-credentials-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Provider</th>
								<th>Used by</th>
								<th>Updated</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range data.SavedCredentials {
								@dsSavedCredentialRowView(c)
							}
						</tbody>
					</table>
				</div>
			}
		}
	</section>
}

// dsSavedCredentialRowView is one saved credential row: metadata only, never a
// secret. Edit reopens the shared modal prefilled; delete is a small POST form
// with a confirm step so an in-use credential fails server-side (409) with a
// readable message instead of vanishing.
templ dsSavedCredentialRowView(c dsSavedCredentialRow) {
	<tr data-testid="ds-saved-credential-row" data-provider={ c.ProviderType }>
		<td>
			<div class="flex min-w-0 items-center gap-2">
				@ui.IconSpan("lucide--key-round", "size-4 shrink-0 text-muted-faint")
				<span class="truncate font-medium">{ c.Name }</span>
			</div>
		</td>
		<td>{ c.ProviderName }</td>
		<td class="whitespace-nowrap text-muted">{ dsUsedByLabel(c.UsedByCount) }</td>
		<td class="whitespace-nowrap text-muted">{ relTimeOrDash(c.UpdatedAt) }</td>
		<td class="text-right">
			<div class="flex items-center justify-end gap-1">
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeButton,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Icon:    "lucide--pencil",
					Attrs: templ.Attributes{
						"data-testid":        "ds-saved-credential-edit",
						"data-cred-id":       c.ID,
						"data-cred-name":     c.Name,
						"data-cred-provider": c.ProviderType,
						"onclick":            "dsSavedCredentialEdit(this)",
					},
				}) {
					Edit
				}
				<form method="post" action={ templ.URL("/settings/credentials/saved/" + url.PathEscape(c.ID) + "/delete") } hx-confirm="Delete this credential? Any data source still using it must be switched to another credential first." class="inline-flex">
					<input type="hidden" name="return_to" value="/settings/credentials"/>
					@ui.Button(ui.ButtonProps{
						Type:      ui.ButtonTypeSubmit,
						Variant:   ui.ButtonGhost,
						Size:      ui.ButtonSM,
						Icon:      "lucide--trash-2",
						AriaLabel: "Delete " + c.Name,
						Attrs:     templ.Attributes{"data-testid": "ds-saved-credential-delete"},
					}) {
						Delete
					}
				</form>
			</div>
		</td>
	</tr>
}

// savedCredentialModal is the one add/edit dialog shared by the Credentials page,
// the connect form, and the source settings card. edit is nil for a new
// credential; otherwise the form posts to that credential's update endpoint with
// the name prefilled and the provider fixed.
templ savedCredentialModal(picker dsSavedCredentialPicker, edit *DSSavedCredential) {
	{{ modalProvider := picker.DefaultProvider }}
	if edit != nil {
		{{ modalProvider = edit.ProviderType }}
	}
	@ui.Dialog(ui.DialogProps{
		ID:       "saved-credential-modal",
		BoxClass: "w-full max-w-md",
		Attrs: templ.Attributes{
			"data-testid":     "ds-saved-credential-modal",
			"aria-labelledby": "saved-credential-modal-title",
		},
	}) {
		<div class="flex items-start justify-between gap-3">
			<div>
				@ui.DialogTitle(ui.DialogTitleProps{ID: "saved-credential-modal-title"}) {
					if edit != nil {
						Edit credential
					} else {
						New credential
					}
				}
				@ui.EmptyNote(ui.EmptyNoteProps{Class: "mt-1"}) {
					A saved credential belongs to this project and can back more than one data source. Secrets are stored encrypted and never shown again. 
				}
			</div>
			@ui.Button(ui.ButtonProps{
				Type:      ui.ButtonTypeButton,
				Variant:   ui.ButtonGhost,
				Size:      ui.ButtonSM,
				Shape:     ui.ButtonShapeSquare,
				Icon:      "lucide--x",
				AriaLabel: "Close",
				Attrs: templ.Attributes{
					"data-testid": "ds-saved-credential-close",
					"onclick":     "dsCloseSavedCredential()",
				},
			})
		</div>
		<form
			id="saved-credential-form"
			method="post"
			action={ templ.URL(savedCredentialFormAction(edit)) }
			class="mt-4 flex flex-col gap-4"
			data-testid="ds-saved-credential-form"
		>
			<input type="hidden" name="return_to" value={ picker.ReturnURL }/>
			if picker.FixedProvider != "" || edit != nil {
				{{ fixedProvider := cmp.Or(picker.FixedProvider, modalProvider) }}
				<input type="hidden" id="saved-credential-fixed-provider" name="providerType" value={ fixedProvider }/>
				<div class="flex flex-col gap-1">
					<span class="text-sm font-medium">Provider</span>
					<span class="text-sm" data-testid="ds-saved-credential-provider-fixed">{ dsPickerProviderName(picker.Providers, fixedProvider) }</span>
				</div>
			} else {
				<div class="flex flex-col gap-1">
					<label class="text-sm font-medium" for="saved-credential-provider">Provider</label>
					<select
						id="saved-credential-provider"
						name="providerType"
						class="select w-full"
						data-testid="ds-saved-credential-provider"
						hx-get="/settings/credentials/saved/fields"
						hx-trigger="change"
						hx-target="#saved-credential-fields"
						hx-swap="innerHTML"
						hx-include="this"
					>
						for _, p := range picker.Providers {
							<option value={ p.Type } selected?={ p.Type == modalProvider }>{ p.Name }</option>
						}
					</select>
					<input type="hidden" id="saved-credential-fixed-provider" name="providerType" value=""/>
				</div>
			}
			<div class="flex flex-col gap-1">
				<label class="text-sm font-medium" for="saved-credential-name">Name <span class="text-error" aria-hidden="true">*</span></label>
				<input
					id="saved-credential-name"
					name="name"
					type="text"
					class="input w-full"
					required
					autocomplete="off"
					data-testid="ds-saved-credential-name"
					placeholder="e.g. CI read-only token"
					if edit != nil {
						value={ edit.Name }
					}
				/>
			</div>
			<div id="saved-credential-fields" data-testid="ds-saved-credential-fields">
				@dsSavedCredentialFields(modalProvider, picker.Fields, edit == nil, nil)
			</div>
			<div class="modal-action">
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeButton,
					Variant: ui.ButtonOutline,
					Size:    ui.ButtonSM,
					Attrs: templ.Attributes{
						"data-testid": "ds-saved-credential-cancel",
						"onclick":     "dsCloseSavedCredential()",
					},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--check",
					Attrs:   templ.Attributes{"data-testid": "ds-saved-credential-submit"},
				}) {
					Save credential
				}
			</div>
		</form>
	}
	<script>
	function dsCloseSavedCredential() {
		var d = document.getElementById('saved-credential-modal');
		if (d) d.close();
	}
	function dsSavedCredentialLoadFields(provider, optional) {
		var fields = document.getElementById('saved-credential-fields');
		if (!fields || !provider || !window.htmx) return;
		var url = '/settings/credentials/saved/fields?providerType=' + encodeURIComponent(provider);
		if (optional) url += '&optional=1';
		htmx.ajax('GET', url, '#saved-credential-fields');
	}
	function dsSavedCredentialOpenNew() {
		var form = document.getElementById('saved-credential-form');
		if (form) form.action = '/settings/credentials/saved';
		var title = document.getElementById('saved-credential-modal-title');
		if (title) title.textContent = 'New credential';
		var name = document.getElementById('saved-credential-name');
		if (name) name.value = '';
		var select = document.getElementById('saved-credential-provider');
		var fixed = document.getElementById('saved-credential-fixed-provider');
		if (select) {
			select.disabled = false;
			if (fixed) fixed.value = '';
			// The page's provider select makes the field set changeable; reload
			// the required fields for whichever provider is now selected.
			dsSavedCredentialLoadFields(select.value, false);
		}
		var d = document.getElementById('saved-credential-modal');
		if (d) d.showModal();
	}
	function dsSavedCredentialEdit(btn) {
		var form = document.getElementById('saved-credential-form');
		if (!form || !btn) return;
		var id = btn.getAttribute('data-cred-id') || '';
		var name = btn.getAttribute('data-cred-name') || '';
		var provider = btn.getAttribute('data-cred-provider') || '';
		form.action = '/settings/credentials/saved/' + encodeURIComponent(id) + '/update';
		var title = document.getElementById('saved-credential-modal-title');
		if (title) title.textContent = 'Edit credential';
		var nameInput = document.getElementById('saved-credential-name');
		if (nameInput) nameInput.value = name;
		var select = document.getElementById('saved-credential-provider');
		if (select) select.disabled = true;
		var fixed = document.getElementById('saved-credential-fixed-provider');
		if (fixed) fixed.value = provider;
		dsSavedCredentialLoadFields(provider, true);
		var d = document.getElementById('saved-credential-modal');
		if (d) d.showModal();
	}
	</script>
}

// dsSavedCredentialFields renders the provider's credential inputs (write-only).
// Only required fields are shown on the connect/create path: the optional ones
// (a GitHub Enterprise API base, for example) keep their defaults. On edit the
// fields are optional, so a rename does not force the secret to be retyped.
templ dsSavedCredentialFields(providerType string, fields []dsConfigField, required bool, loadErr error) {
	<input type="hidden" name="providerType" value={ providerType }/>
	if loadErr != nil {
		<div class="text-sm text-error" data-testid="ds-saved-credential-fields-error">{ loadErr.Error() }</div>
	} else if len(fields) == 0 {
		@ui.EmptyNote(ui.EmptyNoteProps{Attrs: templ.Attributes{"data-testid": "ds-saved-credential-fields-empty"}}) {
			This provider declares no credential fields. 
		}
	} else {
		<div class="flex flex-col gap-3">
			for _, f := range fields {
				<div class="flex flex-col gap-1">
					<label class="text-sm font-medium" for={ "saved-credential-" + f.Key }>
						{ f.Label }
						if required && f.Required {
							<span class="text-error" aria-hidden="true">*</span>
						}
					</label>
					if f.Description != "" {
						@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS}) {
							{ f.Description }
						}
					}
					<input
						id={ "saved-credential-" + f.Key }
						name={ f.Key }
						type="password"
						autocomplete="new-password"
						class="input w-full"
						data-testid={ "ds-saved-credential-field-" + f.Key }
						required?={ required && f.Required }
					/>
				</div>
			}
			if !required {
				@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet, Size: ui.EmptyNoteSizeXS}) {
					Leave a field empty to keep its stored value. 
				}
			}
		</div>
	}
}

// dsCredentialsSubtitle builds the page subtitle from the project and org names:
// the page holds both the project's saved credentials and its OAuth apps.
func dsCredentialsSubtitle(projectName, orgName string) string {
	switch {
	case projectName == "" && orgName == "":
		return "Credentials saved for this project, and the OAuth apps available to it."
	case orgName == "":
		return "Credentials saved for " + projectName + ", and the OAuth apps available to it."
	default:
		return "Credentials saved for " + projectName + ", and the OAuth apps available to it from the project and from " + orgName + "."
	}
}

// dsCredentialTable renders the credentials table. Rows are grouped by provider
// in catalog order: the project-scope row first, then the organization-scope
// row. An empty catalog renders an empty state.
templ dsCredentialTable(rows []dsCredentialRow) {
	if len(rows) == 0 {
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--key-round",
			Title:       "No OAuth providers",
			Description: "The provider catalog does not offer any OAuth-capable data sources yet.",
			Bordered:    true,
			Class:       "py-12",
		})
	} else {
		@components.TableCard(nil) {
			<div class="overflow-x-auto stacked-table" style="--h1:'App';--h2:'Data source';--h3:'Scope';--h4:'Client ID';--h5:'Status';--h6:'Updated';--h7:''">
				<table class="table table-sm" data-testid="ds-credentials-table">
					<thead>
						<tr>
							<th>App</th>
							<th>Data source</th>
							<th>Scope</th>
							<th>Client ID</th>
							<th>Status</th>
							<th>Updated</th>
							<th class="text-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range rows {
							@dsCredentialRowView(row)
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// dsCredentialRowView is one credential instance: a provider at one scope.
templ dsCredentialRowView(row dsCredentialRow) {
	<tr data-testid="ds-credential-row" data-provider={ row.ProviderType } data-scope={ row.ScopeKey }>
		<td>
			<div class="flex min-w-0 items-center gap-2">
				@ui.IconSpan("lucide--key-round", "size-4 shrink-0 text-muted-faint")
				<span class="truncate font-medium">{ row.App }</span>
			</div>
		</td>
		<td>{ row.DataSource }</td>
		<td>
			<span class="inline-flex items-center gap-1.5 whitespace-nowrap text-sm">
				@ui.IconSpan(row.ScopeIcon, "size-3.5 shrink-0 text-muted-faint")
				{ row.ScopeLabel }
			</span>
		</td>
		<td>
			if row.ClientID == "" {
				@components.EmptyDash()
			} else {
				<span class="font-mono text-xs whitespace-nowrap text-muted" title={ row.ClientID } data-testid="ds-credential-client-id">{ shortCredentialID(row.ClientID) }</span>
			}
		</td>
		<td>
			if row.Resolved {
				@components.StatusBadge("In use", ui.BadgeSuccess, "", components.StatusBadgeOpts{Size: ui.BadgeSizeXS, Dot: true, Attrs: templ.Attributes{"data-testid": "ds-credential-in-use"}})
			} else if row.Configured {
				@components.StatusBadge("Configured", ui.BadgeNeutral, "", components.StatusBadgeOpts{Size: ui.BadgeSizeXS, Dot: true})
			} else {
				@ui.Badge(ui.BadgeProps{Label: "Not configured", Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS})
			}
		</td>
		<td class="whitespace-nowrap text-muted">{ relTimeOrDash(row.UpdatedAt) }</td>
		<td class="text-right">
			if row.ManageHref != "" {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    row.ManageHref,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Icon:    "lucide--settings",
					Attrs:   templ.Attributes{"data-testid": "ds-credential-manage"},
				}) {
					{ row.ManageLabel }
				}
			} else if row.ManagedNote != "" {
				<span class="text-xs text-muted">{ row.ManagedNote }</span>
			} else {
				@components.EmptyDash()
			}
		</td>
	</tr>
}

// CredentialDetailPage renders the per-provider OAuth app editor for the project
// (project-admin only; everyone else gets a 404). The editor reuses the shared
// OAuth client card, so the write-only secret and provider console guide stay in
// one place. The inheritance note explains which scope wins and links org admins
// to the organization-wide editor.
templ CredentialDetailPage(data dsCredentialDetailData) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Settings", "/settings", "Credentials", "/settings/credentials", data.Provider.Name)), "", dsCredentialAppLabel(data.Provider), "Used when connecting "+data.Provider.Name+" in this project.", detailHeaderOpts{Margin: "mb-6"}) {
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/settings/credentials",
				Variant: ui.ButtonOutline,
				Size:    ui.ButtonSM,
				Icon:    "lucide--arrow-left",
				Attrs:   templ.Attributes{"data-testid": "ds-credential-back"},
			}) {
				Back to credentials
			}
		}
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageErrorNotice("Credential unavailable", data.LoadErr)
		} else {
			@layout.Rail(settingsSubNav("credentials", data.Nav.ProvidersMissing), nil) {
				<div class="flex flex-col gap-4" data-testid="ds-credential-detail">
					@dsCredentialInheritanceNote(data)
					@dsOAuthClientCard("/settings/credentials", data.Provider, data.Config)
				</div>
			}
		}
	}
}

// dsCredentialInheritanceNote explains which scope's OAuth app this project
// resolves to, and offers org admins a direct link to the organization editor.
templ dsCredentialInheritanceNote(data dsCredentialDetailData) {
	if data.Config.Configured {
		if data.OrgConfigured {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertInfo,
				Style:   ui.AlertStyleSoft,
				Icon:    "lucide--layers",
				Message: "This project has its own app, which overrides the organization-wide app for this project only.",
			})
		} else {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertSuccess,
				Style:   ui.AlertStyleSoft,
				Icon:    "lucide--circle-check",
				Message: "This project has its own app. OAuth connections in this project use it.",
			})
		}
		if data.OrgManageHref != "" {
			<div>
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    data.OrgManageHref,
					Variant: ui.ButtonOutline,
					Size:    ui.ButtonSM,
					Icon:    "lucide--building-2",
					Attrs:   templ.Attributes{"data-testid": "ds-credential-org-link"},
				}) {
					Manage organization app
				}
			</div>
		}
	} else if data.OrgConfigured {
		@ui.Alert(ui.AlertProps{
			Type:    ui.AlertInfo,
			Style:   ui.AlertStyleSoft,
			Icon:    "lucide--building-2",
			Message: "No project app is configured, so this project uses the organization-wide app.",
		})
		if data.OrgManageHref != "" {
			<div>
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    data.OrgManageHref,
					Variant: ui.ButtonOutline,
					Size:    ui.ButtonSM,
					Icon:    "lucide--building-2",
					Attrs:   templ.Attributes{"data-testid": "ds-credential-org-link"},
				}) {
					Manage organization app
				}
			</div>
		}
	} else {
		@ui.Alert(ui.AlertProps{
			Type:    ui.AlertWarning,
			Style:   ui.AlertStyleSoft,
			Icon:    "lucide--alert-triangle",
			Message: "No project or organization app is configured. New OAuth connections fail until you add one; some deployments expose a built-in default.",
		})
		// The project table no longer carries an empty organization row, so this
		// is where an org admin still gets a direct route to the org-wide editor.
		if data.OrgManageHref != "" {
			<div>
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    data.OrgManageHref,
					Variant: ui.ButtonOutline,
					Size:    ui.ButtonSM,
					Icon:    "lucide--building-2",
					Attrs:   templ.Attributes{"data-testid": "ds-credential-org-link"},
				}) {
					Manage organization app
				}
			</div>
		}
	}
}

// shortCredentialID shortens a client id for table display while keeping the
// full value in the cell's title attribute. Client ids are not secrets.
func shortCredentialID(id string) string {
	const keep = 18
	if len(id) <= keep {
		return id
	}
	return id[:keep] + "…"
}

// dsCredentialAppHref is the per-provider editor path.
func dsCredentialAppHref(providerType string) string {
	return "/settings/credentials/" + url.PathEscape(providerType)
}
