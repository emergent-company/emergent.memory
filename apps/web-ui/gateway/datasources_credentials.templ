package main

import (
	"net/url"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Credentials (project settings) ---
//
// Credentials are OAuth *apps*: a vendor-level client (e.g. "Google OAuth app")
// that can back one or more data-source providers. They live on their own
// project settings page, rendered as the standard table, and never on the Data
// Sources connections table. Every project member can view the table; only
// project admins can open a per-provider editor and change the project app.
// Organization-wide apps appear as organization-scope rows, managed from the
// org settings page.

// CredentialsPage renders the project's Credentials table: one row per provider
// per scope (project, then organization), with the resolved scope marked "In
// use". A failed member-safe credentials fetch renders the whole-page error
// state; the rail still renders so the page is navigable.
templ CredentialsPage(data dsCredentialsPageData) {
	@layout.Container(layout.ContainerLG, nil) {
		@pageHeader("Project", "Credentials", dsCredentialsSubtitle(data.ProjectName, data.OrgName))
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageError("Credentials unavailable", data.LoadErr)
		} else {
			@layout.Rail(settingsSubNav("credentials", data.Nav.ProvidersMissing), nil) {
				<div class="flex flex-col gap-4" data-testid="ds-credentials">
					@ui.Alert(ui.AlertProps{
						Type:    ui.AlertInfo,
						Style:   ui.AlertStyleSoft,
						Icon:    "lucide--info",
						Message: "An OAuth app is shared by its vendor and can back more than one data source. A project app overrides the organization-wide app for this project only. Every project member can view this page; project admins manage the project app, and org admins manage the organization app.",
					})
					if data.DeploymentNote != "" {
						@ui.Alert(ui.AlertProps{
							Type:    ui.AlertInfo,
							Style:   ui.AlertStyleOutline,
							Icon:    "lucide--server",
							Message: data.DeploymentNote,
						})
					}
					@dsCredentialTable(data.Rows)
				</div>
			}
		}
	}
}

// dsCredentialsSubtitle builds the page subtitle from the project and org names.
func dsCredentialsSubtitle(projectName, orgName string) string {
	if projectName == "" && orgName == "" {
		return "OAuth apps available to this project, at the project and organization scope."
	}
	if orgName == "" {
		return "OAuth apps available to " + projectName + ", at the project and organization scope."
	}
	return "OAuth apps available to " + projectName + " from the project and from " + orgName + "."
}

// dsCredentialTable renders the credentials table. Rows are grouped by provider
// in catalog order: the project-scope row first, then the organization-scope
// row. An empty catalog renders an empty state.
templ dsCredentialTable(rows []dsCredentialRow) {
	if len(rows) == 0 {
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--key-round",
			Title:       "No OAuth providers",
			Description: "The provider catalog does not offer any OAuth-capable data sources yet.",
			Bordered:    true,
			Class:       "py-12",
		})
	} else {
		@components.TableCard(nil) {
			<div class="overflow-x-auto">
				<table class="table table-sm" data-testid="ds-credentials-table">
					<thead>
						<tr>
							<th>App</th>
							<th>Data source</th>
							<th>Scope</th>
							<th>Client ID</th>
							<th>Status</th>
							<th>Updated</th>
							<th class="text-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range rows {
							@dsCredentialRowView(row)
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// dsCredentialRowView is one credential instance: a provider at one scope.
templ dsCredentialRowView(row dsCredentialRow) {
	<tr data-testid="ds-credential-row" data-provider={ row.ProviderType } data-scope={ row.ScopeKey }>
		<td>
			<div class="flex min-w-0 items-center gap-2">
				@ui.IconSpan("lucide--key-round", "size-4 shrink-0 text-muted-faint")
				<span class="truncate font-medium">{ row.App }</span>
			</div>
		</td>
		<td>{ row.DataSource }</td>
		<td>
			<span class="inline-flex items-center gap-1.5 whitespace-nowrap text-sm">
				@ui.IconSpan(row.ScopeIcon, "size-3.5 shrink-0 text-muted-faint")
				{ row.ScopeLabel }
			</span>
		</td>
		<td>
			if row.ClientID == "" {
				@components.EmptyDash()
			} else {
				<span class="font-mono text-xs whitespace-nowrap text-muted" title={ row.ClientID } data-testid="ds-credential-client-id">{ shortCredentialID(row.ClientID) }</span>
			}
		</td>
		<td>
			if row.Resolved {
				@components.StatusBadge("In use", ui.BadgeSuccess, "", components.StatusBadgeOpts{Size: ui.BadgeSizeXS, Dot: true, Attrs: templ.Attributes{"data-testid": "ds-credential-in-use"}})
			} else if row.Configured {
				@components.StatusBadge("Configured", ui.BadgeNeutral, "", components.StatusBadgeOpts{Size: ui.BadgeSizeXS, Dot: true})
			} else {
				@ui.Badge(ui.BadgeProps{Label: "Not configured", Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS})
			}
		</td>
		<td class="whitespace-nowrap text-muted">{ relTimeOrDash(row.UpdatedAt) }</td>
		<td class="text-right">
			if row.ManageHref != "" {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    row.ManageHref,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Icon:    "lucide--settings",
					Attrs:   templ.Attributes{"data-testid": "ds-credential-manage"},
				}) {
					{ row.ManageLabel }
				}
			} else if row.ManagedNote != "" {
				<span class="text-xs text-muted">{ row.ManagedNote }</span>
			} else {
				@components.EmptyDash()
			}
		</td>
	</tr>
}

// CredentialDetailPage renders the per-provider OAuth app editor for the project
// (project-admin only; everyone else gets a 404). The editor reuses the shared
// OAuth client card, so the write-only secret and provider console guide stay in
// one place. The inheritance note explains which scope wins and links org admins
// to the organization-wide editor.
templ CredentialDetailPage(data dsCredentialDetailData) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Settings", "/settings", "Credentials", "/settings/credentials", data.Provider.Name)), "", dsCredentialAppLabel(data.Provider), "Used when connecting "+data.Provider.Name+" in this project.", detailHeaderOpts{Margin: "mb-6"}) {
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/settings/credentials",
				Variant: ui.ButtonOutline,
				Size:    ui.ButtonSM,
				Icon:    "lucide--arrow-left",
				Attrs:   templ.Attributes{"data-testid": "ds-credential-back"},
			}) {
				Back to credentials
			}
		}
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageError("Credential unavailable", data.LoadErr)
		} else {
			@layout.Rail(settingsSubNav("credentials", data.Nav.ProvidersMissing), nil) {
				<div class="flex flex-col gap-4" data-testid="ds-credential-detail">
					@dsCredentialInheritanceNote(data)
					@dsOAuthClientCard("/settings/credentials", data.Provider, data.Config)
				</div>
			}
		}
	}
}

// dsCredentialInheritanceNote explains which scope's OAuth app this project
// resolves to, and offers org admins a direct link to the organization editor.
templ dsCredentialInheritanceNote(data dsCredentialDetailData) {
	if data.Config.Configured {
		if data.OrgConfigured {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertInfo,
				Style:   ui.AlertStyleSoft,
				Icon:    "lucide--layers",
				Message: "This project has its own app, which overrides the organization-wide app for this project only.",
			})
		} else {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertSuccess,
				Style:   ui.AlertStyleSoft,
				Icon:    "lucide--circle-check",
				Message: "This project has its own app. OAuth connections in this project use it.",
			})
		}
		if data.OrgManageHref != "" {
			<div>
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    data.OrgManageHref,
					Variant: ui.ButtonOutline,
					Size:    ui.ButtonSM,
					Icon:    "lucide--building-2",
					Attrs:   templ.Attributes{"data-testid": "ds-credential-org-link"},
				}) {
					Manage organization app
				}
			</div>
		}
	} else if data.OrgConfigured {
		@ui.Alert(ui.AlertProps{
			Type:    ui.AlertInfo,
			Style:   ui.AlertStyleSoft,
			Icon:    "lucide--building-2",
			Message: "No project app is configured, so this project uses the organization-wide app.",
		})
		if data.OrgManageHref != "" {
			<div>
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    data.OrgManageHref,
					Variant: ui.ButtonOutline,
					Size:    ui.ButtonSM,
					Icon:    "lucide--building-2",
					Attrs:   templ.Attributes{"data-testid": "ds-credential-org-link"},
				}) {
					Manage organization app
				}
			</div>
		}
	} else {
		@ui.Alert(ui.AlertProps{
			Type:    ui.AlertWarning,
			Style:   ui.AlertStyleSoft,
			Icon:    "lucide--alert-triangle",
			Message: "No project or organization app is configured. New OAuth connections fail until you add one; some deployments expose a built-in default.",
		})
	}
}

// shortCredentialID shortens a client id for table display while keeping the
// full value in the cell's title attribute. Client ids are not secrets.
func shortCredentialID(id string) string {
	const keep = 18
	if len(id) <= keep {
		return id
	}
	return id[:keep] + "…"
}

// dsCredentialAppHref is the per-provider editor path.
func dsCredentialAppHref(providerType string) string {
	return "/settings/credentials/" + url.PathEscape(providerType)
}
