package main

import (
	"net/url"

	"github.com/emergent-company/go-daisy/components/form"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	"github.com/emergent-company/go-daisy/components/table"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Organizations ---

// OrgsPage renders the signed-in user's access tree: each org (with the user's
// org role) and its nested projects (with the project role). A
// "Create organization" action navigates to the standalone create page at
// /orgs/new. A failed tree fetch renders the whole-page error state.
templ OrgsPage(data orgsPageData) {
	@layout.Container(layout.ContainerLG, nil) {
		@pageHeader("Workspace", "Organizations", "The organizations you belong to and the projects inside them.") {
			if data.LoadErr == nil {
				@countBadge(len(data.Orgs), "org", "lucide--building-2")
			}
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/orgs/new",
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonSM,
				Icon:    "lucide--building-2",
			}) {
				Create organization
			}
		}
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageError("Organizations unavailable", data.LoadErr)
		} else {
			@ui.Section("Your organizations", ui.SectionProps{
				Margin:    "mb-6",
				BodyClass: "p-0",
			}) {
				if len(data.Orgs) == 0 {
					@ui.EmptyState(ui.EmptyStateProps{
						Icon:        "lucide--building-2",
						Title:       "No organizations yet",
						Description: "Organizations group your projects and the people who work on them.",
						ActionHref:  "/orgs/new",
						ActionLabel: "Create organization",
						ActionIcon:  "lucide--plus",
					})
				} else {
					<div class="divide-y divide-base-200">
						for _, o := range data.Orgs {
							@orgTreeRow(o)
						}
					</div>
				}
			}
		}
	}
}

// orgTreeRow is one org in the access tree: the org name with the user's org
// role badge and its nested projects, each with its project role.
templ orgTreeRow(o OrgWithProjectsDto) {
	<div class="px-5 py-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div class="flex min-w-0 items-center gap-2.5">
				@ui.IconSpan("lucide--building-2", "size-4 shrink-0 text-base-content/50")
				<p class="truncate text-sm font-semibold">{ o.Name }</p>
			</div>
			<div class="flex items-center gap-2">
				if o.Role == "org_admin" {
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeLink,
						Href:    "/orgs/" + url.PathEscape(o.ID) + "/invite",
						Variant: ui.ButtonGhost,
						Style:   ui.ButtonStyleOutline,
						Size:    ui.ButtonSM,
						Icon:    "lucide--user-plus",
					}) {
						Invite
					}
				}
				@roleBadge(o.Role)
			</div>
		</div>
		<div class="mt-3 flex flex-col">
			if len(o.Projects) == 0 {
				<p class="text-base-content/40 text-xs">No projects in this organization yet.</p>
			} else {
				for _, p := range o.Projects {
					@orgProjectRow(p)
				}
			}
		</div>
	</div>
}

// orgProjectRow is one project inside an org tree row: name + project role.
// The whole row is a submit button (POST /projects/activate) so clicking a
// project opens it directly, like the switcher's project rows.
templ orgProjectRow(p ProjectAccessDto) {
	<form method="post" action="/projects/activate" class="flex">
		<input type="hidden" name="projectId" value={ p.ID }/>
		<button type="submit" class="group flex min-w-0 flex-1 cursor-pointer items-center gap-2.5 py-1.5 text-left" title={ "Open " + p.Name }>
			<span class="border-base-content/10 ml-1 h-4 border-l"></span>
			@ui.IconSpan("lucide--folder", "size-3.5 shrink-0 text-base-content/30")
			<span class="min-w-0 flex-1 truncate text-sm text-base-content/85 group-hover:text-base-content">{ p.Name }</span>
			@roleBadge(p.Role)
		</button>
	</form>
}

// roleBadge renders the shared role badge (label + colour derived from the
// role enum).
templ roleBadge(role string) {
	@ui.Badge(ui.BadgeProps{
		Label:   roleLabel(role),
		Variant: roleIntent(role),
		Size:    ui.BadgeSizeXS,
	})
}

// OrgCreatePage renders the standalone create-organization page (/orgs/new):
// the name field posting to POST /orgs. flashErr surfaces PRG feedback from
// the create flow.
templ OrgCreatePage(data orgCreatePageData) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Organizations", "/orgs", "New organization")), "", "New organization", "A home for projects and the people who work on them.") {}
		@flashToasts("", data.FlashErr)
		@ui.CardRaw("card-border", "p-5", nil) {
			<form method="post" action="/orgs" class="flex flex-col gap-4">
				@form.FormControl("new-org-name", "Name", form.LabelAbove, "", "", nil) {
					<input id="new-org-name" name="name" type="text" required placeholder="e.g. Acme" class="input w-full"/>
				}
				@form.FormActions("", "") {
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonPrimary,
						Size:    ui.ButtonSM,
						Icon:    "lucide--building-2",
					}) {
						Create organization
					}
				}
			</form>
		}
	}
}

// --- Members (merged view + invite form + details) ---

// MembersPage renders the active project's people in one table: confirmed
// members (avatar + identity, role, joined, remove affordance — suppressed
// for the sole project_admin) and pending invitations in a special
// not-yet-confirmed state (email + invited role + a subdued "Not responded"
// badge, revoke affordance). An "Add member" action navigates to the invite
// form at /members/new.
templ MembersPage(data membersPageData) {
	{{ title := "Members"
	subtitle := "People with access to the active project."
	if data.ProjectName != "" {
		subtitle = "People with access to " + data.ProjectName + "."
	} }}
	@layout.Container(layout.ContainerLG, nil) {
		@pageHeader("Workspace", title, subtitle) {
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    "/members/new",
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonSM,
				Icon:    "lucide--user-plus",
			}) {
				Add member
			}
		}
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageError("Members unavailable", data.LoadErr)
		} else {
			if data.PendingErr != nil {
				@ui.Alert(ui.AlertProps{
					Type:    ui.AlertError,
					Style:   ui.AlertStyleOutline,
					Icon:    "lucide--alert-triangle",
					Message: "Couldn't load pending invitations: " + data.PendingErr.Error(),
				})
			}
			if len(data.Members) == 0 && len(data.Pending) == 0 {
				@ui.EmptyState(ui.EmptyStateProps{
					Icon:        "lucide--users",
					Title:       "No members yet",
					Description: "Invite someone to this project and they will show up here once they accept.",
					Bordered:    true,
					Class:       "py-12",
					ActionHref:  "/members/new",
					ActionLabel: "Add member",
					ActionIcon:  "lucide--user-plus",
				})
			} else {
				@ui.CardRaw("card-border overflow-hidden shadow-sm", "p-0", nil) {
					@table.TableWithProps(table.TableProps{Bordered: false}) {
						@table.TableHead() {
							@table.TableHeadRow() {
								@table.TableHeadCell("Member")
								@table.TableHeadCell("Role")
								@table.TableHeadCell("Since")
								@table.TableHeadCell("")
							}
						}
						@table.TableBody() {
							for _, m := range data.Members {
								@memberRow(m, canRemoveMember(data.Members, m))
							}
							for _, inv := range data.Pending {
								@memberInviteRow(inv)
							}
						}
					}
				}
			}
		}
	}
}

// memberRow is one confirmed member row: avatar + identity (the name links to
// the member details page), role badge, joined date, and (when removable) a
// remove form.
templ memberRow(m ProjectMemberDto, removable bool) {
	@table.TableRow(m.ID, true, nil) {
		@table.TableCell("", nil) {
			<div class="flex items-center gap-3">
				@memberAvatar(m)
				<div class="min-w-0">
					<a class="truncate text-sm font-medium hover:underline" href={ templ.URL("/members/" + url.PathEscape(m.ID)) }>{ memberDisplayName(m) }</a>
					<p class="text-base-content/50 truncate text-xs">{ m.Email }</p>
				</div>
			</div>
		}
		@table.TableCell("", nil) {
			@roleBadge(m.Role)
		}
		@table.TableCell("", nil) {
			<span class="text-base-content/50 text-xs whitespace-nowrap">{ relTime(m.JoinedAt) }</span>
		}
		@table.TableCell("text-right", nil) {
			if removable {
				<div class="flex justify-end">
					<form method="post" action={ templ.URL("/members/" + url.PathEscape(m.ID) + "/remove") }>
						@ui.Button(ui.ButtonProps{
							Type:       ui.ButtonTypeSubmit,
							Variant:    ui.ButtonGhost,
							Size:       ui.ButtonSM,
							Shape:      ui.ButtonShapeSquare,
							Icon:       "lucide--trash-2",
							ExtraClass: "text-error hover:text-error",
							AriaLabel:  "Remove " + memberDisplayName(m),
							Attrs:      templ.Attributes{"title": "Remove from project"},
						})
					</form>
				</div>
			}
		}
	}
}

// memberAvatar renders the member's avatar via go-daisy's AvatarFull: picture
// when present, else initials on a muted circle, else a user icon.
templ memberAvatar(m ProjectMemberDto) {
	<div class="shrink-0 text-xs">
		@ui.AvatarFull(ui.AvatarProps{
			Name:     memberDisplayName(m),
			Src:      m.AvatarURL,
			Icon:     "lucide--user",
			Size:     ui.AvatarSM,
			Tone:     ui.AvatarToneMuted,
			Fallback: ui.AvatarFallbackInitials,
		})
	</div>
}

// memberInviteRow is one still-pending invitation to the active project,
// rendered in the members table as a not-yet-confirmed member: a muted mail
// tile, the invited email with the subdued "Not responded" badge, the invited
// role, when it was sent, and a revoke affordance.
templ memberInviteRow(inv SentInviteDto) {
	@table.TableRow(inv.ID, true, nil) {
		@table.TableCell("", nil) {
			<div class="flex items-center gap-3">
				<div class="border-base-content/15 flex size-8 shrink-0 items-center justify-center rounded-full border">
					@ui.IconSpan("lucide--mail", "size-4 text-base-content/45")
				</div>
				<div class="min-w-0">
					<p class="truncate text-sm font-medium">{ inv.Email }</p>
					@ui.Badge(ui.BadgeProps{
						Label:   "Not responded",
						Variant: ui.BadgeGhost,
						Size:    ui.BadgeSizeXS,
						Dot:     true,
					})
				</div>
			</div>
		}
		@table.TableCell("", nil) {
			@roleBadge(inv.Role)
		}
		@table.TableCell("", nil) {
			<span class="text-base-content/50 text-xs whitespace-nowrap">{ relTime(inv.CreatedAt) }</span>
		}
		@table.TableCell("text-right", nil) {
			<div class="flex justify-end">
				<form method="post" action={ templ.URL("/invites/" + url.PathEscape(inv.ID) + "/revoke") }>
					@ui.Button(ui.ButtonProps{
						Type:       ui.ButtonTypeSubmit,
						Variant:    ui.ButtonGhost,
						Size:       ui.ButtonSM,
						Shape:      ui.ButtonShapeSquare,
						Icon:       "lucide--trash-2",
						ExtraClass: "text-error hover:text-error",
						AriaLabel:  "Revoke invite for " + inv.Email,
						Attrs:      templ.Attributes{"title": "Revoke invite"},
					})
				</form>
			</div>
		}
	}
}

// MemberInvitePage renders the standalone invite-a-member page (/members/new).
// The email field autocompletes against registered users: while the user
// types, htmx fetches /partial/invite-user-search and swaps the matches into
// the datalist, so a click (or Enter) fills the address. The target
// org/project are resolved server-side from the active project. When no
// project is active the form is replaced by a hint.
templ MemberInvitePage(data memberInvitePageData) {
	{{ subtitle := "An email invitation with a role — they join once they accept."
	if data.ProjectName != "" {
		subtitle = "Invite someone to " + data.ProjectName + " — they join once they accept."
	} }}
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Members", "/members", "Invite a member")), "", "Invite a member", subtitle) {}
		@flashToasts("", data.FlashErr)
		if !data.HasProject {
			@ui.CardRaw("card-border", "p-5", nil) {
				<p class="text-base-content/50 text-sm">Select or create a project first — invitations are sent per project from the project you are in.</p>
			}
		} else {
			@ui.CardRaw("card-border", "p-5", nil) {
				<form method="post" action="/members" class="flex flex-col gap-4">
					@form.FormControl("invite-email", "Email", form.LabelAbove, "Start typing to match a registered user, or type any email address.", "", nil) {
						<input
							id="invite-email"
							name="email"
							type="email"
							required
							list="invite-email-options"
							autocomplete="off"
							placeholder="name@example.com"
							class="input w-full"
							hx-get="/partial/invite-user-search"
							hx-trigger="input changed delay:300ms"
							hx-target="#invite-email-options"
							hx-swap="innerHTML"
						/>
						<datalist id="invite-email-options"></datalist>
					}
					@form.FormControl("invite-role", "Role", form.LabelAbove, "Project admins manage members, invites, and project settings; project users work with the project.", "", nil) {
						<select id="invite-role" name="role" class="select w-full">
							<option value="project_user" selected>Project user</option>
							<option value="project_admin">Project admin</option>
						</select>
					}
					@form.FormActions("", "") {
						@ui.Button(ui.ButtonProps{
							Type:    ui.ButtonTypeSubmit,
							Variant: ui.ButtonPrimary,
							Size:    ui.ButtonSM,
							Icon:    "lucide--mail-plus",
						}) {
							Send invitation
						}
					}
				</form>
			}
		}
	}
}

// MemberDetailPage renders one confirmed member's details page
// (/members/:userId): identity (avatar/initials, display name, email) plus
// role and joined date, and — for removable members — a role-change form.
// Memory has no member-role PATCH, so the role-change posts a remove +
// re-invite (see memberRoleChangeSection). NotFound renders the not-found
// state; LoadErr the whole-page error state; FlashErr surfaces PRG feedback
// from a failed role change.
templ MemberDetailPage(data memberDetailPageData) {
	@layout.Container(layout.ContainerLG, nil) {
		if data.LoadErr != nil {
			@pageError("Member unavailable", data.LoadErr)
		} else if data.NotFound || data.Member == nil {
			@detailHeader(crumbsActive(nav.Crumbs("Members", "/members", "Member not found")), "", "Member not found", "") {}
			@ui.EmptyState(ui.EmptyStateProps{
				Icon:        "lucide--user",
				Title:       "Member not found",
				Description: "No member with this id in the active project.",
				Bordered:    true,
			})
		} else {
			{{ m := *data.Member }}
			@detailHeader(crumbsActive(nav.Crumbs("Members", "/members", memberDisplayName(m))), "", memberDisplayName(m), m.Email) {
				@roleBadge(m.Role)
			}
			@flashToasts("", data.FlashErr)
			@ui.Section("Member", ui.SectionProps{
				Margin:    "mb-6",
				BodyClass: "p-5",
			}) {
				<div class="flex items-center gap-4">
					@memberAvatar(m)
					<div class="min-w-0 leading-tight">
						<p class="truncate text-lg font-semibold">{ memberDisplayName(m) }</p>
						if memberFullName(m) != "" {
							<p class="text-base-content/60 mt-0.5 text-sm">{ memberFullName(m) }</p>
						}
						<p class="text-base-content/45 mt-0.5 text-xs">Joined { relTime(m.JoinedAt) }</p>
					</div>
				</div>
			}
			@ui.Section("Details", ui.SectionProps{
				Margin:    "mb-6",
				BodyClass: "p-5",
			}) {
				<dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
					@memberDetailRow("Display name", memberDisplayName(m))
					@memberDetailRow("Email", m.Email)
					@memberDetailRow("First name", m.FirstName)
					@memberDetailRow("Last name", m.LastName)
					<div>
						<dt class="text-base-content/45 text-xs">Role</dt>
						<dd class="mt-1">@roleBadge(m.Role)</dd>
					</div>
					@memberDetailRow("Joined", relTime(m.JoinedAt))
				</dl>
			}
			@memberRoleChangeSection(m, data.CanChangeRole)
		}
	}
}

// memberRoleChangeSection is the role-management affordance on the member
// details page: the current role plus, for removable members, a change-role
// form. Because Memory cannot persist a role change, submitting it removes the
// member and re-invites their email with the chosen role — the submit confirm
// (window.confirm) spells that consequence out. The form opts out of hx-boost
// so the browser runs a native PRG; the handler 303s back with a flash. When
// the member is the project's only admin the control is replaced by a hint:
// removing them would leave the project with no admin and Memory rejects it.
templ memberRoleChangeSection(m ProjectMemberDto, canChange bool) {
	@ui.Section("Role", ui.SectionProps{
		Margin:    "mb-6",
		BodyClass: "p-5",
	}) {
		<div class="flex flex-wrap items-start justify-between gap-4">
			<div class="min-w-0">
				<div class="flex items-center gap-2">
					<p class="text-sm font-medium">Current role</p>
					@roleBadge(m.Role)
				</div>
				<p class="text-base-content/50 mt-1 max-w-md text-xs">
					Changing a role removes this member and sends a new invitation with the chosen role.
					They regain access only after accepting the new invitation.
				</p>
			</div>
			if canChange {
				<form
					method="post"
					action={ templ.URL("/members/" + url.PathEscape(m.ID) + "/role") }
					hx-boost="false"
					onsubmit="return confirm('Change this role? The member is removed and re-invited with the new role; they must accept the new invitation to regain access.');"
					class="flex flex-wrap items-end gap-2"
				>
					<select id="member-role" name="role" required class="select select-sm w-full sm:w-44">
						<option value="" disabled selected>Change to…</option>
						<option value="project_user">Project user</option>
						<option value="project_admin">Project admin</option>
					</select>
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonPrimary,
						Size:    ui.ButtonSM,
						Icon:    "lucide--user-cog",
					}) {
						Change role
					}
				</form>
			} else {
				<p class="text-base-content/50 max-w-xs text-xs">
					This is the project's only admin. Assign another admin before changing their role.
				</p>
			}
		</div>
	}
}

// memberDetailRow is one label/value line of the member details definition
// list. Empty values render an em dash.
templ memberDetailRow(label, value string) {
	<div>
		<dt class="text-base-content/45 text-xs">{ label }</dt>
		<dd class="text-base-content/85 mt-0.5 text-sm">
			if value == "" {
				@emptyDash()
			} else {
				{ value }
			}
		</dd>
	</div>
}

// userSearchOptions is the htmx partial swapped into the invite form's
// datalist: one option per matching user (email as the value, the display
// label as the option text where present).
templ userSearchOptions(users []UserSearchResultDto) {
	for _, u := range users {
		if u.DisplayName != "" {
			<option value={ u.Email }>{ u.DisplayName } — { u.Email }</option>
		} else {
			<option value={ u.Email }></option>
		}
	}
}

// --- Profile (identity, invitations, and account API tokens split across
// three pages sharing a vertical sub-nav rail) ---

// profileSubNav is the vertical sub-navigation rail for the Profile area
// (Profile / Invitations / API tokens), mirroring settingsSubNav. It stacks
// horizontally on small screens and becomes a sticky left rail on desktop.
templ profileSubNav(active string) {
	<nav class="flex flex-row gap-1 overflow-x-auto lg:flex-col" aria-label="Profile sections">
		@subNavItem("/profile", active == "profile", "lucide--user", "Profile")
		@subNavItem("/profile/invitations", active == "invitations", "lucide--mail-plus", "Invitations")
		@subNavItem("/profile/tokens", active == "tokens", "lucide--key-round", "API tokens")
	</nav>
}

// profilePageFrame renders the Profile area's shared chrome: the account page
// header, flash toasts, and the two-column rail layout (sticky sub-nav on the
// left, page content on the right). Children hold the page body placed inside
// the content column.
templ profilePageFrame(active, title, subtitle, flashMsg string, flashErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		@pageHeader("Account", title, subtitle) {}
		@flashToasts(flashMsg, flashErr)
		{ children... }
	}
}

// profileRailContent is the shared rail layout wrapper: the sticky profile
// sub-nav aside plus a content column holding the caller's children.
templ profileRailContent(active string) {
	@layout.Rail(profileSubNav(active), nil) {
		{ children... }
	}
}

// ProfilePage renders the signed-in user's profile (/profile): the identity
// summary and the edit form, with the profile sub-nav ("Profile" active).
// Invitations live on their own page (/profile/invitations) and account API
// tokens on /profile/tokens. A failed profile fetch renders the whole-page
// error state.
templ ProfilePage(data profilePageData) {
	@profilePageFrame("profile", "Profile", "Your name and contact details.", data.FlashMsg, data.FlashErr) {
		if data.LoadErr != nil {
			@pageError("Profile unavailable", data.LoadErr)
		} else {
			@profileRailContent("profile") {
				if data.Profile != nil {
					@profileIdentityCard(data.Profile, data.Email)
					@profileAvatarModal(data.Profile)
					@profileEditForm(data.Profile)
				}
			}
		}
	}
}

// InvitationsPage renders the signed-in user's pending invitations
// (/profile/invitations): each invitation to an organization/project with
// accept (token-bound) and decline forms, and the profile sub-nav
// ("Invitations" active). A failed fetch renders the whole-page error state.
templ InvitationsPage(data invitationsPageData) {
	@profilePageFrame("invitations", "Invitations", "Invitations to join organizations and projects.", data.FlashMsg, data.FlashErr) {
		if data.LoadErr != nil {
			@pageError("Invitations unavailable", data.LoadErr)
		} else {
			@profileRailContent("invitations") {
				@ui.Section("Pending invitations", ui.SectionProps{
					Margin:    "mb-6",
					BodyClass: "p-0",
				}) {
					if len(data.Pending) == 0 {
						<div class="px-5 py-8 text-center">
							@ui.IconSpan("lucide--mail-plus", "mx-auto size-6 text-base-content/25")
							<p class="text-base-content/45 mt-2 text-sm">No pending invitations.</p>
						</div>
					} else {
						<div class="divide-y divide-base-200">
							for _, inv := range data.Pending {
								@pendingInviteRow(inv)
							}
						</div>
					}
				}
			}
		}
	}
}

// pendingInviteRow is one invitation addressed to the signed-in user: the
// target organization/project and the role offered, with accept (token-bound)
// and decline forms.
templ pendingInviteRow(inv PendingInviteDto) {
	<div class="flex flex-wrap items-center gap-3 px-5 py-3.5">
		@ui.IconTile("lucide--mail-plus", ui.IconTileProps{Tone: "secondary", Size: "size-9"})
		<div class="min-w-0 grow">
			<p class="truncate text-sm font-medium">{ inv.OrganizationName }</p>
			<p class="text-base-content/50 mt-0.5 truncate text-xs">{ pendingInviteMeta(inv) }</p>
		</div>
		<div class="flex items-center gap-2">
			@roleBadge(inv.Role)
			<div class="flex shrink-0 gap-1.5">
				<form method="post" action={ templ.URL("/invites/" + url.PathEscape(inv.ID) + "/accept") }>
					<input type="hidden" name="token" value={ inv.Token }/>
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonSuccess,
						Style:   ui.ButtonStyleOutline,
						Size:    ui.ButtonSM,
						Icon:    "lucide--check",
					}) {
						Accept
					}
				</form>
				<form method="post" action={ templ.URL("/invites/" + url.PathEscape(inv.ID) + "/decline") }>
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonGhost,
						Style:   ui.ButtonStyleOutline,
						Size:    ui.ButtonSM,
						Icon:    "lucide--circle-x",
					}) {
						Decline
					}
				</form>
			</div>
		</div>
	</div>
}

// profileIdentityCard renders the profile identity summary: the editable
// avatar (a button opening the profile-photo dialog, see profileAvatar) + the
// user's display name (falling back to first + last when no display name is
// set), email, and phone in a titled card. Full name is deliberately not
// repeated here — the profile form below edits the underlying first/last
// fields.
templ profileIdentityCard(p *UserProfileDto, email string) {
	@ui.Section("Profile", ui.SectionProps{
		Margin:    "mb-6",
		BodyClass: "p-5",
	}) {
		<div class="flex items-center gap-4">
			@profileAvatar(p)
			<div class="min-w-0 leading-tight">
				<p class="truncate text-lg font-semibold">{ profileDisplayName(*p) }</p>
				if email != "" {
					<p class="text-base-content/45 mt-0.5 text-xs">{ email }</p>
				}
				if p.PhoneE164 != "" {
					<p class="text-base-content/45 mt-0.5 text-xs">{ p.PhoneE164 }</p>
				}
			</div>
		</div>
	}
}

// profileAvatar renders the profile header avatar as a button that opens the
// profile-photo dialog (profileAvatarModal): the uploaded photo when the
// profile has an AvatarUrl, else initials on a primary circle. Hovering or
// focusing the avatar reveals a translucent edit overlay with a pencil.
templ profileAvatar(p *UserProfileDto) {
	if p != nil {
		<button
			type="button"
			class="group relative cursor-pointer rounded-full border-0 bg-transparent p-0 outline-none transition focus-visible:ring-2 focus-visible:ring-primary/60"
			aria-label="Edit profile photo"
			onclick="document.getElementById('profile-avatar-modal').showModal()"
		>
			<div class="shrink-0 text-lg">
				@ui.AvatarFull(ui.AvatarProps{
					Name:     profileDisplayName(*p),
					Src:      p.AvatarUrl,
					Icon:     "lucide--user",
					Size:     ui.AvatarSize14,
					Fallback: ui.AvatarFallbackInitials,
				})
			</div>
			<span aria-hidden="true" class="bg-black/45 text-white absolute inset-0 z-10 grid place-items-center rounded-full opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100">
				@ui.IconSpan("lucide--pencil", "size-5")
			</span>
		</button>
	}
}

// profileAvatarModal is the profile-photo editor dialog (PRG → POST
// /profile/avatar): a multipart upload field whose action row pairs the
// "Remove photo" button (form="profile-avatar-remove-form", only when an
// override exists) on the left with the "Upload photo" submit on the right.
// Opened by the identity-card avatar trigger via showModal(); the header X
// (method="dialog" submit) and the backdrop form both close it natively.
templ profileAvatarModal(p *UserProfileDto) {
	@modalShell("profile-avatar-modal", "", "max-w-sm") {
		<div class="mb-5 flex items-start justify-between gap-4">
			<div>
				<h3 class="text-lg font-semibold">Profile photo</h3>
				<p class="text-base-content/50 mt-0.5 text-sm">Upload a photo to appear in the top bar and across your account.</p>
			</div>
			<form method="dialog">
				@ui.Button(ui.ButtonProps{
					Type:      ui.ButtonTypeSubmit,
					Variant:   ui.ButtonGhost,
					Size:      ui.ButtonSM,
					Shape:     ui.ButtonShapeCircle,
					Icon:      "lucide--x",
					AriaLabel: "Close",
				})
			</form>
		</div>
		<form method="post" action="/profile/avatar" enctype="multipart/form-data" class="flex flex-col gap-4">
			<input id="profile-avatar-file" name="file" type="file" accept="image/*" class="file-input file-input-sm w-full"/>
			<div class="flex items-center justify-between gap-2">
				if p != nil && p.AvatarUrl != "" {
					@ui.Button(ui.ButtonProps{
						Type:       ui.ButtonTypeSubmit,
						Variant:    ui.ButtonGhost,
						Style:      ui.ButtonStyleOutline,
						Size:       ui.ButtonSM,
						Icon:       "lucide--trash-2",
						ExtraClass: "text-error hover:text-error",
						Attrs:      templ.Attributes{"form": "profile-avatar-remove-form"},
					}) {
						Remove photo
					}
				}
				@ui.Button(ui.ButtonProps{
					Type:       ui.ButtonTypeSubmit,
					Variant:    ui.ButtonPrimary,
					Size:       ui.ButtonSM,
					Icon:       "lucide--image-plus",
					ExtraClass: "ms-auto",
				}) {
					Upload photo
				}
			</div>
		</form>
		if p != nil && p.AvatarUrl != "" {
			<form id="profile-avatar-remove-form" method="post" action="/profile/avatar/remove"></form>
		}
	}
}

// profileEditForm is the edit form (PRG → POST /profile) carrying the
// UpdateUserProfileDto fields, prefilled from the current profile.
templ profileEditForm(p *UserProfileDto) {
	@ui.Section("Edit profile", ui.SectionProps{
		Margin:    "mb-6",
		BodyClass: "p-5",
	}) {
		<form method="post" action="/profile" class="flex flex-col gap-4">
			@form.FormControl("profile-display-name", "Display name", form.LabelAbove, "", "", nil) {
				<input id="profile-display-name" name="displayName" type="text" value={ p.DisplayName } placeholder="e.g. Ada Lovelace" class="input w-full"/>
			}
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				@form.FormControl("profile-first-name", "First name", form.LabelAbove, "", "", nil) {
					<input id="profile-first-name" name="firstName" type="text" value={ p.FirstName } placeholder="Ada" class="input w-full"/>
				}
				@form.FormControl("profile-last-name", "Last name", form.LabelAbove, "", "", nil) {
					<input id="profile-last-name" name="lastName" type="text" value={ p.LastName } placeholder="Lovelace" class="input w-full"/>
				}
			</div>
			@form.FormControl("profile-phone", "Phone", form.LabelAbove, "In E.164 format, e.g. +14155552671.", "", nil) {
				<input id="profile-phone" name="phoneE164" type="tel" value={ p.PhoneE164 } placeholder="+14155552671" class="input w-full"/>
			}
			@form.FormActions("", "") {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--save",
				}) {
					Save changes
				}
			}
		</form>
	}
}
