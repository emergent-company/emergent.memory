package main

import (
	"net/url"
	"strconv"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Schema packs list ---

// SchemaPacksPage renders the "Schema packs" list: the project's ACTIVE packs
// with their owner, type counts, and description. Each row links to the
// read-only pack detail. "Add schema" is the list-page action (the existing
// /schema/add install flow). A load error renders the whole-page error state
// inside the rail.
templ SchemaPacksPage(packs []schemaPackSummary, loadErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Schema", "/schema", "Schema packs")), "", "Schema packs", "Active schema packs contributing object and relationship types to this project.") {
			<div class="flex flex-wrap items-center gap-2">
				if loadErr == nil {
					@countBadgeLabel(countLabel(len(packs), "pack", "packs"), "lucide--library")
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    "/schema/add",
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--plus",
				}) {
					Add schema
				}
			</div>
		}
		@layout.Rail(schemaSubNav("packs"), nil) {
			if loadErr != nil {
				@pageError("Failed to load schema packs", loadErr)
			} else if len(packs) == 0 {
				@ui.EmptyState(ui.EmptyStateProps{
					Icon:        "lucide--library",
					Title:       "No active schema packs",
					Description: "Install a schema pack to add object and relationship types to this project.",
					Bordered:    true,
					ActionHref:  "/schema/add",
					ActionLabel: "Add schema",
					ActionIcon:  "lucide--plus",
				})
			} else {
				@cardList("", cardListProps{}) {
					for _, p := range packs {
						@schemaPackRow(p)
					}
				}
			}
		}
	}
}

// schemaPackRow is one active pack: name, version, owner badge, owning
// blueprint (when one applies), type counts, and description. The whole row is
// the link to the pack detail.
templ schemaPackRow(p schemaPackSummary) {
	<a class="block px-4 py-3 transition-colors hover:bg-base-200/40" href={ templ.URL("/schema/packs/" + url.PathEscape(p.ID)) }>
		<div class="flex flex-wrap items-center gap-2">
			<p class="text-sm font-medium">{ p.Name }</p>
			@ui.Badge(ui.BadgeProps{Label: "v" + p.Version, Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS})
			@ownerBadge(p, ui.BadgeSizeXS)
			if p.Provenance != nil {
				@ui.Badge(ui.BadgeProps{Label: typeProvenanceLabel(p.Provenance), Variant: ui.BadgeSecondary, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: "lucide--library"})
			}
		</div>
		@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-1"}) {
			{ p.typeCountLabel() }
		}
		if p.Description != "" {
			@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-0.5"}) {
				{ p.Description }
			}
		}
	</a>
}

// --- Schema pack detail (read-only) ---

// SchemaPackPage renders one active pack's read-only detail: a metadata header
// and two type tables (object types / relationship types). pack == nil with a
// nil loadErr is the not-found state (unknown or absent pack id); a non-nil
// loadErr is the whole-page error state. Neither panics.
templ SchemaPackPage(pack *schemaPackSummary, loadErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		if pack == nil {
			@detailHeader(crumbsActive(nav.Crumbs("Schema", "/schema", "Schema packs", "/schema/packs", "Schema pack")), "", "Schema pack", "")
		} else {
			@schemaPackHeader(pack)
		}
		@layout.Rail(schemaSubNav("packs"), nil) {
			if loadErr != nil {
				@pageError("Schema pack unavailable", loadErr)
			} else if pack == nil {
				@ui.EmptyState(ui.EmptyStateProps{
					Icon:        "lucide--circle-help",
					Title:       "Schema pack not found",
					Description: "This pack is not active in this project. It may have been removed by a blueprint change.",
					Bordered:    true,
					ActionHref:  "/schema/packs",
					ActionLabel: "Back to Schema packs",
					ActionIcon:  "lucide--arrow-left",
				})
			} else {
				@schemaPackMeta(pack)
				{{
					prov := map[string]*ProvenanceInfo{}
					if pack.Provenance != nil {
						for _, t := range pack.ObjectTypes {
							prov[t.Name] = pack.Provenance
						}
					}
				}}
				@compiledTypesTable("Object types", pack.ObjectTypes, false, "/schema/object-types/", prov)
				@compiledTypesTable("Relationship types", pack.RelationshipTypes, true, "", nil)
			}
		}
	}
}

// schemaPackHeader is the pack detail header: breadcrumb, name, description,
// version, owner, and installed (active) state.
templ schemaPackHeader(pack *schemaPackSummary) {
	@detailHeader(crumbsActive(nav.Crumbs("Schema", "/schema", "Schema packs", "/schema/packs", pack.Name)), "Schema pack", pack.Name, pack.Description, detailHeaderOpts{Margin: "mb-6"}) {
		<div class="flex flex-wrap items-center gap-2">
			@ui.Badge(ui.BadgeProps{Label: "v" + pack.Version, Variant: ui.BadgeGhost, Size: ui.BadgeSizeSM})
			@ownerBadge(*pack, ui.BadgeSizeSM)
			@ui.Badge(ui.BadgeProps{Label: "Active", Variant: ui.BadgeSuccess, Size: ui.BadgeSizeSM, Dot: true})
		</div>
	}
}

// SchemaPackPendingPage renders a pack that exists in the project's catalog but
// is not installed — the state a discovery run leaves its result in. It shows
// what the run proposed and the one action that turns it into compiled types,
// so the Schema page's "Review pack" link never dead-ends on a not-found page.
templ SchemaPackPendingPage(pack *pendingPack, flashErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Schema", "/schema", "Schema packs", "/schema/packs", pack.Name)), "Schema pack", pack.Name, pack.Description, detailHeaderOpts{Margin: "mb-6"}) {
			<div class="flex flex-wrap items-center gap-2">
				@ui.Badge(ui.BadgeProps{Label: "v" + pack.Version, Variant: ui.BadgeGhost, Size: ui.BadgeSizeSM})
				@ui.Badge(ui.BadgeProps{Label: "Pending review", Variant: ui.BadgeInfo, Size: ui.BadgeSizeSM, Dot: true})
			</div>
		}
		@layout.Rail(schemaSubNav("packs"), nil) {
			if flashErr != nil {
				<div class="mb-4">
					@ui.Alert(ui.AlertProps{
						Type:    ui.AlertError,
						Style:   ui.AlertStyleSoft,
						Icon:    "lucide--alert-triangle",
						Message: "Could not install the pack: " + flashErr.Error(),
					})
				</div>
			}
			@ui.EmptyNote(ui.EmptyNoteProps{Class: "mb-4"}) {
				This pack was proposed by a discovery run and is not installed. Its types are not used for extraction until you install it, and installing is the only step that takes them live.
			}
			@ui.Section("Pack details", ui.SectionProps{Margin: "mb-6", BodyClass: "memory-density-comfortable"}) {
				@components.MetaGrid() {
					@schemaPackMetaRow("Pack id", pack.ID, true)
					if pack.Author != "" {
						@schemaPackMetaRow("Author", pack.Author, false)
					}
					if pack.Source != "" {
						@schemaPackMetaRow("Source", pack.Source, false)
					}
					@schemaPackMetaRow("Types", strconv.Itoa(len(pack.ObjectTypes)+len(pack.RelationTypes)), false)
				}
			}
			<form method="post" action={ templ.URL("/schema/packs/" + url.PathEscape(pack.ID) + "/install") } class="mb-6">
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--check",
					Attrs:   templ.Attributes{"data-testid": "schema-pack-install"},
				}) {
					Install pack
				}
			</form>
			@pendingPackTypeList("Object types", pack.ObjectTypes)
			@pendingPackTypeList("Relationship types", pack.RelationTypes)
		}
	}
}

// pendingPackTypeList is a plain name list: a pending pack's types are not in
// the compiled registry, so the compiled-types table (which links to type
// detail pages) would produce dead links.
templ pendingPackTypeList(title string, names []string) {
	@ui.Section(title, ui.SectionProps{Margin: "mb-6"}) {
		if len(names) == 0 {
			@ui.EmptyNote() {
				None proposed.
			}
		} else {
			<ul class="list-disc space-y-1 pl-5 text-sm">
				for _, name := range names {
					<li>{ name }</li>
				}
			</ul>
		}
	}
}

// schemaPackMeta is the pack's read-only metadata panel: id, owner, source,
// type counts, and the owning blueprint link when one applies.
templ schemaPackMeta(pack *schemaPackSummary) {
	@ui.Section("Pack details", ui.SectionProps{
		Margin:    "mb-6",
		BodyClass: "memory-density-comfortable",
	}) {
		@components.MetaGrid() {
			@schemaPackMetaRow("Pack id", pack.ID, true)
			@schemaPackMetaRow("Owner", pack.ownerLabel(), false)
			if pack.Source != "" {
				@schemaPackMetaRow("Source", pack.Source, false)
			}
			@schemaPackMetaRow("Types", pack.typeCountLabel(), false)
			if pack.Provenance != nil {
				@components.MetaRowCustom("Owning blueprint", components.MetaRowOpts{NoEmptyDash: true}) {
					<a class="text-primary font-medium hover:underline" href={ templ.URL("/blueprints/" + url.PathEscape(pack.Provenance.BlueprintID)) }>{ typeProvenanceLabel(pack.Provenance) }</a>
				}
			}
		}
	}
}

templ schemaPackMetaRow(label, value string, mono bool) {
	@components.MetaRow(label, value, components.MetaRowOpts{Mono: mono})
}

// ownerBadge is the shared Global / Project marker for pack rows and detail.
templ ownerBadge(pack schemaPackSummary, size ui.BadgeSize) {
	if pack.global() {
		@components.StatusBadge("Global", ui.BadgeNeutral, "", components.StatusBadgeOpts{Size: size, Dot: true})
	} else {
		@components.StatusBadge("Project", ui.BadgePrimary, "", components.StatusBadgeOpts{Size: size, Dot: true})
	}
}
