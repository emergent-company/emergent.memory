package main

import (
	"net/url"
	"strconv"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Schema packs list ---

// SchemaPacksPage renders the "Schema packs" list in four fixed sections:
// Manual, Blueprints, Data Sources and Built-in. A blueprint section keeps the
// per-blueprint groups (the heading links to the blueprint, as before); a Data
// Sources section lists one row per installed app (the row links to the app);
// Manual and Built-in rows have no title link. Each row still exposes its object
// types as links, and a "Details" link opens the read-only pack page. "Add
// schema" is the list-page action (the existing /schema/add install flow). A
// load error renders the whole-page error state inside the rail.
templ SchemaPacksPage(sections []schemaPackSection, loadErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Schema", "/schema", "Schema packs")), "", "Schema packs", "Active schema packs contributing object and relationship types to this project.") {
			<div class="flex flex-wrap items-center gap-2">
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeLink,
					Href:    "/schema/add",
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--plus",
				}) {
					Add schema
				}
			</div>
		}
		@layout.Rail(schemaSubNav("packs"), nil) {
			if loadErr != nil {
				@pageErrorNotice("Failed to load schema packs", loadErr)
			} else if len(sections) == 0 {
				@ui.EmptyState(ui.EmptyStateProps{
					Icon:        "lucide--library",
					Title:       "No active schema packs",
					Description: "Install a schema pack to add object and relationship types to this project.",
					Bordered:    true,
					ActionHref:  "/schema/add",
					ActionLabel: "Add schema",
					ActionIcon:  "lucide--plus",
				})
			} else {
				<div class="flex flex-col gap-8" data-testid="schema-pack-groups">
					for _, sec := range sections {
						<section class="flex flex-col gap-3" data-testid="schema-pack-section" data-schema-pack-section={ sec.Key }>
							@originHeading(sec.Label, "", "", sec.packCount(), "pack", "packs")
							for _, g := range sec.Groups {
								<div class="flex flex-col gap-2" data-testid="schema-pack-group" data-schema-pack-group={ g.Key }>
									if g.Label != "" {
										if g.Href != "" {
											<div class="flex flex-wrap items-center gap-2">
												@ui.IconSpan("lucide--library", "text-info size-3.5 shrink-0")
												<a class="text-info text-sm font-semibold hover:underline" href={ templ.URL(g.Href) }>{ g.Label }</a>
												<span class="text-muted-faint text-[11px]">{ countLabel(len(g.Rows), "pack", "packs") }</span>
												<span class="text-muted-faint text-[11px]">· blueprint</span>
											</div>
										} else {
											<div class="flex flex-wrap items-center gap-2">
												@ui.IconSpan("lucide--database", "text-info size-3.5 shrink-0")
												<span class="text-muted-bright text-sm font-semibold">{ g.Label }</span>
												<span class="text-muted-faint text-[11px]">{ countLabel(len(g.Rows), "pack", "packs") }</span>
											</div>
										}
									}
									for _, r := range g.Rows {
										@schemaPackRowCard(r)
									}
								</div>
							}
						</section>
					}
				</div>
			}
		}
	}
}

// schemaPackRowCard is one active pack in the list. The title is the pack name,
// or an installed app's name for a data-source row; it links only where the
// section gives it a destination (the app, for data sources) — a blueprint's
// destination is the group heading above it, and manual/built-in rows are plain.
// The row keeps the pack's object types as chips linking to their type pages, so
// the data is reachable even when the title is not a link, and offers the
// read-only pack detail behind an explicit "Details" link.
templ schemaPackRowCard(r schemaPackRow) {
	{{ p := r.Pack
	icon := ""
	color := ""
	for _, t := range p.ObjectTypes {
		if icon == "" {
			icon = compiledTypeIcon(t)
		}
		if color == "" {
			color = compiledTypeColor(t)
		}
		if icon != "" && color != "" {
			break
		}
	} }}
	<div class="rounded-box border-base-content/10 bg-base-100 group flex items-start gap-3 border px-3 py-2.5" data-testid="schema-pack-card">
		@typeIconTile(icon, color)
		<div class="min-w-0 flex-1">
			<div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
				<span class="text-warning truncate text-sm font-medium" data-testid="schema-pack-title">
					if r.Href != "" {
						<a class="hover:underline" href={ templ.URL(r.Href) } data-schema-pack-title-href={ r.Href }>{ r.Title }</a>
					} else {
						{ r.Title }
					}
				</span>
				@ui.Badge(ui.BadgeProps{Label: "v" + p.Version, Variant: ui.BadgeGhost, Size: ui.BadgeSizeXS})
				@ownerBadge(p, ui.BadgeSizeXS)
				if r.Subtitle != "" {
					<span class="text-muted-faint text-[11px]">{ r.Subtitle }</span>
				}
			</div>
			if len(p.ObjectTypes) > 0 {
				<div class="mt-1 flex flex-wrap items-center gap-1" data-testid="schema-pack-types">
					for _, t := range p.ObjectTypes {
						@schemaPackTypeChip(t)
					}
				</div>
			}
			@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-0.5"}) {
				{ p.typeCountLabel() }
			}
			if p.Description != "" {
				@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-0.5 truncate"}) {
					{ p.Description }
				}
			}
		</div>
		<a class="text-muted-faint hover:text-base-content inline-flex shrink-0 items-center gap-0.5 text-[11px]" href={ templ.URL("/schema/packs/" + url.PathEscape(p.ID)) } data-testid="schema-pack-details">
			Details
			@ui.IconSpan("lucide--chevron-right", "size-3.5")
		</a>
	</div>
}

// schemaPackTypeChip is one object type of a pack, rendered with the type's own
// declared icon and colour accent and linking to that type's page.
templ schemaPackTypeChip(t CompiledType) {
	{{ icon := compiledTypeIcon(t)
	color := compiledTypeColor(t)
	cls := typeIconClass(icon)
	glyph := ""
	if cls == "" {
		glyph = icon
	} }}
	<a href={ templ.URL("/schema/object-types/" + url.PathEscape(t.Name)) } class="inline-flex items-center" data-testid="schema-pack-type-link" data-pack-type={ t.Name } title={ t.Name }>
		@ui.Badge(ui.BadgeProps{Label: t.Name, Variant: ui.BadgeGhost, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: cls, Glyph: glyph, Color: color})
	</a>
}

// --- Schema pack detail (read-only) ---

// SchemaPackPage renders one active pack's read-only detail: a metadata header
// and two type tables (object types / relationship types). pack == nil with a
// nil loadErr is the not-found state (unknown or absent pack id); a non-nil
// loadErr is the whole-page error state. notice is the install confirmation, so
// installing a pending pack lands somewhere that says it worked. Neither panics.
templ SchemaPackPage(pack *schemaPackSummary, loadErr error, notice string) {
	@layout.Container(layout.ContainerLG, nil) {
		if pack == nil {
			@detailHeader(crumbsActive(nav.Crumbs("Schema", "/schema", "Schema packs", "/schema/packs", "Schema pack")), "", "Schema pack", "")
		} else {
			@schemaPackHeader(pack)
		}
		@layout.Rail(schemaSubNav("packs"), nil) {
			if loadErr != nil {
				@pageErrorNotice("Schema pack unavailable", loadErr)
			} else if pack == nil {
				@ui.EmptyState(ui.EmptyStateProps{
					Icon:        "lucide--circle-help",
					Title:       "Schema pack not found",
					Description: "This pack is not active in this project. It may have been removed by a blueprint change.",
					Bordered:    true,
					ActionHref:  "/schema/packs",
					ActionLabel: "Back to Schema packs",
					ActionIcon:  "lucide--arrow-left",
				})
			} else {
				if notice != "" {
					<div class="mb-4">
						@ui.Alert(ui.AlertProps{
							Type:    ui.AlertSuccess,
							Style:   ui.AlertStyleSoft,
							Icon:    "lucide--check-circle",
							Message: notice,
						})
					</div>
				}
				@schemaPackMeta(pack)
				@typeCardSection("Object types", pack.ObjectTypes, false, "/schema/object-types/")
				@typeCardSection("Relationship types", pack.RelationshipTypes, true, "")
			}
		}
	}
}

// schemaPackHeader is the pack detail header: breadcrumb, name, description,
// version, owner, and installed (active) state.
templ schemaPackHeaderMeta(pack *schemaPackSummary) {
	@ui.Badge(ui.BadgeProps{Label: "v" + pack.Version, Variant: ui.BadgeGhost, Size: ui.BadgeSizeSM})
	@ownerBadge(*pack, ui.BadgeSizeSM)
	@ui.Badge(ui.BadgeProps{Label: "Active", Variant: ui.BadgeSuccess, Size: ui.BadgeSizeSM, Dot: true})
}

templ schemaPackHeader(pack *schemaPackSummary) {
	@detailHeader(crumbsActive(nav.Crumbs("Schema", "/schema", "Schema packs", "/schema/packs", pack.Name)), "", pack.Name, pack.Description, detailHeaderOpts{Margin: "mb-6", Meta: schemaPackHeaderMeta(pack)})
}

// SchemaPackPendingPage renders a pack that exists in the project's catalog but
// is not installed — the state a discovery run leaves its result in. It shows
// what the run proposed and the one action that turns it into compiled types,
// so the Schema page's "Review pack" link never dead-ends on a not-found page.
templ pendingPackHeaderMeta(pack *pendingPack) {
	@ui.Badge(ui.BadgeProps{Label: "v" + pack.Version, Variant: ui.BadgeGhost, Size: ui.BadgeSizeSM})
	if pack.PendingReview {
		@ui.Badge(ui.BadgeProps{Label: "Pending review", Variant: ui.BadgeInfo, Size: ui.BadgeSizeSM, Dot: true})
	} else {
		@ui.Badge(ui.BadgeProps{Label: "Not installed", Variant: ui.BadgeNeutral, Size: ui.BadgeSizeSM})
	}
}

templ SchemaPackPendingPage(pack *pendingPack, flashErr error) {
	@layout.Container(layout.ContainerLG, nil) {
		@detailHeader(crumbsActive(nav.Crumbs("Schema", "/schema", "Schema packs", "/schema/packs", pack.Name)), "", pack.Name, pack.Description, detailHeaderOpts{Margin: "mb-6", Meta: pendingPackHeaderMeta(pack)})
		@layout.Rail(schemaSubNav("packs"), nil) {
			if flashErr != nil {
				<div class="mb-4">
					@ui.Alert(ui.AlertProps{
						Type:    ui.AlertError,
						Style:   ui.AlertStyleSoft,
						Icon:    "lucide--alert-triangle",
						Message: "Could not install the pack: " + flashErr.Error(),
					})
				</div>
			}
			@ui.EmptyNote(ui.EmptyNoteProps{Class: "mb-4"}) {
				if pack.PendingReview {
					This pack was proposed by a discovery run and is not installed. Its types are not used for extraction until you install it, and installing is the only step that takes them live.
				} else {
					This pack is listed for this project but is not installed. Its types are not used for extraction until you install it.
				}
			}
			@ui.Section("Pack details", ui.SectionProps{Margin: "mb-6", BodyClass: "memory-density-comfortable"}) {
				@components.MetaGrid() {
					@schemaPackMetaRow("Pack id", pack.ID, true)
					if pack.Author != "" {
						@schemaPackMetaRow("Author", pack.Author, false)
					}
					if label := packSourceDisplay(pack.Source); label != "" {
						@schemaPackMetaRow("Source", label, false)
					}
					@schemaPackMetaRow("Types", strconv.Itoa(len(pack.ObjectTypes)+len(pack.RelationTypes)), false)
				}
			}
			<form method="post" action={ templ.URL("/schema/packs/" + url.PathEscape(pack.ID) + "/install") } class="mb-6">
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Icon:    "lucide--check",
					Attrs:   templ.Attributes{"data-testid": "schema-pack-install"},
				}) {
					Install pack
				}
			</form>
			@pendingPackTypeList("Object types", pack.ObjectTypes)
			@pendingPackTypeList("Relationship types", pack.RelationTypes)
		}
	}
}

// pendingPackTypeList is a plain name list: a pending pack's types are not in
// the compiled registry, so the compiled-types table (which links to type
// detail pages) would produce dead links.
templ pendingPackTypeList(title string, names []string) {
	@ui.Section(title, ui.SectionProps{Margin: "mb-6"}) {
		if len(names) == 0 {
			@ui.EmptyNote() {
				None proposed.
			}
		} else {
			<ul class="list-disc space-y-1 pl-5 text-sm">
				for _, name := range names {
					<li>{ name }</li>
				}
			</ul>
		}
	}
}

// schemaPackMeta is the pack's read-only metadata panel: id, owner, source,
// type counts, and the owning blueprint link when one applies.
templ schemaPackMeta(pack *schemaPackSummary) {
	@ui.Section("Pack details", ui.SectionProps{
		Margin:    "mb-6",
		BodyClass: "memory-density-comfortable",
	}) {
		@components.MetaGrid() {
			@schemaPackMetaRow("Pack id", pack.ID, true)
			@schemaPackMetaRow("Owner", pack.ownerLabel(), false)
			if label := pack.sourceLabel(); label != "" {
				@schemaPackMetaRow("Source", label, false)
			}
			if len(pack.LinkedSources) > 0 {
				@components.MetaRowCustom("Installed apps", components.MetaRowOpts{NoEmptyDash: true}) {
					<div class="flex flex-wrap gap-x-2 gap-y-1">
						for _, src := range pack.LinkedSources {
							<a class="text-primary font-medium hover:underline" href={ templ.URL("/data-sources/" + url.PathEscape(src.ID)) }>{ src.Name }</a>
						}
					</div>
				}
			}
			@schemaPackMetaRow("Types", pack.typeCountLabel(), false)
			if pack.Provenance != nil {
				@components.MetaRowCustom("Owning blueprint", components.MetaRowOpts{NoEmptyDash: true}) {
					<a class="text-primary font-medium hover:underline" href={ templ.URL("/blueprints/" + url.PathEscape(pack.Provenance.BlueprintID)) }>{ typeProvenanceLabel(pack.Provenance) }</a>
				}
			}
		}
	}
}

templ schemaPackMetaRow(label, value string, mono bool) {
	@components.MetaRow(label, value, components.MetaRowOpts{Mono: mono})
}

// ownerBadge is the shared Global / Project marker for pack rows and detail.
templ ownerBadge(pack schemaPackSummary, size ui.BadgeSize) {
	if pack.global() {
		@components.StatusBadge("Global", ui.BadgeNeutral, "", components.StatusBadgeOpts{Size: size, Dot: true})
	} else {
		@components.StatusBadge("Project", ui.BadgePrimary, "", components.StatusBadgeOpts{Size: size, Dot: true})
	}
}
