package main

import (
	"net/url"
	"strconv"

	"github.com/emergent-company/go-daisy/components/form"
	"github.com/emergent-company/go-daisy/components/layout"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// AgentWorkPage renders the top-level Work section: Board (stacked per-type
// swimlanes) or Settings (scope, per-type rules, guardrails).
templ AgentWorkPage(data agentWorkData) {
	if data.LoadErr != nil {
		@layout.Container(layout.ContainerLG, nil) {
			@pageError("Agent work unavailable", data.LoadErr)
		}
	} else if data.Section == workSectionBoard {
		@layout.Container(layout.ContainerFull, nil) {
			@agentDashboardHeader(data.Agent, "Work")
			@flashToasts(data.FlashMsg, data.FlashErr)
			@layout.Rail(agentSubNav(data.Agent.ID, "work", data.Section), nil) {
				@agentWorkBoardSection(data)
			}
		}
	} else {
		<div class={ pageFormChromeClass }>
			@agentDashboardHeader(data.Agent, "Work")
			@flashToasts(data.FlashMsg, data.FlashErr)
		</div>
		@layout.Container(layout.ContainerLG, nil) {
			@layout.Rail(agentSubNav(data.Agent.ID, "work", data.Section), nil) {
				@agentWorkRulesForm(data)
			}
		}
	}
}

// agentWorkBoardSection renders the stacked swimlanes: one row per object type,
// each with that type's own lanes.
templ agentWorkBoardSection(data agentWorkData) {
	@ui.Section("Board", ui.SectionProps{Margin: "mt-2", BodyClass: "memory-density-comfortable"}) {
		if len(data.View.Swimlanes) == 0 {
			@ui.EmptyState(ui.EmptyStateProps{
				Icon:        "lucide--kanban-square",
				Title:       "No work items",
				Description: "Items assigned to this agent, or unassigned items of a type it handles, appear here grouped by type and status.",
				Bordered:    true,
				Class:       "py-12",
			})
		} else {
			{{ firstMap := "" }}
			if len(data.View.Swimlanes) > 0 {
				{{ firstMap = data.View.StatusMaps[data.View.Swimlanes[0].Type].statusMapJSON() }}
			}
			<div id="board" data-testid="work-board" data-board-status-map={ firstMap } class="flex flex-col gap-6">
				for _, sl := range data.View.Swimlanes {
					<section class="flex flex-col gap-2" data-board-type={ sl.Type } data-board-status-map={ data.View.StatusMaps[sl.Type].statusMapJSON() } data-testid={ "work-swimlane-" + sl.Type }>
						<header class="flex items-center gap-2">
							<span class="font-mono text-[11px] font-semibold tracking-wide text-muted uppercase">{ sl.Type }</span>
							<span class="font-mono text-[11px] text-muted-faint">{ strconv.Itoa(sl.Count) }</span>
						</header>
						<div class="grid grid-flow-col auto-cols-[minmax(13rem,1fr)] items-stretch gap-3 overflow-x-auto pb-3">
							for _, col := range sl.Lanes {
								@boardLaneView(col, data.Allowances)
							}
						</div>
					</section>
				}
			</div>
		}
	}
}

// agentWorkSettingsForm renders scope, per-type rules, and guardrails as one PRG
// form.
templ agentWorkRulesForm(data agentWorkData) {
	{{ wc := workConfigOf(data.Agent) }}
	<form
		method="post"
		action={ templ.URL("/agents/" + url.PathEscape(data.Agent.ID) + "/work/" + workSectionSettings) }
		hx-disable="find button.memory-save-btn"
		data-testid="agent-work-settings-form"
	>
		@ui.Section("Scope", ui.SectionProps{Margin: "mt-6", BodyClass: "memory-density-comfortable"}) {
			<div class="flex flex-col gap-4">
				@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneStrong}) { Limit which graph types this agent may see and write. Leave everything unchecked to allow every type. }
				@form.FormControl("agent-work-object-types", "Object types", form.LabelAbove, "Only the object types this agent may see and query.", "", nil) {
					<input type="hidden" name="objectType" value=""/>
					@checkboxPicker(checkboxPickerProps{
						Name:          "objectType",
						EmptyContent:  objectTypeEmptyContent(),
						LabelClass:    "items-start gap-2 py-1.5",
						CheckboxClass: "checkbox checkbox-sm mt-0.5",
						TitleClass:    "block text-sm font-medium",
						DescClass:     "text-muted block text-xs",
						WrapTitle:     true,
						Items:         compiledTypePickerItems(data.ObjectTypes, func(name string) bool { return containsString(agentObjectTypesValue(data.Agent), name) }),
					})
				}
				@form.FormControl("agent-work-relationship-types", "Relationship types", form.LabelAbove, "Only the relationship types this agent may see and query.", "", nil) {
					<input type="hidden" name="relationshipType" value=""/>
					@checkboxPicker(checkboxPickerProps{
						Name:          "relationshipType",
						EmptyContent:  relationshipTypeEmptyContent(),
						LabelClass:    "items-start gap-2 py-1.5",
						CheckboxClass: "checkbox checkbox-sm mt-0.5",
						TitleClass:    "block text-sm font-medium",
						DescClass:     "text-muted block text-xs",
						WrapTitle:     true,
						Items:         compiledTypePickerItems(data.RelationshipTypes, func(name string) bool { return containsString(agentRelationshipTypesValue(data.Agent), name) }),
					})
				}
			</div>
		}

		@ui.Section("Type rules", ui.SectionProps{Margin: "mt-6", BodyClass: "memory-density-comfortable"}) {
			<div class="flex flex-col gap-6">
				if len(data.BoardTypes) == 0 {
					@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneStrong}) { No board-enabled object types are installed in this project. }
				}
				for _, t := range data.BoardTypes {
					{{ r := ruleFor(data.Agent, t.Name)
					eff := effectiveStatusForType(data.Agent, t.Name) }}
					<div class="rounded-box border border-base-content/10 p-4" data-testid={ "work-rule-" + t.Name }>
						<input type="hidden" name="ruleType" value={ t.Name }/>
						<div class="flex flex-wrap items-center justify-between gap-2">
							<div>
								<span class="font-mono text-xs font-semibold tracking-wide uppercase">{ t.Name }</span>
								<span class="mt-1 block text-xs text-muted">Lanes: { compiledTypeStatusesText(t) }</span>
							</div>
							<div class="flex flex-wrap items-center gap-4">
								<label class="flex items-center gap-1.5 text-xs">
									<input type="hidden" name={ "rule-" + t.Name + "-create" } value="false"/>
									<input type="checkbox" name={ "rule-" + t.Name + "-create" } value="true" checked?={ ruleAllows(r.CanCreate) } class="checkbox checkbox-sm"/>
									Create
								</label>
								<label class="flex items-center gap-1.5 text-xs">
									<input type="hidden" name={ "rule-" + t.Name + "-update" } value="false"/>
									<input type="checkbox" name={ "rule-" + t.Name + "-update" } value="true" checked?={ ruleAllows(r.CanUpdate) } class="checkbox checkbox-sm"/>
									Update
								</label>
								<label class="flex items-center gap-1.5 text-xs">
									<input type="hidden" name={ "rule-" + t.Name + "-delete" } value="false"/>
									<input type="checkbox" name={ "rule-" + t.Name + "-delete" } value="true" checked?={ ruleAllows(r.CanDelete) } class="checkbox checkbox-sm"/>
									Delete
								</label>
							</div>
						</div>
						<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
							@form.FormControl("work-rule-"+t.Name+"-fields", "Writable fields", form.LabelAbove, "Comma-separated property names. Empty allows every field.", "", nil) {
								<input id={ "work-rule-" + t.Name + "-fields" } name={ "rule-" + t.Name + "-fields" } type="text" value={ ruleFieldsText(r) } placeholder="title, description" class="input w-full"/>
							}
							@form.FormControl("work-rule-"+t.Name+"-triggers", "Triggers", form.LabelAbove, "One per line: status | prompt. The prompt becomes the run's user message.", "", nil) {
								<textarea id={ "work-rule-" + t.Name + "-triggers" } name={ "rule-" + t.Name + "-triggers" } rows="3" placeholder={ "ready | Claim this item and do the work." } class="textarea w-full">{ ruleTriggersText(r) }</textarea>
							}
							@form.FormControl("work-rule-"+t.Name+"-transitions", "Transitions", form.LabelAbove, "One per line: from -> to. Empty allows only the standard complete/block edges.", "", nil) {
								<textarea id={ "work-rule-" + t.Name + "-transitions" } name={ "rule-" + t.Name + "-transitions" } rows="3" placeholder={ eff.InProgress + " -> " + eff.Review } class="textarea w-full">{ ruleTransitionsText(r) }</textarea>
							}
						</div>
						<div class="mt-4">
							<p class="text-[11px] font-semibold tracking-wide text-muted-faint uppercase">Phase map (this type)</p>
							<div class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-3">
								@form.FormControl("work-rule-"+t.Name+"-status-ready", "Ready", form.LabelAbove, "Blank inherits the agent default.", "", nil) {
									<input name={ "rule-" + t.Name + "-status-ready" } type="text" value={ ruleStatusValue(r, "ready") } placeholder={ eff.Ready } class="input w-full"/>
								}
								@form.FormControl("work-rule-"+t.Name+"-status-in-progress", "In progress", form.LabelAbove, "Blank inherits the agent default.", "", nil) {
									<input name={ "rule-" + t.Name + "-status-inProgress" } type="text" value={ ruleStatusValue(r, "inProgress") } placeholder={ eff.InProgress } class="input w-full"/>
								}
								@form.FormControl("work-rule-"+t.Name+"-status-review", "Review", form.LabelAbove, "Blank inherits the agent default.", "", nil) {
									<input name={ "rule-" + t.Name + "-status-review" } type="text" value={ ruleStatusValue(r, "review") } placeholder={ eff.Review } class="input w-full"/>
								}
								@form.FormControl("work-rule-"+t.Name+"-status-revision", "Revision", form.LabelAbove, "Blank inherits the agent default.", "", nil) {
									<input name={ "rule-" + t.Name + "-status-revision" } type="text" value={ ruleStatusValue(r, "revision") } placeholder={ eff.Revision } class="input w-full"/>
								}
								@form.FormControl("work-rule-"+t.Name+"-status-blocked", "Blocked", form.LabelAbove, "Blank inherits the agent default.", "", nil) {
									<input name={ "rule-" + t.Name + "-status-blocked" } type="text" value={ ruleStatusValue(r, "blocked") } placeholder={ eff.Blocked } class="input w-full"/>
								}
								@form.FormControl("work-rule-"+t.Name+"-status-done", "Done", form.LabelAbove, "Blank inherits the agent default.", "", nil) {
									<input name={ "rule-" + t.Name + "-status-done" } type="text" value={ ruleStatusValue(r, "done") } placeholder={ eff.Done } class="input w-full"/>
								}
							</div>
						</div>
					</div>
				}
			</div>
		}

		@ui.Section("Guardrails", ui.SectionProps{Margin: "mt-6", BodyClass: "memory-density-comfortable"}) {
			<div class="flex flex-col gap-4">
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					@form.FormControl("agent-work-ready", "Default ready status", form.LabelAbove, "Fallback phase map for types without a per-type override.", "", nil) {
						<input name="workStatus.ready" type="text" value={ wc.Status.Ready } placeholder="ready" class="input w-full"/>
					}
					@form.FormControl("agent-work-in-progress", "Default in-progress status", form.LabelAbove, "Fallback phase map for types without a per-type override.", "", nil) {
						<input name="workStatus.inProgress" type="text" value={ wc.Status.InProgress } placeholder="in_progress" class="input w-full"/>
					}
					@form.FormControl("agent-work-review", "Default review status", form.LabelAbove, "Fallback phase map for types without a per-type override.", "", nil) {
						<input name="workStatus.review" type="text" value={ wc.Status.Review } placeholder="review" class="input w-full"/>
					}
					@form.FormControl("agent-work-revision", "Default revision status", form.LabelAbove, "Fallback phase map for types without a per-type override.", "", nil) {
						<input name="workStatus.revision" type="text" value={ wc.Status.Revision } placeholder="revision" class="input w-full"/>
					}
					@form.FormControl("agent-work-blocked", "Default blocked status", form.LabelAbove, "Fallback phase map for types without a per-type override.", "", nil) {
						<input name="workStatus.blocked" type="text" value={ wc.Status.Blocked } placeholder="blocked" class="input w-full"/>
					}
					@form.FormControl("agent-work-done", "Default done status", form.LabelAbove, "Fallback phase map for types without a per-type override.", "", nil) {
						<input name="workStatus.done" type="text" value={ wc.Status.Done } placeholder="done" class="input w-full"/>
					}
				</div>
				@form.FormControl("agent-work-requires-review", "Require review", form.LabelAbove, "Route completed items through a human review step before they are done.", "", nil) {
					<input type="hidden" name="workRequiresReview" value="false"/>
					<input type="checkbox" name="workRequiresReview" value="true" checked?={ wc.RequiresReview } class="checkbox"/>
				}
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					@form.FormControl("agent-work-failure-limit", "Failure limit", form.LabelAbove, "Failures an item tolerates before escalation. Zero inherits the default (3).", "", nil) {
						<input name="failureLimit" type="number" min="0" step="1" value={ workIntStr(wc.FailureLimit) } placeholder="3" class="input w-full"/>
					}
					@form.FormControl("agent-work-revision-limit", "Revision limit", form.LabelAbove, "Rework rounds before escalation. Zero inherits the default (3).", "", nil) {
						<input name="revisionLimit" type="number" min="0" step="1" value={ workIntStr(wc.RevisionLimit) } placeholder="3" class="input w-full"/>
					}
					@form.FormControl("agent-work-max-attempts", "Max attempts", form.LabelAbove, "Maximum run attempts per queued item.", "", nil) {
						<input name="maxAttempts" type="number" min="1" step="1" value={ workIntStr(wc.RetryPolicy.MaxAttempts) } placeholder="1" class="input w-full"/>
					}
					@form.FormControl("agent-work-initial-interval", "Initial interval (ms)", form.LabelAbove, "Saved but not applied yet.", "", nil) {
						<input name="initialIntervalMs" type="number" min="0" step="1" value={ workIntStr(wc.RetryPolicy.InitialIntervalMS) } placeholder="0" class="input w-full"/>
					}
					@form.FormControl("agent-work-backoff", "Backoff coefficient", form.LabelAbove, "Saved but not applied yet.", "", nil) {
						<input name="backoffCoefficient" type="number" min="1" step="any" value={ workFloatStr(wc.RetryPolicy.BackoffCoefficient) } placeholder="1" class="input w-full"/>
					}
					@form.FormControl("agent-work-max-interval", "Max interval (ms)", form.LabelAbove, "Saved but not applied yet.", "", nil) {
						<input name="maxIntervalMs" type="number" min="0" step="1" value={ workIntStr(wc.RetryPolicy.MaxIntervalMS) } placeholder="0" class="input w-full"/>
					}
				</div>
				@form.FormControl("agent-work-require-artifacts", "Require artifacts", form.LabelAbove, "Require a summary or artifacts before the item may complete.", "", nil) {
					<input type="hidden" name="workRequireArtifacts" value="false"/>
					<input type="checkbox" name="workRequireArtifacts" value="true" checked?={ wc.WorkContract.RequireArtifacts } class="checkbox"/>
				}
				@form.FormControl("agent-work-required-deliverables", "Required deliverable types", form.LabelAbove, "Comma-separated object types the agent must produce before completing an item.", "", nil) {
					<input name="requiredDeliverableType" type="text" value={ workListValue(wc.WorkContract.RequiredDeliverableTypes) } placeholder="e.g. Document, Chunk" class="input w-full"/>
				}
				@form.FormControl("agent-work-trigger-statuses", "Legacy trigger statuses", form.LabelAbove, "Used only when no per-type trigger rows are declared.", "", nil) {
					<input name="triggerStatus" type="text" value={ workListValue(wc.TriggerStatuses) } placeholder="ready" class="input w-full"/>
				}
			</div>
		}
		@agentSettingsSave()
	</form>
}
