package main

import (
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- MCP Registry browse/install page (/settings/mcp-registry) ---
//
// One crumb-framed list page: a search box plus a list of matching catalog
// entries. An entry with a remote transport (http/sse) installs an outbound
// server into the project via POST /settings/mcp-registry/install (PRG). A
// package-only entry (no remotes) offers a device install instead: it opens a
// dialog that picks a connected connector and posts to
// /settings/mcp-registry/install-to-device, or explains how to connect one when
// no device is present.

// MCPServerRegistryPage renders the registry browse page.
templ MCPServerRegistryPage(data mcpRegistryPageData) {
	@layout.Container(layout.ContainerLG, templ.Attributes{"data-mcp-registry-root": ""}) {
		{{ crumbs := crumbsActive(nav.Crumbs("Settings", "/settings", "MCP Servers", mcpServerSettingsBase, "Registry")) }}
		@detailHeader(crumbs, "", "MCP Registry", "A curated set of recommended MCP servers, vetted by Memory. Install remote servers into this project.", detailHeaderOpts{Margin: "mb-6"}) {
			@countBadge(len(data.Servers), "result", "lucide--globe")
		}
		@mcpRegistrySearchBox(data.Query)
		@flashToasts(data.FlashMsg, data.FlashErr)
		if data.LoadErr != nil {
			@pageError("MCP registry unavailable", data.LoadErr)
		} else if len(data.Servers) == 0 {
			@mcpRegistryEmptyState(data.Query)
		} else {
			<div class="flex flex-col gap-2">
				for _, entry := range data.Servers {
					@mcpRegistryEntry(entry, data.Devices, data.DevicesErr)
				}
			</div>
			@mcpRegistryNextLink(data.Query, data.NextCursor)
		}
	}
}

// mcpRegistrySearchBox renders the search form (GET /settings/mcp-registry?q=).
templ mcpRegistrySearchBox(query string) {
	<form method="get" action={ templ.URL(mcpRegistrySettingsBase) } class="mb-4 flex items-center gap-2">
		<input type="search" name="q" value={ query } placeholder="Search recommended servers — e.g. github, playwright, sentry" class="input w-full" autocomplete="off" data-testid="mcp-registry-search"/>
		@ui.Button(ui.ButtonProps{
			Type:    ui.ButtonTypeSubmit,
			Variant: ui.ButtonPrimary,
			Size:    ui.ButtonSM,
			Icon:    "lucide--search",
			Attrs:   templ.Attributes{"data-testid": "mcp-registry-search-submit"},
		}) {
			Search
		}
	</form>
}

// mcpRegistryEmptyState renders the pre-search hint or the no-results state,
// keyed on whether a query is present.
templ mcpRegistryEmptyState(query string) {
	if query == "" {
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--globe",
			Title:       "Search recommended servers",
			Description: "Find MCP servers by name or description — e.g. github, playwright, or sentry.",
			Bordered:    true,
			Class:       "py-12",
		})
	} else {
		@ui.EmptyState(ui.EmptyStateProps{
			Icon:        "lucide--search-x",
			Title:       "No matching servers",
			Description: "No recommended servers matched \"" + query + "\". Try a different search.",
			Bordered:    true,
			Class:       "py-12",
		})
	}
}

// mcpRegistryEntry renders one registry result: the availability badges and
// name/title/description on the left (badges above the title), and the call to
// action — an Install form for a remote transport, a device-install trigger for
// a package-only entry — in a right-hand column, vertically centred against the
// entry content. No credential preview is shown here — credential guidance
// lives on the configure form after install. devices/devicesErr come from the
// page's session list and feed the device dialog.
templ mcpRegistryEntry(entry MCPRegistryServer, devices []RelaySession, devicesErr error) {
	@ui.SoftBox(ui.SoftBoxProps{Attrs: templ.Attributes{"data-testid": "mcp-registry-entry", "data-registry-name": entry.Name}}) {
		<div class="flex items-center justify-between gap-3">
			<div class="min-w-0">
				<div class="mb-1.5 flex items-center gap-1.5">
					if entry.HasRemotes {
						@ui.Badge(ui.BadgeProps{Label: "remote", Variant: ui.BadgeAccent, Size: ui.BadgeSizeXS, Icon: "lucide--radio"})
					}
					if entry.HasPackages {
						@ui.Badge(ui.BadgeProps{Label: "package", Variant: ui.BadgeInfo, Size: ui.BadgeSizeXS, Icon: "lucide--package"})
					}
				</div>
				<div class="flex min-w-0 items-center gap-2">
					@ui.IconSpan("lucide--server", "size-4 shrink-0 text-muted-faint")
					<span class="truncate text-sm font-medium">{ mcpRegistryDisplayTitle(entry) }</span>
				</div>
				if entry.Name != "" {
					<p class="text-muted-faint mt-0.5 truncate font-mono text-xs">{ entry.Name }</p>
				}
				if entry.Description != "" {
					@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-1 leading-snug"}) {
						{ entry.Description }
					}
				}
			</div>
			<div class="flex shrink-0 flex-col items-end gap-2" data-testid="mcp-registry-entry-actions">
				if entry.HasRemotes {
					@mcpRegistryInstallAction(entry)
				} else {
					@mcpRegistryDeviceInstallAction(entry, devices, devicesErr)
				}
			</div>
		</div>
	}
}

// mcpRegistryInstallAction renders the per-entry install form for entries with
// a remote transport (POST /settings/mcp-registry/install).
templ mcpRegistryInstallAction(entry MCPRegistryServer) {
	<form method="post" action={ templ.URL(mcpRegistrySettingsBase + "/install") }>
		<input type="hidden" name="registryName" value={ entry.Name }/>
		@ui.Button(ui.ButtonProps{
			Type:    ui.ButtonTypeSubmit,
			Variant: ui.ButtonPrimary,
			Size:    ui.ButtonSM,
			Icon:    "lucide--download",
			Attrs:   templ.Attributes{"data-testid": "mcp-registry-install"},
		}) {
			Install
		}
	</form>
}

// mcpRegistryDeviceInstallAction renders a package-only entry's call to action:
// an "Install to device" trigger plus the modal it opens. The dialog picks a
// connected connector (posts to /settings/mcp-registry/install-to-device) or,
// when none is connected, explains how to connect one. devicesErr surfaces a
// failed session-list fetch instead of falsely claiming there are no devices.
templ mcpRegistryDeviceInstallAction(entry MCPRegistryServer, devices []RelaySession, devicesErr error) {
	{{ dialogID := mcpRegistryDeviceDialogID(entry.Name) }}
	@ui.Button(ui.ButtonProps{
		Type:    ui.ButtonTypeButton,
		Variant: ui.ButtonPrimary,
		Size:    ui.ButtonSM,
		Icon:    "lucide--laptop",
		Attrs: templ.Attributes{
			"data-dialog-open": dialogID,
			"data-testid":      "mcp-registry-install-to-device",
		},
	}) {
		Install to device
	}
	@ui.Dialog(ui.DialogProps{
		ID:       dialogID,
		BoxClass: "max-w-md",
		Attrs:    templ.Attributes{"data-testid": "mcp-registry-device-dialog"},
	}) {
		@ui.DialogTitle(ui.DialogTitleProps{Size: ui.DialogTitleSizeMD}) { Install { mcpRegistryDisplayTitle(entry) } on a device }
		@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS, Class: "mt-1"}) {
			The server runs on the connector you pick; Memory pushes its configuration over the relay.
		}
		if devicesErr != nil {
			<p class="text-error mt-3 text-xs" data-testid="mcp-registry-device-error">Couldn't load connected devices. Reload the page and try again.</p>
			<div class="modal-action">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Attrs: templ.Attributes{"data-dialog-close": ""}}) {
					Close
				}
			</div>
		} else if len(devices) == 0 {
			@mcpRegistryConnectorSetup()
		} else {
			<form method="post" action={ templ.URL(mcpRegistrySettingsBase + "/install-to-device") } class="mt-4 flex flex-col gap-3">
				<input type="hidden" name="registryName" value={ entry.Name }/>
				<label class="flex flex-col gap-1">
					<span class="text-xs font-medium">Device</span>
					<select name="targetInstanceId" class="select w-full" required data-testid="mcp-registry-device-select">
						for _, d := range devices {
							<option value={ d.InstanceID }>{ mcpRegistryDeviceLabel(d) }</option>
						}
					</select>
				</label>
				<div class="modal-action">
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Attrs: templ.Attributes{"data-dialog-close": ""}}) {
						Cancel
					}
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonPrimary,
						Size:    ui.ButtonSM,
						Icon:    "lucide--download",
						Attrs:   templ.Attributes{"data-testid": "mcp-registry-device-install-submit"},
					}) {
						Install
					}
				</div>
			</form>
		}
	}
}

// mcpRegistryConnectorSetup renders the no-device state of the device install
// dialog: the steps to connect a connector. A relay applies a pushed server
// config only when it was started with --accept-managed-config, so that flag is
// part of the instructions rather than an afterthought.
templ mcpRegistryConnectorSetup() {
	<div class="mt-3 flex flex-col gap-2" data-testid="mcp-registry-device-setup">
		@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS}) {
			No connector device is connected to this project yet. Install the Memory connector on the machine that should run this server, then:
		}
		<ol class="text-muted flex list-decimal flex-col gap-1 pl-4 text-xs">
			<li>Sign in: <code class="rounded bg-base-200 px-1 py-0.5 font-mono">memory-connector auth login</code></li>
			<li>Start the relay accepting pushed configuration: <code class="rounded bg-base-200 px-1 py-0.5 font-mono">memory-connector relay --accept-managed-config</code></li>
		</ol>
		@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSizeXS}) {
			The device then appears under <a class="link" href="/settings/devices">Connected devices</a>, and you can install this server to it.
		}
	</div>
	<div class="modal-action">
		@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Attrs: templ.Attributes{"data-dialog-close": ""}}) {
			Close
		}
	</div>
}

// mcpRegistryNextLink renders the "Next page" affordance when the search result
// carries a next cursor.
templ mcpRegistryNextLink(query, nextCursor string) {
	if nextCursor != "" {
		<div class="mt-3 flex justify-center">
			@ui.Button(ui.ButtonProps{
				Type:    ui.ButtonTypeLink,
				Href:    mcpRegistryNextURL(query, nextCursor),
				Variant: ui.ButtonGhost,
				Size:    ui.ButtonSM,
				Icon:    "lucide--chevron-right",
				Attrs:   templ.Attributes{"data-testid": "mcp-registry-next"},
			}) {
				Next page
			}
		</div>
	}
}
