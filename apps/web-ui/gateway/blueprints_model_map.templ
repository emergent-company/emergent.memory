package main

import (
	"fmt"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	"github.com/emergent-company/go-daisy/components/form"
	"github.com/emergent-company/go-daisy/components/layout"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// BlueprintModelMapRow is one agent whose pinned model the project can't
// resolve: the agent's name, the source manifest model, and the human-readable
// reason it needs a mapping.
type BlueprintModelMapRow struct {
	AgentName   string
	SourceModel string
	Issue       string
}

// BlueprintModelMapData carries the state for the model-mapping page: the
// import source plus the unresolved agents and the project's configured
// generative models to map them onto. Token is an optional private-repo
// credential, forwarded through a hidden input so a private-repo import that
// hits unresolved models still authenticates on the confirm step. It is never
// placed in a redirect target or flash.
type BlueprintModelMapData struct {
	URL    string
	Ref    string
	Token  string
	Rows   []BlueprintModelMapRow
	Models []Model
}

// BlueprintImportModelMapPage is the standalone step shown when a GitHub
// blueprint import pins models the project can't resolve. It maps each
// unresolved agent to a configured model (or the project default) before
// committing the import. Nothing has been installed yet.
templ BlueprintImportModelMapPage(d BlueprintModelMapData) {
	@layout.Container(layout.ContainerLG, nil) {
		@pageHeader("Knowledge", "Map blueprint models", "This blueprint pins models this project can't resolve. Map each agent to one of your configured models, or keep the project default. Nothing is installed until you confirm.") {
		}
		<div data-testid="blueprint-import-map" class="flex flex-col gap-4">
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertWarning,
				Style:   ui.AlertStyleSoft,
				Icon:    "lucide--list-checks",
				Message: blueprintModelMapSummary(len(d.Rows)),
			})
			<form method="post" action="/blueprints/import/confirm" class="flex flex-col gap-4">
				<input type="hidden" name="url" value={ d.URL }/>
				if d.Ref != "" {
					<input type="hidden" name="ref" value={ d.Ref }/>
				}
				if d.Token != "" {
					<input type="hidden" name="token" value={ d.Token }/>
				}
				@ui.CardRaw("card-border overflow-hidden", "memory-density-flush", nil) {
					for _, row := range d.Rows {
						@blueprintModelMapRow(row, d.Models)
					}
				}
				if len(d.Models) == 0 {
					@blueprintModelMapNoModels()
				}
				@components.StickyFormActions(components.StickyFormActionsProps{Edge: "container"}) {
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeLink,
						Href:    "/blueprints",
						Variant: ui.ButtonGhost,
						Size:    ui.ButtonSM,
						Attrs:   templ.Attributes{"data-testid": "blueprint-model-map-cancel"},
					}) {
						Cancel
					}
					@ui.Button(ui.ButtonProps{
						Type:    ui.ButtonTypeSubmit,
						Variant: ui.ButtonPrimary,
						Size:    ui.ButtonSM,
						Icon:    "lucide--download",
						Attrs:   templ.Attributes{"data-testid": "blueprint-model-map-submit"},
					}) {
						Install with these models
					}
				}
			</form>
		</div>
	}
}

// blueprintModelMapSummary is the one-line install-blocker summary shown above
// the mapping form. It is a plain Go function (not a templ component) so the
// count — and its singular/plural wording — stays in one place.
func blueprintModelMapSummary(n int) string {
	if n == 1 {
		return "1 agent model needs mapping before this blueprint can be installed."
	}
	return fmt.Sprintf("%d agent models need mapping before this blueprint can be installed.", n)
}

// blueprintModelMapRow renders one unresolved agent: its name and pinned source
// model as a heading, the reason it needs a mapping (wired to the select via
// aria-describedby), and a full-width select of the project's configured models
// (first option is the project default, an empty value). The label is explicit
// that the user is choosing a replacement model.
templ blueprintModelMapRow(row BlueprintModelMapRow, models []Model) {
	{{ selectID := "model." + row.AgentName
		issueID := "model-issue." + row.AgentName }}
	<div class="flex flex-col gap-3 border-b border-base-200 px-4 py-4 last:border-b-0" data-testid="blueprint-model-map-row">
		<div class="flex flex-wrap items-center gap-2">
			<h2 class="text-sm font-semibold">{ row.AgentName }</h2>
			if row.SourceModel != "" {
				@ui.Badge(ui.BadgeProps{Label: row.SourceModel, Variant: ui.BadgeNeutral, Style: ui.BadgeStyleSoft, Size: ui.BadgeSizeXS, Icon: "lucide--cpu"})
			}
		</div>
		if row.Issue != "" {
			<div id={ issueID }>
				@ui.Alert(ui.AlertProps{
					Type:    ui.AlertWarning,
					Style:   ui.AlertStyleOutline,
					Icon:    "lucide--alert-triangle",
					Message: row.Issue,
				})
			</div>
		}
		@form.FormControl(selectID, "Replacement model for "+row.AgentName, form.LabelAbove, "Choose a configured model, or keep the project default.", "", nil) {
			<select
				id={ selectID }
				name={ selectID }
				class="select w-full"
				data-testid="blueprint-model-map-select"
				if row.Issue != "" {
					aria-describedby={ issueID }
				}>
				<option value="">Project default</option>
				for _, m := range models {
					<option value={ m.Provider + "/" + m.ModelName }>{ m.Provider }/{ m.ModelName }</option>
				}
			</select>
		}
	</div>
}

// blueprintModelMapNoModels is the empty state shown when the project has no
// configured generative models: it points the user at the providers settings
// page while making clear they can still proceed with the project default.
templ blueprintModelMapNoModels() {
	<div class="flex flex-col gap-2">
		@ui.Alert(ui.AlertProps{
			Type:    ui.AlertInfo,
			Style:   ui.AlertStyleSoft,
			Icon:    "lucide--circle-help",
			Message: "No generative models are configured for this project. Add a provider and model to pick a specific replacement, or install now and use the project default.",
		})
		<a href="/settings/providers" class="link link-primary self-start text-sm">Configure a provider</a>
	</div>
}
