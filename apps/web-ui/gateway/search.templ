package main

import (
	"net/url"
	"strconv"

	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Project search (the /search page's results) ---
//
// The page shell is ObjectsPage: the same header, toolbar, cards and bulk
// actions whether the reader is browsing or searching. This file owns the one
// thing browsing does not have — the text-leg document section and the query
// summary above it.

// searchResultsBody is the results region's content, rendered by
// objectsBrowserResults inside #search-results:
//
//   - a failed request replaces the results with a notice (the header stays);
//   - an empty query is the browse list, cards or the browse empty state;
//   - a query is the summary line, the document section when the scope includes
//     documents, and the object cards.
//
// The object cards own their empty state, so the document section defers to them
// instead of rendering a second "nothing matched": a query that matched only
// documents shows the documents and no empty object card, and a query that
// matched nothing shows exactly one empty state.
templ searchResultsBody(data objectsPageData) {
	if data.LoadErr != nil {
		// A filter/limit change that failed keeps the page: the error replaces
		// the results instead of the whole surface. ObjectsPage renders its
		// header unconditionally, so this stays a notice.
		@pageErrorNotice("Search failed", data.LoadErr)
	} else if data.Query == "" {
		@objectsBrowserCards(data, true)
	} else {
		{{ scope := searchScopeOf(data) }}
		@searchResultsNote(data)
		if scope != searchScopeObjects {
			if len(data.Documents) > 0 || scope == searchScopeDocuments {
				@searchDocumentsSection(data)
			} else if len(data.Results) > 0 {
				@searchDocumentsPrompt(data)
			}
		}
		@objectsBrowserCards(data, len(data.Documents) == 0 || scope == searchScopeObjects)
	}
}

// searchResultsNote is the one-line summary above the sections: what matched,
// how long the server took, how the hits are ranked, and how many held-back
// object hits the relevance floor removed. An exact id lookup says so instead:
// one resolved object is not a result count and is not ranked.
templ searchResultsNote(data objectsPageData) {
	if data.Lookup != nil && data.Lookup.Reason == "" {
		<div class="mb-3 flex flex-wrap items-center justify-between gap-2 px-1" data-testid="search-results-summary">
			<span class="text-muted-faint min-w-0 truncate text-xs">
				Exact id match <span class="font-mono">{ data.Lookup.ID }</span>
				if data.Lookup.Detail != "" {
					<span class="ml-2" data-testid="search-lookup-detail">{ data.Lookup.Detail }</span>
				}
			</span>
			<span class="text-muted-faint shrink-0 text-xs">Not ranked</span>
		</div>
	} else {
		<div class="mb-3 flex flex-wrap items-center justify-between gap-2 px-1">
			<span class="text-muted-faint min-w-0 truncate text-xs" data-testid="search-results-summary">
				{ countLabel(len(data.Documents)+len(data.Results), "result", "results") } matching "{ data.Query }"
				if data.HiddenCount > 0 {
					<a class="link link-hover" href={ templ.URL(objectsSearchShowAllHref(data)) } data-testid="search-hidden-count">
						{ " · " + countLabel(data.HiddenCount, "lower-scoring match", "lower-scoring matches") + " hidden" }
					</a>
				}
			</span>
			<div class="text-muted-faint flex shrink-0 items-center gap-3 text-xs">
				if data.Meta.ExecutionTime.TotalMs > 0 {
					<span class="tabular-nums" data-testid="search-timing">{ strconv.Itoa(data.Meta.ExecutionTime.TotalMs) } ms</span>
				}
				<span>Ranked by relevance</span>
			</div>
		</div>
	}
}

// searchDocumentsSection is the document-chunk section. Its empty state is a
// real answer — "no document text matched" — but it renders only when the scope
// asked for documents alone; everywhere else an empty text leg is a prompt line,
// not a full card competing with the objects below it.
templ searchDocumentsSection(data objectsPageData) {
	@cardList("Documents", cardListProps{
		Margin:    "mb-4",
		Empty:     len(data.Documents) == 0,
		EmptyIcon: "lucide--file-text", EmptyTitle: "No document text matched",
		EmptyDesc: "No chunk of an ingested document matches this query. Documents become searchable once they are converted and chunked.",
	}) {
		for _, hit := range data.Documents {
			@searchDocumentRow(hit)
		}
	}
}

// searchDocumentsPrompt is the quiet stand-in for the document section when the
// text leg found nothing but the object leg did: one line and the escape to a
// documents-only search, instead of a full empty card that would read as a
// second, contradictory empty state next to results that exist.
templ searchDocumentsPrompt(data objectsPageData) {
	<div class="border-base-content/10 mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 rounded-box border px-4 py-2.5" data-testid="search-documents-prompt">
		@ui.IconSpan("lucide--file-text", "size-4 shrink-0 text-muted")
		<span class="text-muted-faint min-w-0 flex-1 text-xs">No document text matched this query — showing objects only.</span>
		@ui.Button(ui.ButtonProps{
			Type:    ui.ButtonTypeLink,
			Href:    searchDocumentsOnlyHref(data),
			Variant: ui.ButtonGhost,
			Size:    ui.ButtonXS,
		}) {
			Search documents
		}
	</div>
}

// searchDocumentRow is one chunk hit: the document it belongs to, how it
// matched, its score and the matching passage.
templ searchDocumentRow(hit searchDocumentHit) {
	<div class="px-4 py-3" data-testid="search-hit-document">
		<div class="flex flex-wrap items-center gap-2">
			<a
				class="link link-hover min-w-0 truncate text-sm font-medium"
				href={ templ.URL("/documents/" + url.PathEscape(hit.DocumentID)) }
				data-testid="search-hit-document-link"
			>
				{ searchDocumentLabel(hit) }
			</a>
			if label := searchModeLabel(hit.Mode); label != "" {
				@ui.Badge(ui.BadgeProps{Label: label, Variant: ui.BadgeGhost, Size: ui.BadgeSizeSM})
			}
			<span class="text-muted ml-auto text-xs font-medium tabular-nums" data-testid="search-hit-score">{ searchScoreLabel(hit.Score) }</span>
		</div>
		@ui.EmptyNote(ui.EmptyNoteProps{
			Class: "mt-1.5 line-clamp-3 leading-relaxed",
			Attrs: templ.Attributes{"data-testid": "search-hit-snippet"},
		}) {
			{ hit.Snippet }
		}
	</div>
}
