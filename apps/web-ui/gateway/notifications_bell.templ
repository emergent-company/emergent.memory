package main

import (
	"strconv"

	ui "github.com/emergent-company/go-daisy/components/ui"
)

// notificationsBell renders the topbar inbox bell: a bell icon linking to the
// inbox with an unread count badge when there is anything unread, and no
// indicator at all when there is not (spec: notification bell with unread
// indicator).
//
// The badge markup mirrors go-daisy's ui.IndicatorBadge, which cannot carry
// content (its signature has no children slot), so the count + the
// data-notifications-badge hook the inbox JS updates are rendered inline on the
// same indicator-item span. The outer wrapper is ui.IndicatorWrapper.
//
// data-notifications-bell is the JS/test anchor; data-notifications-badge marks
// the count element the client updates live.
templ notificationsBell(unread int) {
	<div class="contents" data-notifications-bell data-testid="notifications-bell" data-unread={ strconv.Itoa(unread) }>
		@ui.IndicatorWrapper() {
			<a
				href="/inbox"
				class="btn btn-ghost btn-sm btn-square"
				aria-label={ bellAriaLabel(unread) }
				title={ bellAriaLabel(unread) }
			>
				@ui.IconSpan("lucide--bell", "size-5")
			</a>
			if unread > 0 {
				<span
					class="indicator-item indicator-top indicator-end badge badge-error badge-sm tabular-nums"
					data-notifications-badge
				>{ bellUnreadLabel(unread) }</span>
			}
		}
	</div>
}
