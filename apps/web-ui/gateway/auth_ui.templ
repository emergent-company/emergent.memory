package main

import (
	"net/url"

	"github.com/emergent-company/emergent.memory/apps/web-ui/webui"
	"github.com/emergent-company/go-daisy/components/form"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Sign-in page (task 4.1) ---

// loginPage is the standalone sign-in screen rendered at /auth/login in
// session mode. It is a full document on purpose (no appShell): a centered
// brand + card on the app's dark canvas with the same anti-white-flash paint
// guard the shell uses. The "Sign in" action links to /auth/start, which runs
// the real OIDC redirect.
templ loginPage(sentryDSN string, sentryEnvironment string, sentryTracesSampleRate float64, sentryReplaySessionSampleRate float64, sentryReplayOnErrorSampleRate float64, returnTo string) {
	{{
		startHref := "/auth/start"
		if returnTo != "" {
			startHref = "/auth/start?return_to=" + url.QueryEscape(returnTo)
		}
	}}
	<!DOCTYPE html>
	<html lang="en" data-theme="dark" class="group/html">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="theme-color" content="#171921"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png"/>
			<link rel="manifest" href="/assets/manifest.webmanifest"/>
			@appleSplashLinks()
			<title>{ pageTitle("Sign in") }</title>
			<!-- Pre-paint guard: single source is foucBackgroundGuard(). -->
			@foucBackgroundGuard()
			<style>
			/* Sign-in stage: full-viewport centered column over a faint
			   brass/steel aura. Self-contained so the page never depends on
			   app.css beyond the daisy utilities it already loads. */
			.login-stage {
				position: relative;
				min-height: 100dvh;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				padding: 2.5rem 1.5rem;
			}
			.login-aura {
				position: absolute;
				inset: 0;
				pointer-events: none;
				background:
					radial-gradient(640px 360px at 50% -8%, oklch(0.74 0.135 78 / 0.15), transparent 70%),
					radial-gradient(760px 500px at 88% 112%, oklch(0.64 0.105 240 / 0.09), transparent 70%),
					radial-gradient(520px 420px at 4% 96%, oklch(0.76 0.15 162 / 0.05), transparent 70%);
			}
			.login-card {
				position: relative;
				width: 100%;
				max-width: 24rem;
				padding: 2.25rem 1.75rem 2rem;
				text-align: center;
				border-radius: 1.25rem;
				border: 1px solid oklch(1 0 0 / 0.07);
				background: linear-gradient(180deg, oklch(0.225 0.017 274), oklch(0.185 0.014 274));
				box-shadow:
					0 32px 90px -28px oklch(0 0 0 / 0.7),
					inset 0 1px 0 oklch(1 0 0 / 0.05);
			}
			.login-brand {
				display: flex;
				justify-content: center;
			}
			.login-divider {
				height: 1px;
				margin: 1.25rem 0 1.5rem;
				background: linear-gradient(90deg, transparent, oklch(1 0 0 / 0.1), transparent);
			}
			.login-title {
				margin: 0;
				font-size: 1.4rem;
				line-height: 1.25;
				font-weight: 700;
				letter-spacing: -0.015em;
			}
			.login-subtitle {
				margin: 0.4rem auto 0;
				max-width: 18rem;
				font-size: 0.85rem;
				line-height: 1.5;
				color: var(--color-base-content);
				opacity: 0.55;
			}
			.login-cta {
				margin-top: 1.75rem;
			}
			.login-foot {
				margin: 1.5rem 0 0;
				font-size: 0.7rem;
				letter-spacing: 0.02em;
				color: var(--color-base-content);
				opacity: 0.35;
			}
			</style>
			<link rel="stylesheet" href={ templ.SafeURL(webui.AssetPath("/css/app.css")) } data-asset-track="reload"/>
			<!-- Sentry sits after the stylesheet, as in the app shell: the SDK is
			     deferred today (see sentry_head.templ), so position blocks
			     nothing — this keeps it behind app.css even if that regresses. -->
			@sentryHead(sentryHeadOpts{
				DSN:                     sentryDSN,
				Environment:             sentryEnvironment,
				TracesSampleRate:        sentryTracesSampleRate,
				ReplaySessionSampleRate: sentryReplaySessionSampleRate,
				ReplayOnErrorSampleRate: sentryReplayOnErrorSampleRate,
			})
		</head>
		<body class="bg-base-200">
			<div class="login-stage">
				<div class="login-aura" aria-hidden="true"></div>
				<main class="login-card">
					<div class="login-brand">
						@memoryLogo()
					</div>
					<div class="login-divider" aria-hidden="true"></div>
					<h1 class="login-title">Sign in to Memory</h1>
					<p class="login-subtitle">Continue with your Memory account</p>
					<div class="login-cta">
						@ui.Button(ui.ButtonProps{
							Type:    ui.ButtonTypeLink,
							Href:    startHref,
							Variant: ui.ButtonPrimary,
							Size:    ui.ButtonLG,
							Block:   true,
							Glow:    true,
						}) {
							Sign in
						}
					</div>
				</main>
			</div>
		</body>
	</html>
}

// --- Project switcher (task 4.2) ---

// projectSwitcher renders the compact "current project" dropdown in the app
// navbar: it doubles as the org selector. The trigger shows the active
// project (prefixed with its org name when known), the dropdown lists
// projects grouped under muted, non-clickable org headers (an unknown/org-less
// project lands in a trailing "Other" group — it never disappears), and a
// "New project" footer opens the create dialog. State changes are POSTs (no
// GET links): switching re-issues the session and redirects back to the page
// the switch happened on. currentOrgName is the resolved org display name for
// current ("" when unknown or no current project). orgs feeds the create
// modal's org <select>.
//
// The modal open/close functions live in a raw <script> element at the END of
// this component (after the dropdown and the dialog), NEVER inside the
// <ul class="menu">: daisyUI's `.menu li > *` selector applies `display:grid`
// to any direct li child (including a templ-emitted <script>), which would
// override the UA `display:none` and paint the JS source as a tall visible
// blob inside the dropdown. Buttons reference the plain global functions via
// an `onclick` attribute instead of templ's OnClick (whose script would be
// emitted at the reference site, i.e. back inside the menu markup).
//
// Presentation is breakpoint-dependent, content is not: md and up keeps the
// compact focus dropdown, while below md the same list opens in a full-screen
// dialog (projectPickerDialog). The dropdown cannot work at phone widths —
// dropdown-end anchors a ~330px panel to a trigger that sits near the left of
// the navbar, so on a 390px viewport the menu starts at x = -52px and every
// label is clipped. projectSwitcherLabel, projectPickerItems and
// projectPickerActions are shared by both presentations, so they cannot drift.
templ projectSwitcher(current *ProjectRef, currentOrgName string, activeOrg *Org, projectGroups []projectGroup, orgs []Org, recentProjects []ProjectRef, showRecent bool, pendingInvites []PendingInviteDto) {
	<div class="hidden min-w-0 md:block">
		@ui.Dropdown(ui.DropdownEnd, nil) {
			@ui.Button(ui.ButtonProps{
				Type:       ui.ButtonTypeButton,
				Variant:    ui.ButtonGhost,
				Size:       ui.ButtonSM,
				ExtraClass: "gap-1.5 font-normal min-w-0 shrink",
				Attrs: templ.Attributes{
					"tabindex":      "0",
					"aria-haspopup": "menu",
					"aria-label":    "Switch project",
					"data-testid":   "project-switcher",
				},
			}) {
				@projectSwitcherLabel(current, currentOrgName, activeOrg, len(pendingInvites))
			}
			@ui.DropdownMenu(templ.Attributes{"aria-label": "Projects", "class": "min-w-80 border-base-content/10 z-50 max-h-96 flex-nowrap overflow-x-hidden overflow-y-auto"}) {
				@projectPickerItems(current, projectGroups, recentProjects, showRecent, pendingInvites)
				<li class="menu-title sticky bottom-0 mt-1.5 border-t border-base-content/10 bg-base-100 px-1 py-1.5">
					@projectPickerActions()
				</li>
			}
		}
	</div>
	<div class="min-w-0 md:hidden">
		@ui.Button(ui.ButtonProps{
			Type:       ui.ButtonTypeButton,
			Variant:    ui.ButtonGhost,
			Size:       ui.ButtonSM,
			ExtraClass: "gap-1.5 font-normal min-w-0 shrink",
			AriaLabel:  "Switch project",
			Attrs: templ.Attributes{
				"id":            "project-picker-trigger",
				"data-testid":   "project-switcher-mobile",
				"aria-haspopup": "dialog",
				"aria-controls": "project-picker-modal",
				"onclick":       "openProjectPicker()",
			},
		}) {
			@projectSwitcherLabel(current, currentOrgName, activeOrg, len(pendingInvites))
		}
	</div>
	@projectPickerDialog(current, currentOrgName, activeOrg, projectGroups, recentProjects, showRecent, pendingInvites)
	@newProjectModal(orgs, activeOrg)
	<script>
	function openNewProjectModal() {
		var t = document.activeElement;
		if (t && typeof t.blur === "function") t.blur();
		// The mobile picker stays behind the create dialog otherwise, and its
		// full-screen card would be left open underneath on cancel.
		var picker = document.getElementById("project-picker-modal");
		if (picker && picker.open) picker.close();
		window.MemoryApp.openDialog("new-project-modal");
		var i = document.getElementById("new-project-name");
		if (i) i.focus();
	}
	function closeNewProjectModal() {
		var d = document.getElementById("new-project-modal");
		if (d) d.close();
	}
	function openProjectPicker() {
		var t = document.activeElement;
		if (t && typeof t.blur === "function") t.blur();
		window.MemoryApp.openDialog("project-picker-modal");
		// app.css turns off this dialog's entry transition, so showModal() focuses
		// the dialog itself (aria-labelledby → the title is announced). If that
		// ever regresses, put focus on the heading rather than leaving it on body.
		var d = document.getElementById("project-picker-modal");
		if (d && d.open && !d.contains(document.activeElement)) {
			var h = document.getElementById("project-picker-title");
			if (h) h.focus();
		}
	}
	// Hand focus back to the trigger the picker was opened from, so a keyboard
	// user resumes where they were instead of at the document top
	// (openProjectPicker blurs the trigger, so the native restore has nothing
	// to return to). Wired to the dialog's `close` event, which fires for the X,
	// Esc and the backdrop button alike.
	function restoreProjectPickerFocus() {
		// One task later: the dialog's own teardown moves focus to <body> after
		// our handler runs when the dismissed control lived inside the card (the
		// backdrop button does), which would undo an immediate focus().
		setTimeout(function () {
			var t = document.getElementById("project-picker-trigger");
			if (t) t.focus();
		}, 0);
	}
	function closeProjectPicker() {
		var d = document.getElementById("project-picker-modal");
		if (d) d.close();
	}
	</script>
}

// pickerSectionHeader is a muted, non-interactive section label inside the
// switcher (used for the "Recent" section above the org-grouped list). px-2.5
// matches the .menu-sm item padding (.625rem) so labels and rows share the
// same left edge.
templ pickerSectionHeader(label string) {
	<li class="menu-title pointer-events-none px-2.5 pt-3 pb-0.5 text-[10px] font-medium tracking-[0.14em] uppercase text-muted-faint select-none">
		{ label }
	</li>
}

// projectGroupHeader is one org section header in the switcher: for a real org
// the name is a link that opens the org context (landing page) and a cogwheel
// link opens its Settings hub; the org-less "Other" group stays a muted,
// non-clickable label. The li is a .menu-title so its children are exempt from
// daisyUI's .menu li > * grid rule, and px-2.5 keeps it flush with the rows.
templ projectGroupHeader(g projectGroup) {
	if g.OrgID != "" {
		<li class="menu-title px-2.5 pt-3 pb-0.5 text-[10px] font-medium tracking-[0.14em] uppercase text-muted-strong">
			<div class="flex w-full items-center gap-1">
				<a href={ templ.URL("/orgs/" + url.PathEscape(g.OrgID)) } class="min-w-0 flex-1 truncate text-left hover:text-base-content" title={ projectGroupLabel(g) }>
					{ projectGroupLabel(g) }
				</a>
				<a href={ templ.URL("/orgs/" + url.PathEscape(g.OrgID) + "/settings") } class="shrink-0 text-muted-faint hover:text-base-content" aria-label={ "Manage " + projectGroupLabel(g) } title="Manage organization">
					@ui.IconSpan("lucide--settings", "size-3.5")
				</a>
			</div>
		</li>
	} else {
		@pickerSectionHeader(projectGroupLabel(g))
	}
}

// projectSwitchRow is one project in the switcher menu: a link to the
// project's scoped landing, so switching lands on the target project's URL
// (each tab keeps its own context). The active project is marked with a check.
templ projectSwitchRow(p ProjectRef, active bool) {
	<li>
		<a href={ templ.URL(projectScopeURL(p.OrgID, p.ID) + "/agents") } role="menuitem" class="flex w-full min-w-0 cursor-pointer items-center gap-2 text-left">
			<span class={ "min-w-0 flex-1 truncate text-sm", templ.KV("text-muted-strong", !active) }>{ p.Name }</span>
			if active {
				@ui.IconSpan("lucide--check", "size-4 shrink-0 text-primary")
			}
		</a>
	</li>
}

// projectSwitcherLabel is the trigger label shared by the desktop dropdown and
// the mobile full-screen picker: the org name over the project name when both
// are known, the active org with a "Select project" hint when no project is
// selected, and a bare placeholder otherwise. Shared so the two breakpoints
// cannot drift.
templ projectSwitcherLabel(current *ProjectRef, currentOrgName string, activeOrg *Org, pendingCount int) {
	if current != nil {
		if currentOrgName != "" {
			<div class="flex min-w-0 flex-col text-left leading-tight">
				<span class="max-w-[8rem] truncate sm:max-w-[16rem] text-[10px] font-medium tracking-[0.14em] uppercase text-muted-strong">{ currentOrgName }</span>
				<span class="max-w-[8rem] truncate sm:max-w-[16rem] text-sm">{ current.Name }</span>
			</div>
		} else {
			<span class="max-w-[8rem] truncate sm:max-w-[12rem] text-sm">{ current.Name }</span>
		}
	} else if activeOrg != nil {
		<div class="flex min-w-0 flex-col text-left leading-tight">
			<span class="max-w-[8rem] truncate sm:max-w-[16rem] text-[10px] font-medium tracking-[0.14em] uppercase text-muted-strong">{ activeOrg.Name }</span>
			<span class="max-w-[8rem] truncate sm:max-w-[16rem] text-sm text-muted-strong">Select project</span>
		</div>
	} else {
		<span class="text-sm text-muted-strong">Select project</span>
	}
	if pendingCount > 0 {
		@ui.Badge(ui.BadgeProps{
			Label:       inviteCountLabel(pendingCount),
			Variant:     ui.BadgePrimary,
			Size:        ui.BadgeSizeXS,
			DirectLabel: true,
			Attrs: templ.Attributes{
				"data-testid": "pending-invites-badge",
				"title":       pendingInviteBadgeTitle(pendingCount),
				"aria-label":  pendingInviteBadgeTitle(pendingCount),
			},
		})
	}
	@ui.IconSpan("lucide--chevron-down", "size-3.5 text-muted-faint")
}

// projectPickerItems is the project list shared by the desktop dropdown menu
// and the mobile full-screen picker: the optional "Recent" section, then one
// group per organization in org order, then a trailing "Other" group for
// org-less projects — plus the first-run empty line. An organization with no
// projects keeps its header and gets an italic "No projects" line instead of
// rows, so the org stays visible (and switchable) rather than reading like a
// broken header. It emits <li> rows only, so each caller supplies its own <ul>.
templ projectPickerItems(current *ProjectRef, projectGroups []projectGroup, recentProjects []ProjectRef, showRecent bool, pendingInvites []PendingInviteDto) {
	if len(pendingInvites) > 0 {
		@pickerSectionHeader(pendingInviteSectionLabel(len(pendingInvites)))
		for _, inv := range pendingInvites {
			@pendingInvitePickerRow(inv)
		}
	}
	if showRecent && len(recentProjects) > 0 {
		@pickerSectionHeader("Recent")
		for _, p := range recentProjects {
			@projectSwitchRow(p, current != nil && current.ID == p.ID)
		}
	}
	if len(projectGroups) == 0 {
		<li role="menuitem" aria-disabled="true" class="pointer-events-none">
			<span class="text-muted-faint text-xs">No projects yet</span>
		</li>
	} else {
		for _, g := range projectGroups {
			@projectGroupHeader(g)
			if len(g.Projects) == 0 {
				// A non-interactive row inside role="menu", so it carries
				// menuitem + aria-disabled rather than aria-hidden: the empty
				// state is the point of the row, and a screen reader should hear
				// it rather than a bare org heading.
				<li role="menuitem" aria-disabled="true" class="pointer-events-none px-2.5 pb-1">
					<span class="text-muted-faint text-xs italic">No projects</span>
				</li>
			} else {
				for _, p := range g.Projects {
					@projectSwitchRow(p, current != nil && current.ID == p.ID)
				}
			}
		}
	}
}

// pendingInvitePickerRow is one invitation addressed to the signed-in account,
// shown at the top of the project switcher and the mobile picker. Accept is a
// one-click token-bound form that lands on the invitation's target project (or
// the org list for an org-only invite); the full page — with Decline, the
// "signed in as" line and the wrong-account explanation — lives at
// /invites/accept and /profile/invitations.
templ pendingInvitePickerRow(inv PendingInviteDto) {
	<li class="px-2.5 py-1.5">
		<form method="post" action={ templ.URL("/invites/" + url.PathEscape(inv.ID) + "/accept") } class="flex w-full items-center gap-2">
			<input type="hidden" name="token" value={ inv.Token }/>
			<input type="hidden" name="return_to" value={ inviteAcceptPath(inv.OrganizationID, inv.ProjectID) }/>
			<div class="min-w-0 flex-1">
				<p class="truncate text-sm">{ inviteTargetLabel(&inv) }</p>
				@ui.EmptyNote(ui.EmptyNoteProps{Size: ui.EmptyNoteSize2XS, Class: "truncate"}) {
					{ pendingInvitePickerMeta(inv) }
				}
			</div>
			@ui.Button(ui.ButtonProps{
				Type:       ui.ButtonTypeSubmit,
				Variant:    ui.ButtonSuccess,
				Style:      ui.ButtonStyleOutline,
				Size:       ui.ButtonXS,
				Icon:       "lucide--check",
				ExtraClass: "shrink-0",
			}) {
				Accept
			}
		</form>
	</li>
}

// projectPickerActions is the "New project" / "New org" footer pair shared by
// the dropdown and the mobile picker.
templ projectPickerActions() {
	<div class="flex items-center">
		<a href="#" onclick="openNewProjectModal(); return false;" class="flex flex-1 items-center justify-center gap-1.5 px-3 py-0.5 text-sm font-normal text-muted-strong transition-colors hover:text-base-content">
			@ui.IconSpan("lucide--folder-plus", "size-3.5")
			New project
		</a>
		<span class="h-4 w-px shrink-0 bg-base-content/15" aria-hidden="true"></span>
		<a href="/orgs/new" class="flex flex-1 items-center justify-center gap-1.5 px-3 py-0.5 text-sm font-normal text-muted-strong transition-colors hover:text-base-content">
			@ui.IconSpan("lucide--building-2", "size-3.5")
			New org
		</a>
	</div>
}

// projectPickerDialog is the mobile presentation of the switcher: a
// full-screen card with a header, a close X, the scrollable shared list and the
// shared footer actions. Opened by the md:hidden trigger above; the native
// <dialog> supplies focus trapping, Esc and the backdrop for free, and closing
// it returns focus to the trigger.
//
// h-dvh (not vh) so the card tracks the collapsing mobile browser chrome, and
// header/footer are shrink-0 so only the list ever moves: the title and the X
// stay put however many projects there are. The header is unpadded on the
// right on purpose — the X is a 44px target whose glyph is centred, so letting
// the button sit flush puts that glyph on the cog column of the org headers
// below it instead of ~16px to its left. The box's own padding is zeroed in
// app.css (#project-picker-modal .modal-box) because the generic .modal-box
// rule adds a second bottom inset for dialogs that have no footer of their
// own; here exactly one rule owns the gap, the footer's own pt-2 /
// pb-[max(0.5rem,env(safe-area-inset-bottom))] — equal top and bottom on a
// device without a home indicator, and only the bottom growing where the inset
// means something.
// The list keeps role="menu" to match the desktop dropdown's semantics for the
// same rows.
templ projectPickerDialog(current *ProjectRef, currentOrgName string, activeOrg *Org, projectGroups []projectGroup, recentProjects []ProjectRef, showRecent bool, pendingInvites []PendingInviteDto) {
	{{
		context := currentOrgName
		if context == "" && activeOrg != nil {
			context = activeOrg.Name
		}
	}}
	{{
		title := "Switch project"
		if current == nil {
			title = "Select project"
		}
	}}
	@ui.Dialog(ui.DialogProps{
		ID:       "project-picker-modal",
		BoxClass: "flex h-dvh max-h-none w-screen max-w-none flex-col overflow-hidden rounded-none p-0",
		Attrs: templ.Attributes{
			"data-testid":     "project-picker-modal",
			"aria-labelledby": "project-picker-title",
			// 'close' fires for every exit path — the X, Esc and the backdrop
			// button ui.Dialog renders — so focus returns to the trigger however
			// the card was dismissed.
			"onclose": "restoreProjectPickerFocus()",
		},
	}) {
		<header class="flex shrink-0 items-center justify-between gap-3 border-b border-base-content/10 py-3 pl-4">
			<div class="min-w-0">
				if context != "" {
					<p class="truncate text-[10px] font-medium tracking-[0.14em] uppercase text-muted-strong">{ context }</p>
				}
				<h2 id="project-picker-title" class="truncate text-base font-medium" tabindex="-1">{ title }</h2>
			</div>
			@ui.Button(ui.ButtonProps{
				Type:       ui.ButtonTypeButton,
				Variant:    ui.ButtonGhost,
				Size:       ui.ButtonSM,
				Shape:      ui.ButtonShapeSquare,
				Icon:       "lucide--x",
				AriaLabel:  "Close project picker",
				ExtraClass: "mr-0 min-h-11 min-w-11 shrink-0",
				Attrs: templ.Attributes{
					"data-testid": "project-picker-close",
					"onclick":     "closeProjectPicker()",
				},
			})
		</header>
		<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain">
			<ul role="menu" aria-label="Projects" class="menu menu-sm w-full p-1">
				@projectPickerItems(current, projectGroups, recentProjects, showRecent, pendingInvites)
			</ul>
		</div>
		<footer class="shrink-0 border-t border-base-content/10 px-2 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))]">
			@projectPickerActions()
		</footer>
	}
}

// newProjectModal is the create-project dialog opened from the switcher
// footer. It POSTs to /projects (name + orgId); the submit is disabled until
// the user belongs to an organization.
templ newProjectModal(orgs []Org, activeOrg *Org) {
	@ui.Dialog(ui.DialogProps{ID: "new-project-modal", BoxClass: "w-full max-w-sm"}) {
		<div class="mb-5 flex items-start justify-between gap-4">
			<div>
				@ui.DialogTitle() {
					New project 
				}
				@ui.EmptyNote(ui.EmptyNoteProps{Class: "mt-0.5"}) {
					Projects group the agents, memory, and settings you work on together. 
				}
			</div>
			@ui.Button(ui.ButtonProps{
				Type:      ui.ButtonTypeButton,
				Variant:   ui.ButtonGhost,
				Size:      ui.ButtonSM,
				Shape:     ui.ButtonShapeCircle,
				Icon:      "lucide--x",
				AriaLabel: "Close",
				Attrs:     templ.Attributes{"onclick": "closeNewProjectModal()"},
			})
		</div>
		<form method="post" action="/projects" class="flex flex-col gap-4">
			@form.FormControl("new-project-name", "Project name", form.LabelAbove, "", "", nil) {
				<input id="new-project-name" name="name" type="text" required placeholder="e.g. Home lab" class="input w-full"/>
			}
			@form.FormControl("new-project-org", "Organization", form.LabelAbove, "", "", nil) {
				if len(orgs) == 0 {
					@ui.EmptyNote(ui.EmptyNoteProps{Tone: ui.EmptyNoteToneQuiet}) {
						You need an organization first. 
					}
				} else {
					<select id="new-project-org" name="orgId" required class="select w-full">
						if activeOrg != nil {
							<option value={ activeOrg.ID } selected>{ activeOrg.Name }</option>
						} else {
							<option value="" disabled selected>Select an organization</option>
						}
						for _, o := range orgs {
							if activeOrg == nil || o.ID != activeOrg.ID {
								<option value={ o.ID }>{ o.Name }</option>
							}
						}
					</select>
				}
			}
			@form.FormActions("", "") {
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeButton,
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonSM,
					Attrs:   templ.Attributes{"onclick": "closeNewProjectModal()"},
				}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{
					Type:    ui.ButtonTypeSubmit,
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonSM,
					Attrs: templ.Attributes{
						"id":       "new-project-create",
						"disabled": len(orgs) == 0,
					},
				}) {
					Create
				}
			}
		</form>
	}
}
