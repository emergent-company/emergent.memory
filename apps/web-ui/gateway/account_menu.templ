package main

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// userAccountMenu renders the topbar account menu: the signed-in user's avatar
// as a dropdown trigger listing the active account, any other cached accounts
// (switch via POST /auth/switch), "Add another account" (/auth/add), "My
// Profile" (/profile, htmx partial swap into #main-content), and "Log out"
// (POST /auth/logout). Renders nothing when user is nil (dev / API-key mode
// has no identity).
//
// The menu itself is ui.AccountMenu in go-daisy, which the market renders too —
// this function only maps the gateway's session type onto it and owns the
// gateway's routes. Behaviour, labels and markup live in the shared component so
// the two apps cannot drift.
templ userAccountMenu(user *currentUser, accounts []currentUser) {
	@ui.AccountMenu(ui.AccountMenuProps{
		SignedIn:    user != nil,
		Active:      accountForUser(user),
		Others:      accountsForUsers(accounts),
		SwitchPath:  "/auth/switch",
		AddPath:     "/auth/add",
		ProfilePath: "/profile",
		// The profile link swaps the page into #main-content rather than
		// reloading the shell; the component passes these through so the shared
		// markup can stay app-agnostic.
		ProfileAttrs: templ.Attributes{
			"hx-get":      "/profile",
			"hx-target":   "#main-content",
			"hx-swap":     "innerHTML",
			"hx-push-url": "true",
		},
		LogoutPath: "/auth/logout",
	})
}

// accountForUser maps the gateway's session identity onto the shared account
// shape. A nil user yields the zero Account, which ui.AccountMenu never renders
// when SignedIn is false.
func accountForUser(user *currentUser) ui.Account {
	if user == nil {
		return ui.Account{}
	}
	return accountFor(*user)
}

// accountFor maps one gateway identity onto the shared account shape — the
// single place the field correspondence lives, so a new identity field cannot
// reach the menu for one row and not another.
func accountFor(user currentUser) ui.Account {
	return ui.Account{Sub: user.Sub, Name: user.Name, Email: user.Email, Picture: user.Picture}
}

// accountsForUsers maps the cached accounts (the switch list) one by one.
func accountsForUsers(users []currentUser) []ui.Account {
	if len(users) == 0 {
		return nil
	}
	out := make([]ui.Account, 0, len(users))
	for _, u := range users {
		out = append(out, accountFor(u))
	}
	return out
}
