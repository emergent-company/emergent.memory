package main

import (
	"strconv"

	"github.com/emergent-company/go-daisy/components/layout"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// --- Embeddings status/progress ---

// EmbeddingsPage renders the embedding pipeline status: per-queue job counts,
// the live embedding coverage, worker running/paused state, and the active
// configuration. Each section degrades independently: a failed progress fetch
// renders an error for the queue section (leaving the worker section intact), a
// failed status fetch renders an error for the worker section (leaving the
// queue section intact), and a failed coverage fetch renders a coverage-only
// error. An all-zero queue renders the "no statistics yet" state, unless
// coverage shows live rows that are all embedded — then it reads as no
// pending embedding work instead.
templ EmbeddingsPage(data embeddingPageData) {
	@layout.Container(layout.ContainerLG, nil) {
		@embeddingsHeader(data.ProgressErr == nil && data.StatusErr == nil)
		if data.EmbeddingModelMissing {
			@embeddingsModelWarning()
		}
		if data.ProgressErr != nil {
			@pageError("Failed to load embedding statistics", data.ProgressErr)
		} else if data.Empty {
			if data.coverageComplete() {
				@embeddingsComplete(data.Coverage)
			} else {
				@embeddingsEmpty()
			}
		} else {
			@queueCountsSection(data.Progress)
		}
		if data.CoverageErr != nil {
			@coverageSectionError(data.CoverageErr)
		} else if data.Coverage != nil {
			@coverageSection(data.Coverage)
		}
		if data.StatusErr != nil {
			@workerStateError(data.StatusErr)
		} else if data.Status != nil {
			@workerStateSection(data.Status)
		}
	}
}

templ embeddingsHeader(ok bool) {
	@pageHeader("Memory Browser", "Embeddings", "Vector embedding pipeline — queue backlog, worker state, and tuning.") {
		if ok {
			@ui.Badge(ui.BadgeProps{
				Label:   "pipeline status",
				Variant: ui.BadgeGhost,
				Size:    ui.BadgeSizeSM,
				Icon:    "lucide--scan-line",
			})
		}
	}
}

// embeddingsModelWarning is shown when the active project has no embedding
// model configured. In that state the embedding sweep silently enqueues
// nothing, so objects and relationships never get vectors. It links to the
// project's provider settings, which hold the default models (including the
// embedding model), so the message names the real destination.
templ embeddingsModelWarning() {
	<div class="mb-6" data-testid="embeddings-model-warning">
		@ui.Alert(ui.AlertProps{
			Type:    ui.AlertWarning,
			Style:   ui.AlertStyleOutline,
			Icon:    "lucide--alert-triangle",
			Message: "No embedding model is configured for this project. Object and relationship embeddings will not be generated, so objects and relationships stay without vectors and similar-objects search is incomplete. Set a default embedding model and the pipeline will start.",
		})
		@ui.Button(ui.ButtonProps{
			Type:       ui.ButtonTypeLink,
			Href:       "/settings/providers",
			Variant:    ui.ButtonOutline,
			Size:       ui.ButtonSM,
			Icon:       "lucide--settings",
			ExtraClass: "mt-3",
		}) {
			Configure embedding model
		}
	</div>
}

// embeddingsEmpty is the "no statistics yet" state: the queue counters are all
// zero (or unavailable), so the page shows a single clear message instead of a
// row of zeroes. It is also the fallback when coverage is unavailable or
// reports no live rows.
templ embeddingsEmpty() {
	@ui.EmptyState(ui.EmptyStateProps{
		Icon:        "lucide--scan-line",
		Title:       "No embedding statistics yet",
		Description: "Once objects and relationships flow through the embedding pipeline, queue counts will show up here.",
		Bordered:    true,
		Class:       "py-12",
		Attrs:       templ.Attributes{"data-testid": "embeddings-empty"},
	})
}

// embeddingsComplete is the queue empty state for an idle, fully-embedded
// project: every live row holds a vector and no queue work is pending, so the
// all-zero counters are explained rather than left reading as "no data". It
// names the embedded object and relationship counts.
templ embeddingsComplete(c *EmbeddingCoverageResponse) {
	@ui.EmptyState(ui.EmptyStateProps{
		Icon: "lucide--check",
		Title: "No embedding work pending",
		Description: groupDigits(c.Objects.Embedded) + " objects and " + groupDigits(c.Relationships.Embedded) +
			" relationships hold embeddings. Completed embedding jobs are removed after a retention window, so the queue counters read zero.",
		Bordered: true,
		Class:    "py-12",
		Attrs:    templ.Attributes{"data-testid": "embeddings-complete"},
	})
}

// coverageSection renders the embedding inventory per queue: live rows that
// already hold a vector, rows still awaiting one, and their total. Unlike the
// job counters above it is not subject to the terminal-row purge, so an idle
// project that is fully embedded still shows its vectors here.
templ coverageSection(c *EmbeddingCoverageResponse) {
	<div class="mb-6" data-testid="embeddings-coverage">
		@ui.Section("Coverage", ui.SectionProps{BodyClass: "memory-density-comfortable"}) {
			<div class="flex flex-col gap-5">
				@coverageQueueRow("objects", "Objects", c.Objects)
				@coverageQueueRow("relationships", "Relationships", c.Relationships)
			</div>
		}
	</div>
}

// coverageQueueRow renders one queue's embedded/awaiting/total counts as stat
// cards under a small queue label.
templ coverageQueueRow(queue, title string, cov EmbeddingCoverage) {
	<div>
		@ui.Eyebrow(title, ui.EyebrowProps{Size: "text-[11px]", Margin: "mb-2"})
		@statRow([]ui.StatCardProps{
			{Label: "Embedded", Value: groupDigits(cov.Embedded), Icon: "lucide--check", IconColor: "bg-success/10 text-success", Attrs: templ.Attributes{"data-testid": "coverage-" + queue + "-embedded"}},
			{Label: "Awaiting", Value: groupDigits(cov.Awaiting), Icon: "lucide--clock", IconColor: "bg-warning/10 text-warning", Attrs: templ.Attributes{"data-testid": "coverage-" + queue + "-awaiting"}},
			{Label: "Total", Value: groupDigits(cov.Total), Icon: "lucide--layers", IconColor: "bg-base-200/60 text-base-content", Attrs: templ.Attributes{"data-testid": "coverage-" + queue + "-total"}},
		}, "")
	</div>
}

// coverageSectionError renders the Coverage section's failure state as an
// inline error, so the queue and worker sections stay usable when only the
// coverage endpoint failed.
templ coverageSectionError(err error) {
	<div class="mb-6" data-testid="embeddings-coverage-error">
		@ui.Section("Coverage", ui.SectionProps{BodyClass: "memory-density-comfortable"}) {
			@ui.Alert(ui.AlertProps{
				Type:    ui.AlertError,
				Style:   ui.AlertStyleOutline,
				Icon:    "lucide--alert-triangle",
				Message: err.Error(),
			})
		}
	</div>
}

// queueCountsSection renders the object and relationship queue counters as two
// titled sections of stat cards.
templ queueCountsSection(p *EmbeddingProgress) {
	@queueStatsSection("Object embedding queue", p.Objects)
	@queueStatsSection("Relationship embedding queue", p.Relationships)
}

templ queueStatsSection(title string, s EmbeddingQueueStats) {
	@ui.Section(title, ui.SectionProps{
		Margin:    "mb-6",
		BodyClass: "memory-density-comfortable",
	}) {
		@statRow([]ui.StatCardProps{
			{Label: "Pending", Value: strconv.FormatInt(s.Pending, 10), Icon: "lucide--clock", IconColor: "bg-base-200/60 text-base-content"},
			{Label: "Processing", Value: strconv.FormatInt(s.Processing, 10), Icon: "lucide--loader-circle", IconColor: "bg-primary/10 text-primary"},
			{Label: "Completed", Value: strconv.FormatInt(s.Completed, 10), Icon: "lucide--check", IconColor: "bg-success/10 text-success"},
			{Label: "Failed", Value: strconv.FormatInt(s.Failed, 10), Icon: "lucide--x", IconColor: "bg-error/10 text-error"},
			{Label: "Stale failed", Value: strconv.FormatInt(s.StaleFailed, 10), Icon: "lucide--history", IconColor: "bg-base-200/60 text-base-content"},
			{Label: "Dead letter", Value: strconv.FormatInt(s.DeadLetter, 10), Icon: "lucide--mail-warning", IconColor: "bg-warning/10 text-warning"},
		}, "")
	}
}

// workerStateError renders the worker-state section's failure state: the
// "Workers" title with an inline error alert, so the queue section above stays
// usable when only the status endpoint failed.
templ workerStateError(err error) {
	@ui.Section("Workers", ui.SectionProps{
		Margin:    "mb-6",
		BodyClass: "memory-density-comfortable",
	}) {
		@ui.Alert(ui.AlertProps{
			Type:    ui.AlertError,
			Style:   ui.AlertStyleOutline,
			Icon:    "lucide--alert-triangle",
			Message: err.Error(),
		})
	}
}

// workerStateSection renders the object/relationship/sweep worker state plus the
// active configuration.
templ workerStateSection(st *EmbeddingStatus) {
	@ui.Section("Workers", ui.SectionProps{
		Margin:    "mb-6",
		BodyClass: "memory-density-comfortable",
	}) {
		<div class="flex flex-wrap gap-2">
			@workerStateBadge("Objects", st.Objects)
			@workerStateBadge("Relationships", st.Relationships)
			@workerStateBadge("Sweep", st.Sweep)
		</div>
		<div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
			@configStat("Batch size", strconv.Itoa(st.Config.BatchSize), "lucide--layers")
			@configStat("Concurrency", strconv.Itoa(st.Config.Concurrency), "lucide--cpu")
			@configStat("Interval", strconv.Itoa(st.Config.IntervalMs)+"ms", "lucide--timer")
			@configStat("Stale after", strconv.Itoa(st.Config.StaleMinutes)+"m", "lucide--clock")
		</div>
		<div class="mt-4 flex flex-wrap items-center gap-2">
			@ui.Eyebrow("Adaptive scaling", ui.EyebrowProps{Size: "text-[10px]", Margin: "mb-0"})
			if st.Config.EnableAdaptiveScaling {
				@ui.Badge(ui.BadgeProps{Label: "enabled", Variant: ui.BadgeSuccess, Size: ui.BadgeSizeXS})
			} else {
				@ui.Badge(ui.BadgeProps{Label: "disabled", Variant: ui.BadgeNeutral, Size: ui.BadgeSizeXS})
			}
		</div>
	}
}

// workerStateBadge renders one worker's running/paused state as a labeled badge.
templ workerStateBadge(name string, st EmbeddingWorkerStatus) {
	{{ lbl, variant := workerStateLabel(st) }}
	@ui.Badge(ui.BadgeProps{
		Label:   name + ": " + lbl,
		Variant: variant,
		Size:    ui.BadgeSizeSM,
		Dot:     true,
	})
}

// configStat renders one configuration value as a small stat card.
templ configStat(label, value, icon string) {
	@ui.StatCard(ui.StatCardProps{
		Label:     label,
		Value:     value,
		Icon:      icon,
		IconColor: "bg-base-200/60 text-base-content",
	})
}
