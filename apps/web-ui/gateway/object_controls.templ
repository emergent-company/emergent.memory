package main

import (
	"net/url"
	"strconv"

	components "github.com/emergent-company/emergent.memory/apps/web-ui/components"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// objectWorkControls is the editable workflow strip at the top of an object
// page and the shared object preview. It shows the current status as a
// ticket-style badge trigger (dropdown of the other workflow statuses) and the
// current assignee as an avatar pill trigger (Unassigned, agents, members).
// Both controls render only for a type that declares a workflow; the caller
// passes the resolved objectStatusControl, so a no-workflow type never gets a
// second status editor next to its own typed `status` property.
templ objectWorkControls(obj *GraphObject, ctrl *objectStatusControl, candidates []boardAssigneeCandidate, target objectWorkControlTarget) {
	if !objectWorkControlDisabled(ctrl) {
		<div class="mt-3 flex flex-wrap items-center gap-2" data-testid="object-work-controls">
			@objectStatusPicker(target, obj.Status, ctrl)
			@objectAssigneeControl(target, obj.Assignee, candidates)
		</div>
	}
}

// objectStatusPicker renders the ticket-style status picker: the current
// status badge is the trigger, and the menu lists the workflow's other
// statuses. The selected status is posted as `status`; a preview surface swaps
// #object-preview-body, while a page surface redirects back to the object.
templ objectStatusPicker(target objectWorkControlTarget, current string, ctrl *objectStatusControl) {
	{{ options := make([]string, 0, len(ctrl.Options))
	for _, s := range ctrl.Options {
		if s != current {
			options = append(options, s)
		}
	} }}
	if len(options) == 0 {
		<div data-testid="object-status-control">
			@objectStatusTrigger(current)
		</div>
	} else {
		@ui.Dropdown(ui.DropdownEnd, templ.Attributes{"data-testid": "object-status-control"}) {
			<div
				tabindex="0"
				role="button"
				class="flex cursor-pointer items-center rounded-full py-0.5 pr-2 pl-0.5 outline-none transition hover:ring-1 hover:ring-base-content/25 focus-visible:ring-1 focus-visible:ring-base-content/45"
				aria-label="Change status"
				aria-haspopup="menu"
			>
				@objectStatusTrigger(current)
			</div>
			@ui.DropdownMenu(templ.Attributes{"aria-label": "Change status", "class": "min-w-44 border-base-content/10 z-50"}) {
				for _, s := range options {
					<li>
						<form
							method="post"
							action={ templ.URL(target.objectStatusPostsPath()) }
							if target.Preview {
								hx-post={ target.objectStatusPostsPath() }
								hx-target="#object-preview-body"
								hx-swap="innerHTML"
							}
							class="flex w-full"
						>
							@objectWorkControlHiddenFields(target)
							<input type="hidden" name="status" value={ s }/>
							<button type="submit" role="menuitem" class="flex w-full cursor-pointer items-center gap-2 text-left">
								@components.StatusBadge(boardStatusLabel(s), boardStatusIntent(s), "", components.StatusBadgeOpts{Size: ui.BadgeSizeXS, Dot: true})
							</button>
						</form>
					</li>
				}
			}
		}
	}
}

// objectStatusTrigger renders the current status badge (or a muted "Set status"
// placeholder when the object has no status yet).
templ objectStatusTrigger(current string) {
	if current == "" {
		@ui.Badge(ui.BadgeProps{Label: "Set status", Variant: ui.BadgeGhost, Size: ui.BadgeSizeSM, Icon: "lucide--circle-dashed"})
	} else {
		@components.StatusBadge(boardStatusLabel(current), boardStatusIntent(current), "", components.StatusBadgeOpts{
			Size:  ui.BadgeSizeSM,
			Dot:   true,
			Attrs: templ.Attributes{"data-status": current},
		})
	}
}

// objectAssigneeControl renders the ticket-style assignee picker: the current
// assignee pill is the trigger, and the menu lists Unassigned, then runtime
// agents, then project members. The selected value is posted as `assignee`; an
// empty value clears the assignment.
templ objectAssigneeControl(target objectWorkControlTarget, current string, candidates []boardAssigneeCandidate) {
	@ui.Dropdown(ui.DropdownEnd, templ.Attributes{"data-testid": "object-assignee-control"}) {
		<div
			tabindex="0"
			role="button"
			class="flex cursor-pointer items-center gap-2 rounded-full py-0.5 pr-2.5 pl-0.5 outline-none transition hover:ring-1 hover:ring-base-content/25 focus-visible:ring-1 focus-visible:ring-base-content/45"
			aria-label="Assignee"
			aria-haspopup="menu"
		>
			if current == "" {
				<div class="shrink-0">
					@ui.AvatarFull(ui.AvatarProps{Name: "Unassigned", Icon: "lucide--user", Size: ui.AvatarSize6, Tone: ui.AvatarToneMuted})
				</div>
				<span class="text-xs text-muted-faint">Unassigned</span>
			} else {
				<div class="shrink-0">
					@ui.AvatarFull(ui.AvatarProps{Name: current, Icon: "lucide--user", Size: ui.AvatarSize6, Fallback: ui.AvatarFallbackInitials, TextClass: "text-[10px]"})
				</div>
				<span class="max-w-32 truncate text-xs font-medium">{ current }</span>
			}
		</div>
		@ui.DropdownMenu(templ.Attributes{"aria-label": "Assignee", "class": "min-w-52 border-base-content/10 z-50"}) {
			<li>
				<form
					method="post"
					action={ templ.URL(target.objectAssigneePostsPath()) }
					if target.Preview {
						hx-post={ target.objectAssigneePostsPath() }
						hx-target="#object-preview-body"
						hx-swap="innerHTML"
					}
					class="flex w-full"
				>
					@objectWorkControlHiddenFields(target)
					<input type="hidden" name="assignee" value=""/>
					<button type="submit" role="menuitem" class="flex w-full cursor-pointer items-center gap-2 text-left">
						<div class="shrink-0">
							@ui.AvatarFull(ui.AvatarProps{Name: "Unassigned", Icon: "lucide--user", Size: ui.AvatarSize6, Tone: ui.AvatarToneMuted})
						</div>
						<span class="text-sm text-muted">Unassigned</span>
					</button>
				</form>
			</li>
			for _, c := range candidates {
				<li>
					<form
						method="post"
						action={ templ.URL(target.objectAssigneePostsPath()) }
						if target.Preview {
							hx-post={ target.objectAssigneePostsPath() }
							hx-target="#object-preview-body"
							hx-swap="innerHTML"
						}
						class="flex w-full"
					>
						@objectWorkControlHiddenFields(target)
						<input type="hidden" name="assignee" value={ c.Value }/>
						<button type="submit" role="menuitem" class="flex w-full cursor-pointer items-center gap-2 text-left">
							<div class="shrink-0">
								if c.IsAgent {
									@ui.AvatarFull(ui.AvatarProps{Name: c.Label, Icon: "lucide--bot", Size: ui.AvatarSize6, Tone: ui.AvatarToneMuted})
								} else {
									@ui.AvatarFull(ui.AvatarProps{Name: c.Label, Src: c.AvatarURL, Icon: "lucide--user", Size: ui.AvatarSize6, Fallback: ui.AvatarFallbackInitials, TextClass: "text-[10px]"})
								}
							</div>
							<div class="min-w-0 grow">
								<p class="truncate text-sm">{ c.Label }</p>
								if c.IsAgent {
									<p class="truncate text-[10px] text-muted-faint">agent</p>
								} else {
									<p class="truncate text-[10px] text-muted-faint">won't be picked up</p>
								}
							</div>
						</button>
					</form>
				</li>
			}
			<li class="pointer-events-none border-t border-base-content/10 px-3 py-1.5">
				<p class="text-[10px] text-muted-faint">Only agents that handle work are woken.</p>
			</li>
		}
	}
}

// objectWorkControlHiddenFields carries the surface context through a control
// POST: preview swaps keep the drawer's ?actions=board / ?rel= context, and
// page redirects keep the optional ?from= origin trail.
templ objectWorkControlHiddenFields(target objectWorkControlTarget) {
	if target.Preview {
		<input type="hidden" name="surface" value="preview"/>
	}
	if target.Actions != "" {
		<input type="hidden" name="actions" value={ target.Actions }/>
	}
	if target.Rel != "" {
		<input type="hidden" name="rel" value={ target.Rel }/>
	}
	if target.From != "" {
		<input type="hidden" name="from" value={ target.From }/>
	}
}

// objectWorkflowPanel renders the Overview's editable workflow panel: a labelled
// Status picker and Assignee picker. The panel is conditional — the caller only
// renders it for a type that declares a workflow — so a no-workflow type never
// gets a second status editor beside its typed `status` property. The preview
// drawer keeps the compact unlabelled strip (objectWorkControls).
templ objectWorkflowPanel(obj *GraphObject, ctrl *objectStatusControl, candidates []boardAssigneeCandidate, target objectWorkControlTarget) {
	if !objectWorkControlDisabled(ctrl) {
		@ui.Section("Workflow", ui.SectionProps{
			Margin:    "mt-6",
			BodyClass: "memory-density-comfortable",
		}) {
			<div class="flex flex-wrap items-start gap-6" data-testid="object-workflow-panel">
				<div class="flex flex-col gap-1.5">
					<span class="text-muted text-xs font-medium">Status</span>
					@objectStatusPicker(target, obj.Status, ctrl)
				</div>
				<div class="flex flex-col gap-1.5">
					<span class="text-muted text-xs font-medium">Assignee</span>
					@objectAssigneeControl(target, obj.Assignee, candidates)
				</div>
			</div>
		}
	}
}

// objectRailCount renders a rail item's trailing count pill. An empty label
// renders nothing, so a zero count simply leaves the item unbadged.
templ objectRailCount(label, testID string) {
	if label != "" {
		@ui.Badge(ui.BadgeProps{
			Label:   label,
			Variant: ui.BadgeNeutral,
			Style:   ui.BadgeStyleSoft,
			Size:    ui.BadgeSizeXS,
			Attrs:   templ.Attributes{"data-testid": testID},
		})
	}
}

// objectSimilarCountSlot is the rail's deferred similar-count placeholder. It
// swaps itself for the count badge after paint, so the slow vector search never
// blocks the page (issue #1096). A zero count swaps in nothing, removing the
// badge.
//
// hx-target="this" overrides the hx-target="#main-content" inherited from the
// page shell's <main> (htmx implicitInheritance=true); without it the count
// swap would replace the whole main-content region (and an empty zero-count
// response would delete it) — see objects.templ's objectSimilarObjectsDeferred.
templ objectSimilarCountSlot(objectID string) {
	<span
		class="inline-flex"
		hx-get={ templ.URL("/objects/" + url.PathEscape(objectID) + "/similar/count") }
		hx-trigger="load"
		hx-target="this"
		hx-swap="outerHTML"
		data-testid="object-similar-count-slot"
	></span>
}

// objectSubNav is the vertical sub-navigation rail shared by the object
// Overview, History, Relationships, and Similar objects views, mirroring
// documentSubNav. Relationships and Similar objects carry count badges;
// Similar's is deferred so the vector search stays off the critical path.
templ objectSubNav(objectID, active string, edgeCount int) {
	{{ base := "/objects/" + url.PathEscape(objectID)
	relationshipsBadge := templ.Component(nil)
	if edgeCount > 0 {
		relationshipsBadge = objectRailCount(strconv.Itoa(edgeCount), "object-relationships-count")
	} }}
	@components.SettingsRail("Object sections", active, []components.RailItem{
		{Key: "overview", Href: base, Icon: "lucide--file-text", Label: "Overview"},
		{Key: "history", Href: base + "/history", Icon: "lucide--history", Label: "History"},
		{Key: "relationships", Href: base + "/relationships", Icon: "lucide--link", Label: "Relationships", Badge: relationshipsBadge},
		{Key: "similar", Href: base + "/similar", Icon: "lucide--git-merge", Label: "Similar objects", Badge: objectSimilarCountSlot(objectID)},
	})
}
