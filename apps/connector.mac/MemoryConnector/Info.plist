<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Memory</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Memory</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.emergent.memory.connector</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.emergent.memory.connector</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The connector's hosted-MCP-server management API is loopback HTTP
		     (http://127.0.0.1:8931). This permits local networking only; ATS
		     still applies to non-local connections. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Sparkle 2 auto-update configuration. The rolling `mac-appcast` release
	     URL is permanent by design so an install several releases behind can
	     still resolve the newest archive. The public EdDSA key pairs with the
	     private key held only in the release pipeline. Sandbox XPC keys are
	     intentionally absent — the app is not sandboxed. -->
	<key>SUFeedURL</key>
	<string>https://github.com/emergent-company/emergent.memory/releases/download/memory-appcast/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>PmNdMg8V1L//noPSUCvjjmBy14WQfnlyeVPAFySIE2A=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SURequireSignedFeed</key>
	<true/>
	<!-- Prompt before installing; never silently install in the background. -->
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Emergent Company. Licensed under the MIT License (Diane-derived).</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Memory lets an agent list, add, edit, complete, move, and delete your reminders when you ask it to.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Memory lets an agent view and manage your reminders when you ask it to.</string>
</dict>
</plist>
